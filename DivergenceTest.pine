// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
indicator("WaveTrend Divergence Test", "DIV-TEST", overlay = false, max_lines_count = 50, max_labels_count = 50)

// ═══════════════════════════════════════════════════════════════════════════
// WHAT THIS TESTS
// ═══════════════════════════════════════════════════════════════════════════
// The divergence signal from the Liquidity Tracker, reproduced verbatim.
//   BULLISH divergence: between two fast/slow crosses, price prints a LOWER low
//     while the WaveTrend prints a HIGHER low -> the classic "momentum is
//     leaving the move" reversal, traded LONG.
//   BEARISH divergence: price a HIGHER high, WaveTrend a LOWER high -> SHORT.
// The WaveTrend (9/12/3 on hlc3), the money-flow wave, the per-cross low/high
// tracking and the divergence test are all copied from the source so the
// signals fired here are the same ones the indicator draws.
//
// Each divergence opens a paper trade at the close, scored on the same terms as
// every other test: 2R target, 1 ATR stop, 100-bar horizon, exact 1/(1+R) null,
// drift removed by averaging the two direction strata, Haldane-corrected MDL.

string G_WT = "WaveTrend"
float wtExt   = input.float(60.0, "Extreme level", minval = 5.0, maxval = 200.0, step = 5.0, group = G_WT)
int   wtChan  = input.int(9,  "Channel length", minval = 2, maxval = 100, group = G_WT)
int   wtAvg   = input.int(12, "Average length", minval = 2, maxval = 200, group = G_WT)
int   wtSig   = input.int(3,  "Signal length",  minval = 1, maxval = 50,  group = G_WT)

string G_DV = "Divergence"
bool  divExt    = input.bool(false, "Only between crosses beyond the extreme level", group = G_DV)
bool  divBoth   = input.bool(false, "The money flow must diverge as well", group = G_DV)
int   divMinBar = input.int(5,  "Minimum bars between the two crosses", minval = 1, maxval = 200, inline = "db", group = G_DV)
int   divMaxBar = input.int(20, "Maximum", minval = 5, maxval = 500, inline = "db", group = G_DV)

string G_MF = "Money flow (for the divBoth option)"
string flowType = input.string("EMA", "Smoothing", options = ["EMA", "SMA", "WMA", "RMA"], group = G_MF)
int   flowSm1   = input.int(21, "First smoothing",  minval = 2, maxval = 300, inline = "fs", group = G_MF)
int   flowSm2   = input.int(9,  "Second smoothing", minval = 1, maxval = 200, inline = "fs", group = G_MF)
float flowVolW  = input.float(50.0, "Close-in-range weight (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_MF)
float flowScale = input.float(150.0, "Scale", minval = 1.0, maxval = 1000.0, step = 10.0, group = G_MF)

float wtSrc = hlc3
float esa = ta.ema(wtSrc, wtChan)
float dev = ta.ema(math.abs(wtSrc - esa), wtChan)
float ci  = dev != 0 ? (wtSrc - esa) / (0.015 * dev) : 0.0
float wt1 = ta.ema(ci, wtAvg)
float wt2 = ta.sma(wt1, wtSig)
bool  wtOversold   = wt2 <= -wtExt
bool  wtOverbought = wt2 >=  wtExt

float rngBar    = high - low
float bodyPos   = rngBar > 0 ? (close - open) / rngBar : 0.0
float deltaMult = rngBar > 0 ? ((close - low) - (high - close)) / rngBar : 0.0
float fvw       = flowVolW / 100.0
float mfRaw = bodyPos * (1 - fvw) + deltaMult * fvw

smooth(float srcIn, simple int len) =>
    e  = ta.ema(srcIn, len)
    sm = ta.sma(srcIn, len)
    w  = ta.wma(srcIn, len)
    r  = ta.rma(srcIn, len)
    flowType == "SMA" ? sm : flowType == "WMA" ? w : flowType == "RMA" ? r : e
float mfOne = smooth(mfRaw, flowSm1)
float mfTwo = smooth(mfOne, math.max(flowSm2, 2))
float mf = (flowSm2 <= 1 ? mfOne : mfTwo) * flowScale

bool crossUp = ta.crossover(wt1, wt2)
bool crossDn = ta.crossunder(wt1, wt2)

// Running extremes since the last cross.
var float curLoPx  = na
var float curLoWt  = na
var float curLoMf  = na
var float curHiPx  = na
var float curHiWt  = na
var float curHiMf  = na
var float preLoPx  = na
var float preLoWt  = na
var float preLoMf  = na
var int   preLoB   = na
var float preHiPx  = na
var float preHiWt  = na
var float preHiMf  = na
var int   preHiB   = na

if na(curLoPx) or low < curLoPx
    curLoPx := low
if na(curLoWt) or wt1 < curLoWt
    curLoWt := wt1
curLoMf := na(curLoMf) ? mf : math.min(curLoMf, mf)
if na(curHiPx) or high > curHiPx
    curHiPx := high
if na(curHiWt) or wt1 > curHiWt
    curHiWt := wt1
curHiMf := na(curHiMf) ? mf : math.max(curHiMf, mf)

bool bullDiv = false
bool bearDiv = false
bool divBuyPt  = crossUp and (not divExt or wtOversold)
bool divSellPt = crossDn and (not divExt or wtOverbought)

if divBuyPt
    int gap = na(preLoB) ? na : bar_index - preLoB
    bool ok = not na(gap) and gap >= divMinBar and gap <= divMaxBar
    if ok
        bool priceLower = curLoPx < preLoPx
        bool waveHigher = curLoWt > preLoWt
        bool flowHigher = not divBoth or curLoMf > preLoMf
        if priceLower and waveHigher and flowHigher
            bullDiv := true
    preLoPx := curLoPx
    preLoWt := curLoWt
    preLoMf := curLoMf
    preLoB  := bar_index
    curHiPx := high
    curHiWt := wt1
    curHiMf := mf

if divSellPt
    int gap = na(preHiB) ? na : bar_index - preHiB
    bool ok = not na(gap) and gap >= divMinBar and gap <= divMaxBar
    if ok
        bool priceHigher = curHiPx > preHiPx
        bool waveLower   = curHiWt < preHiWt
        bool flowLower   = not divBoth or curHiMf < preHiMf
        if priceHigher and waveLower and flowLower
            bearDiv := true
    preHiPx := curHiPx
    preHiWt := curHiWt
    preHiMf := curHiMf
    preHiB  := bar_index
    curLoPx := low
    curLoWt := wt1
    curLoMf := mf

plot(wt1, "WaveTrend", color = color.new(#42A5F5, 0), linewidth = 2)
plot(wt2, "WaveTrend slow", color = color.new(#B2B5BE, 45), linewidth = 1)
hline( wtExt, "OB", color = color.new(#EF5350, 65), linestyle = hline.style_dashed)
hline(-wtExt, "OS", color = color.new(#26A69A, 65), linestyle = hline.style_dashed)
plotshape(bullDiv ? wt1 : na, "Bullish div", shape.triangleup,   location.absolute, color.new(#26A69A, 0), size = size.small)
plotshape(bearDiv ? wt1 : na, "Bearish div", shape.triangledown, location.absolute, color.new(#EF5350, 0), size = size.small)

alertcondition(bullDiv, "Bullish divergence", "WaveTrend bullish divergence.")
alertcondition(bearDiv, "Bearish divergence", "WaveTrend bearish divergence.")

// ═══════════════════════════════════════════════════════════════════════════
// MEASUREMENT PANEL  (build m2)   -- identical apparatus to every other test
// ═══════════════════════════════════════════════════════════════════════════
bool ictBull = bullDiv
bool ictBear = bearDiv

string STAT_GROUP  = "Measurement"
bool   statOnInput      = input.bool(true, "Show measurement panel", group = STAT_GROUP)
float  statTargetRInput = input.float(2.0, "Target (R)", minval = 0.5, maxval = 10.0, step = 0.5, group = STAT_GROUP)
float  statStopAtrInput = input.float(1.0, "Stop = ATR x", minval = 0.1, maxval = 10.0, step = 0.1, group = STAT_GROUP)
int    statAtrLenInput  = input.int(14, "ATR length", minval = 2, maxval = 200, group = STAT_GROUP)
int    statHorizonInput = input.int(100, "Horizon (bars)", minval = 5, maxval = 2000, group = STAT_GROUP)
float  statCostRInput   = input.float(0.05, "Round-trip cost (R)", minval = 0.0, maxval = 1.0, step = 0.005, group = STAT_GROUP)
int    statMinNInput    = input.int(30, "Minimum resolved per direction", minval = 5, maxval = 500, group = STAT_GROUP)
bool   statOneAtATimeInput = input.bool(false, "One trade at a time", group = STAT_GROUP)
string statPosInput     = input.string("Bottom Left", "Panel position", options = ["Top Right", "Top Left", "Middle Right", "Bottom Right", "Bottom Left"], group = STAT_GROUP)

f_statPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Middle Right"  => position.middle_right
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        => position.top_right

f_statPct(float v) =>
    na(v) ? "—" : str.tostring(v, "#.#") + "%"

f_statPp(float v) =>
    na(v) ? "—" : (v > 0 ? "+" : "") + str.tostring(v, "#.#") + "pp"

var array<float> statEntry  = array.new<float>()
var array<float> statStop   = array.new<float>()
var array<float> statTarget = array.new<float>()
var array<int>   statDir    = array.new<int>()
var array<int>   statOpened = array.new<int>()

var int statSigLong  = 0
var int statSigShort = 0
var int statWinLong  = 0
var int statLosLong  = 0
var int statTimLong  = 0
var int statWinShort = 0
var int statLosShort = 0
var int statTimShort = 0

float statAtr = ta.atr(statAtrLenInput)
bool  statLive = statOnInput and barstate.isconfirmed

if statLive and array.size(statEntry) > 0
    for tradeIndex = array.size(statEntry) - 1 to 0
        int   tradeDir = array.get(statDir, tradeIndex)
        float tradeTarget = array.get(statTarget, tradeIndex)
        float tradeStop = array.get(statStop, tradeIndex)
        bool  stopHit = tradeDir > 0 ? low <= tradeStop : high >= tradeStop
        bool  targetHit = tradeDir > 0 ? high >= tradeTarget : low <= tradeTarget
        bool  expired = bar_index - array.get(statOpened, tradeIndex) >= statHorizonInput
        bool  resolved = stopHit or targetHit or expired
        if stopHit
            if tradeDir > 0
                statLosLong += 1
            else
                statLosShort += 1
        else if targetHit
            if tradeDir > 0
                statWinLong += 1
            else
                statWinShort += 1
        else if expired
            if tradeDir > 0
                statTimLong += 1
            else
                statTimShort += 1
        if resolved
            array.remove(statEntry, tradeIndex)
            array.remove(statStop, tradeIndex)
            array.remove(statTarget, tradeIndex)
            array.remove(statDir, tradeIndex)
            array.remove(statOpened, tradeIndex)

float statStopDistance = na(statAtr) ? na : statStopAtrInput * statAtr
bool  statCanOpen = statLive and not na(statStopDistance) and statStopDistance > 0
if statCanOpen and ictBull and (not statOneAtATimeInput or array.size(statEntry) == 0)
    array.push(statEntry, close)
    array.push(statStop, close - statStopDistance)
    array.push(statTarget, close + statTargetRInput * statStopDistance)
    array.push(statDir, 1)
    array.push(statOpened, bar_index)
    statSigLong += 1
if statCanOpen and ictBear and (not statOneAtATimeInput or array.size(statEntry) == 0)
    array.push(statEntry, close)
    array.push(statStop, close + statStopDistance)
    array.push(statTarget, close - statTargetRInput * statStopDistance)
    array.push(statDir, -1)
    array.push(statOpened, bar_index)
    statSigShort += 1

int   statNLong  = statWinLong + statLosLong
int   statNShort = statWinShort + statLosShort
float statPLong  = statNLong > 0 ? statWinLong / float(statNLong) : na
float statPShort = statNShort > 0 ? statWinShort / float(statNShort) : na
bool  statBothSides = not na(statPLong) and not na(statPShort)
float statDriftFree = statBothSides ? (statPLong + statPShort) / 2 * 100 : na
float statDrift     = statBothSides ? (statPLong - statPShort) / 2 * 100 : na
float statVLong     = statNLong  > 0 ? (statWinLong  + 0.5) / (statNLong  + 1) : na
float statVShort    = statNShort > 0 ? (statWinShort + 0.5) / (statNShort + 1) : na
float statSe        = statBothSides ? math.sqrt(statVLong * (1 - statVLong) / statNLong + statVShort * (1 - statVShort) / statNShort) / 2 * 100 : na
float statNull      = 100.0 / (1.0 + statTargetRInput)
float statEdge      = na(statDriftFree) ? na : statDriftFree - statNull
float statMdl       = na(statSe) or statSe <= 0 ? na : 2.8 * statSe
float statExpR      = na(statDriftFree) ? na : statDriftFree / 100 * statTargetRInput - (1 - statDriftFree / 100) - statCostRInput
float statNeeded    = (1.0 + statCostRInput) / (1.0 + statTargetRInput) * 100

string statVerdict = "NEED MORE DATA"
color  statVerdictColor = color.gray
if statBothSides and statNLong >= statMinNInput and statNShort >= statMinNInput
    if na(statMdl) or math.abs(statEdge) < statMdl
        statVerdict := "NO EDGE DETECTABLE"
        statVerdictColor := color.gray
    else if statEdge < 0
        statVerdict := "NEGATIVE"
        statVerdictColor := color.red
    else if statExpR > 0
        statVerdict := "EDGE, net " + str.tostring(statExpR, "#.##") + "R"
        statVerdictColor := color.green
    else
        statVerdict := "EDGE BELOW COST"
        statVerdictColor := color.orange

var table statTable = table.new(f_statPos(statPosInput), 2, 13, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

f_statRow(int rowIndex, string label, string value, color valueColor) =>
    table.cell(statTable, 0, rowIndex, label, text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(statTable, 1, rowIndex, value, text_color = valueColor, text_size = size.small, text_halign = text.align_right)
    rowIndex

if statOnInput and barstate.islast
    table.cell(statTable, 0, 0, "DIVERGENCE MEASUREMENT", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(statTable, 1, 0, "m2  " + str.tostring(statTargetRInput, "#.#") + "R / " + str.tostring(statHorizonInput) + "b", text_color = color.new(color.white, 45), text_size = size.small, text_halign = text.align_right)
    f_statRow(1,  "Signals  bull / bear",  str.tostring(statSigLong) + " / " + str.tostring(statSigShort), color.new(color.white, 10))
    f_statRow(2,  "Resolved  bull / bear", str.tostring(statNLong) + " / " + str.tostring(statNShort), color.new(color.white, 10))
    f_statRow(3,  "Timed out  bull / bear", str.tostring(statTimLong) + " / " + str.tostring(statTimShort), color.new(color.white, 45))
    f_statRow(4,  "Still open", str.tostring(array.size(statEntry)), color.new(color.white, 45))
    f_statRow(5,  "Hit rate  bullish", f_statPct(statPLong * 100), color.new(color.white, 10))
    f_statRow(6,  "Hit rate  bearish", f_statPct(statPShort * 100), color.new(color.white, 10))
    f_statRow(7,  "Drift-free hit rate", f_statPct(statDriftFree), color.new(color.white, 0))
    f_statRow(8,  "Drift removed", f_statPp(statDrift), color.new(color.white, 45))
    f_statRow(9,  "Chance baseline  1/(1+R)", f_statPct(statNull) + "  (need " + str.tostring(statNeeded, "#.#") + "% after cost)", color.new(color.white, 45))
    f_statRow(10, "Edge vs chance", f_statPp(statEdge), na(statEdge) ? color.gray : statEdge > 0 ? color.green : color.red)
    f_statRow(11, "Detection floor  MDL", na(statMdl) ? "—" : "±" + str.tostring(statMdl, "#.#") + "pp", color.new(color.white, 45))
    f_statRow(12, "VERDICT", statVerdict, statVerdictColor)
