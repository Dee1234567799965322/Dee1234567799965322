//@version=6
// Auction Runner — MEASURED IN DOLLARS (small loss, let winners run)
// ───────────────────────────────────────────────────────────────────────────
// THE PIVOT: a fixed small win + a fixed small loss is SYMMETRIC, and symmetric
// against a coin-flip entry just pays the fees (proved both ways: wide stop =
// lucky coin flip, tight cap = unanimous bleed). The only escape is ASYMMETRY:
//   - keep the loss SMALL and capped (your insight — it was right)
//   - but let the WINNER RUN behind a trailing stop instead of grabbing $150
// Small loss + rare big win + ~50% direction = positive, with NO entry edge.
// That is trend participation: the payoff does the work, not the prediction.
//
// Same engine as before: Auction Cipher's real volume-profile value area, a
// WaveTrend turn at the edge, and a liquidity-sweep / SFP gate. Only the EXIT
// changed — from a fixed target to a runner. Read the PAYOFF row: avg win must
// beat avg loss by enough that a ~35-45% win rate still nets green.
indicator("Auction Runner — MEASURED", "AUC-RUN", overlay = true, max_labels_count = 500)

// ── Your trade (dollars) ───────────────────────────────────────────────────────
gT = "Your trade (dollars)"
float targetUsd = input.float(0, "Profit target ($, 0 = let winners run)", step = 10, group = gT, tooltip = "0 = pure runner (trail only). Set a value to also cap the win there — but capping the win is what made it a coin flip, so 0 is the point of this version.")
float qty       = input.float(1.0, "Lots (BTC per trade)", step = 0.1, group = gT, tooltip = "1 BTC: a $1 price move = $1.")
float feeUsd    = input.float(8.0, "Round-trip fee ($ per trade)", step = 1.0, group = gT)
float acct      = input.float(10000, "Account size ($)", step = 1000, group = gT)
int   maxBars   = input.int(300, "Give up after N bars (time exit)", minval = 10, group = gT)

// ── Initial stop — 'the right place' ───────────────────────────────────────────
gS = "Initial stop"
string stopMode = input.string("Structural (VA edge)", "Stop mode", options = ["Structural (VA edge)", "Fixed $"], group = gS, tooltip = "Where the FIRST stop sits before the trailing stop takes over.")
float bufferAtr = input.float(0.5, "Buffer beyond edge (ATR)", step = 0.1, group = gS)
float stopUsd   = input.float(400, "Fixed stop ($, if Fixed mode)", step = 25, group = gS)

// ── Loss management — keep the loss small (your edge) ──────────────────────────
gLM = "Loss management"
float maxLossUsd = input.float(100, "Hard max loss per trade ($)", step = 10, group = gLM, tooltip = "Clamp the initial stop so no loss exceeds this. This is the SMALL half of the asymmetry.")
bool  cutOnBreak = input.bool(true, "Cut early if value re-breaks (close beyond edge)", group = gLM, tooltip = "If the fade fails fast (long closes back below VAL / short above VAH), take the small loss now.")

// ── Trailing runner — let the winner run (the other half) ──────────────────────
gTR = "Trailing runner (let it run)"
float trailAtr   = input.float(2.5, "Trail distance (ATR)", step = 0.1, group = gTR, tooltip = "How far the trailing stop sits behind the extreme. Wider = gives the runner more room and bigger winners; tighter = locks sooner.")
float trailStart = input.float(75, "Start trailing after +$", step = 5, group = gTR, tooltip = "Give the trade room first: the capped stop protects it until it is this far in profit, then the trail takes over and rides the move.")

// ── Auction value — REAL volume profile (Auction Cipher's engine) ──────────────
gA = "Auction value (Auction Cipher engine)"
int   profLook = input.int(200, "Profile lookback (bars)", minval = 30, maxval = 480, group = gA, tooltip = "Rolling window the volume profile is built from. Lower it if the study is slow.")
int   profRows = input.int(50, "Profile rows (bins)", minval = 10, maxval = 150, group = gA)
float vaPctIn  = input.float(70.0, "Value area %", minval = 50, maxval = 95, group = gA) / 100.0
bool  requireWT= input.bool(true, "Require WaveTrend turn at edge", group = gA)
bool  useLong  = input.bool(true, "Longs (fade VAL)", group = gA)
bool  useShort = input.bool(true, "Shorts (fade VAH)", group = gA)
bool  mShow    = input.bool(true, "Show dollar panel", group = gA)

// ── Extra rule: liquidity sweep / Swing Failure Pattern ────────────────────────
gL = "Liquidity sweep / SFP filter"
bool  useSweep    = input.bool(true, "Require sweep / SFP to enter", group = gL)
int   sweepLen    = input.int(5, "Swing strength (pivot bars)", minval = 1, group = gL)
int   sweepWindow = input.int(3, "Sweep stays valid for N bars", minval = 0, group = gL)

// ── Trend filter — only trade WITH the trend (kills chop-bleed) ────────────────
gTF = "Trend filter (stop chop-bleed)"
bool  useTrend = input.bool(true, "Only trade with the trend", group = gTF, tooltip = "Longs only when price is above the trend EMA, shorts only when below. A runner bleeds in chop; this stops it firing when there is no trend to ride, so it only takes 'buy the dip in an uptrend / sell the rip in a downtrend' setups.")
int   trendLen = input.int(200, "Trend EMA length", minval = 20, group = gTF)

// ── Real volume profile — POC + 70% value area (ported from Auction Cipher) ────
float atr = ta.atr(14)

f_profile(array<float> hs, array<float> ls, array<float> vs, int rows, float pct) =>
    float poc = na
    float vah = na
    float val = na
    bool  ok  = false
    array<float> bins = array.new<float>(rows, 0.0)
    int n = hs.size()
    if n > 0
        float hi = hs.max()
        float lo = ls.min()
        float rng = hi - lo
        if rng > 0
            float step = rng / rows
            for i = 0 to n - 1
                float bv = vs.get(i)
                if bv > 0
                    int lvlLo = math.max(0, math.min(rows - 1, int((ls.get(i) - lo) / step)))
                    int lvlHi = math.max(0, math.min(rows - 1, int((hs.get(i) - lo) / step)))
                    float slice = bv / (lvlHi - lvlLo + 1)
                    for lvl = lvlLo to lvlHi
                        bins.set(lvl, bins.get(lvl) + slice)
            float total = bins.sum()
            if total > 0
                int pocIdx = bins.indexof(bins.max())
                if pocIdx < 0
                    pocIdx := int(rows / 2)
                float target = total * pct
                float acc = bins.get(pocIdx)
                int up = pocIdx + 1
                int dn = pocIdx - 1
                while acc < target and (up <= rows - 1 or dn >= 0)
                    float vUp = up <= rows - 1 ? bins.get(up) : -1.0
                    float vDn = dn >= 0 ? bins.get(dn) : -1.0
                    if vUp < 0 and vDn < 0
                        break
                    if vUp >= vDn
                        acc += vUp
                        up += 1
                    else
                        acc += vDn
                        dn -= 1
                poc := lo + (pocIdx + 0.5) * step
                vah := lo + math.min(rows, up) * step
                val := lo + math.max(0, dn + 1) * step
                ok := true
    [poc, vah, val, ok]

var array<float> winH = array.new<float>(0)
var array<float> winL = array.new<float>(0)
var array<float> winV = array.new<float>(0)
if barstate.isconfirmed
    winH.push(high)
    winL.push(low)
    winV.push(volume)
    if winH.size() > profLook
        winH.shift()
        winL.shift()
        winV.shift()
[POC, VAH, VAL, vaOk] = f_profile(winH, winL, winV, profRows, vaPctIn)

// ── WaveTrend (Auction Cipher's momentum, standard 9/12/3) ─────────────────────
float esa = ta.ema(hlc3, 9)
float dev = ta.ema(math.abs(hlc3 - esa), 9)
float ci  = dev != 0 ? (hlc3 - esa) / (0.015 * dev) : 0.0
float wt1 = ta.ema(ci, 12)
float wt2 = ta.sma(wt1, 3)
bool  wtUp = wt1 >= wt2
bool  wtDn = wt1 <= wt2

// ── Trend filter ───────────────────────────────────────────────────────────────
float trendEma = ta.ema(close, trendLen)
bool  trendUp  = close > trendEma
bool  trendDn  = close < trendEma

// ── Liquidity sweep / SFP confluence ───────────────────────────────────────────
float phS = ta.pivothigh(sweepLen, 1)
float plS = ta.pivotlow(sweepLen, 1)
var float swHi = na
var float swLo = na
if not na(phS)
    swHi := phS
if not na(plS)
    swLo := plS
bool bullSweep = not na(swLo) and low  < swLo and close > swLo
bool bearSweep = not na(swHi) and high > swHi and close < swHi
var int agoBull = 1000000
var int agoBear = 1000000
agoBull := bullSweep ? 0 : agoBull + 1
agoBear := bearSweep ? 0 : agoBear + 1
bool bullSweepOk = not useSweep or agoBull <= sweepWindow
bool bearSweepOk = not useSweep or agoBear <= sweepWindow

// ── Entry: value-area-edge rejection + (optional) sweep/SFP ────────────────────
bool longRaw  = not na(VAL) and low  < VAL and close > VAL
bool shortRaw = not na(VAH) and high > VAH and close < VAH
bool longSig  = useLong  and vaOk and longRaw  and (not requireWT or wtUp) and bullSweepOk and (not useTrend or trendUp)
bool shortSig = useShort and vaOk and shortRaw and (not requireWT or wtDn) and bearSweepOk and (not useTrend or trendDn) and not longSig

// ── One position at a time ─────────────────────────────────────────────────────
var int   pos      = 0
var float entryPx  = na
var float tgtPx    = na
var float stopPx   = na
var int   entryBar = na
var float mae      = 0.0
var float maxFav   = na
var bool  trailOn  = false

// ── Dollar ledger ──────────────────────────────────────────────────────────────
var int   nTot_ = 0
var int   nWinNet = 0
var float grossWin = 0.0
var float grossLoss = 0.0
var float netCum = 0.0
var float bestTrade = 0.0
var float worstTrade = 0.0
var float worstMAE = 0.0
var float feesPaid = 0.0
var float peakEq = 0.0
var float maxDD = 0.0

bool openedLong  = false
bool openedShort = false

if barstate.isconfirmed
    // manage open trade
    if pos != 0 and not na(entryPx)
        float adv = pos == 1 ? entryPx - low : high - entryPx
        if adv > mae
            mae := adv
        // trailing runner: give room, then ride
        float ext = pos == 1 ? high : low
        maxFav := na(maxFav) ? ext : (pos == 1 ? math.max(maxFav, ext) : math.min(maxFav, ext))
        float favUsd = (pos == 1 ? maxFav - entryPx : entryPx - maxFav) * qty
        if not trailOn and favUsd >= trailStart
            trailOn := true
        if trailOn and not na(atr)
            float ts = pos == 1 ? maxFav - trailAtr * atr : maxFav + trailAtr * atr
            stopPx := pos == 1 ? math.max(stopPx, ts) : math.min(stopPx, ts)
        bool  done = false
        float exitPx = na
        if pos == 1
            if low <= stopPx
                exitPx := stopPx
                done := true
            else if not na(tgtPx) and high >= tgtPx
                exitPx := tgtPx
                done := true
        else
            if high >= stopPx
                exitPx := stopPx
                done := true
            else if not na(tgtPx) and low <= tgtPx
                exitPx := tgtPx
                done := true
        if not done and cutOnBreak and ((pos == 1 and close < VAL) or (pos == -1 and close > VAH))
            exitPx := close
            done := true
        if not done and (bar_index - entryBar) >= maxBars
            exitPx := close
            done := true
        if done
            float pnl = (exitPx - entryPx) * (pos == 1 ? 1.0 : -1.0) * qty
            float net = pnl - feeUsd
            feesPaid += feeUsd
            netCum += net
            nTot_ += 1
            if net >= 0
                nWinNet += 1
                grossWin += net
            else
                grossLoss += -net
            if net > bestTrade
                bestTrade := net
            if net < worstTrade
                worstTrade := net
            if mae * qty > worstMAE
                worstMAE := mae * qty
            if netCum > peakEq
                peakEq := netCum
            float dd = peakEq - netCum
            if dd > maxDD
                maxDD := dd
            pos := 0
    // open a new trade when flat
    if pos == 0 and not na(atr) and atr > 0 and qty > 0
        if longSig
            pos := 1
            openedLong := true
            entryPx := close
            entryBar := bar_index
            mae := 0.0
            maxFav := close
            trailOn := false
            float sp = stopMode == "Structural (VA edge)" ? VAL - bufferAtr * atr : close - stopUsd / qty
            if maxLossUsd > 0
                sp := math.max(sp, close - maxLossUsd / qty)
            stopPx := sp
            tgtPx := targetUsd > 0 ? close + targetUsd / qty : na
        else if shortSig
            pos := -1
            openedShort := true
            entryPx := close
            entryBar := bar_index
            mae := 0.0
            maxFav := close
            trailOn := false
            float sp = stopMode == "Structural (VA edge)" ? VAH + bufferAtr * atr : close + stopUsd / qty
            if maxLossUsd > 0
                sp := math.min(sp, close + maxLossUsd / qty)
            stopPx := sp
            tgtPx := targetUsd > 0 ? close - targetUsd / qty : na

plotshape(openedLong,  "BUY",  shape.labelup,   location.belowbar, #089981, text = "BUY",  textcolor = color.white, size = size.small)
plotshape(openedShort, "SELL", shape.labeldown, location.abovebar, #f23645, text = "SELL", textcolor = color.white, size = size.small)
plotshape(useSweep and bullSweep and not openedLong,  "sweep lo", shape.xcross, location.belowbar, color.new(#089981, 55), size = size.tiny)
plotshape(useSweep and bearSweep and not openedShort, "sweep hi", shape.xcross, location.abovebar, color.new(#f23645, 55), size = size.tiny)
plot(mShow ? VAH : na, "VAH", color = color.new(#26c6da, 40))
plot(mShow ? VAL : na, "VAL", color = color.new(#26c6da, 40))
plot(mShow ? POC : na, "POC", color = color.new(#ffb300, 50))
plot(mShow and useTrend ? trendEma : na, "Trend EMA", color = color.new(color.gray, 40))

// ── Totals ─────────────────────────────────────────────────────────────────────
int   nTot    = nTot_
int   nLossNet= nTot - nWinNet
float winRate = nTot > 0 ? nWinNet / float(nTot) * 100.0 : na
float avgWin  = nWinNet > 0 ? grossWin / nWinNet : na
float avgLoss = nLossNet > 0 ? grossLoss / nLossNet : na
float payoff  = not na(avgWin) and not na(avgLoss) and avgLoss > 0 ? avgWin / avgLoss : na
float expTr   = nTot > 0 ? netCum / nTot : na
float retPct  = acct > 0 ? netCum / acct * 100.0 : na
bool  wiped   = maxDD >= acct and nTot > 0

string ver = "NEED TRADES"
color  vc  = color.gray
if nTot >= 20
    if wiped
        ver := "ACCOUNT WIPED"
        vc  := color.new(color.red, 0)
    else if netCum > 0
        ver := "NET +$" + str.tostring(netCum, format.volume)
        vc  := color.green
    else
        ver := "NET -$" + str.tostring(-netCum, format.volume)
        vc  := color.new(color.red, 10)

// ── Panel (all dollars) ────────────────────────────────────────────────────────
f_usd(float v) => (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), format.volume)

var table t = table.new(position.bottom_right, 2, 12, bgcolor = color.new(color.black, 10), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(color.white, 20), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
    r

if mShow and barstate.islast
    table.cell(t, 0, 0, "AUCTION RUNNER", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, "trail " + str.tostring(trailAtr, "#.#") + "x" + (useSweep ? " SFP" : ""), text_color = color.new(color.white, 45), text_size = size.small, text_halign = text.align_right)
    row(1, "Trades", str.tostring(nTot), color.new(color.white, 10))
    row(2, "Win rate (net+)", na(winRate) ? "—" : str.tostring(winRate, "#.#") + "%", color.new(color.white, 10))
    row(3, "Avg win / Avg loss", (na(avgWin) ? "—" : f_usd(avgWin)) + " / " + (na(avgLoss) ? "—" : f_usd(-avgLoss)), color.new(color.white, 10))
    row(4, "Payoff (win:loss)", na(payoff) ? "—" : str.tostring(payoff, "#.##") + "x", na(payoff) ? color.gray : payoff >= 2 ? color.green : payoff >= 1 ? color.new(color.white, 0) : color.red)
    row(5, "NET P&L", nTot > 0 ? f_usd(netCum) : "—", netCum >= 0 ? color.green : color.red)
    row(6, "Expectancy / trade", na(expTr) ? "—" : f_usd(expTr), na(expTr) ? color.gray : expTr > 0 ? color.green : color.red)
    row(7, "Best trade (runner)", nTot > 0 ? f_usd(bestTrade) : "—", color.new(#26c6da, 0))
    row(8, "Worst single trade", nTot > 0 ? f_usd(worstTrade) : "—", worstTrade < 0 ? color.red : color.new(color.white, 10))
    row(9, "Max drawdown", nTot > 0 ? "-$" + str.tostring(maxDD, format.volume) : "—", maxDD > acct * 0.5 ? color.red : color.new(color.white, 10))
    row(10, "Return on account", na(retPct) ? "—" : (retPct >= 0 ? "+" : "") + str.tostring(retPct, "#.#") + "%", na(retPct) ? color.gray : retPct >= 0 ? color.green : color.red)
    row(11, "VERDICT", ver, vc)
