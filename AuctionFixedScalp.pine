//@version=6
// Auction Fixed-$ Scalp — MEASURED IN DOLLARS
// ───────────────────────────────────────────────────────────────────────────
// Your style, Auction Cipher's engine, judged in your currency.
//
// THE IDEA (straight from Auction Cipher's own thesis):
//   The quality trade is a WaveTrend turn AT a value-area edge — price pokes
//   past VAH/VAL, gets rejected, and snaps back toward value. The stop goes
//   JUST BEYOND that edge ("the right place"): if price leaves value and stays
//   out, the idea is broken and you are out for a small, defined loss. Otherwise
//   you ride the snap-back for a fixed $100-200.
//
// WHY A STRUCTURAL STOP ANSWERS YOUR COMPLAINT:
//   Ordinary tight stops sit inside the noise, so you get wicked out and THEN
//   price runs to target. Placing the stop beyond the value edge keeps it out of
//   the noise — you only lose if value genuinely breaks.
//
// THE HONEST TEST (what RR hid): even cheap fees and a smart stop can't create
// edge from nothing. A wide stop means each stop-out erases several small wins,
// so the whole thing lives or dies on ONE thing: does the value edge actually
// hold more often than chance? The dollar panel answers it — NET P&L over
// hundreds of trades, with the worst trade and the drawdown in plain dollars.
//
// The value area here is the REAL volume profile — the same POC / 70%-value
// computation Auction Cipher uses, ported from its code — built in, so there is
// nothing to connect. The VAH/VAL/POC match what Auction Cipher draws.
indicator("Auction Fixed-$ Scalp — MEASURED", "AUC-FIX$", overlay = true, max_labels_count = 500)

// ── Your trade (dollars, not RR) ───────────────────────────────────────────────
gT = "Your trade (dollars)"
float targetUsd = input.float(150, "Profit target per trade ($)", step = 10, group = gT)
float qty       = input.float(1.0, "Lots (BTC per trade)", step = 0.1, group = gT, tooltip = "1 BTC: a $1 price move = $1. 0.5 BTC: a $1 move = $0.50.")
float feeUsd    = input.float(8.0, "Round-trip fee ($ per trade)", step = 1.0, group = gT, tooltip = "Your real cost: ~$8 at 1 BTC, ~$4 at 0.5 BTC.")
float acct      = input.float(10000, "Account size ($)", step = 1000, group = gT)
int   maxBars   = input.int(200, "Give up after N bars (time exit)", minval = 10, group = gT)

// ── The stop — 'the right place' ───────────────────────────────────────────────
gS = "Stop placement"
string stopMode = input.string("Structural (VA edge)", "Stop mode", options = ["Structural (VA edge)", "Fixed $"], group = gS, tooltip = "Structural: just beyond the value-area edge, out of the noise. Fixed $: a flat dollar stop.")
float bufferAtr = input.float(0.5, "Buffer beyond edge (ATR)", step = 0.1, group = gS, tooltip = "How far past VAH/VAL the stop sits, so a normal wick does not trip it.")
float stopUsd   = input.float(400, "Fixed stop ($, if Fixed mode)", step = 25, group = gS)

// ── Loss management — THE EDGE IS HERE (make the loss small & slow) ─────────────
// The month proved the entry is a coin flip, so profit cannot come from winning
// more often. It can only come from LOSING SMALL. These three levers cap and cut
// the loss so the average loss stays BELOW the +$ target. Watch the "Avg win /
// Avg loss" row — the strategy is green only when avg loss < avg win.
gLM = "Loss management (the edge)"
float maxLossUsd = input.float(100, "Hard max loss per trade ($)", step = 10, group = gLM, tooltip = "Clamp every stop so no single loss exceeds this. Keep it BELOW your target — that is the whole point. 0 = no cap (dangerous).")
bool  cutOnBreak = input.bool(true, "Cut early if value re-breaks (close beyond edge)", group = gLM, tooltip = "If a long closes back BELOW VAL (or a short back above VAH), the fade has failed — exit now for a small loss instead of waiting for the full stop. This is how the loss stays small.")
float beAfterUsd = input.float(75, "Move stop to breakeven after +$", step = 5, group = gLM, tooltip = "Once the trade is this far in profit, move the stop to entry so a winner cannot turn into a loser. 0 = off.")

// ── Auction value — REAL volume profile (Auction Cipher's engine) ──────────────
gA = "Auction value (Auction Cipher engine)"
int   profLook = input.int(200, "Profile lookback (bars)", minval = 30, maxval = 480, group = gA, tooltip = "Rolling window the volume profile is built from, exactly like Auction Cipher's rolling mode. Lower it if TradingView says the study takes too long.")
int   profRows = input.int(50, "Profile rows (bins)", minval = 10, maxval = 150, group = gA, tooltip = "Resolution of the profile. Auction Cipher's default is 250; 50 gives the same levels far faster.")
float vaPctIn  = input.float(70.0, "Value area %", minval = 50, maxval = 95, group = gA, tooltip = "The % of volume inside the value area. 70% is the standard (and Auction Cipher's default).") / 100.0
bool  requireWT= input.bool(true, "Require WaveTrend turn at edge", group = gA, tooltip = "Auction Cipher's quality filter: momentum turning back toward value as price is rejected at the edge.")
bool  useLong  = input.bool(true, "Longs (fade VAL)", group = gA)
bool  useShort = input.bool(true, "Shorts (fade VAH)", group = gA)
bool  mShow    = input.bool(true, "Show dollar panel", group = gA)

// ── Extra rule: liquidity sweep / Swing Failure Pattern ────────────────────────
gL = "Liquidity sweep / SFP filter"
bool  useSweep    = input.bool(true, "Require sweep / SFP to enter", group = gL, tooltip = "Only take the value-edge trade if price ALSO swept a swing low (longs) or swing high (shorts) and reclaimed it — a liquidity grab / Swing Failure Pattern.")
int   sweepLen    = input.int(5, "Swing strength (pivot bars)", minval = 1, group = gL, tooltip = "Bigger = only major swing lows/highs count as the liquidity pool that must be swept.")
int   sweepWindow = input.int(3, "Sweep stays valid for N bars", minval = 0, group = gL, tooltip = "The sweep can land on the entry bar (0) or up to N bars before the value-edge reclaim.")

// ── Real volume profile — POC + 70% value area (ported from Auction Cipher) ────
float atr = ta.atr(14)

// Bins volume by price across the lookback, finds the POC (busiest price), then
// grows out from it to the larger adjacent bin until 70% of volume is enclosed.
// Returns [poc, value-area-high, value-area-low, ok]. This is Auction Cipher's
// own f_profile, trimmed to the level math (no buy/sell split needed here).
f_profile(array<float> hs, array<float> ls, array<float> vs, int rows, float pct) =>
    float poc = na
    float vah = na
    float val = na
    bool  ok  = false
    array<float> bins = array.new<float>(rows, 0.0)
    int n = hs.size()
    if n > 0
        float hi = hs.max()
        float lo = ls.min()
        float rng = hi - lo
        if rng > 0
            float step = rng / rows
            for i = 0 to n - 1
                float bv = vs.get(i)
                if bv > 0
                    int lvlLo = math.max(0, math.min(rows - 1, int((ls.get(i) - lo) / step)))
                    int lvlHi = math.max(0, math.min(rows - 1, int((hs.get(i) - lo) / step)))
                    float slice = bv / (lvlHi - lvlLo + 1)
                    for lvl = lvlLo to lvlHi
                        bins.set(lvl, bins.get(lvl) + slice)
            float total = bins.sum()
            if total > 0
                int pocIdx = bins.indexof(bins.max())
                if pocIdx < 0
                    pocIdx := int(rows / 2)
                float target = total * pct
                float acc = bins.get(pocIdx)
                int up = pocIdx + 1
                int dn = pocIdx - 1
                while acc < target and (up <= rows - 1 or dn >= 0)
                    float vUp = up <= rows - 1 ? bins.get(up) : -1.0
                    float vDn = dn >= 0 ? bins.get(dn) : -1.0
                    if vUp < 0 and vDn < 0
                        break
                    if vUp >= vDn
                        acc += vUp
                        up += 1
                    else
                        acc += vDn
                        dn -= 1
                poc := lo + (pocIdx + 0.5) * step
                vah := lo + math.min(rows, up) * step
                val := lo + math.max(0, dn + 1) * step
                ok := true
    [poc, vah, val, ok]

// Rolling window of the last profLook confirmed bars feeds the profile.
var array<float> winH = array.new<float>(0)
var array<float> winL = array.new<float>(0)
var array<float> winV = array.new<float>(0)
if barstate.isconfirmed
    winH.push(high)
    winL.push(low)
    winV.push(volume)
    if winH.size() > profLook
        winH.shift()
        winL.shift()
        winV.shift()
[POC, VAH, VAL, vaOk] = f_profile(winH, winL, winV, profRows, vaPctIn)

// ── WaveTrend (Auction Cipher's momentum, standard 9/12/3) ─────────────────────
float esa = ta.ema(hlc3, 9)
float dev = ta.ema(math.abs(hlc3 - esa), 9)
float ci  = dev != 0 ? (hlc3 - esa) / (0.015 * dev) : 0.0
float wt1 = ta.ema(ci, 12)
float wt2 = ta.sma(wt1, 3)
bool  wtUp = wt1 >= wt2
bool  wtDn = wt1 <= wt2

// ── Liquidity sweep / SFP confluence ───────────────────────────────────────────
// A bullish sweep = price takes out a swing LOW then closes back above it (a
// liquidity grab / Swing Failure Pattern). Mirror for bearish. Longs need a
// recent bullish sweep, shorts a bearish one.
float phS = ta.pivothigh(sweepLen, 1)
float plS = ta.pivotlow(sweepLen, 1)
var float swHi = na
var float swLo = na
if not na(phS)
    swHi := phS
if not na(plS)
    swLo := plS
bool bullSweep = not na(swLo) and low  < swLo and close > swLo
bool bearSweep = not na(swHi) and high > swHi and close < swHi
var int agoBull = 1000000
var int agoBear = 1000000
agoBull := bullSweep ? 0 : agoBull + 1
agoBear := bearSweep ? 0 : agoBear + 1
bool bullSweepOk = not useSweep or agoBull <= sweepWindow
bool bearSweepOk = not useSweep or agoBear <= sweepWindow

// ── Entry: value-area-edge rejection + (optional) sweep/SFP ────────────────────
bool longRaw  = not na(VAL) and low  < VAL and close > VAL
bool shortRaw = not na(VAH) and high > VAH and close < VAH
bool longSig  = useLong  and vaOk and longRaw  and (not requireWT or wtUp) and bullSweepOk
bool shortSig = useShort and vaOk and shortRaw and (not requireWT or wtDn) and bearSweepOk and not longSig

// ── One position at a time ─────────────────────────────────────────────────────
var int   pos      = 0
var float entryPx  = na
var float tgtPx    = na
var float stopPx   = na
var int   entryBar = na
var float mae      = 0.0
var bool  beLocked = false

// ── Dollar ledger ──────────────────────────────────────────────────────────────
var int   nTP = 0
var int   nStop = 0
var int   nCut = 0
var int   nTime = 0
var int   nWinNet = 0
var float grossWin = 0.0
var float grossLoss = 0.0
var float netCum = 0.0
var float worstTrade = 0.0
var float worstMAE = 0.0
var float feesPaid = 0.0
var float peakEq = 0.0
var float maxDD = 0.0

bool openedLong  = false
bool openedShort = false

if barstate.isconfirmed
    // manage open trade
    if pos != 0 and not na(entryPx)
        float adv = pos == 1 ? entryPx - low : high - entryPx
        if adv > mae
            mae := adv
        // breakeven lock: once far enough in profit, a winner can't become a loser
        float fav = pos == 1 ? high - entryPx : entryPx - low
        if beAfterUsd > 0 and not beLocked and fav * qty >= beAfterUsd
            beLocked := true
            stopPx := pos == 1 ? math.max(stopPx, entryPx) : math.min(stopPx, entryPx)
        bool  done = false
        bool  isTP = false
        bool  isStop = false
        bool  isCut = false
        float exitPx = na
        if pos == 1
            if low <= stopPx
                exitPx := stopPx
                isStop := true
                done := true
            else if high >= tgtPx
                exitPx := tgtPx
                isTP := true
                done := true
        else
            if high >= stopPx
                exitPx := stopPx
                isStop := true
                done := true
            else if low <= tgtPx
                exitPx := tgtPx
                isTP := true
                done := true
        // early cut: value re-broke, the fade failed — take the small loss now
        if not done and cutOnBreak and ((pos == 1 and close < VAL) or (pos == -1 and close > VAH))
            exitPx := close
            isCut := true
            done := true
        if not done and (bar_index - entryBar) >= maxBars
            exitPx := close
            done := true
        if done
            float pnl = (exitPx - entryPx) * (pos == 1 ? 1.0 : -1.0) * qty
            float net = pnl - feeUsd
            feesPaid += feeUsd
            netCum += net
            if isTP
                nTP += 1
            else if isCut
                nCut += 1
            else if isStop
                nStop += 1
            else
                nTime += 1
            if net >= 0
                nWinNet += 1
                grossWin += net
            else
                grossLoss += -net
            if net < worstTrade
                worstTrade := net
            if mae * qty > worstMAE
                worstMAE := mae * qty
            if netCum > peakEq
                peakEq := netCum
            float dd = peakEq - netCum
            if dd > maxDD
                maxDD := dd
            pos := 0
    // open a new trade when flat
    if pos == 0 and not na(atr) and atr > 0 and qty > 0
        if longSig
            pos := 1
            openedLong := true
            entryPx := close
            entryBar := bar_index
            mae := 0.0
            float sp = stopMode == "Structural (VA edge)" ? VAL - bufferAtr * atr : close - stopUsd / qty
            if maxLossUsd > 0
                sp := math.max(sp, close - maxLossUsd / qty)
            stopPx := sp
            tgtPx := close + targetUsd / qty
            beLocked := false
        else if shortSig
            pos := -1
            openedShort := true
            entryPx := close
            entryBar := bar_index
            mae := 0.0
            float sp = stopMode == "Structural (VA edge)" ? VAH + bufferAtr * atr : close + stopUsd / qty
            if maxLossUsd > 0
                sp := math.min(sp, close + maxLossUsd / qty)
            stopPx := sp
            tgtPx := close - targetUsd / qty
            beLocked := false

plotshape(openedLong,  "BUY",  shape.labelup,   location.belowbar, #089981, text = "BUY",  textcolor = color.white, size = size.small)
plotshape(openedShort, "SELL", shape.labeldown, location.abovebar, #f23645, text = "SELL", textcolor = color.white, size = size.small)
plotshape(useSweep and bullSweep and not openedLong,  "sweep lo", shape.xcross, location.belowbar, color.new(#089981, 55), size = size.tiny)
plotshape(useSweep and bearSweep and not openedShort, "sweep hi", shape.xcross, location.abovebar, color.new(#f23645, 55), size = size.tiny)
plot(mShow ? VAH : na, "VAH", color = color.new(#26c6da, 40))
plot(mShow ? VAL : na, "VAL", color = color.new(#26c6da, 40))
plot(mShow ? POC : na, "POC", color = color.new(#ffb300, 50))

// ── Totals ─────────────────────────────────────────────────────────────────────
int   nTot    = nTP + nStop + nCut + nTime
float tpRate  = nTot > 0 ? nTP / float(nTot) * 100.0 : na
float avgWin  = nWinNet > 0 ? grossWin / nWinNet : na
int   nLossNet= nTot - nWinNet
float avgLoss = nLossNet > 0 ? grossLoss / nLossNet : na
float expTr   = nTot > 0 ? netCum / nTot : na
float retPct  = acct > 0 ? netCum / acct * 100.0 : na
bool  wiped   = maxDD >= acct and nTot > 0

string ver = "NEED TRADES"
color  vc  = color.gray
if nTot >= 20
    if wiped
        ver := "ACCOUNT WIPED"
        vc  := color.new(color.red, 0)
    else if netCum > 0
        ver := "NET +$" + str.tostring(netCum, format.volume)
        vc  := color.green
    else
        ver := "NET -$" + str.tostring(-netCum, format.volume)
        vc  := color.new(color.red, 10)

// ── Panel (all dollars) ────────────────────────────────────────────────────────
f_usd(float v) => (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), format.volume)

var table t = table.new(position.bottom_right, 2, 12, bgcolor = color.new(color.black, 10), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(color.white, 20), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
    r

if mShow and barstate.islast
    table.cell(t, 0, 0, "AUCTION FIX-$ SCALP", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, "$" + str.tostring(targetUsd, "#") + "/" + (stopMode == "Fixed $" ? "fix" : "VA") + (useSweep ? "/SFP" : ""), text_color = color.new(color.white, 45), text_size = size.small, text_halign = text.align_right)
    row(1, "Trades (win/stop/cut)", str.tostring(nTP) + "/" + str.tostring(nStop) + "/" + str.tostring(nCut), color.new(color.white, 10))
    row(2, "Target-hit rate", na(tpRate) ? "—" : str.tostring(tpRate, "#.#") + "%", na(tpRate) ? color.gray : tpRate >= 70 ? color.green : color.new(color.white, 10))
    row(3, "Avg win / Avg loss", (na(avgWin) ? "—" : f_usd(avgWin)) + " / " + (na(avgLoss) ? "—" : f_usd(-avgLoss)), color.new(color.white, 10))
    row(4, "NET P&L", nTot > 0 ? f_usd(netCum) : "—", netCum >= 0 ? color.green : color.red)
    row(5, "Expectancy / trade", na(expTr) ? "—" : f_usd(expTr), na(expTr) ? color.gray : expTr > 0 ? color.green : color.red)
    row(6, "Worst single trade", nTot > 0 ? f_usd(worstTrade) : "—", worstTrade < 0 ? color.red : color.new(color.white, 10))
    row(7, "Deepest underwater", nTot > 0 ? "-$" + str.tostring(worstMAE, format.volume) : "—", color.new(color.orange, 0))
    row(8, "Max drawdown", nTot > 0 ? "-$" + str.tostring(maxDD, format.volume) : "—", maxDD > acct * 0.5 ? color.red : color.new(color.white, 10))
    row(9, "Fees paid", nTot > 0 ? "-$" + str.tostring(feesPaid, format.volume) : "—", color.new(color.white, 30))
    row(10, "Return on account", na(retPct) ? "—" : (retPct >= 0 ? "+" : "") + str.tostring(retPct, "#.#") + "%", na(retPct) ? color.gray : retPct >= 0 ? color.green : color.red)
    row(11, "VERDICT", ver, vc)
