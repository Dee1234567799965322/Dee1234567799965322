//@version=6
// ============================================================================
// REGIME TEST  v1.0
// ----------------------------------------------------------------------------
// THE HYPOTHESIS CAME FROM THE DATA, NOT FROM THE BOOK. SAY SO LOUDLY.
//
// Across four hypotheses and roughly 2,500 measured observations on this repo,
// exactly ONE result cleared two sigma:
//
//   POOR extremes are revisited LESS than EXCESS extremes.
//   63.5% vs 68.9%, -5.4pp, z -2.25, direction-matched, over 1,567 pairs.
//
// Auction theory predicts the opposite. An unfinished auction is supposed to
// be the one that gets revisited. It was dismissed as "backwards" and almost
// thrown away. This file takes it seriously instead, because a mechanism fits:
//
//   A POOR high means the period CLOSED near its high. Price was still going.
//   That is not unfinished business waiting to be revisited - it is a trend
//   still running, and the next period continues through it.
//
//   An EXCESS high means price spiked and was slammed back, closing well below.
//   That is exhaustion. The market then ranges, and ranging price eventually
//   wanders back to touch the spike.
//
// If that is right then extreme quality is not a SIGNAL, it is a REGIME
// CLASSIFIER - and it has been read upside down. It would also explain why
// Auction Cipher netted to zero: it faded value edges indiscriminately,
// mixing continuation setups and reversion setups into one bucket.
//
// THE HONEST HEALTH WARNING, WHICH BELONGS AT THE TOP AND NOT IN A FOOTNOTE.
//
// This hypothesis was GENERATED by looking at the data. Dozens of tests were
// run this session; a single -2.25 among dozens is roughly what chance
// produces. The measurement that suggested this idea therefore CANNOT also
// test it. That is the entire reason this is a separate file on fresh
// statistics rather than another column added to the magnet table.
//
// WHAT IS MEASURED.
//
// Both extremes of the finished period get classified. A call is made ONLY
// when they DISAGREE, so the two votes are unanimous:
//
//   poor high + excess low   -> both say UP     (trend up, downside exhausted)
//   poor low  + excess high  -> both say DOWN   (trend down, upside exhausted)
//   both poor, both excess, anything flat -> NO CALL
//
// Then a symmetric race from the registration price: does +k ATR arrive before
// -k ATR? Equal distance both ways, so the arithmetic null is 50% and no stop,
// target, cost or R-multiple assumption enters the measurement at all.
//
// THE BASELINE IS NOT 50%, AND THIS IS THE LESSON FROM THE LAST FILE.
//
// The magnet test was confounded by trend: in a falling sample every level
// below price beat every level above it, whatever its structure meant. A
// symmetric race has exactly the same weakness - in a trending market one side
// simply wins more often.
//
// So the race is run on EVERY period, including the ones with no call, and
// that unconditional up-win rate is the DRIFT baseline. An UP call has to beat
// the drift; a DOWN call has to beat one minus the drift. The panel prints the
// raw accuracy and the drift-adjusted edge side by side, and only the second
// one means anything.
// ============================================================================
indicator("Regime Test", shorttitle="REGIME", overlay=true,
     max_boxes_count=50, max_lines_count=100, max_labels_count=200, max_bars_back=500)

// ============================================================================
// 1. INPUTS
// ============================================================================
string G_P = "1 - PERIOD & CLASSIFIER"
string perMode = input.string("Daily", "Auction Period", options=["Daily", "Weekly"], group=G_P)
int   rows    = input.int(24, "Profile Rows", minval=8, maxval=60, group=G_P)
int   excTouch  = input.int(1, "Excess: bars at the extreme <=", minval=1, maxval=5, group=G_P,
     tooltip="One bar topping within a profile row of the period high means a single spike that was rejected - a tail. EXCESS.")
int   poorTouch = input.int(3, "Poor: bars at the extreme >=", minval=2, maxval=10, group=G_P,
     tooltip="Three or more bars all topping at the same place means price stalled flat at the extreme. POOR.\\n\\nThe panel prints the share of periods that produce a call. If that share is near zero the classifier is starving and nothing below means anything.")

string G_R = "2 - THE RACE"
float raceK  = input.float(1.0, "Race Distance (ATR)", minval=0.2, maxval=5.0, step=0.1, group=G_R,
     tooltip="How far price must travel, equally in both directions, for the race to resolve. Equal distance is what makes the arithmetic null exactly 50% and keeps every stop, target and cost assumption out of the measurement.")
int   raceBars = input.int(100, "Race Horizon (bars)", minval=10, maxval=500, group=G_R,
     tooltip="Races unresolved after this many bars are recorded as UNRESOLVED and excluded from the accuracy, rather than being assigned to whichever side was closer.")

string G_D = "3 - DISPLAY"
bool showCalls = input.bool(true, "Mark Calls", group=G_D)
bool showTbl   = input.bool(true, "Results Table", group=G_D)
color cUp   = input.color(#26a69a, "Up",   group=G_D, inline="c")
color cDn   = input.color(#ef5350, "Down", group=G_D, inline="c")

// ============================================================================
// 2. PRIMITIVES
// ----------------------------------------------------------------------------
// Top level, every bar, unconditional. Pine's ta.* functions carry rolling
// state and silently return stale values when reached through an `and` or a
// ternary - a bug that has already cost this project one whole round.
// ============================================================================
bool  barClosed = barstate.isconfirmed
float atr       = ta.atr(14)
bool  isNew     = perMode == "Daily" ? ta.change(time("D")) != 0 : ta.change(time("W")) != 0

// ============================================================================
// 3. PERIOD PROFILE AND EXTREME CLASSIFICATION
// ----------------------------------------------------------------------------
// Chart bars only, no intrabar requests: request.security_lower_tf has a depth
// limit that silently starves long histories, and this test needs samples.
// ============================================================================
var array<float> pH = array.new<float>()
var array<float> pL = array.new<float>()

var float perHi = na
var float perLo = na
var float fTopN = na
var float fBotN = na
var bool  fOk   = false

f_classify() =>
    float oTop = na
    float oBot = na
    bool  ok = false
    if pH.size() > 2 and not na(perHi) and not na(perLo) and perHi > perLo
        float step = (perHi - perLo) / rows
        if step > 0
            int topN = 0
            int botN = 0
            for i = 0 to pH.size() - 1
                if pH.get(i) >= perHi - step
                    topN += 1
                if pL.get(i) <= perLo + step
                    botN += 1
            oTop := topN
            oBot := botN
            ok := true
    [oTop, oBot, ok]

if barClosed
    if isNew
        [a, b, c] = f_classify()
        fTopN := a
        fBotN := b
        fOk   := c
        pH.clear()
        pL.clear()
        perHi := high
        perLo := low
    else
        fOk := false
        perHi := na(perHi) ? high : math.max(perHi, high)
        perLo := na(perLo) ? low : math.min(perLo, low)
    pH.push(high)
    pL.push(low)
    while pH.size() > 600
        pH.shift()
        pL.shift()

// ============================================================================
// 4. THE CALL
// ----------------------------------------------------------------------------
// Both extremes vote and only unanimity counts. A period whose high and low
// carry the same quality is telling you nothing directional - two poor
// extremes is a wide trending range, two excess extremes is a bracket that
// rejected both edges - so no call is made rather than forcing one.
// ============================================================================
int callDir = 0
if barClosed and fOk and not na(fTopN) and not na(fBotN)
    bool poorHi = fTopN >= poorTouch
    bool excHi  = fTopN <= excTouch
    bool poorLo = fBotN >= poorTouch
    bool excLo  = fBotN <= excTouch
    // poor high (trend still running up) + excess low (downside exhausted)
    if poorHi and excLo
        callDir := 1
    // poor low (trend still running down) + excess high (upside exhausted)
    else if poorLo and excHi
        callDir := -1

// ============================================================================
// 5. THE RACE
// ----------------------------------------------------------------------------
// Started on EVERY period rollover, called or not. The uncalled races are the
// drift baseline, and without them the accuracy below would be unreadable in
// any market that happened to trend during the sample.
// ============================================================================
var array<float> rUp  = array.new<float>()
var array<float> rDn  = array.new<float>()
var array<int>   rBar = array.new<int>()
var array<int>   rDir = array.new<int>()

// 0 calls up   1 calls up correct   2 calls down   3 calls down correct
// 4 all races  5 all races won by UP   6 unresolved   7 periods seen
var array<float> led = array.new<float>(8, 0.0)

f_led(int k, float v) =>
    led.set(k, led.get(k) + v)

if barClosed and fOk and not na(atr) and atr > 0
    rUp.push(close + raceK * atr)
    rDn.push(close - raceK * atr)
    rBar.push(bar_index)
    rDir.push(callDir)
    f_led(7, 1)

f_race() =>
    if rUp.size() > 0
        for i = rUp.size() - 1 to 0
            int age = bar_index - rBar.get(i)
            int d   = rDir.get(i)
            int won = 0
            // NOTHING IS JUDGED ON THE STARTING BAR. The race is registered at
            // that bar's close, but its high and low were made before the close
            // existed - reading them would resolve races on price action that
            // predates the start.
            if age >= 1
                bool up = high >= rUp.get(i)
                bool dn = low  <= rDn.get(i)
                // Both levels inside one bar is genuinely ambiguous, so it is
                // thrown away rather than guessed. Guessing here would quietly
                // hand the win to whichever side the test hopes for.
                won := up and dn ? 0 : up ? 1 : dn ? -1 : 0
            if won != 0
                f_led(4, 1)
                if won == 1
                    f_led(5, 1)
                if d == 1
                    f_led(0, 1)
                    if won == 1
                        f_led(1, 1)
                else if d == -1
                    f_led(2, 1)
                    if won == -1
                        f_led(3, 1)
                rUp.remove(i)
                rDn.remove(i)
                rBar.remove(i)
                rDir.remove(i)
            else if age >= raceBars
                f_led(6, 1)
                rUp.remove(i)
                rDn.remove(i)
                rBar.remove(i)
                rDir.remove(i)
    rUp.size()

if barClosed
    f_race()

plotshape(showCalls and barClosed and callDir == 1, "Call up", shape.triangleup,
     location.belowbar, cUp, size=size.small)
plotshape(showCalls and barClosed and callDir == -1, "Call down", shape.triangledown,
     location.abovebar, cDn, size=size.small)

// ============================================================================
// 6. RESULTS
// ----------------------------------------------------------------------------
// RAW is the accuracy. EDGE is the accuracy minus what drift alone delivered
// over the same bars. Only EDGE means anything, and in a trending sample the
// two can point in opposite directions.
// ============================================================================
var table t = table.new(position.bottom_left, 4, 9, bgcolor=color.new(#131722, 10),
     border_color=color.new(#000000, 55), border_width=1)

f_cell(int c, int r, string v, color col, bool hdr) =>
    table.cell(t, c, r, v, text_color=col, text_size=size.tiny,
         text_halign=c == 0 ? text.align_left : text.align_right,
         bgcolor=hdr ? color.new(#2a2e39, 20) : color(na))

f_results() =>
    float nUp   = led.get(0)
    float wUp   = led.get(1)
    float nDn   = led.get(2)
    float wDn   = led.get(3)
    float nAll  = led.get(4)
    float upAll = led.get(5)
    float drift = nAll > 0 ? upAll / nAll : na          // P(up wins) with no view
    float accU  = nUp > 0 ? wUp / nUp : na
    float accD  = nDn > 0 ? wDn / nDn : na
    float edgeU = na(accU) or na(drift) ? na : (accU - drift) * 100
    float edgeD = na(accD) or na(drift) ? na : (accD - (1 - drift)) * 100
    float nC    = nUp + nDn
    float edge  = nC > 0 and not na(drift) ?
         ((na(edgeU) ? 0 : edgeU * nUp) + (na(edgeD) ? 0 : edgeD * nDn)) / nC : na
    color ec = nC < 40 ? #b2b5be : na(edge) ? #b2b5be : edge > 5 ? #26a69a : edge < -5 ? #ef5350 : #b2b5be

    f_cell(0, 0, "REGIME CALL", #d1d4dc, true)
    f_cell(1, 0, "N", #d1d4dc, true)
    f_cell(2, 0, "RAW", #d1d4dc, true)
    f_cell(3, 0, "EDGE", #d1d4dc, true)
    f_cell(0, 1, "Up  (poor hi + exc lo)", #b2b5be, false)
    f_cell(1, 1, str.tostring(int(nUp)), nUp < 20 ? #ff9800 : #b2b5be, false)
    f_cell(2, 1, na(accU) ? "-" : str.tostring(accU * 100, "#.#") + "%", #b2b5be, false)
    f_cell(3, 1, na(edgeU) ? "-" : str.tostring(edgeU, "+#.#"), #b2b5be, false)
    f_cell(0, 2, "Down  (poor lo + exc hi)", #b2b5be, false)
    f_cell(1, 2, str.tostring(int(nDn)), nDn < 20 ? #ff9800 : #b2b5be, false)
    f_cell(2, 2, na(accD) ? "-" : str.tostring(accD * 100, "#.#") + "%", #b2b5be, false)
    f_cell(3, 2, na(edgeD) ? "-" : str.tostring(edgeD, "+#.#"), #b2b5be, false)
    f_cell(0, 3, "BOTH", #d1d4dc, true)
    f_cell(1, 3, str.tostring(int(nC)), nC < 40 ? #ff9800 : #d1d4dc, true)
    f_cell(2, 3, nC > 0 ? str.tostring((wUp + wDn) / nC * 100, "#.#") + "%" : "-", #d1d4dc, true)
    f_cell(3, 3, na(edge) ? "-" : str.tostring(edge, "+#.#") + "pp", ec, true)
    // The drift row is the whole reason this table can be believed. In a
    // trending sample RAW and EDGE disagree, and RAW is the one that lies.
    f_cell(0, 4, "Drift baseline  P(up wins)", #6c7080, false)
    f_cell(1, 4, str.tostring(int(nAll)), #6c7080, false)
    f_cell(2, 4, na(drift) ? "-" : str.tostring(drift * 100, "#.#") + "%", #6c7080, false)
    f_cell(3, 4, "no view", #6c7080, false)
    f_cell(0, 5, "Unresolved / periods", #6c7080, false)
    f_cell(1, 5, str.tostring(int(led.get(6))) + " / " + str.tostring(int(led.get(7))), #6c7080, false)
    f_cell(2, 5, "open " + str.tostring(rUp.size()), #6c7080, false)
    f_cell(3, 5, str.tostring(raceK, "#.#") + " ATR", #6c7080, false)
    // CALIBRATION. A classifier that almost never reaches unanimity produces an
    // empty table, and an empty table is not a result about markets.
    float share = led.get(7) > 0 ? nC / led.get(7) * 100 : na
    f_cell(0, 6, "Call rate " + (na(share) ? "-" : str.tostring(share, "#.#") + "%") +
         (not na(share) and share < 5 ? "   CLASSIFIER STARVED" : ""),
         na(share) ? #6c7080 : share < 5 ? #ef5350 : #6c7080, false)
    f_cell(1, 6, "", #6c7080, false)
    f_cell(2, 6, "", #6c7080, false)
    f_cell(3, 6, "", #6c7080, false)
    f_cell(0, 7, "HYPOTHESIS GENERATED BY THE DATA", #ff9800, false)
    f_cell(1, 7, "", #ff9800, false)
    f_cell(2, 7, "", #ff9800, false)
    f_cell(3, 7, "", #ff9800, false)
    f_cell(0, 8, "this run is its first fresh test", #6c7080, false)
    f_cell(1, 8, "", #6c7080, false)
    f_cell(2, 8, "", #6c7080, false)
    f_cell(3, 8, "", #6c7080, false)
    nC

if showTbl and barstate.islast
    f_results()
