//@version=6
// ============================================================================
// INDUCEMENT TEST  v1.0
// ----------------------------------------------------------------------------
// THE LAST PIECE OF THE OBJECTION, AND THE DEFINITION FIXED BEFORE THE RUN.
//
// Setup Excursion tested swing failures and found them WORSE than random
// entries: eighteen of twenty cells negative across 4,356 trades. The reply
// left standing was that swing failure and liquidity sweep were folded
// together, and that the two-stage version - inducement - was never built.
//
// Fair. It is built here, and because defining it mechanically means choices
// that become free parameters, the definition is written down before the
// result exists and is not adjusted afterwards.
//
//   DEFINITION, SHORT SIDE
//   1. H_major - the highest UN-SWEPT confirmed swing high in the window
//   2. H_minor - a confirmed swing high that formed AFTER H_major and sits
//      BELOW it
//   3. The grab - price trades above H_minor at some point after it formed
//   4. The sweep - price then trades above H_major and closes back below it
//   5. INDUCEMENT PRESENT if step 3 happened before step 4
//
//   Mirrored for longs. Free parameters: swing strength, and a maximum age for
//   the sequence. Nothing else.
//
// WHY THIS DESIGN BEATS THE LAST ONE.
//
// Setup Excursion stacked filters and watched N collapse to 247, where nothing
// under 5pp is visible and one instrument popping green means nothing. This is
// a PARTITION instead: every sweep lands in exactly one of two buckets, with
// and without inducement. So:
//
//   - the two halves must sum back to the sweep total, which is a consistency
//     check the nested design could not offer
//   - N stays large in both halves
//   - the comparison is the claim itself, IND against NO-IND, rather than each
//     against a baseline with the difference inferred
//
// Both halves are still measured against a timer baseline blended to their own
// long/short mix, because a sweep has the direction the sweep chose.
//
// ACCEPTANCE CRITERIA, SET NOW AND NOT MOVED LATER.
//
//   - the halves reconcile to the total
//   - inducement beats no-inducement by MORE THAN 3pp at MULTIPLE targets
//   - signs agree on at least THREE of four instruments
//   - the inducement bucket holds at least 300 pooled trades, or it is not read
//
// Anything short of all four is a null, including a single spectacular cell.
// Twenty-cell tables produced a green gold row twice today and neither
// survived contact with the other three instruments.
// ============================================================================
indicator("Inducement Test", shorttitle="INDUCE", overlay=true,
     max_boxes_count=50, max_lines_count=100, max_labels_count=300, max_bars_back=500)

// ============================================================================
// 1. INPUTS
// ============================================================================
string G_T = "1 - THE TEST"
float stopK   = input.float(1.0, "Stop Distance (ATR) = 1R", minval=0.2, maxval=5.0, step=0.1, group=G_T)
int   spacing = input.int(10, "Timer Entry Every N Bars", minval=1, maxval=100, group=G_T)
int   horizon = input.int(500, "Give Up After (bars)", minval=50, maxval=2000, group=G_T)

string G_S = "2 - THE SEQUENCE"
int   pivLen  = input.int(5, "Swing Strength (bars)", minval=2, maxval=20, group=G_S,
     tooltip="Bars either side a pivot must dominate. A real free parameter - fixed at 5 before the run and not adjusted after.")
int   seqMax  = input.int(200, "Maximum Sequence Age (bars)", minval=20, maxval=1000, group=G_S,
     tooltip="How long a swing point stays eligible as H_major or H_minor. Without a limit an ancient high would count as inducement forever. The second and last free parameter.")

string G_D = "3 - DISPLAY"
bool showMk  = input.bool(true, "Mark Sweeps", group=G_D)
bool showTbl = input.bool(true, "Results Table", group=G_D)

// ============================================================================
// 2. PRIMITIVES
// ============================================================================
bool  barClosed = barstate.isconfirmed
float atr       = ta.atr(14)
float pvH       = ta.pivothigh(high, pivLen, pivLen)
float pvL       = ta.pivotlow(low,  pivLen, pivLen)

// ============================================================================
// 3. THE SWING REGISTER
// ----------------------------------------------------------------------------
// Each stored swing carries the bar it formed on and the bar it was first
// traded through, which is what makes "was it grabbed BEFORE this sweep" an
// answerable question rather than a judgement call.
//   grab = -1 means never traded through.
//   used =  1 means a sweep has already fired on it, so it cannot fire twice.
// ============================================================================
var array<float> hPx = array.new<float>()
var array<int>   hBr = array.new<int>()
var array<int>   hGr = array.new<int>()
var array<int>   hUs = array.new<int>()
var array<float> lPx = array.new<float>()
var array<int>   lBr = array.new<int>()
var array<int>   lGr = array.new<int>()
var array<int>   lUs = array.new<int>()

f_age() =>
    if hPx.size() > 0
        for i = hPx.size() - 1 to 0
            if bar_index - hBr.get(i) > seqMax
                hPx.remove(i)
                hBr.remove(i)
                hGr.remove(i)
                hUs.remove(i)
    if lPx.size() > 0
        for i = lPx.size() - 1 to 0
            if bar_index - lBr.get(i) > seqMax
                lPx.remove(i)
                lBr.remove(i)
                lGr.remove(i)
                lUs.remove(i)
    hPx.size()

f_mark() =>
    if hPx.size() > 0
        for i = 0 to hPx.size() - 1
            if hGr.get(i) < 0 and high > hPx.get(i)
                hGr.set(i, bar_index)
    if lPx.size() > 0
        for i = 0 to lPx.size() - 1
            if lGr.get(i) < 0 and low < lPx.get(i)
                lGr.set(i, bar_index)
    lPx.size()

if barClosed
    f_age()
    if not na(pvH)
        hPx.push(pvH)
        hBr.push(bar_index - pivLen)
        hGr.push(-1)
        hUs.push(0)
    if not na(pvL)
        lPx.push(pvL)
        lBr.push(bar_index - pivLen)
        lGr.push(-1)
        lUs.push(0)

// ============================================================================
// 4. THE SWEEP, AND WHETHER IT WAS INDUCED
// ----------------------------------------------------------------------------
// Returns the index of the swept level and whether a lower, NEWER swing was
// grabbed before this bar. Both answers come from the register rather than
// from anything recomputed here, so the sequence cannot be read two ways.
// ============================================================================
var array<float> outS = array.new<float>(3, 0.0)   // 0 fired  1 induced  2 level

f_sweepHi() =>
    outS.set(0, 0.0)
    outS.set(1, 0.0)
    int best = -1
    float bestPx = 0.0
    if hPx.size() > 0
        for i = 0 to hPx.size() - 1
            if hUs.get(i) == 0 and hPx.get(i) > bestPx
                bestPx := hPx.get(i)
                best := i
    if best >= 0 and high > bestPx and close < bestPx
        hUs.set(best, 1)
        outS.set(0, 1.0)
        outS.set(2, bestPx)
        int mb = hBr.get(best)
        if hPx.size() > 0
            for j = 0 to hPx.size() - 1
                // lower, formed later, and already traded through before now
                if hPx.get(j) < bestPx and hBr.get(j) > mb and hGr.get(j) >= 0 and hGr.get(j) < bar_index
                    outS.set(1, 1.0)
    outS.get(0)

var array<float> outL = array.new<float>(3, 0.0)

f_sweepLo() =>
    outL.set(0, 0.0)
    outL.set(1, 0.0)
    int best = -1
    float bestPx = 1.0e18
    if lPx.size() > 0
        for i = 0 to lPx.size() - 1
            if lUs.get(i) == 0 and lPx.get(i) < bestPx
                bestPx := lPx.get(i)
                best := i
    if best >= 0 and low < bestPx and close > bestPx
        lUs.set(best, 1)
        outL.set(0, 1.0)
        outL.set(2, bestPx)
        int mb = lBr.get(best)
        if lPx.size() > 0
            for j = 0 to lPx.size() - 1
                if lPx.get(j) > bestPx and lBr.get(j) > mb and lGr.get(j) >= 0 and lGr.get(j) < bar_index
                    outL.set(1, 1.0)
    outL.get(0)

if barClosed
    f_mark()
    f_sweepHi()
    f_sweepLo()

bool swpS = barClosed and outS.get(0) == 1.0
bool indS = swpS and outS.get(1) == 1.0
bool swpL = barClosed and outL.get(0) == 1.0
bool indL = swpL and outL.get(1) == 1.0

// ============================================================================
// 5. TRADES
// ----------------------------------------------------------------------------
// bucket 0 timer   1 sweep WITHOUT inducement   2 sweep WITH inducement
// Every sweep lands in exactly one of buckets 1 and 2, so they partition the
// population and must sum back to it.
// ============================================================================
var array<float> tEn  = array.new<float>()
var array<float> tRk  = array.new<float>()
var array<int>   tDir = array.new<int>()
var array<int>   tBar = array.new<int>()
var array<int>   tBk  = array.new<int>()
var array<float> tMax = array.new<float>()

int NB = 3
int NT = 5
var array<float> hits  = array.new<float>(NB * NT, 0.0)
var array<float> bN    = array.new<float>(NB, 0.0)
var array<float> bL    = array.new<float>(NB, 0.0)
var array<float> tlHit = array.new<float>(NT, 0.0)
var array<float> tsHit = array.new<float>(NT, 0.0)
var array<float> tDirN = array.new<float>(2, 0.0)
var array<float> misc  = array.new<float>(1, 0.0)

f_tgt(int i) =>
    i == 0 ? 2.0 : i == 1 ? 3.0 : i == 2 ? 5.0 : i == 3 ? 8.0 : 12.0

f_open(int bucket, int d) =>
    bool ok = false
    if not na(atr) and atr > 0
        tEn.push(close)
        tRk.push(stopK * atr)
        tDir.push(d)
        tBar.push(bar_index)
        tBk.push(bucket)
        tMax.push(0.0)
        ok := true
    ok

if barClosed and not na(atr) and atr > 0 and bar_index % spacing == 0
    f_open(0, 1)
    f_open(0, -1)
if swpS
    f_open(indS ? 2 : 1, -1)
if swpL
    f_open(indL ? 2 : 1, 1)

f_track() =>
    if tEn.size() > 0
        for i = tEn.size() - 1 to 0
            float en = tEn.get(i)
            float rk = tRk.get(i)
            int   d  = tDir.get(i)
            int   bk = tBk.get(i)
            int   age = bar_index - tBar.get(i)
            bool  done = false
            // Nothing judged on the entry bar, whose extremes predate the close
            // that registered it.
            if age >= 1
                float fav = d == 1 ? (high - en) / rk : (en - low) / rk
                if fav > tMax.get(i)
                    tMax.set(i, fav)
                // Favourable excursion credited BEFORE the stop is checked -
                // within one bar the order is unknowable, and this reading stays
                // honest about what was reachable.
                if d == 1 ? low <= en - rk : high >= en + rk
                    done := true
                else if age >= horizon
                    done := true
                    misc.set(0, misc.get(0) + 1)
            if done
                float mx = tMax.get(i)
                bN.set(bk, bN.get(bk) + 1)
                if d == 1
                    bL.set(bk, bL.get(bk) + 1)
                if bk == 0
                    tDirN.set(d == 1 ? 0 : 1, tDirN.get(d == 1 ? 0 : 1) + 1)
                for L = 0 to NT - 1
                    if mx >= f_tgt(L)
                        hits.set(bk * NT + L, hits.get(bk * NT + L) + 1)
                        if bk == 0
                            if d == 1
                                tlHit.set(L, tlHit.get(L) + 1)
                            else
                                tsHit.set(L, tsHit.get(L) + 1)
                tEn.remove(i)
                tRk.remove(i)
                tDir.remove(i)
                tBar.remove(i)
                tBk.remove(i)
                tMax.remove(i)
    tEn.size()

if barClosed
    f_track()

plotshape(showMk and indS, "Induced short", shape.triangledown, location.abovebar, #ef5350, size=size.tiny)
plotshape(showMk and indL, "Induced long",  shape.triangleup,   location.belowbar, #26a69a, size=size.tiny)
plotshape(showMk and swpS and not indS, "Plain short", shape.xcross, location.abovebar, #787b86, size=size.tiny)
plotshape(showMk and swpL and not indL, "Plain long",  shape.xcross, location.belowbar, #787b86, size=size.tiny)

// ============================================================================
// 6. RESULTS
// ----------------------------------------------------------------------------
// The DIFF row is the claim. Everything above it is working.
// ============================================================================
var table t = table.new(position.bottom_left, 7, 9, bgcolor=color.new(#131722, 10),
     border_color=color.new(#000000, 55), border_width=1)

f_cell(int c, int r, string v, color col, bool hdr) =>
    table.cell(t, c, r, v, text_color=col, text_size=size.tiny,
         text_halign=c == 0 ? text.align_left : text.align_right,
         bgcolor=hdr ? color.new(#2a2e39, 20) : color(na))

f_base(int bk, int L) =>
    float nL = tDirN.get(0)
    float nS = tDirN.get(1)
    float pL = nL > 0 ? tlHit.get(L) / nL : na
    float pS = nS > 0 ? tsHit.get(L) / nS : na
    float n  = bN.get(bk)
    float l  = bL.get(bk)
    n > 0 and not na(pL) and not na(pS) ? (l * pL + (n - l) * pS) / n : na

f_row(int r, int bk, string nm) =>
    float n = bN.get(bk)
    f_cell(0, r, nm, #b2b5be, false)
    f_cell(1, r, str.tostring(int(n)), n < 300 and bk > 0 ? #ff9800 : #b2b5be, false)
    for L = 0 to NT - 1
        float p = n > 0 ? hits.get(bk * NT + L) / n : na
        float b = f_base(bk, L)
        float e = na(p) or na(b) ? na : (p - b) * 100
        f_cell(2 + L, r, na(p) ? "-" : str.tostring(p * 100, "#.#") +
             (bk == 0 or na(e) ? "" : " " + str.tostring(e, "+#.#")), #b2b5be, false)
    n

f_results() =>
    f_cell(0, 0, "BUCKET", #d1d4dc, true)
    f_cell(1, 0, "N", #d1d4dc, true)
    f_cell(2, 0, "2R", #d1d4dc, true)
    f_cell(3, 0, "3R", #d1d4dc, true)
    f_cell(4, 0, "5R", #d1d4dc, true)
    f_cell(5, 0, "8R", #d1d4dc, true)
    f_cell(6, 0, "12R", #d1d4dc, true)
    f_row(1, 0, "TIMER  (control)")
    f_row(2, 1, "SWEEP  no inducement")
    f_row(3, 2, "SWEEP  + inducement")
    // THE ROW. Induced minus plain, the two halves of one population.
    float n1 = bN.get(1)
    float n2 = bN.get(2)
    f_cell(0, 4, "INDUCED minus PLAIN", #d1d4dc, true)
    f_cell(1, 4, str.tostring(int(n2)) + "/" + str.tostring(int(n1)), n2 < 300 ? #ff9800 : #d1d4dc, true)
    for L = 0 to NT - 1
        float p1 = n1 > 0 ? hits.get(1 * NT + L) / n1 : na
        float p2 = n2 > 0 ? hits.get(2 * NT + L) / n2 : na
        float d = na(p1) or na(p2) ? na : (p2 - p1) * 100
        color c = n2 < 300 ? #b2b5be : na(d) ? #b2b5be : d > 3 ? #26a69a : d < -3 ? #ef5350 : #b2b5be
        f_cell(2 + L, 4, na(d) ? "-" : str.tostring(d, "+#.#"), c, true)
    f_cell(0, 5, "random walk 1/(1+n)", #6c7080, false)
    f_cell(1, 5, "", #6c7080, false)
    f_cell(2, 5, "33.3", #6c7080, false)
    f_cell(3, 5, "25.0", #6c7080, false)
    f_cell(4, 5, "16.7", #6c7080, false)
    f_cell(5, 5, "11.1", #6c7080, false)
    f_cell(6, 5, "7.7", #6c7080, false)
    // Consistency check the nested design could not offer.
    f_cell(0, 6, "halves reconcile: " + str.tostring(int(n1 + n2)) + " sweeps total", #6c7080, false)
    f_cell(1, 6, str.tostring(int(bL.get(2))) + "L in IND", #6c7080, false)
    for c = 2 to 6
        f_cell(c, 6, "", #6c7080, false)
    f_cell(0, 7, "censored " + str.tostring(int(misc.get(0))) + "   open " + str.tostring(tEn.size()), #6c7080, false)
    for c = 1 to 6
        f_cell(c, 7, "", #6c7080, false)
    f_cell(0, 8, "NEED >3pp AT MULTIPLE TARGETS, 3 OF 4 INSTRUMENTS", #ff9800, false)
    for c = 1 to 6
        f_cell(c, 8, "", #ff9800, false)
    n1 + n2

if showTbl and barstate.islast
    f_results()
