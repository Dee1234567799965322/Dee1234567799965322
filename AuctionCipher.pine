string bubText    = input.string("Volume", "Bubble Text",
     options=["Volume", "Delta", "Ratio", "Vol + Delta", "Vol + Ratio"], group=G_BUB)
color  bubBuyCol  = input.color(color.new(#00ffaa, 40), "Buy Color",   group=G_BUB)
color  bubSellCol = input.color(color.new(#ff0000, 20), "Sell Color",  group=G_BUB)
color  bubMixCol  = input.color(color.new(#ffd600, 30), "Mixed Color", group=G_BUB)



string G_PRESET = "* START HERE  -  CHART PRESET"
string preset = input.string("Standard", "Chart Preset",
     options=["Clean", "Standard", "Everything", "Custom (use the groups below)"], group=G_PRESET,
     tooltip="CLEAN - value area, POC, naked POCs, VWAP, labels and the plain-English read. Nothing else. This is what you want when you are actually trading.\n\nSTANDARD - Clean plus the profile histogram, initial balance, low volume nodes, DNA glow and absorption clouds, golden pockets.\n\nEVERYTHING - every layer, including volume bubbles, the barcode tape, DNA circles and target fibs. For studying, not for trading.\n\nCUSTOM - the individual toggles in the groups below take over.")

string instrProf = input.string("Auto-detect", "Instrument Profile", group=G_PRESET,
     options=["Auto-detect", "BTC / crypto perp", "Gold (XAU / GC)", "Manual (use settings below)"],
     tooltip="Switches the handful of settings that are genuinely instrument-specific, so you do not have to remember them when you change symbol.\n\nAUTO-DETECT reads the ticker and picks for you. BTC and GOLD force a profile regardless of symbol. MANUAL uses the values in the groups below exactly as you set them.\n\nWHAT IT CHANGES - and nothing else:\n  Period mode        BTC 24h UTC - Gold RTH session\n  RTH session        Gold 0820-1330 New York\n  Initial balance    BTC 240 min - Gold 60 min\n  CME symbol         CME:BTC1! - COMEX:GC1!\n  Minimum gap        BTC 0.5% - Gold 0.2%\n\nEverything else is already instrument-agnostic: WaveTrend is normalised, the DNA thresholds are z-scores, the risk layer is ATR-based, and the distance filters are percentages. Those need no switching and are left alone.\n\nOpen interest needs no switch either - it resolves per symbol and reports 'no OI feed' where there is none, which is the correct behaviour on spot gold.")

string G_LBL = "0 - LABELS  (read the chart without the menu)"
bool   lblOn     = input.bool(true, "Name Every Line", group=G_LBL,
     tooltip="Writes what each line IS next to it - VAH, VAL, POC, IB High, nPOC, LVN, VWAP. You should never have to open settings to know what you are looking at.")
string lblStyle  = input.string("Name + Price", "Label Content",
     options=["Name Only", "Name + Price", "Price Only"], group=G_LBL)
string lblSizeIn = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal"], group=G_LBL)
int    lblOffset = input.int(3, "Label Offset (bars right)", minval=0, maxval=40, group=G_LBL)
int    labSpacing = input.int(14, "Gap Between Side-by-side Labels (bars)", minval=4, maxval=60, group=G_LBL,
     tooltip="When two levels sit at almost the same price their labels are placed SIDE BY SIDE instead of stacked, this many bars apart. Increase it if they still overlap on your chart.\n\nThis replaced nudging the label up the price axis. Nudging had to move the label by a whole label height to clear anything, which at 250 rows on a 1m chart is many times the distance between the levels themselves - so either the nudge was too small to help or the label ended up pointing at a price the level is not at. Sideways there is unlimited room and the label keeps its true price.")
float  labTolATR  = input.float(0.5, "Label Collision Tolerance (x ATR)", minval=0.05, maxval=3.0, step=0.05, group=G_LBL,
     tooltip="How close two levels have to be before their labels are treated as colliding. Raise it if labels still overlap, lower it if they are being spread out when they did not need to be.")
int    labMaxCols = input.int(4, "Maximum Side-by-side Columns", minval=2, maxval=8, group=G_LBL,
     tooltip="How far the staggering is allowed to march to the right before it starts over. It takes this many levels within the collision tolerance to fill them, which is rare.")
bool   labSolid   = input.bool(true, "Solid Background Behind Labels", group=G_LBL,
     tooltip="Gives the label an opaque background in the chart's own colour so the level line passes BEHIND the text instead of striking through it. Turn it off for see-through labels.")
int    guideGap  = input.int(28, "Read Offset (bars right of labels)", minval=0, maxval=120, group=G_LBL,
     tooltip="Pushes the plain-English read clear of the level labels so the two do not overlap.")
bool   guideOn   = input.bool(true, "Show Plain-English Read", group=G_LBL,
     tooltip="One line at the top of price telling you what the auction is doing and which playbook that selects. No jargon to decode.")

string G_VWAP = "13 - VWAP"
bool   vwapOn_in    = input.bool(true, "Show VWAP", group=G_VWAP,
     tooltip="VWAP is the volume-weighted mean price. It belongs here: it is the same question the POC answers, asked continuously instead of once per period. When VWAP and POC sit apart, value is still migrating.")
string vwapAnchor= input.string("Auction Period", "VWAP Anchor",
     options=["Auction Period", "Daily", "Weekly", "Session"], group=G_VWAP,
     tooltip="Auction Period keeps VWAP on exactly the same clock as the volume profile, so VWAP and POC are always comparable.")
bool   vwapBands_in = input.bool(true, "Show Std Dev Bands", group=G_VWAP)
float  vwapMult1 = input.float(1.0, "Band 1 (std dev)", minval=0.1, maxval=5.0, group=G_VWAP)
float  vwapMult2 = input.float(2.0, "Band 2 (std dev)", minval=0.1, maxval=5.0, group=G_VWAP)
color  cVwap     = input.color(#ff9800, "VWAP Color", group=G_VWAP)
color  cVwapBand = input.color(color.new(#ff9800, 70), "Band Color", group=G_VWAP)

string G_FIB = "14 - FIB LEVELS"
bool  gpOn_in      = input.bool(true, "Golden Pockets (retracement)", group=G_FIB,
     tooltip="0.5 / 0.618 / 0.786 / 0.886 measured from the most recent confirmed swing. Drawn as lines, so they cost no plot slots.")
int   gpLookback= input.int(120, "Swing Window (bars)", minval=10, maxval=1000, group=G_FIB,
     tooltip="If the leg the fibs are measured from is older than this, they are not drawn.\n\nThis input previously did NOTHING. It was named Swing Lookback, it sat in the menu looking adjustable, and the only place it appeared was as a fallback that could never be reached. Now it does the job the fibs actually needed: a retracement of a leg that finished two hundred bars ago is not a level, it is a leftover, and it is the main reason fibs appear to sit still while price moves away from them.\n\nIt is now the window the swing high and swing low are taken from, which is the same idea stated honestly: a leg cannot be older than the window it is measured over.")
bool  gpConf    = input.bool(false, "Count the Golden Pocket as Confluence", group=G_FIB,
     tooltip="Adds 0.618 and 0.786 to the level confluence count, so a fib that lands on the POC or a naked POC raises the score of that price the way any other stacked level does.\n\nOFF by default and deliberately so: turning it on changes how many signals pass the location gate, and that is a change you should MEASURE rather than assume. The section header has always said confluence is where fibs earn their place - until now the code did not actually do it, so the claim was decoration.")
int   gpMinLeg  = input.int(15, "Minimum Leg Length (bars)", minval=3, maxval=50, group=G_FIB,
     tooltip="How far apart the swing high and the swing low have to be before they count as a leg. A high and a low three bars apart is noise.\n\nThis input used to be Pivot Strength, feeding ta.pivothigh/ta.pivotlow. That is why the fibs lagged: a pivot cannot exist until this many bars have printed to its RIGHT, so the leg's endpoint was always that far behind the market - on a daily chart, three weeks. The leg is now taken from the window's own extremes, which cannot lag, and this number filters noise instead of creating it.")
int   gpExtend  = input.int(20, "Extend Right (bars)", minval=0, maxval=200, group=G_FIB)
bool  fibTgtOn_in  = input.bool(false, "Custom Target Fibs (extension)", group=G_FIB,
     tooltip="Your original extension set: 1.47, 1.55, 2.56, 2.60, 2.64 above and -0.20, -0.23, -0.29 below. These are projection targets, not entries.")
color cGp618    = input.color(#ffd54f, "0.618 Color", group=G_FIB)
color cGp5      = input.color(#ff00ff, "0.5 Color", group=G_FIB)
color cGp786    = input.color(#00aaff, "0.786 Color", group=G_FIB)
color cGp886    = input.color(color.new(#ffffff, 30), "0.886 Color", group=G_FIB)
float fibMaxDist= input.float(25.0, "Hide Fibs Beyond (% from price)", minval=1.0, maxval=200.0, group=G_FIB,
     tooltip="A 2.64 extension of a big swing can land far off the chart or below zero, forcing the price scale to include it. Levels further than this are not drawn.")
color cFibTgt   = input.color(color.new(#ffffff, 55), "Target Fib Color", group=G_FIB)






string G_CME = "20 - CME GAP"
bool   cmeOn_in   = input.bool(true, "Show CME Gaps", group=G_CME,
     tooltip="CME Bitcoin futures close for the weekend; spot and perps do not. The range price travelled while CME was shut is genuinely UNTRADED on the futures book - a single print in auction terms, and the cleanest example of one you will find.\n\nIf the symbol does not resolve it is ignored rather than breaking the script.")
string cmeSym  = input.string("CME:BTC1!", "CME Symbol", group=G_CME)
bool   cmeWeekOnly = input.bool(true, "Weekend Gaps Only", group=G_CME,
     tooltip="THE fix for a gap count in the hundreds. The detector fires on every CME daily open gap, and BTC gaps the daily open constantly - those are not what anyone means by 'the CME gap'.\n\nWith this ON, a gap only counts when the futures book was actually SHUT across it. That is measured from the real time between consecutive CME sessions rather than by looking for a Friday, so a holiday closure - Good Friday, Christmas, Thanksgiving - is caught the same way a normal weekend is.")
float  cmeMin  = input.float(0.5, "Minimum Gap (%)", minval=0.01, maxval=5.0, group=G_CME)
int    cmeKeep = input.int(6, "Max Open Gaps", minval=1, maxval=20, group=G_CME)
color  cCmeGap = input.color(color.new(#9c27b0, 82), "Gap Color", group=G_CME)

string G_RISK = "21 - RISK LAYER"
bool  riskOn_in    = input.bool(true, "Draw Stop / Target / R", group=G_RISK,
     tooltip="The only layer that decides whether you keep money. Stops here are STRUCTURAL, not an ATR multiple: a long off value fails if the low that produced it is taken out, so the stop sits below that low. The target is the next real level the auction has to visit - the opposite value edge or the nearest untested POC.\n\nR is drawn before you act, not worked out afterwards.")
float riskBuf   = input.float(0.3, "Stop Buffer (x ATR)", minval=0.05, maxval=2.0, group=G_RISK)
int   riskSwing = input.int(5, "Stop Swing Lookback", minval=2, maxval=30, group=G_RISK)
float riskMinStop = input.float(0.6, "Minimum Stop Distance (x ATR)", minval=0.1, maxval=3.0, group=G_RISK,
     tooltip="Floor on how close the stop may sit. Without it, a tight recent low produced an enormous R that passed the minimum-R filter automatically - rewarding the stops most likely to be taken out.")
float riskMinR  = input.float(1.5, "Minimum R to Show Signal", minval=0.0, maxval=10.0, group=G_RISK,
     tooltip="Signals whose target is closer than this multiple of the risk are not drawn. A 0.6R setup is a losing trade taken slowly - better never to see it.")
string riskFill = input.string("Next bar open (realistic)", "Assumed Fill",
     options=["Next bar open (realistic)", "Signal bar close (optimistic)"], group=G_RISK,
     tooltip="Where the statistics assume you actually got filled.\n\nThe signal is only KNOWN at the close of its bar, so you cannot have bought at that close - the first price available to you is the next bar's open. Measuring from the signal bar's close quietly credits you with a fill nobody could have taken, and overstates expectancy by that distance on every single trade.\n\nLeave this on the realistic setting unless you are comparing against something that measures the optimistic way.")
float riskSlipT = input.float(0.0, "Slippage (ticks)", minval=0.0, maxval=200.0, group=G_RISK,
     tooltip="Applied against you on entry - buys fill higher, sells fill lower. Set it to what your venue actually costs you and the expectancy row becomes something you can trust.")
float riskTgtCap = input.float(2.0, "Cap Target at (R)", minval=0.0, maxval=20.0, step=0.5, group=G_RISK,
     tooltip="MEASURED DEFAULT, changed from 0 (off). Across three matched A/B runs on 30m gold, capping at 2R beat no cap on REALISED money every time - by 20.5R, 6.4R and 28.5R. Realised means win plus loss plus flat: outcomes you could actually have banked.\n\nThe headline Total R sometimes went DOWN when the cap went on, which is why this took so long to settle. That fall was the expired bucket: uncapped, trades sat past 2R waiting for a 3R target until the outcome horizon gave up on them and booked the unrealised R as profit. Capped, those same trades hit their target and became wins. The R did not disappear, it moved from paper into the bank.\n\nIt also matches what seven samples had already said: winners land near 2R while targets were being set near 2.9R.\n\n0 = off. The target is otherwise always a STRUCTURAL level - the next place the auction has to visit - and nothing caps how far away that is.\n\nRead your own statistics before setting this. If R from wins minus R from losses is NEGATIVE while R from flat is strongly POSITIVE, the trades are reaching profit and then giving it back before the structural target: the entries work and the target is too far. A cap turns that into realised R.\n\nThe cap can never sit closer than Minimum R, or the setup would fail its own filter the moment it was drawn.\n\nLeave HEADROOM. Setting the cap equal to Minimum R gives the trade none: fills happen at the next bar's open, R is recomputed from the price you actually got, and any adverse open then drops it under the minimum and the signal is dropped as unfilled. If Minimum R is 1.5, cap at 2 - or lower Minimum R first.")
int   riskExtend= input.int(25, "Box Extend (bars)", minval=5, maxval=200, group=G_RISK)
color cRiskStop = input.color(color.new(#ef5350, 78), "Stop Zone", group=G_RISK)
color cRiskTgt  = input.color(color.new(#26a69a, 78), "Target Zone", group=G_RISK)

string G_SESS = "22 - SESSION RANGES"
bool   sessOn_in   = input.bool(true, "Show Session Ranges", group=G_SESS,
     tooltip="Crypto has no exchange sessions, but it absolutely has session behaviour. The Asia range in particular is a real reference - London and New York routinely open by taking one side of it.\n\nThis is the auction-legitimate version of ICT killzones: measured ranges rather than arbitrary windows.")
string sess1    = input.session("0000-0800", "Asia", group=G_SESS)
string sess2    = input.session("0800-1600", "London", group=G_SESS)
string sess3    = input.session("1300-2100", "New York", group=G_SESS)
string sessTz   = input.string("UTC", "Session Range Timezone", options=["UTC", "America/New_York", "Europe/London", "Asia/Tokyo"], group=G_SESS)
int    sessKeep = input.int(3, "Days To Keep", minval=1, maxval=10, group=G_SESS)
bool   sessLbl  = input.bool(true, "Label Sessions", group=G_SESS)
color  cSess1   = input.color(color.new(#ffa726, 88), "Asia", group=G_SESS)
color  cSess2   = input.color(color.new(#42a5f5, 88), "London", group=G_SESS)
color  cSess3   = input.color(color.new(#66bb6a, 88), "New York", group=G_SESS)

string G_STAT = "23 - STATISTICS"
bool   statOn_in   = input.bool(true, "Show Statistics Table", group=G_STAT,
     tooltip="Everything this indicator asserts - poor highs get revisited, excess holds, balance breaks follow through - is a CLAIM until it is counted on your instrument. This counts them.\n\nTreat a low sample size as no answer at all. Under about 20 occurrences the percentages mean nothing.")
int    statHorizon = input.int(200, "Outcome Horizon (bars)", minval=5, maxval=500, group=G_STAT,
     tooltip="How long a trade gets to reach its target or its stop before it is given up on and booked as EXPIRED.\n\nRaised from 50 because 50 was distorting every number above it. An expired trade is not a result - it is a position still open when the clock ran out, marked at whatever R it happened to show. On a 30m gold sample with the target cap OFF, that bucket held between 23R and 38R of unrealised paper against headline totals of 9R to 53R: in one configuration the strategy had made 2.9R of real money and the table reported 40.8R.\n\nAt 200 almost everything resolves into a genuine win or loss, so Total R becomes a number you can read rather than one you have to take apart. Lower it only if you deliberately want to measure how fast setups resolve.")
string statPos  = input.string("Bottom Left", "Table Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=G_STAT)

string G_BAL = "19 - BALANCE AREAS  (auto-detected)"
bool  balOn_in      = input.bool(true, "Detect Balance Areas", group=G_BAL,
     tooltip="Every other profile in this script is anchored to a CLOCK - the UTC day, the week. Real auctions ignore calendars. Balance forms and breaks when it wants to.\n\nThis finds balance by its signature instead: volatility contracting. When ADX falls through its threshold the market has stopped trending and started rotating, so a box opens, builds, and gets its own volume profile. The POC and edges of THAT box are the levels that matter for the break.\n\nConcept from Low Volatility Profiles [BigBeluga], CC BY-NC-SA 4.0 - reimplemented, not copied.")
int   balAdxLen  = input.int(14, "ADX Length", minval=2, maxval=100, group=G_BAL)
int   balAdxTh   = input.int(30, "ADX Threshold", minval=5, maxval=80, group=G_BAL,
     tooltip="ADX falling through this is the contraction signal. Higher = only deep contractions qualify.")
int   balBuild   = input.int(20, "Build Length (bars)", minval=5, maxval=120, group=G_BAL,
     tooltip="How long the box expands before it is profiled and armed for a break.")
int   balBins    = input.int(20, "Balance Profile Bins", minval=5, maxval=40, group=G_BAL)
bool  balProfile = input.bool(true, "Draw Balance Profile", group=G_BAL)
bool  balUseLoc  = input.bool(true, "Use Balance Edges as Signal Location", group=G_BAL,
     tooltip="Feeds the box edges and its POC into the chart-signal location test, so a rejection off a real balance edge counts the same as one off the value area.")
color cBalBox    = input.color(color.new(#787b86, 40), "Box Border", group=G_BAL)
color cBalFill   = input.color(color.new(#2196f3, 90), "Box Fill", group=G_BAL)
color cBalPoc    = input.color(#ff9800, "Balance POC", group=G_BAL)
color cBalLo     = input.color(color.new(#2196f3, 30), "Low Volume Shade", group=G_BAL)

string G_HTF = "18 - HIGHER TIMEFRAME VALUE"
string htfMode = input.string("Weekly", "HTF Value Area",
     options=["Off", "Daily", "Weekly", "Monthly"], group=G_HTF,
     tooltip="A second, slower volume profile running alongside the main one. Your period profile answers 'where is value today'. This answers 'where is value this week', which is what decides whether today's balance is itself sitting high or low in a bigger auction.\n\nBuilt from chart bars rather than intrabar data - a week of 15m bars is already 672 points, far more than a profile needs, and it keeps the script fast.")
color cHtfPoc  = input.color(#ffee58, "HTF POC", group=G_HTF)
color cHtfVa   = input.color(color.new(#ef5350, 25), "HTF VAH / VAL", group=G_HTF)

string G_HTFC = "18b - HTF CANDLES"
bool   htfcOn_in = input.bool(false, "Show HTF Candles", group=G_HTFC,
     tooltip="Draws the higher-timeframe candles beside the chart, with the newest one still forming and updating live.\n\nThe point is not decoration. On a 15m chart you can see that the 4h candle is a long upper wick closing on its low WITHOUT changing timeframe and losing your place - and the wick is the part that matters, because it is where the auction went and got rejected.\n\nBuilt entirely from the chart's own bars. No data request, so nothing here can repaint and it costs nothing on any TradingView plan.")
string htfcTf    = input.timeframe("240", "Candle Timeframe", group=G_HTFC,
     tooltip="Must be HIGHER than the chart timeframe to mean anything. Equal or lower and every chart bar starts a new candle, so you get a row of copies of the bars you are already looking at.")
int    htfcCount = input.int(4, "Candles Shown", minval=1, maxval=10, group=G_HTFC,
     tooltip="Includes the one still forming. 4 gives you the live candle and the three before it - enough to see whether this one is continuing or breaking the sequence.")
int    htfcOffset= input.int(60, "Offset (bars right of price)", minval=5, maxval=300, group=G_HTFC,
     tooltip="How far right of the last bar the row of candles starts.\n\nIt has to clear the volume profile, which ends at Histogram Offset plus its width. At the defaults that is about bar 45, so 60 leaves a gap. Raise it if the two overlap on your chart.")
int    htfcWidth = input.int(5, "Candle Width (bars)", minval=1, maxval=20, group=G_HTFC)
int    htfcGap   = input.int(4, "Gap Between Candles (bars)", minval=1, maxval=30, group=G_HTFC)
bool   htfcRays  = input.bool(true, "Extend Open / High / Low of the Live Candle", group=G_HTFC,
     tooltip="Rays from the bar where each was actually made, out to the candle. This is the half the drawn candle cannot tell you: WHEN in the period the high was set. A high made in the first bar and never revisited is a very different candle from the same high made five minutes ago.")
bool   htfcLbl   = input.bool(true, "Label the Live Candle", group=G_HTFC,
     tooltip="Timeframe, percent change from the HTF open, and where the close sits inside the candle's range - 0% is on the low, 100% on the high. Closing near an extreme is the whole reading.")
color  cHtfcUp   = input.color(#26a69a, "HTF Candle Up", inline="hcc", group=G_HTFC)
color  cHtfcDn   = input.color(#ef5350, "HTF Candle Down", inline="hcc", group=G_HTFC)
color  cHtfcWick = input.color(color.new(#b2b5be, 25), "Wick", group=G_HTFC)
color  cHtfcRay  = input.color(color.new(#b2b5be, 55), "Open / High / Low Rays", group=G_HTFC)

string G_OI = "17 - OPEN INTEREST & FUNDING  (perps)"
bool   oiOn_in      = input.bool(true, "Enable Open Interest", group=G_OI,
     tooltip="OI is the count of contracts still open. Combined with price direction it tells you WHO is doing the moving:\n\nPrice up + OI up      new longs opening - real buying, but risk is building\nPrice up + OI down    shorts covering - a squeeze, not demand; tends to stall\nPrice down + OI up    new shorts opening - real selling\nPrice down + OI down  longs closing or being liquidated - a flush\n\nA squeeze into resistance and genuine buying into resistance look identical on price. They are opposite trades. This is the only thing that separates them.")
bool   liqOn_in     = input.bool(true, "Mark Liquidation Cascades", group=G_OI,
     tooltip="A wide-range bar where open interest COLLAPSES is forced closing, not fresh conviction. These flushes tend to overshoot and mean-revert, which is why they so often print the excess tail at the extreme.")
bool   oiProofOn = input.bool(true, "Count OI as Signal Proof", group=G_OI,
     tooltip="Adds open interest to the PROOF gate.\n\nInto support, price falling on FALLING open interest is longs being closed or liquidated - a flush, not fresh supply. That is what you want to be buying into.\n\nInto resistance, price rising on FALLING open interest is shorts covering - a squeeze, not demand. That is what you want to be selling into.")
bool   oiVetoOn  = input.bool(true, "Veto Signals Against Real Positioning", group=G_OI,
     tooltip="The more important half. Price rising on RISING open interest is new longs opening - genuine demand - and fading it is how you get run over. Price falling on rising OI is new shorts opening, genuine supply, and catching it is how you get run over the other way.\n\nWith this ON, a sell signal into real buying and a buy signal into real selling are both suppressed. A squeeze and genuine demand look identical on price; this is the only thing that separates them.")
float  liqOiZ    = input.float(1.5, "Liquidation OI Drop (std dev)", minval=0.5, maxval=5.0, group=G_OI)
float  liqSprZ   = input.float(1.2, "Liquidation Spread (std dev)", minval=0.3, maxval=5.0, group=G_OI)
string fundSym   = input.string("", "Funding Symbol (optional)", group=G_OI,
     tooltip="Leave blank unless you know the funding ticker for your venue. If the symbol does not resolve, it is ignored rather than breaking the script.")
color  cOiUp     = input.color(#26a69a, "OI Rising Color", group=G_OI)
color  cOiDn     = input.color(#ef5350, "OI Falling Color", group=G_OI)
color  cLiq      = input.color(#ffea00, "Liquidation Color", group=G_OI)

string G_STR = "15 - MARKET STRUCTURE"
bool  strOn_in      = input.bool(true, "Show Structure (BOS / CHoCH)", group=G_STR,
     tooltip="Swing labels and structure breaks. This is the ONE part of SMC that is not already covered by the auction layer - everything else it offers you already measure better.\n\nBOS  = break in the SAME direction as the trend. Continuation.\nCHoCH = break AGAINST the trend. The first warning of a turn.")
int   strLen     = input.int(10, "Swing Strength", minval=2, maxval=50, group=G_STR)
bool  strSwings  = input.bool(true, "Label Swings (HH / HL / LH / LL)", group=G_STR)
int   strMaxDraw = input.int(12, "Max Structure Marks", minval=2, maxval=40, group=G_STR)
color cBos       = input.color(#26a69a, "BOS Color", group=G_STR)
color cChoch     = input.color(#ff9800, "CHoCH Color", group=G_STR)
color cSwing     = input.color(color.new(#b2b5be, 25), "Swing Label Color", group=G_STR)

string G_CSIG = "16 - CHART SIGNALS  (location-gated)"
bool  csigOn_in     = input.bool(true, "Show Buy / Sell on Price Chart", group=G_CSIG,
     tooltip="These are NOT the pane's A/B/C grades. A pane signal only needs momentum. A chart signal needs all four layers to agree:\n\n1 CONTEXT  - regime permits the direction\n2 LOCATION - price at a value area edge or an untested POC\n3 TRIGGER  - WaveTrend cross in the extreme zone\n4 PROOF    - real money flow, absorption, or a delta divergence\n\nYou will see far fewer of these. That is the point.")
string gateMode  = input.string("Same event (strict)", "Gate Mode",
     options=["Window (legacy)", "Same event (strict)"], group=G_CSIG,
     tooltip="WINDOW is what this script has always done and what every measurement so far was taken on. Each gate asks 'did this happen in the last csigWindow + divLbR bars' - eight, on the defaults. The four gates therefore do not have to describe the same event, only the same week, and PROOF is an OR of five sources of which money-flow-crossing-zero is by far the loosest. The practical effect is that the gates qualify on a larger share of bars than the cooldown allows through, so the COOLDOWN is doing the selecting and the four-layer hierarchy is description rather than mechanism.\n\nSAME EVENT anchors everything to one swing. A divergence cannot confirm until divLbR bars after the pivot it measures - that delay is what makes it non-repainting - so the signal is evaluated on the divergence bar and the rejection and the WaveTrend cross must both belong to THAT pivot, within Event Tolerance bars. Divergence stops being one of five options and becomes mandatory: no divergence, no signal.\n\nExpect far fewer trades. That is the point, and it is also the only way the costs come down: on a Binance perp at roughly 0.09 percent round trip against a half-percent stop you are paying about 0.16R a trade, so 588 trades carry ~94R of friction that no signal was ever going to clear.")
int   gateTol    = input.int(6, "Event Tolerance (bars)", minval=0, maxval=6, group=G_CSIG,
     tooltip="How far the rejection and the momentum cross may sit from the divergence's own pivot and still count as the same swing. 0 demands they land on the exact pivot bar. Same event mode only.")
string csigSens  = input.string("Strict (all 4)", "Sensitivity",
     options=["Strict (all 4)", "Standard (3 of 4)", "Loose (location + trigger)"], group=G_CSIG,
     tooltip="How many of the four gates must pass. Location and trigger are always required - sensitivity only relaxes context and proof.\n\nIf you are seeing no signals at all, this is the dial to turn first.")
bool  csigZoneOnly = input.bool(false, "Cross Must Be In Extreme Zone", group=G_CSIG,
     tooltip="ON is the purist reading, but on ranging days WaveTrend may never reach +/-53 and you will see nothing for days. OFF accepts any cross that clears the other gates.")
bool  csigNeedBody = input.bool(false, "Rejection Must Close In Direction", group=G_CSIG,
     tooltip="ON also demands an up candle for a buy. That discards most higher-timeframe rejections, where the bar often closes red after a deep wick into the level. Closing back above the level is already the rejection.")
bool  csigVwap   = input.bool(true, "Count VWAP Bands as Location", group=G_CSIG,
     tooltip="Adds the VWAP standard deviation bands to the list of valid locations. These exist on every bar, unlike the developing value area.")
int   csigCool   = input.int(20, "Cooldown (bars between signals)", minval=1, maxval=200, group=G_CSIG,
     tooltip="Minimum bars before the same side can signal again. Six was far too short - one genuine swing re-fired over and over.")
int   csigWindow = input.int(3, "Trigger Window (bars)", minval=1, maxval=10, group=G_CSIG,
     tooltip="How many bars the cross and the location touch may be apart and still count as the same event.")
float csigTol    = input.float(0.12, "Location Tolerance (%)", minval=0.01, maxval=2.0, group=G_CSIG)
bool  csigOneTrade = input.bool(true, "One Trade At A Time", group=G_CSIG,
     tooltip="Nothing used to stop a BUY firing while a SELL was still open, so the chart could show you a long and a short at once with their stop and target boxes overlapping - two contradictory instructions, which is worse than none.\n\nWith this ON no new signal is drawn while a trade is still live.")
string csigFlipMode = input.string("Opposite setup completes", "Reversal Close Trigger",
     options=["Opposite setup completes", "Opposite momentum cross"], group=G_CSIG,
     tooltip="WHEN a reversal close fires.\n\nSETUP COMPLETES - the moment the opposite side satisfies all its gates. This is the behaviour every measurement so far was taken on.\n\nMOMENTUM CROSS - additionally requires the opposite WaveTrend cross on that exact bar. Far rarer, so more trades run to their stop or target instead.\n\nWhich is better is an open question, not a settled one. Read your own R rows: divide R-from-flat by the flat count, and R-from-wins-plus-losses by the resolved count. Whichever bucket has the higher per-trade R is where you want trades ending up. On the 297-trade sample that produced this input, flats returned +0.03R each against resolved trades at -0.035R each - so cutting early was marginally the better of the two, and the stricter setting would have sent more trades into the worse bucket.")
bool  csigFlip     = input.bool(true, "Opposite Signal Closes Open Trade", group=G_CSIG,
     tooltip="If a long is open and the sell side fully qualifies, the reason you were long is gone. The trade is closed at market and counted at whatever R it actually made, instead of being left to drift to its stop.\n\nIt does NOT immediately reverse - you go flat and wait for the next clean signal.")
int   csigConfMin = input.int(1, "Minimum Level Confluence", minval=1, maxval=6, group=G_CSIG,
     tooltip="How many independent levels must sit together at the rejection price.\n\nLocation is otherwise a BINARY test: a wick off a lone VWAP band counts exactly the same as a wick off a price where prior VAL, the POC, an untested POC and the weekly value low all coincide. Those are not the same trade.\n\n1 keeps the current behaviour - any single level qualifies. 2 or 3 demands a genuine cluster and will cut your signal count substantially.\n\nThe live count for both sides is shown after the gate letters in the dashboard, so you can watch what your instrument actually produces before raising this.")
bool  csigNoiseOn = input.bool(false, "Require Efficient Price Movement", group=G_CSIG,
     tooltip="A NOISE gate. None of the other four gates asks whether the market is currently smooth enough for a target to be reachable - context measures the SIZE of the range, not how cleanly price moves through it.\n\nEfficiency ratio is the straight-line distance price covered divided by the total distance it actually travelled. Near 1 is a clean directional move; near 0 is chop that happens to end up somewhere.\n\nThis matters most when your targets are far away. A 3R target needs price to travel efficiently - in chop the stop is reached first, every time.\n\nOFF by default so it cannot disturb a measurement already in progress. Turn it on, gather a fresh sample, and compare expectancy against your baseline.")
int   csigErLen  = input.int(20, "Efficiency Lookback (bars)", minval=5, maxval=200, group=G_CSIG)
float csigErMin  = input.float(0.25, "Minimum Efficiency", minval=0.0, maxval=1.0, step=0.05, group=G_CSIG,
     tooltip="Below this, no signal. Trending markets typically run 0.3 to 0.6; heavy chop sits under 0.15. Start at 0.25 and read the Efficiency row in the dashboard for a while before moving it.")
bool  csigStrict = input.bool(true, "Require Regime Agreement", group=G_CSIG,
     tooltip="ON - no counter-trend buys while value is migrating down, and vice versa. This is the filter that stops you fading a trend day.")
color cBuySig    = input.color(#00e676, "Buy Color", group=G_CSIG)
color cSellSig   = input.color(#ff1744, "Sell Color", group=G_CSIG)

string G_VIS = "MARKET CIPHER B: VISUALS (LOWER PANE)"
color cFastWave = input.color(color.new(#4a4e57, 12), "Fast Wave", group=G_VIS,
     tooltip="WaveTrend 1 - the faster of the two momentum waves.")
color cSlowWave = input.color(color.new(#22262f, 5), "Slow Wave", group=G_VIS,
     tooltip="WaveTrend 2 - the signal line the fast wave crosses.")
color cVwapUp   = input.color(color.new(#00c8f0, 30), "VWAP Wave Up", group=G_VIS,
     tooltip="Cyan in the original, one colour for both directions. It is a magnitude reading, not a direction reading - direction is already carried by the green/red money flow underneath it.")
color cVwapDn   = input.color(color.new(#00c8f0, 30), "VWAP Wave Down", group=G_VIS)
color cMfiBull  = input.color(color.new(#2eb872, 15), "MFI Bullish Ribbon", group=G_VIS)
color cMfiBear  = input.color(color.new(#e8384f, 15), "MFI Bearish Ribbon", group=G_VIS)
color cBuyDot   = input.color(#ffe100, "Buy Dot", group=G_VIS)
color cSellDot  = input.color(#ffffff, "Sell Dot", group=G_VIS)
