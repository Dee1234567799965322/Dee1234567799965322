float  bubSmallP  = input.float(75, "Small Percentile",  minval=50, maxval=99.9, step=1, group=G_BUB)
float  bubMedP    = input.float(90, "Medium Percentile", minval=50, maxval=99.9, step=1, group=G_BUB)
float  bubBigP    = input.float(97, "Big Percentile",    minval=50, maxval=99.9, step=1, group=G_BUB)
string bubConsen  = input.string("Majority (2 of 3)", "Consensus Mode",
     options=["Any Window", "Majority (2 of 3)", "All Windows (strictest)"], group=G_BUB)
int    bubShortW  = input.int(20,  "Short Window",  minval=5, group=G_BUB)
int    bubMidW    = input.int(50,  "Medium Window", minval=5, group=G_BUB)
