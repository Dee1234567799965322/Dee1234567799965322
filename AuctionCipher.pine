string G_DIV = "8 - DIVERGENCES"
bool divWt      = input.bool(true,  "WaveTrend Divergences", group=G_DIV)
bool divCvd     = input.bool(true,  "CVD Divergences (absorption)", group=G_DIV,
     tooltip="Price lower low while CVD makes a higher low: sellers pressing and not being paid. OG Market Cipher cannot see this.")
bool divLines   = input.bool(true,  "Draw Divergence Lines", group=G_DIV)
int  divMaxLines= input.int(20, "Max Divergence Lines Kept", minval=2, maxval=100, group=G_DIV,
     tooltip="Divergence lines used to accumulate without limit. Pine deletes the OLDEST drawing when the 500-object cap fills, so old divergence lines were evicting your value area and naked POC lines.")
bool divHidden  = input.bool(false, "Show Hidden Divergences", group=G_DIV,
     tooltip="Hidden divergence is the CONTINUATION reading, not the reversal one.\n\nHidden bullish: price makes a HIGHER low while the oscillator makes a LOWER low - a pullback inside an uptrend that sold off harder on the oscillator than it did on price. The trend is intact and the dip was bought.\n\nRegular bullish is the opposite situation: price makes a LOWER low, the oscillator makes a HIGHER one, and the DOWNTREND is running out.\n\nThey fire at different places in a move and mean different things, so they are drawn differently - hidden ones print as an X, regular ones as a circle or diamond - and they are counted separately.")
bool divHidProof = input.bool(false, "Hidden Divergence Counts as Proof", group=G_DIV,
     tooltip="Whether hidden divergence may satisfy the PROOF gate and produce signals, as opposed to only being drawn.\n\nSeparate from the switch above on purpose: SEEING something and ACTING on it are different decisions, and merging them means turning on a display changes your signal count without telling you.\n\nThink before enabling it. The other three gates are built around a reversal - LOCATION wants price rejecting a value area edge, and a hidden divergence sits at a higher low well inside the range, which is a different setup entirely. Turn it on, measure it, and compare against the expectancy you had without it.")
int  divLbL     = input.int(5, "Pivot Left Bars",  minval=1, maxval=50, group=G_DIV)
int  divLbR     = input.int(5, "Pivot Right Bars", minval=1, maxval=50, group=G_DIV,
     tooltip="A pivot is only confirmed this many bars after it forms, so markers appear this many bars back. A delay, not a repaint.")
int  divRangeMax= input.int(60, "Max Bars Between Pivots", minval=5, maxval=200, group=G_DIV)
int  divRangeMin= input.int(5,  "Min Bars Between Pivots", minval=1, group=G_DIV)

// --- QUALITY SCORE
// Every oscillator already in this script - WaveTrend, RSI, MFI, CMF - is built
// out of price and volume, so they mostly agree with each other by construction.
// Stacking more of them does not add information, it adds correlated noise and
// more signals. What follows is the opposite: four checks from data the
// oscillators cannot see, used to REJECT weak divergences rather than to
// generate new ones. Raising the minimum can only reduce the signal count.
int  divMinQual = input.int(0, "Minimum Divergence Quality (0-4)", minval=0, maxval=4, group=G_DIV,
     tooltip="0 = off, every divergence counts as proof exactly as before.\n\nSet this ABOVE ZERO ONLY AFTER MEASURING. Turn the statistics table on, run a few hundred bars at 0, note the expectancy, then raise it one step and compare. The dashboard shows the live score next to the gates so you can see what is being thrown away.\n\nThe four points are described in the settings below.")
bool divQPart   = input.bool(true, "Quality: Participation", group=G_DIV,
     tooltip="Scores a point when the new extreme was made on LESS volume than the previous swing extreme.\n\nA lower low that nobody traded is not selling, it is an absence of buying, and it takes very little to reverse it. A lower low on heavier volume is real distribution and is far more likely to continue. This is the one check no oscillator can make, because a divergence looks identical either way on the oscillator itself.")
float divVolFrac= input.float(0.8, "Participation Ratio", minval=0.2, maxval=1.0, step=0.05, group=G_DIV,
     tooltip="How much lighter the new extreme has to be. 0.8 means at most 80% of the previous extreme's volume.")
bool divQOi     = input.bool(true, "Quality: Open Interest Across The Swing", group=G_DIV,
     tooltip="Scores a point when open interest FELL from the previous swing extreme to this one.\n\nFalling OI into an extreme means positions are being CLOSED there - capitulating longs at a low, covering shorts at a high. That flow is finite and stops on its own. Rising OI into an extreme means new positions are being opened into the move, and those have not been squeezed out yet.\n\nThis is the same read as the existing OI proof, except measured across the swing the divergence is actually about instead of the last few bars. Needs Open Interest enabled and available for the symbol.")
bool divQLoc    = input.bool(true, "Quality: At A Real Level", group=G_DIV,
     tooltip="Scores a point when the rejection that goes with the divergence happened at the required number of stacked auction levels - value area edge, POC, naked POC, initial balance. A divergence in the middle of nowhere has nothing to reverse against.")
bool divQRef    = input.bool(false, "Quality: Correlated Market Non-confirmation", group=G_DIV,
     tooltip="Scores a point when a SECOND, correlated market did NOT make the matching new extreme.\n\nThis is the only genuinely new DATA on the list - everything else in the script is derived from this symbol's own price, volume and open interest. If gold makes a new low and the dollar has not made a new high, the low is not being driven by the thing that normally drives gold, and it is much more likely to fail.\n\nSuggestions - gold: TVC:DXY with Invert ON, or TVC:US10Y. BTC: BINANCE:ETHUSDT.P or CRYPTOCAP:TOTAL with Invert OFF.\n\nCosts one extra data request, so it is off by default.")
string divRefSym= input.symbol("", "Correlated Symbol", group=G_DIV)
bool divRefInv  = input.bool(false, "Correlated Symbol Is Inverse", group=G_DIV,
     tooltip="ON for a symbol that normally moves OPPOSITE this one, such as DXY against gold.")

// The pane's own graded markers were removed so it can never contradict the
// chart. buyA / sellA remain as ALERT conditions only.

string G_OF = "24 - ORDER FLOW  (footprint engine, no drawing)"
bool  ofOn      = input.bool(true, "Enable Order Flow Engine", group=G_OF,
     tooltip="Runs the Auction Footprint engine inside this script with the grid switched OFF.\n\nThe expensive half of a footprint is the DRAWING - five hundred boxes, one per cell. The reading is a single pass over the lower-timeframe samples this script already fetches for the volume profile, so running it headless costs almost nothing and adds a source of evidence that is not another oscillator built out of the same price.\n\nNothing here changes a signal until you switch one of the three gate options on below. Off, it is a readout.")
int   ofRows    = input.int(14, "Rows per Bar", minval=4, maxval=40, group=G_OF,
     tooltip="How finely each bar is sliced for the absorption test. Finer finds smaller shelves and more of them.")
float ofAbsMult = input.float(2.5, "Absorption Heavy Row Multiple", minval=1.2, maxval=10.0, step=0.1, group=G_OF,
     tooltip="How much more than an average row of its own bar a price has to trade before it counts as defended.")
float ofAbsEdge = input.float(30.0, "Absorption Edge Band (%)", minval=5.0, maxval=50.0, step=5.0, group=G_OF,
     tooltip="How much of a bar counts as its extreme. Absorption in the middle of a bar is ordinary two-way trade; it only means something where price was trying to go.")
int   ofAbsConf = input.int(3, "Bars to Confirm Absorption", minval=1, maxval=20, group=G_OF)
int   ofAbsKeep = input.int(6, "Absorption Levels Kept", minval=1, maxval=20, group=G_OF)
float ofDivMin  = input.float(10.0, "Delta Divergence Needs (% of volume)", minval=1.0, maxval=60.0, step=1.0, group=G_OF,
     tooltip="A bar closing up on a delta of minus three is rounding error, not absorption. The delta has to be this share of the bar's own volume before the divergence counts.")
bool  ofDraw    = input.bool(false, "Draw Absorption Levels", group=G_OF,
     tooltip="Just the confirmed levels - two or three lines - not the grid. The grid belongs in the separate footprint script where it has a drawing budget of its own.")
color cOfAbs    = input.color(#ff6d00, "Absorption Level Colour", group=G_OF)
bool  ofLoc     = input.bool(false, "Count Absorption as Signal Location", group=G_OF,
     tooltip="Lets a confirmed absorption level satisfy the LOCATION gate the way a value area edge or a naked POC does.\n\nThis is the strongest case for wiring the engine in: every other level in that gate is derived from where price HAS BEEN. An absorption level is derived from somebody actively defending a price and succeeding, which is a different kind of fact.\n\nOFF by default. It changes how many signals pass, so measure it.")
bool  ofConf    = input.bool(false, "Count Absorption in Confluence", group=G_OF)
bool  ofProof   = input.bool(false, "Count Delta Divergence as Proof", group=G_OF,
     tooltip="Lets hidden strength - a bar closing UP while net flow was SELLING - satisfy the PROOF gate, and hidden weakness the reverse.\n\nThis is the one piece of evidence in the whole script that no oscillator can reach: it says the aggressive side was absorbed and price went the wrong way for them. OFF by default for the same reason as the others - measure before you trust it.")

string G_AUD = "26 - GATE AUDIT  (diagnostic)"
string audPos = input.string("Middle Left", "Audit Table Position",
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=G_AUD)
bool  audOn = input.bool(true, "Show Gate Audit", group=G_AUD,
     tooltip="Counts, over every bar this chart has loaded, how often each of the four gates was open, how often all four were open together, and how many of those became signals.\n\nThis answers one question and it is the most important question you can ask a rule set: is the LOGIC selecting the trades, or is the cooldown? If all four gates are open on a large share of bars, the four-layer hierarchy is decoration and the Cooldown input is the real strategy. The PROOF breakdown says the same thing about divergence specifically - if divergence supplies a small share of proofs, then divergence is not what the system trades on, whatever the description says.")

string G_GEX = "25 - GAMMA EXPOSURE  (levels you supply)"
// WHY THESE ARE TYPED IN AND NOT COMPUTED.
//
// Real GEX is the sum over every strike of open interest x gamma x contract
// multiplier, signed by an assumption about which way dealers are positioned.
// It needs the whole option chain: every strike, every near expiry, its open
// interest, and an implied volatility to price gamma from.
//
// Pine cannot reach any of that. There is no options-chain call, open interest
// per contract is not served to scripts, and even if it were you cannot
// enumerate strikes - request.security needs a known symbol per call and the
// script is capped at 40 of them, against a hundred-plus strikes. There is no
// honest proxy for it in price and volume either: gamma is a fact about
// someone else's book, not about the tape. Any script claiming to CALCULATE
// gamma exposure from an OHLCV feed is making it up.
//
// So the levels come from wherever you already get them - SpotGamma, MenthorQ,
// GEX bot, your desk - and this does the part that is actually worth having:
// puts them on the chart with everything else, counts them in the same gates,
// and reads the regime off the flip. Set a field to 0 and it is ignored, so
// fill in only what you have. They are a DAILY snapshot; update them when your
// source updates or they are just old lines.
bool  gexOn    = input.bool(false, "Enable Gamma Levels", group=G_GEX,
     tooltip="Off by default and it changes nothing until you both switch it on AND type levels in. Applies to instruments with a real options market - SPX, NDX, ES, SPY, QQQ, big single names, and gold. On a crypto perp the numbers only mean something if you are pulling Deribit gamma, which is a different book from the one moving the perp.")
float gexCall  = input.float(0.0, "Call Wall", minval=0.0, group=G_GEX,
     tooltip="Largest positive gamma strike above price. Dealers are long gamma here and sell into strength, so it behaves as resistance and as a magnet the market struggles to clear. 0 = not supplied.")
float gexPut   = input.float(0.0, "Put Wall", minval=0.0, group=G_GEX,
     tooltip="Largest negative gamma strike below price. Behaves as support for the same reason in reverse. 0 = not supplied.")
float gexFlip  = input.float(0.0, "Gamma Flip / Zero Gamma", minval=0.0, group=G_GEX,
     tooltip="The price where net dealer gamma crosses zero. This is the single most useful number of the set - it decides which playbook the day is on. 0 = not supplied.")
float gexHvl   = input.float(0.0, "High Volume Level (HVL)", minval=0.0, group=G_GEX,
     tooltip="The strike carrying the most open interest - the day's gravity. Price tends to be pulled back to it into the close on expiry-heavy days. 0 = not supplied.")
float gexCall2 = input.float(0.0, "Second Call Wall", minval=0.0, group=G_GEX)
float gexPut2  = input.float(0.0, "Second Put Wall", minval=0.0, group=G_GEX)
bool  gexLoc   = input.bool(false, "Count Gamma Walls as Signal Location", group=G_GEX,
     tooltip="Lets a rejection at a wall or the HVL satisfy the LOCATION gate the way a value area edge does.\n\nOFF by default, same reason as every other gate option here: it changes how many signals pass, so measure it before you trust it. And it is only as good as the numbers you typed - a stale wall is worse than no wall, because the gate will happily open on it.")
bool  gexConf  = input.bool(false, "Count Gamma Levels in Confluence", group=G_GEX)
color cGexRes  = input.color(#ef5350, "Wall Above", inline="gxc", group=G_GEX)
color cGexSup  = input.color(#26a69a, "Wall Below", inline="gxc", group=G_GEX)
color cGexFlip = input.color(#ffa726, "Gamma Flip / HVL", group=G_GEX)

// 0 means "not supplied". Kept as a function so the six guarded values cost the
// main body nothing - it is already close to Pine's size cap.
f_gx(float v) =>
    gexOn and v > 0 ? v : na

// 1 = positive gamma, -1 = negative gamma, 0 = no flip level supplied.
//
// This is the whole point of the flip. ABOVE it dealers are long gamma: they
// sell rallies and buy dips to stay hedged, which SUPPRESSES range and makes
// mean reversion the right playbook - fading value area edges back to POC is
// the trade. BELOW it they are short gamma and hedge the other way, selling
// weakness and buying strength, which AMPLIFIES the move. Fading in negative
// gamma is how you get run over, and it is the same warning the day type
// already gives on a trend day, arrived at from a completely different source.
f_gexReg() =>
    float f = f_gx(gexFlip)
    na(f) ? 0 : close > f ? 1 : -1

string G_TBL = "10 - DASHBOARD"
bool   showTable = input.bool(true, "Show Dashboard", group=G_TBL)
string tblPos    = input.string("Top Right", "Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=G_TBL)
color  cTblBg    = input.color(color.new(#131722, 10), "Background", group=G_TBL)
color  cTxt      = input.color(#d1d4dc, "Text", group=G_TBL)

color C_UP  = #26a69a
color C_DN  = #ef5350
color C_NE  = #b2b5be
color C_WN  = #ffa726
color C_GLD = #ffd54f


// ============================================================================
// 1b. PRESET RESOLUTION
// ----------------------------------------------------------------------------
// Every visual toggle resolves through the preset unless Custom is selected.
// The point is that one dropdown should decide how busy the chart is, instead
// of you hunting through fourteen groups to quieten it down.
// ============================================================================
bool P_STD   = preset == "Standard"
bool P_ALL   = preset == "Everything"
bool P_CUST  = preset == "Custom (use the groups below)"
bool P_SPLUS = P_STD or P_ALL

bool showHist  = P_CUST ? showHist_in  : P_SPLUS
bool showPrior = P_CUST ? showPrior_in : true
bool showPrHL  = P_CUST ? showPrHL_in  : P_ALL
bool showIB    = P_CUST ? showIB_in    : P_SPLUS
bool showNpoc  = P_CUST ? showNpoc_in  : true
bool showLvn   = P_CUST ? showLvn_in   : P_SPLUS
bool dnaGlow   = P_CUST ? dnaGlow_in   : P_SPLUS
bool dnaCloud  = P_CUST ? dnaCloud_in  : P_SPLUS
bool dnaDots   = P_CUST ? dnaDots_in   : P_ALL
bool dnaTape   = P_CUST ? dnaTape_in   : P_ALL
bool bubOn     = P_CUST ? bubOn_in     : P_ALL
bool gpOn      = P_CUST ? gpOn_in      : P_SPLUS
bool fibTgtOn  = P_CUST ? fibTgtOn_in  : P_ALL
bool vwapOn    = P_CUST ? vwapOn_in    : true
bool vwapBands = P_CUST ? vwapBands_in : P_SPLUS

// These eleven were added after the preset system was written and never wired
// into it, so "Clean" was still drawing structure, balance boxes, sessions,
// CME gaps, OI and risk boxes. Clean is now actually clean.
bool aucOn  = P_CUST ? aucOn_in  : true
bool dnaOn  = P_CUST ? dnaOn_in  : P_SPLUS
bool csigOn = P_CUST ? csigOn_in : true
bool riskOn = P_CUST ? riskOn_in : true
bool strOn  = P_CUST ? strOn_in  : P_SPLUS
bool balOn  = P_CUST ? balOn_in  : P_SPLUS
bool oiOn   = P_CUST ? oiOn_in   : P_SPLUS
bool liqOn  = P_CUST ? liqOn_in  : P_SPLUS
bool cmeOn  = P_CUST ? cmeOn_in  : true
bool sessOn = P_CUST ? sessOn_in : P_ALL
bool statOn = P_CUST ? statOn_in : P_SPLUS

// ============================================================================
// 1c. INSTRUMENT PROFILE
// ----------------------------------------------------------------------------
// A script cannot write to its own inputs - Pine has no mechanism for it. What
// it can do is resolve an EFFECTIVE value, which is how the chart preset above
// already works. So the settings dialog still shows whatever you typed; these
// are what the script actually runs on.
//
// Only genuinely instrument-specific settings are switched. A profile that
// quietly rewrote thirty inputs would be impossible to reason about when a
// signal did something you did not expect.
// ============================================================================
string acTkr = str.upper(syminfo.ticker)
bool acIsBtc  = str.contains(acTkr, "BTC") or str.contains(acTkr, "XBT")
bool acIsGold = str.contains(acTkr, "XAU") or str.contains(acTkr, "GOLD") or
     str.startswith(acTkr, "GC") or str.startswith(acTkr, "MGC")

// BTC is tested first: a hypothetical BTC/XAU pair is a crypto instrument.
bool acBtc  = instrProf == "BTC / crypto perp" or (instrProf == "Auto-detect" and acIsBtc)
bool acGold = instrProf == "Gold (XAU / GC)" or (instrProf == "Auto-detect" and acIsGold and not acIsBtc)

// ---------------------------------------------------------------------------
// RTH BELONGS TO FUTURES, NOT TO EVERY INSTRUMENT WITH GOLD IN THE NAME
// ---------------------------------------------------------------------------
// This profile used to put ALL gold into RTH mode, session 0820-1330 New York.
// That is correct for COMEX:GC1!, whose pit session is a real thing. It is
// wrong for TVC:GOLD, OANDA:XAUUSD and every other spot or CFD feed, which
// trade close to 24 hours.
//
// The damage was not cosmetic. inPeriod is false outside the session, and
// inPeriod gates profile accumulation, the running period range, and the VWAP
// sums. So on a spot gold chart for roughly nineteen hours out of every
// twenty-four the volume profile stopped taking data - the histogram, the value
// area and the POC simply froze in place and stayed frozen while price walked
// away from them. Nothing on the chart said why.
//
// syminfo.type separates the two cases exactly. Futures gold keeps its pit
// session; spot gold gets Chart Daily, which follows the feed's own daily
// boundary rather than a clock that does not apply to it.
bool acGoldFut = acGold and syminfo.type == "futures"

// Gold's regular session is 0820-1330 New York, about five and a quarter hours,
// so the classic 60-minute initial balance is already the right sixth of it.
// A 24-hour crypto period needs 240 to be the same fraction.
string periodModeEff = acGoldFut ? "RTH Session (futures)" : acGold ? "Chart Daily" : acBtc ? "24h UTC (crypto)" : periodMode
string rthSessEff    = acGold ? "0820-1330" : rthSess
string rthTzEff      = acGold ? "America/New_York" : rthTz
// 60 minutes is the right sixth of a five-hour pit session; a near-24-hour
// day needs 240 for the same fraction, which is why spot gold matches BTC here.
int    ibMinEff      = acGoldFut ? 60 : (acGold or acBtc) ? 240 : ibMinutes
string cmeSymEff     = acGold ? "COMEX:GC1!" : acBtc ? "CME:BTC1!" : cmeSym
// Gold's daily range is roughly a third of BTC's, so the same percentage
// threshold would hide most of its weekend gaps.
float  cmeMinEff     = acGold ? 0.2 : acBtc ? 0.5 : cmeMin

string acProfTag = acBtc ? "BTC" : acGoldFut ? "GOLD-F" : acGold ? "GOLD" : "manual"

// ============================================================================
// 2. HELPERS
// ============================================================================
f_tablePos(string s) =>
    switch s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.middle_right

// Returns [poc, vah, val, rangeHigh, rangeLow, ok, bins, binsUp]
//
// binsUp is the part of each bin that traded on an UP sample (close above open).
// It is filled only when us is the same length as the price arrays, so callers
// that do not care about the buy/sell split pass the shared empty array below
// and pay nothing for it. Splitting inside this loop rather than in a second
// pass matters: the binning loop is the most expensive thing in the script.
f_profile(array<float> hs, array<float> ls, array<float> vs, array<float> us, int rows, float pct) =>
    float poc = na
    float vah = na
    float val = na
    float hi  = na
    float lo  = na
    bool  ok  = false
    array<float> bins   = array.new<float>(rows, 0.0)
    array<float> binsUp = array.new<float>(rows, 0.0)

    int n = hs.size()
    bool udOk = us.size() == n
    if n > 0
        hi := hs.max()
        lo := ls.min()
        float rng = hi - lo
        if rng > 0
            float step = rng / rows
            for i = 0 to n - 1
                float bv = vs.get(i)
                if bv > 0
                    int lvlLo = math.max(0, math.min(rows - 1, int((ls.get(i) - lo) / step)))
                    int lvlHi = math.max(0, math.min(rows - 1, int((hs.get(i) - lo) / step)))
                    float slice = bv / (lvlHi - lvlLo + 1)
                    float uSlice = udOk ? us.get(i) / (lvlHi - lvlLo + 1) : 0.0
                    for lvl = lvlLo to lvlHi
                        bins.set(lvl, bins.get(lvl) + slice)
                        if udOk
                            binsUp.set(lvl, binsUp.get(lvl) + uSlice)

            float total = bins.sum()
            if total > 0
                int pocIdx = bins.indexof(bins.max())
                if pocIdx < 0
                    pocIdx := int(rows / 2)
                float target = total * pct
                float acc = bins.get(pocIdx)
                int up = pocIdx + 1
                int dn = pocIdx - 1
                while acc < target and (up <= rows - 1 or dn >= 0)
                    float vUp = -1.0
                    float vDn = -1.0
                    if up <= rows - 1
                        vUp := bins.get(up)
                    if dn >= 0
                        vDn := bins.get(dn)
                    if vUp < 0 and vDn < 0
                        break
                    if vUp >= vDn
                        acc += vUp
                        up += 1
                    else
                        acc += vDn
                        dn -= 1
                poc := lo + (pocIdx + 0.5) * step
                vah := lo + math.min(rows, up) * step
                val := lo + math.max(0, dn + 1) * step
                ok := true

    [poc, vah, val, hi, lo, ok, bins, binsUp]

// Callers that want no buy/sell split pass this. One allocation for the whole
// script rather than a throwaway array per call.
var array<float> noSplit = array.new<float>(0)

// ============================================================================
// 3. ONE LOWER-TIMEFRAME REQUEST, USED BY BOTH LAYERS
// ----------------------------------------------------------------------------
// The profile needs high/low/volume. The delta needs close/open/volume. Doing
// it in a single call is cheaper than the two separate scripts were.
// ============================================================================
int chartSec = timeframe.in_seconds(timeframe.period)

// The requested timeframe must be STRICTLY lower than the chart's, or both
// request.security_lower_tf and requestVolumeDelta throw.
//
// Below 2 minutes the only lower timeframes are second-based (1S, 5S), and
// SECONDS DATA REQUIRES A PAID TRADINGVIEW PLAN. On a free account a 1m chart
// therefore has no usable lower timeframe at all, which is why 1m failed while
// 3m worked. The calls are skipped entirely there rather than asking for data
// that cannot be served.
//
// Nothing important is lost. On 1m the chart bars are themselves 1-minute
// resolution, so the profile and the delta simply read them directly.
bool useLtf = chartSec > 60

string ltfEff = "1"
if chartSec >= 86400
    ltfEff := "60"
else if chartSec >= 3600
    ltfEff := "5"
else
    ltfEff := "1"

string deltaTf = ltfEff

// Intrabar data only earns its cost from 5m upward. On 3m the chart bars
// already give 480 price/volume points per UTC day, more than a 100-row
// profile needs, and pulling finer data risks a timeout.
bool intrabarUseful = chartSec >= 300

array<float> lH = na
array<float> lL = na
array<float> lC = na
array<float> lO = na
array<float> lV = na
float dLast = na
// The HIGHEST and LOWEST the delta reached INSIDE the bar. requestVolumeDelta
// has always returned these and this script has always discarded them, which is
// a waste: the closing delta alone cannot tell a bar that ran steadily to +2K
// from one that was at -8K first and reversed. Same call, same cost, two more
// numbers.
float dHiIn = na
float dLoIn = na

if useLtf
    [rH, rL, rC, rO, rV] = request.security_lower_tf(syminfo.tickerid, ltfEff, [high, low, close, open, volume], ignore_invalid_symbol=true)
    lH := rH
    lL := rL
    lC := rC
    lO := rO
    lV := rV
    [_dOpen, _dMax, _dMin, rDelta] = taLib.requestVolumeDelta(deltaTf)
    dLast := rDelta
    dHiIn := _dMax
    dLoIn := _dMin

bool ltfPresent = false
if useLtf
    if not na(lH)
        if lH.size() > 0
            ltfPresent := true

bool ltfOk = false
if intrabarUseful and ltfPresent
    ltfOk := true

// --- signed volume, two ways
// Primary: TradingView's official requestVolumeDelta. It splits volume inside
// each intrabar rather than judging a whole bar by its direction, which is what
// the original Volume Bubbles and Volume DNA scripts both rely on.
// Fallback: classify the lower-timeframe bars we already fetched for the
// profile, used only when the library returns nothing (deep history).
float buyVol  = 0.0
float sellVol = 0.0
// RUNTIME: this loop walks every intrabar of every bar - 48 iterations a bar on
// a 4h chart at 5m resolution. It only ever feeds fbDelta, which is only used
// when the official delta is missing, so on any chart where the library returns
// data it was pure waste. Now it only runs when it is actually the source.
if na(dLast)
    if ltfPresent
        for i = 0 to lC.size() - 1
            float v = lV.get(i)
            if not na(v)
                if lC.get(i) > lO.get(i)
                    buyVol += v
                else if lC.get(i) < lO.get(i)
                    sellVol += v
    else
        if close > open
            buyVol := nz(volume)
        else if close < open
            sellVol := nz(volume)

// The denominator has to be the bar's TOTAL traded volume. Summing only the
// intrabars that closed up or down silently drops every flat intrabar, so the
// ratio came out too large - and when the official delta was in use the two
// halves came from different sources entirely, which could put the ratio past
// 100%. Bar volume is exact whenever the feed provides it.
float totVol   = nz(volume) > 0 ? nz(volume) : buyVol + sellVol
float fbDelta  = buyVol - sellVol
float barDelta = na(dLast) ? fbDelta : dLast
bool  deltaOfficial = not na(dLast)
// clamped: a ratio outside -100%..+100% is not meaningful and would distort
// the money flow plot it feeds
float deltaRatio = totVol > 0 ? math.max(-1.0, math.min(1.0, barDelta / totVol)) : 0.0

// ============================================================================
// 4. PERIOD BOUNDARY
// ============================================================================
bool inRTH = not na(time(timeframe.period, rthSessEff, rthTzEff))
bool inPeriod = true
if periodModeEff == "RTH Session (futures)"
    inPeriod := inRTH

int utcDayIdx = int(math.floor(time / 86400000.0))
bool isNewPeriod = false
if periodModeEff == "RTH Session (futures)"
    isNewPeriod := inRTH and not inRTH[1]
else if periodModeEff == "24h UTC (crypto)"
    // Epoch milliseconds are already UTC, so integer-dividing by one day gives
    // an exact day index that cannot be missed by a gap. The previous version
    // tested hour==0, which fails if a whole hour is absent and the first bar
    // of the day prints at 01:xx.
    isNewPeriod := utcDayIdx != utcDayIdx[1]
else if periodModeEff == "Weekly"
    isNewPeriod := timeframe.change("W")
else
    isNewPeriod := timeframe.change("D")

// ---------------------------------------------------------------------------
// LIVE-MARKET SAFETY: everything that PERSISTS happens at bar close.
//
// Pine re-executes the whole script on every tick of the unconfirmed bar.
// Plain variables are rolled back to their last committed value before each
// re-run, so counters look after themselves - but objects pushed into arrays
// and drawings created with line.new / box.new / label.new are NOT reliably
// rolled back. On a live chart that meant one forming bar could push hundreds
// of duplicate samples into the volume profile, stack a fresh naked-POC line
// on every tick, and write the same trade into the statistics ledger over and
// over. Historical bars are unaffected because they are always confirmed,
// which is exactly why this never showed up on a reloaded chart and only ever
// went wrong in real time.
//
// Every block that appends to an array or creates a drawing is gated on this.
// Plots, markers and the dashboard stay live - they hold no state.
bool barClosed = barstate.isconfirmed

// ---------------------------------------------------------------------------
// IS THIS FEED ACTUALLY LIVE?
// ---------------------------------------------------------------------------
// On a real-time feed the current bar can never be older than one bar interval:
// the moment it is, that bar has closed and a new one has opened. On a delayed
// feed it can, by exactly the delay. So the age of the forming bar, measured
// against the interval it belongs to, separates the two without needing any
// flag the platform does not expose.
//
// This matters more than it looks. A free TradingView plan serves CME and COMEX
// delayed, so a futures chart looks completely normal while every level, every
// signal and every alert on it describes a market that moved ten minutes ago.
// Nothing else on the chart would ever tell you.
int  feedAgeMs  = timenow - time
int  feedAgeMin = int(feedAgeMs / 60000)
// 30 seconds of grace for ordinary clock and tick-arrival jitter.
bool feedStale  = barstate.isrealtime and feedAgeMs > chartSec * 1000 + 30000

// Declared here, not in the CVD section, because the VWAP anchor needs them too
// and it is evaluated earlier in the script.
bool chgD = timeframe.change("D")
bool chgW = timeframe.change("W")
bool chgS = session.isfirstbar_regular

// ============================================================================
// 5. AUCTION STATE
// ============================================================================
var array<float> curH = array.new<float>()
var array<float> curL = array.new<float>()
var array<float> curV = array.new<float>()
// The up-volume half of each sample, kept in lockstep with curV so the profile
// can be drawn as buying against selling. Anything that touches curV must touch
// this too or the two fall out of alignment and the split silently lies.
var array<float> curU = array.new<float>()

var float priorPoc = na
var float priorVah = na
var float priorVal = na
var float priorHi  = na
var float priorLo  = na

var float ibH = na
var float ibL = na
var bool  ibLocked = false
var int   periodStart = na
var int   periodStartBar = 0
var float periodOpen = na
var bool  firstPeriodDone = false

var array<float> rangeHist = array.new<float>()
var string priorHighQual = "n/a"
var string priorLowQual  = "n/a"
var float  priorHiLvl = na
var float  priorLoLvl = na
var array<Npoc> npocs = array.new<Npoc>()

// The auction level lines. These were ten separate handles created once and
// then nudged with line.set_xy on every last bar. They are one array now,
// cleared and rebuilt, for a mechanical reason: a Pine function cannot reassign
// a global, and the block that draws them had to become a function to keep the
// script's main body under its size cap. Mutating an array IS legal there, and
// rebuilding costs nothing because it only ever runs on the last bar.
var array<line> aucLn = array.new<line>()
var array<box>  histBoxes = array.new<box>()
var array<line> histLines = array.new<line>()
var array<line> lvnLines  = array.new<line>()

// ============================================================================
// 6. PERIOD ROLLOVER
// ============================================================================
if isNewPeriod and aucOn and barClosed
    [fPoc, fVah, fVal, fHi, fLo, fOk, fBins, fBinsU] = f_profile(curH, curL, curV, noSplit, profRows, vaPct)
    if fOk and firstPeriodDone
        priorPoc := fPoc
        priorVah := fVah
        priorVal := fVal
        priorHi  := fHi
        priorLo  := fLo
        // classify the COMPLETED period's extremes here. Doing it from the
        // developing profile meant it only ever ran on the last bar, so the
        // statistics for poor highs and lows never accumulated at all.
        float fMax = fBins.max()
        if fMax > 0
            // average the outer BAND, not one bin - see the Extreme Band tooltip
            int fEdge = math.max(1, int(profRows * excBand / 100))
            float fTopSum = 0.0
            float fBotSum = 0.0
            for e = 0 to fEdge - 1
                fTopSum += fBins.get(profRows - 1 - e)
                fBotSum += fBins.get(e)
            float fTopPct = fTopSum / fEdge / fMax * 100
            float fBotPct = fBotSum / fEdge / fMax * 100
            priorHighQual := fTopPct < excThresh ? "EXCESS" : fTopPct > excThresh * poorMult ? "POOR" : "Flat"
            priorLowQual  := fBotPct < excThresh ? "EXCESS" : fBotPct > excThresh * poorMult ? "POOR" : "Flat"
            priorHiLvl := fHi
            priorLoLvl := fLo
        rangeHist.push(fHi - fLo)
        if rangeHist.size() > 20
            rangeHist.shift()
        if showNpoc
            // x1 and x2 MUST differ. A zero-length line with extend=extend.right
            // has no defined slope; Pine renders it VERTICALLY and it drags the
            // price scale with it. This was the mystery red line.
            int npocX1 = na(time[1]) ? time - 60000 : time[1]
            line nl = line.new(npocX1, fPoc, time, fPoc, xloc=xloc.bar_time, color=cNpoc,
                 style=line.style_dotted, width=1, extend=extend.right, force_overlay=true)
            npocs.push(Npoc.new(price = fPoc, ln = nl))
            if npocs.size() > maxNpoc
                Npoc dropped = npocs.shift()
                line.delete(dropped.ln)

    firstPeriodDone := true
    curH.clear()
    curL.clear()
    curV.clear()
    curU.clear()
    periodStartBar := bar_index
    ibH := high
    ibL := low
    ibLocked := false
    periodStart := time
    periodOpen := open

// ============================================================================
// 7. ACCUMULATION
// ============================================================================
if inPeriod and aucOn and barClosed
    if ltfOk
        for i = 0 to lH.size() - 1
            float v = lV.get(i)
            if not na(v)
                if v > 0
                    curH.push(lH.get(i))
                    curL.push(lL.get(i))
                    curV.push(v)
                    // a sample that closed on its open is not evidence for
                    // either side, so it is split rather than counted as selling
                    curU.push(lC.get(i) > lO.get(i) ? v : lC.get(i) < lO.get(i) ? 0.0 : v * 0.5)
    else
        curH.push(high)
        curL.push(low)
        curV.push(nz(volume))
        curU.push(close > open ? nz(volume) : close < open ? 0.0 : nz(volume) * 0.5)

    if not ibLocked
        if not na(periodStart)
            if time - periodStart < ibMinEff * 60000
                ibH := na(ibH) ? high : math.max(ibH, high)
                ibL := na(ibL) ? low : math.min(ibL, low)
            else
                ibLocked := true

while curH.size() > 20000
    curH.shift()
    curL.shift()
    curV.shift()
    curU.shift()

// ============================================================================
// 8. DEVELOPING PROFILE  (last bar only - the loop is heavy at 250 rows)
// ============================================================================
float devPoc = na
float devVah = na
float devVal = na
float devHi  = na
float devLo  = na
bool  devOk  = false
// How many samples the DRAWN profile is actually built from. The dashboard used
// to report curH.size(), the persistent array - which on a Daily chart is last
// period's count, not this one's, and so never warned about the period that was
// on screen.
int   devSamples = 0
array<float> devBins   = array.new<float>(profRows, 0.0)
array<float> devBinsUp = array.new<float>(profRows, 0.0)

bool profRolling = profRange == "Rolling Lookback"

// ----------------------------------------------------------------------------
// THE SAMPLES THE DEVELOPING PROFILE IS DRAWN FROM.
//
// This is a function purely so its ~35 statements sit in their own scope. The
// main body is close to Pine's size cap and this block is the kind that grows.
// A function may not reassign a global, but it may MUTATE an array it is handed
// or one it creates, which is all this does.
//
// THE FORMING BAR. Accumulation (section 7) is gated on barClosed, because
// array pushes are not rolled back between the ticks of an unconfirmed bar and
// an ungated push would duplicate the whole bar hundreds of times over. The
// side effect is that the profile always STOPS at the last CLOSED bar. On a 15m
// chart that hole is fifteen minutes wide and invisible. On a 4h chart it is
// four hours. On a Daily chart it is a whole day - which is exactly where the
// histogram looked like it had stopped tracking price, because it had.
//
// THE ROLLOVER LAGS THE SAME WAY. Section 6 clears curH on barClosed too, so
// when the live bar is the one that opens a new period the arrays still hold
// the WHOLE PREVIOUS PERIOD. On a Daily chart every bar opens a new period, so
// that chart was drawing yesterday's profile and only ever yesterday's.
//
// The cure is not to loosen either gate - they are what keep the real arrays
// from being corrupted in real time. It is to COPY here and reconstruct the
// state the arrays WOULD be in had the live bar closed: a new period starts
// from nothing, a continuing one keeps what it has, and either way the live bar
// goes on the end. This runs only on the last bar and the copy is rebuilt from
// scratch every tick, so nothing persists.
//
// curH.copy() is not optional. array<float> x = curH ALIASES the real array,
// and the .clear() below would then wipe the period's samples for good.
// ----------------------------------------------------------------------------
f_devSamples() =>
    // Rolling mode ignores the accumulated samples entirely, so it must not pay
    // to copy them: curH can hold 20,000 floats and this runs on every tick of
    // the last bar. Four arrays of that size copied and then immediately thrown
    // away was the difference between a redraw and a timeout.
    bool useAcc = not profRolling
    array<float> pfH = useAcc ? curH.copy() : array.new<float>()
    array<float> pfL = useAcc ? curL.copy() : array.new<float>()
    array<float> pfV = useAcc ? curV.copy() : array.new<float>()
    array<float> pfU = useAcc ? curU.copy() : array.new<float>()
    if useAcc and not barClosed
        if isNewPeriod
            pfH.clear()
            pfL.clear()
            pfV.clear()
            pfU.clear()
        if inPeriod
            if ltfOk
                for i = 0 to lH.size() - 1
                    float lv = lV.get(i)
                    if not na(lv)
                        if lv > 0
                            pfH.push(lH.get(i))
                            pfL.push(lL.get(i))
                            pfV.push(lv)
                            pfU.push(lC.get(i) > lO.get(i) ? lv : lC.get(i) < lO.get(i) ? 0.0 : lv * 0.5)
            else
                float cv = nz(volume)
                if cv > 0
                    pfH.push(high)
                    pfL.push(low)
                    pfV.push(cv)
                    pfU.push(close > open ? cv : close < open ? 0.0 : cv * 0.5)
    // Rolling mode ignores all of the above and rebuilds from the last N CHART
    // bars - coarser than intrabar samples, but one pass on one bar, and it
    // needs no second set of persistent arrays competing with the period ones,
    // so it cannot disturb prior value, the naked POCs or the excess reads.
    // high[0] is the live bar, so rolling mode never had the forming-bar hole.
    if profRolling
        int look = math.min(profLook, bar_index)
        for i = 0 to look
            float bv = nz(volume[i])
            if bv > 0
                pfH.push(high[i])
                pfL.push(low[i])
                pfV.push(bv)
                pfU.push(close[i] > open[i] ? bv : close[i] < open[i] ? 0.0 : bv * 0.5)
    [pfH, pfL, pfV, pfU]

if barstate.islast and aucOn
    [pfH, pfL, pfV, pfU] = f_devSamples()
    devSamples := pfH.size()
    [dP, dVah, dVal, dHi, dLo, dOk, dBins, dBinsU] = f_profile(pfH, pfL, pfV, pfU, profRows, vaPct)
    devPoc := dP
    devVah := dVah
    devVal := dVal
    devHi  := dHi
    devLo  := dLo
    devOk  := dOk
    devBins := dBins
    devBinsUp := dBinsU

// ============================================================================
// 9. EXCESS vs POOR EXTREMES
// ----------------------------------------------------------------------------
// EXCESS - thin volume in the outermost bin. Price went there, found nobody and
//          left. The auction is finished at that price. This is what a genuine
//          rejection looks like when you can see the volume behind it.
// POOR   - heavy volume right at the extreme. It stopped without being
//          rejected, leaving unfinished business. Poor extremes get revisited.
// ============================================================================
string highQual = "n/a"
string lowQual  = "n/a"
// Hoisted so the dashboard can show the MEASURED value beside the verdict.
// Without it the threshold is uncalibratable: POOR needs the outer band to hold
// excThresh x poorMult = 37.5% of the POC bin, and in a bell-shaped profile
// that band typically holds 5 to 20%. So EXCESS fires nearly always and POOR
// nearly never - the live statistics show POOR occurring 2 and 4 times across
// hundreds of periods. A verdict that lands on one side 99% of the time is not
// classifying anything. Showing the number lets the threshold be set from the
// instrument's own distribution rather than guessed.
float topPct = na
float botPct = na
if devOk
    float mxB = devBins.max()
    if mxB > 0
        int dEdge = math.max(1, int(profRows * excBand / 100))
        float dTopSum = 0.0
        float dBotSum = 0.0
        for e = 0 to dEdge - 1
            dTopSum += devBins.get(profRows - 1 - e)
            dBotSum += devBins.get(e)
        topPct := dTopSum / dEdge / mxB * 100
        botPct := dBotSum / dEdge / mxB * 100
        float poorCut = excThresh * poorMult
        if topPct < excThresh
            highQual := "EXCESS"
        else if topPct > poorCut
            highQual := "POOR"
        else
            highQual := "Flat"
        if botPct < excThresh
            lowQual := "EXCESS"
        else if botPct > poorCut
            lowQual := "POOR"
        else
            lowQual := "Flat"

// ============================================================================
// 10. LOW VOLUME NODES
// ============================================================================
// Moved into a function to keep the main body under Pine's size cap. It writes
// no global - it only deletes and rebuilds the low-volume-node lines.
f_drawLvn() =>
    for l in lvnLines
        line.delete(l)
    lvnLines.clear()
    if showLvn and devOk
        float mxB = devBins.max()
        if mxB > 0
            float step = (devHi - devLo) / profRows
            int anchorT = na(periodStart) ? time : periodStart
            for lvl = 2 to profRows - 3
                if lvnLines.size() < maxLvn
                    if devBins.get(lvl) / mxB * 100 < lvnThresh
                        bool trough = devBins.get(lvl) <= devBins.get(lvl - 1) and devBins.get(lvl) <= devBins.get(lvl + 1)
                        bool hvnUp = devBins.get(lvl + 2) / mxB * 100 > lvnThresh * 1.6
                        bool hvnDn = devBins.get(lvl - 2) / mxB * 100 > lvnThresh * 1.6
                        if trough and hvnUp and hvnDn
                            float py = devLo + (lvl + 0.5) * step
                            int lvnX1 = anchorT >= time ? (na(time[1]) ? time - 60000 : time[1]) : anchorT
                            lvnLines.push(line.new(lvnX1, py, time, py, xloc=xloc.bar_time,
                                 color=cLvn, style=line.style_dashed, width=1,
                                 extend=extend.right, force_overlay=true))

if barstate.islast and aucOn
    f_drawLvn()

// ============================================================================
// 11. NAKED POC MAINTENANCE
// ============================================================================
if showNpoc and aucOn and barClosed
    if npocs.size() > 0
        for i = npocs.size() - 1 to 0
            Npoc n = npocs.get(i)
            if high >= n.price and low <= n.price
                line.delete(n.ln)
                npocs.remove(i)

float npocUp = na
float npocDn = na
if npocs.size() > 0
    for i = 0 to npocs.size() - 1
        float p = npocs.get(i).price
        if math.abs(p - close) / close * 100 <= npocMaxDist
            if p > close
                npocUp := na(npocUp) ? p : math.min(npocUp, p)
            else
                npocDn := na(npocDn) ? p : math.max(npocDn, p)

// ============================================================================
// 12. REGIME - VALUE - DAY TYPE - OPEN TYPE
// ============================================================================
string posVsValue = "n/a"
if not na(priorVah) and not na(priorVal)
    if close > priorVah
        posVsValue := "ABOVE value"
    else if close < priorVal
        posVsValue := "BELOW value"
    else
        posVsValue := "INSIDE value"

string vaRelation = "n/a"
if devOk and not na(priorVah) and not na(priorVal)
    if devVal > priorVah
        vaRelation := "Higher value"
    else if devVah < priorVal
        vaRelation := "Lower value"
    else if devVal >= priorVal and devVah <= priorVah
        vaRelation := "Inside prior"
    else if devVal <= priorVal and devVah >= priorVah
        vaRelation := "Wider"
    else
        vaRelation := "Overlapping"

float avgRange = na
if rangeHist.size() > 0
    avgRange := rangeHist.avg()

// ---------------------------------------------------------------------------
// LIVE CONTEXT - computed on every bar
// The displayed regime depends on the developing profile, which for speed is
// only built on the last bar. That meant the signal's context gate was blank on
// every historical bar and therefore always open. This version uses only values
// that exist on every bar: the running period extremes and prior value.
// ---------------------------------------------------------------------------
var float runHi = na
var float runLo = na
// SESSION LEAK: this used to extend on EVERY bar. In RTH mode - which the gold
// profile now selects by default - that meant the running range absorbed the
// whole overnight session while avgRange, which it is measured against, is
// built only from RTH profiles. runRange was therefore inflated against a
// yardstick that excluded the same hours, and regimeLive read IMBALANCE far
// too readily, which then closed the context gate on exactly the rotations
// gold spends its RTH session doing. It must measure the same hours the
// profile measures.
if isNewPeriod
    runHi := high
    runLo := low
else if inPeriod
    runHi := na(runHi) ? high : math.max(runHi, high)
    runLo := na(runLo) ? low : math.min(runLo, low)

float runRange = na(runHi) or na(runLo) ? na : runHi - runLo

bool acceptedAbove = false
bool acceptedBelow = false
if not na(priorVah)
    acceptedAbove := close > priorVah and close[1] > priorVah and close[2] > priorVah
if not na(priorVal)
    acceptedBelow := close < priorVal and close[1] < priorVal and close[2] < priorVal

string regimeLive = "TRANSITION"
if not na(avgRange) and avgRange > 0 and not na(runRange)
    if runRange > avgRange * 1.5 or acceptedAbove or acceptedBelow
        regimeLive := "IMBALANCE"
    else if not na(priorVah) and not na(priorVal) and close <= priorVah and close >= priorVal
        regimeLive := "BALANCE"

bool imbUp = regimeLive == "IMBALANCE" and acceptedAbove
bool imbDn = regimeLive == "IMBALANCE" and acceptedBelow

// ---------------------------------------------------------------------------
// EFFICIENCY RATIO - is the market smooth enough for a distant target?
// ---------------------------------------------------------------------------
// Straight-line distance covered, divided by the total distance actually
// travelled to get there. 1.0 is a move in one direction with no retracement;
// 0.0 is pure chop that happens to finish where it started.
//
// The idea is borrowed from a D-RSI script that fits a polynomial to RSI and
// refuses to signal when the fit is poor - a good instinct wrapped in a QR
// decomposition running every bar. This measures the same thing, "is the data
// smooth enough to act on", as a running sum. Kaufman's ratio, and it costs
// nothing.
float erNum = math.abs(close - close[csigErLen])
float erDen = math.sum(math.abs(close - close[1]), csigErLen)
float effRatio = erDen > 0 ? erNum / erDen : 0.0

// BALANCE means rotate and fade the edges. IMBALANCE means value is migrating
// and fading the edges is how you get run over.
string regime = "n/a"
if devOk and not na(avgRange) and avgRange > 0
    float rr = (devHi - devLo) / avgRange
    bool migrated = vaRelation == "Higher value" or vaRelation == "Lower value"
    if migrated or rr > 1.5
        regime := "IMBALANCE"
    else if vaRelation == "Inside prior" or vaRelation == "Overlapping"
        regime := "BALANCE"
    else
        regime := "TRANSITION"

// Moved into a function to keep the main body under Pine's size cap. Three
// globals, so they come back as a tuple rather than being assigned inside.
f_dayType() =>
    string oExt   = "n/a"
    float  oRatio = na
    string oDay   = "n/a"
    if not na(ibH) and not na(ibL) and devOk
        float ibRange = ibH - ibL
        bool extUp = devHi > ibH
        bool extDn = devLo < ibL
        if extUp and extDn
            oExt := "BOTH"
        else if extUp
            oExt := "UP"
        else if extDn
            oExt := "DOWN"
        else
            oExt := "None"
        if ibRange > 0
            oRatio := (devHi - devLo) / ibRange
            if extUp and extDn
                oDay := "Neutral"
            else if oRatio < 1.15
                oDay := "Normal"
            else if oRatio < 1.8
                oDay := "Normal var"
            else
                oDay := "Trend day"
    [oExt, oRatio, oDay]

[ibExt, rngRatio, dayType] = f_dayType()

string openType = "n/a"
if not na(periodOpen) and not na(ibH) and not na(ibL)
    if ibH > ibL
        float ibr = ibH - ibL
        float upFromOpen = ibH - periodOpen
        float dnFromOpen = periodOpen - ibL
        if upFromOpen > ibr * 0.8
            openType := "Drive UP"
        else if dnFromOpen > ibr * 0.8
            openType := "Drive DOWN"
        else if upFromOpen > ibr * 0.3 and dnFromOpen > ibr * 0.3
            openType := "Open-Auction"
        else
            openType := "Test-Drive"

// ============================================================================
// 12b. VOLUME DNA - effort vs result
// ----------------------------------------------------------------------------
// Wyckoff's effort-versus-result read, expressed as two z-scores. Concept from
// Volume DNA: Heatmap [BigBeluga], MPL 2.0 - reimplemented here rather than
// copied, and restored to all four quadrants.
//
// The quadrant that matters most to an auction trader is ABSORPTION: heavy
// volume with a narrow spread means someone is taking everything offered and
// price is not moving. At a value area edge that is a defended level. In the
// middle of value it is just ordinary two-way trade, which is what the
// "only at value area edges" filter is for.
//
// EXHAUSTION - light volume with a wide spread - is the one Gemini's rebuild
// dropped, and it is the live version of what the profile later shows as
// excess: a move travelling on no participation.
// ============================================================================
float volMean = ta.sma(volume, dnaVolLen)
float volStd  = ta.stdev(volume, dnaVolLen)
float volZ    = volStd > 0 ? (volume - volMean) / volStd : 0.0

float spread    = high - low
float sprMean   = ta.sma(spread, dnaSprLen)
float sprStd    = ta.stdev(spread, dnaSprLen)
float spreadZ   = sprStd > 0 ? (spread - sprMean) / sprStd : 0.0

bool dHighVol = volZ >= dnaVolTh
bool dLowVol  = volZ <= -dnaVolTh * 0.3
bool dWideSpr = spreadZ >= dnaSprTh * 0.5
bool dNarrow  = spreadZ <= 0.0

bool rawAbsorb = dHighVol and dNarrow
bool rawEffort = dHighVol and dWideSpr and not rawAbsorb
bool rawExhaust = dLowVol and dWideSpr
bool rawStagn   = dLowVol and not dWideSpr and not rawExhaust

// value area edge filter
bool atEdge = true
if dnaAtEdge
    atEdge := false
    if not na(priorVah) and not na(priorVal)
        float edgeTol = spread * 1.5
        atEdge := math.abs(close - priorVah) <= edgeTol or math.abs(close - priorVal) <= edgeTol

bool dnaAbsorb  = dnaOn and dnaAbsOn and rawAbsorb and atEdge
bool dnaEffortB = dnaOn and dnaEffOn and rawEffort and close >= open and atEdge
bool dnaEffortS = dnaOn and dnaEffOn and rawEffort and close < open and atEdge
bool dnaExhaust = dnaOn and dnaExhOn and rawExhaust and atEdge
bool dnaStagn   = dnaOn and dnaStgOn and rawStagn and atEdge

string dnaState = "-"
color  dnaCol = C_NE
if rawAbsorb
    dnaState := "ABSORPTION"
    dnaCol := cAbs
else if rawEffort
    dnaState := close >= open ? "EFFORT bull" : "EFFORT bear"
    dnaCol := close >= open ? cEffB : cEffS
else if rawExhaust
    dnaState := "EXHAUSTION"
    dnaCol := cExh
else if rawStagn
    dnaState := "Stagnation"
    dnaCol := cStg


// ============================================================================
// 12c. VOLUME DNA VISUALS  -  glow candles, absorption clouds, circles, tape
// ----------------------------------------------------------------------------
// Visual language modelled on Volume DNA: Heatmap [BigBeluga] (MPL 2.0).
// Reimplemented rather than copied.
// ============================================================================
f_volShort(float v) =>
    string outv = str.tostring(int(v))
    if v >= 1000000000
        outv := str.tostring(math.round(v / 1000000000, 1), "#.#") + "B"
    else if v >= 1000000
        outv := str.tostring(math.round(v / 1000000, 1), "#.#") + "M"
    else if v >= 1000
        outv := str.tostring(math.round(v / 1000, 1), "#.#") + "K"
    outv

// THREE MORE UNBOUNDED LEAKS FOUND - same class as the divergence lines and the
// balance boxes. Absorption clouds, DNA circles and bubble labels were each
// created with no array and no deletion. Pine evicts the OLDEST drawing when
// the 500-object cap fills, so on a long chart these were silently pushing out
// the value area, naked POC and IB lines you actually trade off.
var array<box>   absCloudBx = array.new<box>()
var array<label> dnaLblArr  = array.new<label>()
var array<label> bubLblArr  = array.new<label>()

f_pushAbsCloud(box b) =>
    absCloudBx.push(b)
    while absCloudBx.size() > 15
        box.delete(absCloudBx.shift())

f_pushDnaLbl(label l) =>
    dnaLblArr.push(l)
    while dnaLblArr.size() > 40
        label.delete(dnaLblArr.shift())

f_pushBubLbl(label l) =>
    bubLblArr.push(l)
    while bubLblArr.size() > 40
        label.delete(bubLblArr.shift())

bool dnaAny = dnaAbsorb or dnaEffortB or dnaEffortS or dnaExhaust or dnaStagn

float bodyMax = math.max(close, open)
float bodyMin = math.min(close, open)
float glowExp = (high - low) * 0.2

color glowCol = color(na)
if dnaGlow and dnaAny
    glowCol := color.new(dnaCol, 55)

// Ghost glow: a halo drawn just outside the body, additive to your candles.
// GEOMETRY BUG: this was passing open = bodyMax + glowExp with high = bodyMax,
// and low = bodyMin with close = bodyMin - glowExp. open above high and close
// below low is not a candle TradingView can draw, so the halo never appeared.
// The halo is a block spanning the body plus the expansion on both sides, so
// open/high are the top of it and low/close the bottom.
float glowTop = bodyMax + glowExp
float glowBot = bodyMin - glowExp
plotcandle(dnaGlow and dnaAny ? glowTop : na, dnaGlow and dnaAny ? glowTop : na,
     dnaGlow and dnaAny ? glowBot : na, dnaGlow and dnaAny ? glowBot : na,
     title="DNA Ghost Glow", color=glowCol, wickcolor=glowCol, bordercolor=glowCol,
     force_overlay=true)

// The DNA candle recolour was removed. plotcandle costs FOUR plot slots, it is
// off by default, and it overrode your chart colours. The ghost glow above
// carries the same information additively for the same price.

// Absorption cloud - a zone projected forward from where absorption happened.
if dnaCloud and dnaAbsorb and barClosed
    f_pushAbsCloud(box.new(bar_index, bodyMax + (high - low) * 0.1, bar_index + dnaCloudEx, bodyMin - (high - low) * 0.1,
         bgcolor=color.new(cAbs, 85), border_color=color.new(cAbs, 60), border_width=0,
         text="ABS  " + f_volShort(volume), text_color=color.new(cAbs, 20),
         text_size=size.tiny, text_halign=text.align_right, force_overlay=true))

// DNA circles, sized and shaded by how extreme the volume z-score is.
if dnaDots and dnaAny and barClosed
    string dSize = size.tiny
    int dTransp = 60
    if volZ >= 4.0
        dSize := size.large
        dTransp := 0
    else if volZ >= 3.0
        dSize := size.normal
        dTransp := 15
    else if volZ >= 2.0
        dSize := size.small
        dTransp := 35
    f_pushDnaLbl(label.new(bar_index, hl2, "", color=color.new(dnaCol, dTransp), textcolor=color(na),
         style=label.style_circle, size=dSize, force_overlay=true,
         tooltip=dnaState + "\nVol z: " + str.tostring(volZ, "#.##") + "\nSpread z: " + str.tostring(spreadZ, "#.##") + "\nVolume: " + f_volShort(volume)))
    f_pushDnaLbl(label.new(bar_index, hl2, f_volShort(volume), color=color.new(color.black, 100),
         textcolor=chart.fg_color, style=label.style_label_center, size=size.tiny,
         force_overlay=true))

// --- barcode heatmap tape
var array<int>   dnaHist = array.new<int>(dnaTapeRow, 0)
var array<float> dnaVolHist = array.new<float>(dnaTapeRow, 0.0)
int dnaCode = 0
if rawAbsorb
    dnaCode := 1
else if rawEffort
    dnaCode := close >= open ? 2 : 5
else if rawExhaust
    dnaCode := 3
else if rawStagn
    dnaCode := 4

if barstate.isconfirmed
    dnaHist.push(dnaCode)
    dnaVolHist.push(nz(volume))
    while dnaHist.size() > dnaTapeRow
        dnaHist.shift()
        dnaVolHist.shift()

f_dnaCol(int c) =>
    color outc = color.new(#787b86, 70)
    if c == 1
        outc := cAbs
    else if c == 2
        outc := cEffB
    else if c == 5
        outc := cEffS
    else if c == 3
        outc := cExh
    else if c == 4
        outc := cStg
    outc

f_dnaName(int c) =>
    string outn = "-"
    if c == 1
        outn := "ABS"
    else if c == 2
        outn := "EFF+"
    else if c == 5
        outn := "EFF-"
    else if c == 3
        outn := "EXH"
    else if c == 4
        outn := "STG"
    outn

var table tape = table.new(f_tablePos(tapePos), 2, 41, border_width=1,
     border_color=color.new(#000000, 80), frame_color=color.new(#000000, 60),
     frame_width=1, force_overlay=true)

if dnaTape and barstate.islast
    table.cell(tape, 0, 0, "DNA", text_color=color.new(chart.fg_color, 30), text_size=size.tiny,
         bgcolor=color.new(#1e2735, 20))
    table.cell(tape, 1, 0, "VOL", text_color=color.new(chart.fg_color, 30), text_size=size.tiny,
         bgcolor=color.new(#1e2735, 20))
    int hn = dnaHist.size()
    for i = 0 to dnaTapeRow - 1
        int idx = hn - 1 - i
        int cd = idx >= 0 ? dnaHist.get(idx) : 0
        float bv = idx >= 0 ? dnaVolHist.get(idx) : 0.0
        table.cell(tape, 0, i + 1, f_dnaName(cd), text_color=chart.fg_color, text_size=size.tiny,
             bgcolor=color.new(f_dnaCol(cd), cd == 0 ? 88 : 45))
        table.cell(tape, 1, i + 1, f_volShort(bv), text_color=color.new(chart.fg_color, 35),
             text_size=size.tiny, bgcolor=color.new(#1e2735, 55))

// ============================================================================
// 12d. VOLUME BUBBLES - percentile volume clusters
// ----------------------------------------------------------------------------
// Concept from Volume Bubbles [QuantAlgo] (CC BY-NC-SA 4.0), reimplemented.
// A bar qualifies when its volume (and/or absolute delta) clears a percentile
// threshold in enough of three lookback windows. Three tiers, three windows,
// and a consensus vote - the point is that "high volume" should be high
// relative to short, medium AND long history, not just one of them.
// ============================================================================
float absDelta = math.abs(barDelta)

// RUNTIME: each of these sorts its whole lookback window on every bar, and
// there are eighteen of them across three windows and two sources. They ran
// unconditionally - including for everyone with Volume Bubbles switched OFF,
// which is the default. On a long chart that was the single largest block of
// wasted work in the script and the main reason for the "Heavy script" warning.
//
// bubOn is fixed for the whole run (it comes from an input and the preset), so
// the branch is taken identically on every bar. That is the condition under
// which skipping a ta.* call is safe: what makes it unsafe is a condition that
// VARIES bar to bar, because the function then misses the bars it was not
// called on and its window silently desynchronises.
float vSmS = na
float vSmM = na
float vSmL = na
float vMdS = na
float vMdM = na
float vMdL = na
float vBgS = na
float vBgM = na
float vBgL = na
float dSmS = na
float dSmM = na
float dSmL = na
float dMdS = na
float dMdM = na
float dMdL = na
float dBgS = na
float dBgM = na
float dBgL = na

if bubOn
    vSmS := ta.percentile_linear_interpolation(volume, bubShortW, bubSmallP)
    vSmM := ta.percentile_linear_interpolation(volume, bubMidW,   bubSmallP)
    vSmL := ta.percentile_linear_interpolation(volume, bubLongW,  bubSmallP)
    vMdS := ta.percentile_linear_interpolation(volume, bubShortW, bubMedP)
    vMdM := ta.percentile_linear_interpolation(volume, bubMidW,   bubMedP)
    vMdL := ta.percentile_linear_interpolation(volume, bubLongW,  bubMedP)
    vBgS := ta.percentile_linear_interpolation(volume, bubShortW, bubBigP)
    vBgM := ta.percentile_linear_interpolation(volume, bubMidW,   bubBigP)
    vBgL := ta.percentile_linear_interpolation(volume, bubLongW,  bubBigP)
    dSmS := ta.percentile_linear_interpolation(absDelta, bubShortW, bubSmallP)
    dSmM := ta.percentile_linear_interpolation(absDelta, bubMidW,   bubSmallP)
    dSmL := ta.percentile_linear_interpolation(absDelta, bubLongW,  bubSmallP)
    dMdS := ta.percentile_linear_interpolation(absDelta, bubShortW, bubMedP)
    dMdM := ta.percentile_linear_interpolation(absDelta, bubMidW,   bubMedP)
    dMdL := ta.percentile_linear_interpolation(absDelta, bubLongW,  bubMedP)
    dBgS := ta.percentile_linear_interpolation(absDelta, bubShortW, bubBigP)
    dBgM := ta.percentile_linear_interpolation(absDelta, bubMidW,   bubBigP)
    dBgL := ta.percentile_linear_interpolation(absDelta, bubLongW,  bubBigP)

int needVotes = 2
if bubConsen == "Any Window"
    needVotes := 1
else if bubConsen == "All Windows (strictest)"
    needVotes := 3

f_votes(bool a, bool b, bool c) =>
    (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0)

int vSmall = f_votes(volume >= vSmS, volume >= vSmM, volume >= vSmL)
int vMed   = f_votes(volume >= vMdS, volume >= vMdM, volume >= vMdL)
int vBig   = f_votes(volume >= vBgS, volume >= vBgM, volume >= vBgL)
int dSmall = f_votes(absDelta >= dSmS, absDelta >= dSmM, absDelta >= dSmL)
int dMed   = f_votes(absDelta >= dMdS, absDelta >= dMdM, absDelta >= dMdL)
int dBig   = f_votes(absDelta >= dBgS, absDelta >= dBgM, absDelta >= dBgL)

f_qualify(int vv, int dv) =>
    bool volOk = vv >= needVotes
    bool delOk = dv >= needVotes
    bool outq = volOk or delOk
    if bubDetect == "Volume Only"
        outq := volOk
    else if bubDetect == "Delta Only"
        outq := delOk
    else if bubDetect == "Volume + Delta"
        outq := volOk and delOk
    outq

bool qSmall = bubOn and bubSmallOn and f_qualify(vSmall, dSmall)
bool qMed   = bubOn and bubMedOn   and f_qualify(vMed,   dMed)
bool qBig   = bubOn and bubBigOn   and f_qualify(vBig,   dBig)

// Hoisted to global scope: ta.sma must run on every bar, not only on bars where
// a bubble happens to qualify, or its moving average drifts out of step.
float bubVolAvg = ta.sma(volume, bubMidW)
float volRatio  = bubVolAvg > 0 ? volume / bubVolAvg : 0.0

bool candleBuy = close >= open
bool deltaBuy  = barDelta > 0
bool bubIsBuy  = candleBuy
bool bubIsSell = not candleBuy
bool bubIsMix  = false
if bubClass == "Delta Direction"
    bubIsBuy := deltaBuy
    bubIsSell := not deltaBuy
else if bubClass == "Both"
    bubIsBuy  := candleBuy and deltaBuy
    bubIsSell := not candleBuy and not deltaBuy
    bubIsMix  := not bubIsBuy and not bubIsSell

color bubCol = bubMixCol
if bubIsBuy
    bubCol := bubBuyCol
else if bubIsSell
    bubCol := bubSellCol

bool bubAny = qSmall or qMed or qBig
float bubY = bubAny ? (bubIsSell ? high : low) : na

// Circles sized by tier, exactly as the original stacks them.
// Small and medium tiers share one plot. The tier is still in the tooltip; the
// visual distinction that matters is big versus not-big.
plotshape((qSmall or qMed) and not qBig ? bubY : na, "Bubble Small/Medium", shape.circle,
     location.absolute, bubCol, size=size.small, force_overlay=true)
plotshape(qBig ? bubY : na, "Bubble Big", shape.circle,
     location.absolute, bubCol, size=size.normal, force_overlay=true)

if bubAny and bubLabels and barClosed
    string fv = f_volShort(volume)
    string fd = (barDelta >= 0 ? "+" : "-") + f_volShort(absDelta)
    string bTxt = fv
    if bubText == "Delta"
        bTxt := fd
    else if bubText == "Ratio"
        bTxt := str.tostring(volRatio, "#.##") + "x"
    else if bubText == "Vol + Delta"
        bTxt := fv + "\n" + fd
    else if bubText == "Vol + Ratio"
        bTxt := fv + "\n" + str.tostring(volRatio, "#.##") + "x"

    string tier = qBig ? "BIG" : qMed ? "MEDIUM" : "SMALL"
    string side = bubIsBuy ? "BUY" : bubIsSell ? "SELL" : "MIXED"
    f_pushBubLbl(label.new(bar_index, bubY, bTxt, style=label.style_label_center,
         color=color.new(chart.fg_color, 100), textcolor=chart.fg_color, size=size.small,
         force_overlay=true,
         tooltip="-- " + tier + " " + side + " --\nVolume: " + fv + "\nDelta: " + fd +
              "\nRatio: " + str.tostring(volRatio, "#.##") + "x" +
              "\nMethod: " + bubDetect + "\nDNA: " + dnaState))



// ============================================================================
// 12d2. HIGHER TIMEFRAME VALUE
// ----------------------------------------------------------------------------
// A slower profile running beside the main one. The period profile answers
// "where is value today". This answers "where is value this week" - which is
// what tells you whether today's balance is itself sitting high or low inside
// a larger auction. Balance at the top of weekly value is a very different
// trade from balance at the bottom of it.
//
// Deliberately built from CHART bars, not intrabar: a week of 15m bars is 672
// points already, well past what a profile needs, and it keeps this cheap.
// ============================================================================
var array<float> hH = array.new<float>()
var array<float> hL = array.new<float>()
var array<float> hV = array.new<float>()

var float htfPoc = na
var float htfVah = na
var float htfVal = na
var bool  htfFirstDone = false

bool htfOn = htfMode != "Off"
// Deliberately NOT resolved through the preset. Everything else on the chart is
// a level or a reading at a price; this is a second chart sitting beside the
// first, and how much room that is worth is a per-trader call, not a busyness
// setting. It stays exactly where you put it on every preset.
bool htfcOn = htfcOn_in
bool htfNew = false
if htfMode == "Daily"
    htfNew := chgD
else if htfMode == "Weekly"
    htfNew := chgW
else if htfMode == "Monthly"
    htfNew := timeframe.change("M")

if htfOn and htfNew and barClosed
    [gPoc, gVah, gVal, gHi, gLo, gOk, gBins, gBinsU] = f_profile(hH, hL, hV, noSplit, profRows, vaPct)
    if gOk and htfFirstDone
        htfPoc := gPoc
        htfVah := gVah
        htfVal := gVal
    htfFirstDone := true
    hH.clear()
    hL.clear()
    hV.clear()

if htfOn and barClosed
    hH.push(high)
    hL.push(low)
    hV.push(nz(volume))

while hH.size() > 6000
    hH.shift()
    hL.shift()
    hV.shift()

// developing HTF value, so the levels are live rather than a week stale
float htfDevPoc = na
float htfDevVah = na
float htfDevVal = na
if htfOn and barstate.islast
    // Same forming-bar hole as the developing period profile, and on a Daily
    // chart with Weekly HTF value the week only ever holds seven samples, so
    // one missing bar is a seventh of the evidence.
    array<float> kH = hH.copy()
    array<float> kL = hL.copy()
    array<float> kV = hV.copy()
    if not barClosed
        if htfNew
            kH.clear()
            kL.clear()
            kV.clear()
        kH.push(high)
        kL.push(low)
        kV.push(nz(volume))
    [kPoc, kVah, kVal, kHi, kLo, kOk, kBins, kBinsU] = f_profile(kH, kL, kV, noSplit, profRows, vaPct)
    if kOk
        htfDevPoc := kPoc
        htfDevVah := kVah
        htfDevVal := kVal

var line lnHPoc = na
var line lnHVah = na
var line lnHVal = na

// THE LINES MUST BE THE LEVELS THE ENGINE USES. The signal gate was moved to
// htfVah / htfVal - the last COMPLETED higher-timeframe value area, the only
// version that exists on every bar - but the lines and their labels were still
// drawing htfDevVah / htfDevVal, the developing one. Those are different
// prices. You would watch price reject a line marked "Weekly VAL" and get no
// signal, because the engine was testing a level that was never drawn.
//
// The completed value area is also the conventional reference: it is to the
// week what prior VAH / VAL is to the day. The developing read still has a
// home - the dashboard row, which says so explicitly.
if htfOn and barstate.islast and not na(htfPoc)
    int htL = na(periodStart) ? time : periodStart
    // same degenerate-line guard as the auction block below
    if htL >= time
        htL := na(time[1]) ? time - 60000 : time[1]
    if na(lnHPoc)
        lnHPoc := line.new(htL, htfPoc, time, htfPoc, xloc=xloc.bar_time, color=cHtfPoc, width=2, extend=extend.right, force_overlay=true)
        lnHVah := line.new(htL, htfVah, time, htfVah, xloc=xloc.bar_time, color=cHtfVa, width=1, extend=extend.right, force_overlay=true)
        lnHVal := line.new(htL, htfVal, time, htfVal, xloc=xloc.bar_time, color=cHtfVa, width=1, extend=extend.right, force_overlay=true)
    else
        line.set_xy1(lnHPoc, htL, htfPoc)
        line.set_xy2(lnHPoc, time, htfPoc)
        line.set_xy1(lnHVah, htL, htfVah)
        line.set_xy2(lnHVah, time, htfVah)
        line.set_xy1(lnHVal, htL, htfVal)
        line.set_xy2(lnHVal, time, htfVal)

// ============================================================================
// 12d2. HTF CANDLES
// ----------------------------------------------------------------------------
// The higher-timeframe candles, drawn beside the chart, newest one still
// forming. Built from the chart's own bars - a running open / high / low since
// the last timeframe.change - rather than from request.security.
//
// That is the important decision. The usual way to do this is fifteen
// request.security calls for high[1], low[1], open[1] and so on with
// lookahead_on, which is correct but is fifteen data requests, and the moment
// anyone drops the [1] offset it starts showing the future. Accumulating from
// chart bars cannot repaint, cannot leak the future, costs no requests, and
// works on every TradingView plan. The only thing it cannot do is show a
// candle from before the chart's own history begins.
//
// Scalars here are var, and Pine restores var scalars at the start of every
// realtime recalculation, so the live high and low track the tick correctly.
// The completed-candle ARRAYS do not roll back, which is why the push that
// fills them is the one thing gated on barClosed.
// ============================================================================
var array<float> hcO = array.new<float>()
var array<float> hcH = array.new<float>()
var array<float> hcL = array.new<float>()
var array<float> hcC = array.new<float>()

var float hcLiveO = na
var float hcLiveH = na
var float hcLiveL = na
var int   hcOpenBar = na
var int   hcHiBar   = na
var int   hcLoBar   = na

var array<box>   hcBoxes  = array.new<box>()
var array<line>  hcLines  = array.new<line>()
var array<label> hcLabels = array.new<label>()

bool hcNew = htfcOn and timeframe.change(htfcTf)

if htfcOn
    if hcNew
        // The bar that opens a new HTF period is the bar AFTER the old one
        // closed, so the candle just finished closed at close[1].
        if barClosed and not na(hcLiveO)
            hcO.push(hcLiveO)
            hcH.push(hcLiveH)
            hcL.push(hcLiveL)
            hcC.push(close[1])
            while hcO.size() > htfcCount - 1
                hcO.shift()
                hcH.shift()
                hcL.shift()
                hcC.shift()
        hcLiveO   := open
        hcLiveH   := high
        hcLiveL   := low
        hcOpenBar := bar_index
        hcHiBar   := bar_index
        hcLoBar   := bar_index
    else
        if high > nz(hcLiveH, high)
            hcLiveH := high
            hcHiBar := bar_index
        if low < nz(hcLiveL, low)
            hcLiveL := low
            hcLoBar := bar_index
        if na(hcLiveO)
            // first bars of the chart, before any period boundary has been seen
            hcLiveO   := open
            hcLiveH   := high
            hcLiveL   := low
            hcOpenBar := bar_index
            hcHiBar   := bar_index
            hcLoBar   := bar_index

// Moved into a function to keep the main body under Pine's size cap.
f_drawHtfCandles() =>
    for b in hcBoxes
        box.delete(b)
    hcBoxes.clear()
    for l in hcLines
        line.delete(l)
    hcLines.clear()
    for lb in hcLabels
        label.delete(lb)
    hcLabels.clear()

    if htfcOn and not na(hcLiveO)
        int hcDone = hcO.size()
        int hcSlot = htfcWidth + htfcGap
        int hcHalf = math.max(1, int(htfcWidth / 2))

        // Pine will not place a drawing more than 500 bars beyond the last one,
        // and at the widest settings this row would reach 760 - ten candles,
        // fifty bars apart, starting three hundred bars out. So work out how
        // many actually FIT and drop the oldest, rather than letting the far end
        // of the row fail. The live candle is the one that matters, so it is the
        // one always kept.
        int hcRoom = math.max(0, 480 - htfcOffset - htfcWidth)
        int hcFit  = math.max(1, int(hcRoom / hcSlot) + 1)
        int hcAll  = math.min(hcDone + 1, hcFit)
        int hcSkip = hcDone + 1 - hcAll
        int hcLiveX = bar_index + htfcOffset + (hcAll - 1) * hcSlot

        for k = 0 to hcAll - 1
            int   src    = k + hcSkip
            bool  isLive = src >= hcDone
            float cO = isLive ? hcLiveO : hcO.get(src)
            float cH = isLive ? hcLiveH : hcH.get(src)
            float cL = isLive ? hcLiveL : hcL.get(src)
            float cC = isLive ? close   : hcC.get(src)
            int   xc = bar_index + htfcOffset + k * hcSlot
            color col = cC >= cO ? cHtfcUp : cHtfcDn

            // A vertical line - x1 == x2 with different y - is fine. What is
            // NOT fine is x1 == x2 together with extend.right, which has no
            // defined slope and renders as a vertical line that drags the
            // price scale. That was the mystery red line on the nPOCs. No
            // extend here, so this is a wick and nothing else.
            if cH > cL
                hcLines.push(line.new(xc, cH, xc, cL, xloc=xloc.bar_index,
                     color=cHtfcWick, width=1, force_overlay=true))

            // A candle that opened and closed on the same tick has no body and
            // would draw as nothing at all, so it gets a one-tick doji instead.
            float bT = math.max(cO, cC)
            float bB = math.min(cO, cC)
            if bT <= bB
                bT := bT + syminfo.mintick
                bB := bB - syminfo.mintick
            hcBoxes.push(box.new(xc - hcHalf, bT, xc + hcHalf, bB, bgcolor=col,
                 border_color=col, force_overlay=true))

        // --- rays from where the live open, high and low were actually made
        if htfcRays
            int rayTo = hcLiveX + hcHalf
            // Drawing coordinates cannot reach further back than max_bars_back,
            // and a daily candle on a 1m chart is well over a thousand bars, so
            // the anchor is clamped rather than left to fail silently.
            int rayMin = bar_index - 480
            hcLines.push(line.new(math.max(rayMin, nz(hcHiBar, bar_index)), hcLiveH, rayTo, hcLiveH,
                 xloc=xloc.bar_index, color=cHtfcRay, style=line.style_dotted, force_overlay=true))
            hcLines.push(line.new(math.max(rayMin, nz(hcLoBar, bar_index)), hcLiveL, rayTo, hcLiveL,
                 xloc=xloc.bar_index, color=cHtfcRay, style=line.style_dotted, force_overlay=true))
            hcLines.push(line.new(math.max(rayMin, nz(hcOpenBar, bar_index)), hcLiveO, rayTo, hcLiveO,
                 xloc=xloc.bar_index, color=cHtfcRay, style=line.style_dashed, force_overlay=true))

        if htfcLbl
            float hcRng = hcLiveH - hcLiveL
            // Where the close sits inside the candle's own range. This is the
            // reading: 90% is closing on the high with the low rejected, 10% is
            // the reverse. The percent change alone cannot tell those apart.
            float hcPos = hcRng > 0 ? (close - hcLiveL) / hcRng * 100 : 50.0
            float hcChg = hcLiveO != 0 ? (close - hcLiveO) / hcLiveO * 100 : 0.0
            hcLabels.push(label.new(hcLiveX + hcHalf + 1, hcLiveH, htfcTf + "  " +
                 (hcChg >= 0 ? "+" : "") + str.tostring(hcChg, "#.##") + "%\nclose " +
                 str.tostring(hcPos, "#") + "% of range",
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=color.new(chart.bg_color, 15),
                 textcolor=close >= hcLiveO ? cHtfcUp : cHtfcDn,
                 size=size.tiny, force_overlay=true))

if barstate.islast
    f_drawHtfCandles()

// where does today's value sit inside the bigger auction?
string htfPos = "n/a"
if htfOn and not na(htfDevVah) and not na(htfDevVal)
    if close > htfDevVah
        htfPos := "above " + htfMode + " value"
    else if close < htfDevVal
        htfPos := "below " + htfMode + " value"
    else
        htfPos := "inside " + htfMode + " value"

// ============================================================================
// 12e. VWAP  (anchored, with standard deviation bands)
// ----------------------------------------------------------------------------
// VWAP asks the same question the POC does - where was the bulk of trade - but
// continuously rather than once per period. Anchoring it to the auction period
// makes VWAP and POC directly comparable: when they diverge, value is still
// moving; when they converge, the auction has settled.
// ============================================================================
bool vwapReset = false
if vwapAnchor == "Auction Period"
    vwapReset := isNewPeriod
else if vwapAnchor == "Daily"
    vwapReset := chgD
else if vwapAnchor == "Weekly"
    vwapReset := chgW
else
    vwapReset := chgS

var float vwSumPV  = 0.0
var float vwSumV   = 0.0
var float vwSumPV2 = 0.0

// Same session leak as the running range above. Anchored to the auction period
// in RTH mode, this was still adding every overnight bar, so what the chart
// called the session VWAP was really a rolling 24-hour VWAP wearing a session
// label - and its bands are signal LOCATIONS, so the error reached the trades.
// The other anchors mean what they say and are left alone: if you asked for a
// daily VWAP on an RTH chart, overnight volume belongs in it.
bool vwapAccum = vwapAnchor != "Auction Period" or inPeriod

float vwSrc = hlc3
float vwVol = nz(volume)
if vwapReset
    vwSumPV  := vwSrc * vwVol
    vwSumV   := vwVol
    vwSumPV2 := vwSrc * vwSrc * vwVol
else if vwapAccum
    vwSumPV  := vwSumPV + vwSrc * vwVol
    vwSumV   := vwSumV + vwVol
    vwSumPV2 := vwSumPV2 + vwSrc * vwSrc * vwVol

float vwapVal = vwSumV > 0 ? vwSumPV / vwSumV : na
float vwapVar = vwSumV > 0 ? vwSumPV2 / vwSumV - vwapVal * vwapVal : 0.0
float vwapSd  = vwapVar > 0 ? math.sqrt(vwapVar) : 0.0

float vwapU1 = vwapVal + vwapSd * vwapMult1
float vwapL1 = vwapVal - vwapSd * vwapMult1
float vwapU2 = vwapVal + vwapSd * vwapMult2
float vwapL2 = vwapVal - vwapSd * vwapMult2

plot(vwapOn ? vwapVal : na, "VWAP", color=cVwap, linewidth=2, force_overlay=true)
plot(vwapOn and vwapBands ? vwapU1 : na, "VWAP +1sd", color=cVwapBand, force_overlay=true)
plot(vwapOn and vwapBands ? vwapL1 : na, "VWAP -1sd", color=cVwapBand, force_overlay=true)
// The 2-sigma bands were removed. Every force_overlay plot costs TWO of the 64
// slots (one in the pane, one on the price chart), so these two were worth four
// - more than the profile histogram - for the least-used levels on the chart.
// vwapU2 / vwapL2 still exist and still feed the risk layer's target list.

// ============================================================================
// 12f. FIB LEVELS  -  golden pockets and custom targets
// ----------------------------------------------------------------------------
// Drawn with line objects rather than plots, so the whole section costs zero of
// the 64 plot slots.
//
// Worth being clear about what these are: fib levels are geometry, not auction
// evidence. They carry no volume information at all. Where they earn their
// place is confluence - a 0.618 that lands on the POC or on a naked POC is
// worth more than either alone, and a 0.618 sitting in empty space is just a
// line. Judge them against the profile, not instead of it.
// ============================================================================
var array<line>  fibLines  = array.new<line>()
var array<label> fibLabels = array.new<label>()

// THE LEG IS THE WINDOW'S OWN EXTREMES, NOT A PAIR OF CONFIRMED PIVOTS.
//
// Two rewrites of this block chased the same symptom and both missed. First it
// was two independent "most recent pivot" values, which do not alternate, so one
// anchor went stale for hundreds of bars. Then it was an alternating pivot leg
// with a running extreme bolted on, plus a rule that voided the leg once price
// retraced past 100%. That rule is correct in theory and useless in practice:
// on any chart where price has run beyond the last confirmed swing origin - a
// completely ordinary thing for price to do - it deleted the fibs entirely.
// Drawing nothing is worse than drawing a stale level, because there is nothing
// left to judge.
//
// The mistake in all three was using ta.pivothigh/ta.pivotlow at all. A pivot
// cannot be confirmed until Pivot Strength bars have printed to its RIGHT, so
// the leg's endpoint is structurally behind the market - fifteen bars behind at
// the old default, three weeks on a daily chart - and no amount of patching
// downstream can put back information the anchor does not have yet.
//
// A fib needs two numbers: where the move started and how far it has got. Both
// are simply the extremes of the recent window. The more RECENT extreme is the
// far end of the move, the other is its origin, and that pair cannot go stale,
// cannot be voided by a breach, and re-anchors by itself the moment price makes
// a new extreme. It is also what an auto-fib tool does, and what a chartist
// does by hand.
//
// Computed on EVERY bar, so the levels exist on historical bars too. That is
// what makes them legal to feed the confluence count: a level that only existed
// on the live bar would let the live bar pass a gate no historical bar could.
//
// Clamped to 480 because max_bars_back is 500. The input allows up to 1000, and
// asking ta.highest for more history than the script reserved is a runtime
// error, not a silent shrug.
int   fibLen = math.min(gpLookback, 480)
float winHi  = ta.highest(high, fibLen)
float winLo  = ta.lowest(low, fibLen)
// These come back as offsets <= 0. Closer to zero is more recent.
int   hiOff  = ta.highestbars(high, fibLen)
int   loOff  = ta.lowestbars(low, fibLen)

// The leg runs from the OLDER extreme to the NEWER one, and the pullback comes
// back from the newer one towards the older. Expressed that way a single
// formula covers both directions - level = to + (from - to) * ratio.
float gpFrom  = na
float gpTo    = na
bool  gpLive  = false
bool  hiNewer = false
if not na(winHi) and not na(winLo) and not na(hiOff) and not na(loOff)
    hiNewer := hiOff > loOff
    gpFrom  := hiNewer ? winLo : winHi
    gpTo    := hiNewer ? winHi : winLo
    // A high and a low three bars apart is noise, not a leg. This is the only
    // thing Pivot Strength was ever really buying, so the input keeps its slot
    // and now does the job directly instead of through a lagging pivot.
    gpLive  := math.abs(gpTo - gpFrom) > syminfo.mintick and math.abs(hiOff - loOff) >= gpMinLeg

f_fibAt(float ratio) =>
    gpLive ? gpTo + (gpFrom - gpTo) * ratio : na

float gpF5   = f_fibAt(0.5)
float gpF618 = f_fibAt(0.618)
float gpF786 = f_fibAt(0.786)
float gpF886 = f_fibAt(0.886)

// A 2.64 extension of a large swing can land tens of thousands of points away,
// or below zero. Drawing it forces the price scale to include it and the chart
// becomes unusable. Anything at or below zero, or beyond fibMaxDist% of price,
// is not drawn at all.
f_fibLine(float y, color c, string txt, int x1, int x2, bool dashed) =>
    bool sane = false
    if not na(y)
        if y > 0
            if math.abs(y - close) / close * 100 <= fibMaxDist
                sane := true
    if sane
        line ln = line.new(x1, y, x2, y, xloc=xloc.bar_index, color=c, width=1,
             style=dashed ? line.style_dashed : line.style_solid, force_overlay=true)
        fibLines.push(ln)
        fibLabels.push(label.new(x2, y, txt, xloc=xloc.bar_index, style=label.style_label_left,
             color=color.new(c, 100), textcolor=c, size=size.tiny, force_overlay=true))

// Moved into a function to keep the main body under Pine's size cap.
f_drawFibs() =>
    for l in fibLines
        line.delete(l)
    fibLines.clear()
    for lb in fibLabels
        label.delete(lb)
    fibLabels.clear()

    if gpLive
        int x1 = math.max(bar_index - 480, bar_index + math.min(hiOff, loOff))
        int x2 = bar_index + gpExtend

        if gpOn
            f_fibLine(gpF5,   cGp5,   "0.5",   x1, x2, false)
            f_fibLine(gpF618, cGp618, "0.618", x1, x2, false)
            f_fibLine(gpF786, cGp786, "0.786", x1, x2, false)
            f_fibLine(gpF886, cGp886, "0.886", x1, x2, true)

        if fibTgtOn
            // Same to/from formula. A ratio above 1 lands beyond the far side of
            // the leg, a negative ratio beyond the near side - which is what the
            // original set was reaching for.
            f_fibLine(f_fibAt(1.47),  cFibTgt, "1.47",  x1, x2, true)
            f_fibLine(f_fibAt(1.55),  cFibTgt, "1.55",  x1, x2, true)
            f_fibLine(f_fibAt(2.56),  cFibTgt, "2.56",  x1, x2, true)
            // 2.60 and -0.23 are named in the input tooltip but were never
            // drawn, so the documented set and the actual set disagreed.
            f_fibLine(f_fibAt(2.60),  cFibTgt, "2.60",  x1, x2, true)
            f_fibLine(f_fibAt(2.64),  cFibTgt, "2.64",  x1, x2, true)
            f_fibLine(f_fibAt(-0.20), cFibTgt, "-0.20", x1, x2, true)
            f_fibLine(f_fibAt(-0.23), cFibTgt, "-0.23", x1, x2, true)
            f_fibLine(f_fibAt(-0.29), cFibTgt, "-0.29", x1, x2, true)

if barstate.islast
    f_drawFibs()


// ============================================================================
// 12g. LINE LABELS + PLAIN-ENGLISH READ
// ----------------------------------------------------------------------------
// A line with no name is a line you have to remember. Every level drawn by this
// script now writes what it is beside itself, and the guidance label at the top
// says what the auction is doing in words rather than leaving you to assemble
// it from a dashboard.
// ============================================================================
var array<label> lvlLabels = array.new<label>()
// Widest stagger column actually used this bar. The plain-English read sits to
// the right of the labels, so it has to clear however far they spread.
var int labMaxColUsed = 0

// Labels are queued first, then drawn in one pass sorted by price. That lets
// clustered levels be nudged apart instead of stacking on top of each other,
// which is what made VWAP / IB / prior POC unreadable when they sat within a
// few ticks of one another.
var array<float>  qY = array.new<float>()
var array<string> qT = array.new<string>()
var array<color>  qC = array.new<color>()

f_lblSize() =>
    switch lblSizeIn
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

f_queue(float y, string nm, color c) =>
    if lblOn and not na(y)
        string txt = nm
        if lblStyle == "Name + Price"
            txt := nm + "  " + str.tostring(y, format.mintick)
        else if lblStyle == "Price Only"
            txt := str.tostring(y, format.mintick)
        qY.push(y)
        qT.push(txt)
        qC.push(c)

// One ATR series, not two. This and the risk layer both wanted ta.atr(14) and
// each declared its own, so the whole calculation ran twice per bar.
float atr14 = ta.atr(14)

// Moved into a function to keep the main body under Pine's size cap.
f_drawLabels() =>
    for lb in lvlLabels
        label.delete(lb)
    lvlLabels.clear()
    qY.clear()
    qT.clear()
    qC.clear()

    if aucOn
        if devOk
            f_queue(devVah, "VAH  value area high", cVa)
            f_queue(devPoc, "POC  point of control", cPoc)
            f_queue(devVal, "VAL  value area low", cVa)
        if showPrior and not na(priorPoc)
            f_queue(priorVah, "prior VAH", cPrior)
            f_queue(priorPoc, "prior POC", cPrior)
            f_queue(priorVal, "prior VAL", cPrior)
        if showPrHL and not na(priorHi)
            f_queue(priorHi, "prior HIGH", cPrHL)
            f_queue(priorLo, "prior LOW", cPrHL)
        if showIB and not na(ibH)
            f_queue(ibH, "IB high  initial balance", cIB)
            f_queue(ibL, "IB low  initial balance", cIB)
    if gexOn
        f_queue(f_gx(gexCall),  "CALL WALL", cGexRes)
        f_queue(f_gx(gexCall2), "call wall 2", cGexRes)
        f_queue(f_gx(gexPut),   "PUT WALL", cGexSup)
        f_queue(f_gx(gexPut2),  "put wall 2", cGexSup)
        f_queue(f_gx(gexFlip),  "GAMMA FLIP", cGexFlip)
        f_queue(f_gx(gexHvl),   "HVL", cGexFlip)
        if showNpoc and npocs.size() > 0
            for i = 0 to npocs.size() - 1
                float np = npocs.get(i).price
                if math.abs(np - close) / close * 100 <= npocMaxDist
                    f_queue(np, "nPOC  untested", cNpoc)
        if showLvn and devOk and lvnLines.size() > 0
            for i = 0 to lvnLines.size() - 1
                f_queue(line.get_y1(lvnLines.get(i)), "LVN  thin, price moves fast", cLvn)
    if vwapOn and not na(vwapVal)
        f_queue(vwapVal, "VWAP", cVwap)
    if htfOn and not na(htfPoc)
        f_queue(htfVah, "prior " + htfMode + " VAH", cHtfVa)
        f_queue(htfPoc, "prior " + htfMode + " POC", cHtfPoc)
        f_queue(htfVal, "prior " + htfMode + " VAL", cHtfVa)

    // Draw in ascending price order, stepping colliding labels SIDEWAYS.
    //
    // This used to nudge them up the price axis instead, and that could not
    // work: to clear its neighbour a label has to move a whole label HEIGHT,
    // which is a pixel quantity, while the nudge was 0.45 ATR, which is a price
    // quantity. On a 1m gold chart 0.45 ATR is a few cents - invisible - so the
    // labels still sat on top of each other, which is exactly what IB low,
    // prior POC and VWAP were doing. Raising it would have fixed the overlap by
    // pointing the label at a price the level is not at.
    //
    // Sideways has unlimited room and never lies about the price, so the
    // hairline marker that used to point back at the true level is gone too -
    // every label now sits exactly on its own level.
    int maxCol = 0
    if qY.size() > 0
        // NOT named "order" - that is a reserved Pine namespace (order.ascending)
        array<int> sortIdx = qY.sort_indices(order.ascending)
        float labTol = atr14 * labTolATR
        float lastY = na
        int   col   = 0
        for k = 0 to sortIdx.size() - 1
            int idx = sortIdx.get(k)
            float y = qY.get(idx)
            // Compared against the PREVIOUS label's price, not the previous
            // column's, so a run of three tight levels keeps stepping right.
            if not na(lastY) and y - lastY < labTol
                col := col >= labMaxCols - 1 ? 0 : col + 1
            else
                col := 0
            lastY := y
            maxCol := math.max(maxCol, col)

            // style_label_left seats the box to the RIGHT of its anchor, so the
            // anchor is the level itself. The opaque background is what keeps
            // the line from striking through the text.
            lvlLabels.push(label.new(bar_index + lblOffset + col * labSpacing, y, qT.get(idx),
                 xloc=xloc.bar_index, style=label.style_label_left,
                 color=labSolid ? chart.bg_color : color.new(qC.get(idx), 88),
                 textcolor=qC.get(idx),
                 size=f_lblSize(), force_overlay=true))
    maxCol

if barstate.islast
    labMaxColUsed := f_drawLabels()

// ============================================================================
// 13. AUCTION DRAWING  (force_overlay puts these on the PRICE chart)
// ============================================================================
// Moved into a function to keep the main body under Pine's size cap.
// One guarded line push, so the six gamma levels do not become twelve
// statements of "if not na" in a function that is already long.
f_gexLine(float y, color c, int tL, int tR, int w, string st) =>
    if not na(y)
        aucLn.push(line.new(tL, y, tR, y, xloc=xloc.bar_time, color=c, width=w,
             style=st, extend=extend.right, force_overlay=true))

f_drawAuction() =>
    int tR = time
    int tL = na(periodStart) ? time : periodStart

    // THE VERTICAL GREY LINE - FOUND.
    // Every one of these levels is drawn with extend=extend.right. When x1 and
    // x2 are the SAME timestamp the line has no slope, and Pine renders a
    // zero-length extended line VERTICALLY, straight down the chart.
    //
    // periodStart is set to `time` on every new period. On a DAILY chart with
    // "24h UTC" mode every bar IS a new period, so periodStart == time on the
    // last bar and tL == tR. That is why it only appeared on daily, on both BTC
    // and gold, and vanished when the indicator was switched off.
    //
    // Same root cause as the naked POC and LVN lines I fixed earlier; I patched
    // those two and missed this block, which draws POC, VAH, VAL, prior value,
    // prior high/low and the initial balance.
    if tL >= tR
        tL := na(time[1]) ? time - 60000 : time[1]

    for l in aucLn
        line.delete(l)
    aucLn.clear()

    if devOk
        aucLn.push(line.new(tL, devPoc, tR, devPoc, xloc=xloc.bar_time, color=cPoc, width=2, extend=extend.right, force_overlay=true))
        aucLn.push(line.new(tL, devVah, tR, devVah, xloc=xloc.bar_time, color=cVa, style=line.style_dashed, extend=extend.right, force_overlay=true))
        aucLn.push(line.new(tL, devVal, tR, devVal, xloc=xloc.bar_time, color=cVa, style=line.style_dashed, extend=extend.right, force_overlay=true))

    if showPrior and not na(priorPoc)
        aucLn.push(line.new(tL, priorPoc, tR, priorPoc, xloc=xloc.bar_time, color=cPrior, width=2, extend=extend.right, force_overlay=true))
        aucLn.push(line.new(tL, priorVah, tR, priorVah, xloc=xloc.bar_time, color=cPrior, style=line.style_dotted, extend=extend.right, force_overlay=true))
        aucLn.push(line.new(tL, priorVal, tR, priorVal, xloc=xloc.bar_time, color=cPrior, style=line.style_dotted, extend=extend.right, force_overlay=true))

    if showPrHL and not na(priorHi)
        aucLn.push(line.new(tL, priorHi, tR, priorHi, xloc=xloc.bar_time, color=cPrHL, extend=extend.right, force_overlay=true))
        aucLn.push(line.new(tL, priorLo, tR, priorLo, xloc=xloc.bar_time, color=cPrHL, extend=extend.right, force_overlay=true))

    if showIB and not na(ibH) and not na(ibL)
        aucLn.push(line.new(tL, ibH, tR, ibH, xloc=xloc.bar_time, color=cIB, extend=extend.right, force_overlay=true))
        aucLn.push(line.new(tL, ibL, tR, ibL, xloc=xloc.bar_time, color=cIB, extend=extend.right, force_overlay=true))

    // Gamma levels. Drawn thick because they are strikes - a single price, not
    // a band - and a wall you cannot see at a glance is not doing its job.
    if gexOn
        f_gexLine(f_gx(gexCall),  cGexRes,  tL, tR, 2, line.style_solid)
        f_gexLine(f_gx(gexCall2), cGexRes,  tL, tR, 1, line.style_dotted)
        f_gexLine(f_gx(gexPut),   cGexSup,  tL, tR, 2, line.style_solid)
        f_gexLine(f_gx(gexPut2),  cGexSup,  tL, tR, 1, line.style_dotted)
        f_gexLine(f_gx(gexFlip),  cGexFlip, tL, tR, 2, line.style_dashed)
        f_gexLine(f_gx(gexHvl),   cGexFlip, tL, tR, 1, line.style_dashed)

    for b in histBoxes
        box.delete(b)
    histBoxes.clear()
    for l in histLines
        line.delete(l)
    histLines.clear()

    if showHist and devOk and devHi > devLo
        // --- how wide, in bars
        // Percent of the period's own bar count, so the profile is the same
        // visual size on a 1m chart as on a 4h one.
        int perBars = profRolling ? profLook : math.max(1, bar_index - periodStartBar + 1)
        // Floored at 10 bars: on a high timeframe a period is only a handful of
        // bars, and 34% of six bars is two bars wide - correct by the formula and
        // useless on screen.
        int histWidth = math.max(10, math.min(300, int(math.round(perBars * histWidthPct / 100.0))))

        // --- how many rows can actually be DRAWN
        // Pine gives the whole script 500 boxes and, separately, 500 lines, and
        // silently deletes the OLDEST of a type when its pool fills. A profile
        // that overruns does not fail loudly - it eats the balance areas, CME
        // gaps, session boxes, naked POCs and divergence lines drawn before it.
        //
        // So the row is a BOX (total volume) and the dominant side drawn over it
        // is a LINE. Two different pools, one object each, and 250 rows fits in
        // both with room to spare. The reserves below are the real caps of every
        // other feature rather than a guessed number, so raising Max Naked POCs
        // or Max Divergence Lines correctly takes rows away from the profile
        // instead of quietly evicting them.
        int boxReserve  = 15 + balBins + 2 + cmeKeep + sessKeep * 3 + 20 + (htfcOn ? htfcCount : 0)
        int lineReserve = maxNpoc + maxLvn + divMaxLines + 60 + (htfcOn ? htfcCount + 3 : 0) + (ofOn and ofDraw ? ofAbsKeep : 0) + (gexOn ? 6 : 0)
        int boxRoom     = math.max(60, 500 - boxReserve)
        int lineRoom    = math.max(60, 500 - lineReserve)
        int cap         = histSplitUD ? math.min(boxRoom, lineRoom) : boxRoom

        // Rows beyond that are MERGED for drawing only. The profile is still
        // COMPUTED at full resolution, so the POC, value area and LVNs never
        // change with this.
        int drawRows = math.min(profRows, cap)
        int merge    = int(math.ceil(profRows / float(drawRows)))
        drawRows    := int(math.ceil(profRows / float(merge)))

        float step  = (devHi - devLo) / profRows
        float dStep = step * merge
        // The empty sliver above and below each bar. This is what separates the
        // rows visually - without it 250 rows render as one solid mass.
        float pad   = dStep * (1.0 - histRowFill / 100.0) / 2.0

        // --- merge the computed bins down to the drawn rows
        array<float> dTot = array.new<float>(drawRows, 0.0)
        array<float> dUp  = array.new<float>(drawRows, 0.0)
        for lvl = 0 to profRows - 1
            int dRow = math.min(drawRows - 1, int(lvl / merge))
            dTot.set(dRow, dTot.get(dRow) + devBins.get(lvl))
            dUp.set(dRow, dUp.get(dRow) + devBinsUp.get(lvl))

        float mx = dTot.max()
        if mx > 0
            int xL     = histExtR ? bar_index + histOffset : bar_index - histWidth - histOffset
            int xEnd   = histExtR ? bar_index + histOffset + histWidth : bar_index - histOffset
            int xAnch  = histExtR ? xL : xEnd
            int pocRow = dTot.indexof(mx)

            // --- range background, behind everything else
            if histBgOn
                histBoxes.push(box.new(math.min(xL, xEnd), devHi, math.max(xL, xEnd), devLo,
                     bgcolor=cHistBg, border_color=color(na), force_overlay=true))

            for d = 0 to drawRows - 1
                float tot = dTot.get(d)
                if tot > 0
                    // THE HOLES IN THE PROFILE.
                    // This rounded to the nearest whole bar and then skipped the
                    // row when the result was 0, so any price that traded less
                    // than half a bar's worth of the busiest price drew NOTHING.
                    // At a 34-bar width that is everything under about 1.5% of
                    // the POC - which is exactly what a low volume node is. The
                    // thinnest, most informative part of the auction was the
                    // part being erased, and it came out as a black band
                    // through the middle of the profile.
                    //
                    // A price that traded at all now always draws at least one
                    // bar. Blank rows from here on mean genuinely zero volume:
                    // price passed through without trading, which is a real and
                    // different thing worth being able to see.
                    int wid = math.max(1, int(math.round(tot / mx * histWidth)))
                    float slotLo = devLo + d * dStep
                    float bot = slotLo + pad
                    // The top slot can overshoot devHi when merging does not
                    // divide the rows evenly; clamping it can invert the box,
                    // so the row is skipped rather than drawn upside down.
                    float top = math.min(devHi, slotLo + dStep - pad)
                    // A row is "in value" when its own centre is inside the
                    // value area, not when it merely overlaps it - otherwise
                    // the two rows straddling VAH and VAL both light up and
                    // the band reads two rows too wide.
                    float mid   = slotLo + dStep / 2
                    bool  inVa  = histVaColor and not na(devVah) and not na(devVal) and mid <= devVah and mid >= devVal
                    bool  isPoc = d == pocRow

                    if top > bot
                        // --- the row itself: TOTAL volume traded at this price
                        color cRow = isPoc ? cHistPoc : inVa ? cHistVaTot : cHistTot
                        int rx1 = histExtR ? xAnch : xAnch - wid
                        int rx2 = histExtR ? xAnch + wid : xAnch
                        histBoxes.push(box.new(rx1, top, rx2, bot, bgcolor=cRow,
                             border_color=color(na), force_overlay=true))

                        // --- over it: the DOMINANT side, from the same edge
                        // Same origin as the row, so the two tips can be read
                        // against each other - how far the colour reaches into
                        // the grey is how one-sided that price was.
                        if histSplitUD
                            float uv  = math.min(tot, math.max(0.0, dUp.get(d)))
                            float dv  = tot - uv
                            bool  buyDom = uv >= dv
                            float dom = buyDom ? uv : dv
                            // Same rounding trap as the row: on a thin row
                            // the dominant side rounded away and the row lost
                            // its colour, so the sparse edges of the profile
                            // read as neutral when they are often the most
                            // one-sided prices in it. Never wider than the
                            // row it sits on.
                            int   wOv = dom <= 0 ? 0 : math.min(wid, math.max(1, int(math.round(dom / mx * histWidth))))
                            if wOv > 0
                                color cOv = buyDom ? (inVa ? cHistVaUp : cHistUp) : (inVa ? cHistVaDn : cHistDn)
                                int ox1 = histExtR ? xAnch : xAnch - wOv
                                int ox2 = histExtR ? xAnch + wOv : xAnch
                                histLines.push(line.new(ox1, mid, ox2, mid, xloc=xloc.bar_index,
                                     color=cOv, width=histOvW, force_overlay=true))

            // --- value area extremities, drawn across the profile itself
            if histVaExt and not na(devVah) and not na(devVal)
                int vx1 = math.min(xL, xEnd)
                int vx2 = math.max(xL, xEnd)
                histLines.push(line.new(vx1, devVah, vx2, devVah, xloc=xloc.bar_index,
                     color=cVaExt, style=line.style_dotted, width=1, force_overlay=true))
                histLines.push(line.new(vx1, devVal, vx2, devVal, xloc=xloc.bar_index,
                     color=cVaExt, style=line.style_dotted, width=1, force_overlay=true))

if barstate.islast and aucOn
    f_drawAuction()

// ============================================================================
// 14. MOMENTUM WAVES  (WaveTrend)
// ============================================================================
float wtSrc = hlc3
float esa = ta.ema(wtSrc, wtChannel)
float dev = ta.ema(math.abs(wtSrc - esa), wtChannel)
float ci  = dev != 0 ? (wtSrc - esa) / (0.015 * dev) : 0.0
float wt1 = ta.ema(ci, wtAverage)
float wt2 = ta.sma(wt1, wtMALen)
float wtDiff = (wt1 - wt2) * vwScale

bool wtCrossUp = ta.crossover(wt1, wt2)
bool wtCrossDn = ta.crossunder(wt1, wt2)

// ============================================================================
// 15. MONEY FLOW - all four computed every bar
// ----------------------------------------------------------------------------
// Stateful ta.* functions inside a conditional branch do not accumulate
// history correctly, so the selection happens after the maths, not around it.
// ============================================================================
float mfDelta = ta.sma(ta.ema(deltaRatio * 100.0, mfSmooth), math.max(1, int(mfLength / 10)))
float mfMfi   = ta.sma(ta.mfi(hlc3, mfLength) - 50.0, mfSmooth)

float hlRange = high - low
float mfm     = hlRange != 0 ? ((close - low) - (high - close)) / hlRange : 0.0
float mfvSum  = math.sum(mfm * nz(volume), mfLength)
float volSum  = math.sum(nz(volume), mfLength)
float mfCmf   = ta.sma(volSum != 0 ? mfvSum / volSum * 100.0 : 0.0, mfSmooth)

// the original - note that volume appears nowhere in this line
float ogBody = hlRange != 0 ? (close - open) / hlRange : 0.0
float mfOg   = ta.sma(ogBody * ogMult, mfLength) - ogPosY

float mfRaw = mfOg
if mfSource == "Volume Delta (intrabar)"
    mfRaw := mfDelta
else if mfSource == "Money Flow Index"
    mfRaw := mfMfi
else if mfSource == "Chaikin Money Flow"
    mfRaw := mfCmf

float mfSd = ta.stdev(mfRaw, 200)
float mfPlot = mfRaw * mfScale
if mfAutoNorm and mfSd > 0
    mfPlot := mfRaw / mfSd * 12.0 * mfScale
bool mfBull = mfRaw > 0

// ============================================================================
// 16. CVD
// ============================================================================
float rollDelta = math.sum(barDelta, cvdRoll)

bool cvdNew = false
if cvdReset == "Daily"
    cvdNew := chgD
else if cvdReset == "Weekly"
    cvdNew := chgW
else if cvdReset == "Session"
    cvdNew := chgS

var float cvdRun = 0.0
if cvdNew
    cvdRun := barDelta
else
    cvdRun := cvdRun + barDelta

float cvdAcc = cvdReset == "None (rolling)" ? rollDelta : cvdRun
// Normalised the way the original does it: mapped into a fixed band by its own
// 300-bar high/low, rather than a z-score. Bounded and predictable, so the line
// never wanders off the pane.
float cvdHi = ta.highest(cvdAcc, 300)
float cvdLo = ta.lowest(cvdAcc, 300)
float cvdRng = cvdHi - cvdLo
float cvdNorm = cvdRng > 0 ? -cvdLineScale + (2.0 * cvdLineScale) * ((cvdAcc - cvdLo) / cvdRng) : 0.0

// GREEN rising, RED falling. Nothing else to decode.
bool cvdRising = ta.change(cvdAcc) >= 0
color cvdCol = cvdRising ? cCvdUp : cCvdDn

// ============================================================================
// 17. HIDDEN LINES
// ============================================================================
float rsiVal  = ta.rsi(close, rsiLen)
float rsiPlot = rsiVal - 50.0

// ============================================================================
// 18. DIVERGENCE ENGINE
// ----------------------------------------------------------------------------
// Pivot-confirmed. A pivot is only known divLbR bars after it forms, so markers
// and lines are placed divLbR bars back. Delayed, not repainting.
// ============================================================================
f_inRange(bool cond) =>
    int bars = ta.barssince(cond == true)
    divRangeMin <= bars and bars <= divRangeMax

// [bullReg, bearReg, bullHid, bearHid, prevLowVal, prevLowIdx, prevHighVal, prevHighIdx]
f_divergence(float osc, int lbL, int lbR) =>
    float pl = ta.pivotlow(osc, lbL, lbR)
    float ph = ta.pivothigh(osc, lbL, lbR)
    bool plFound = not na(pl)
    bool phFound = not na(ph)

    float prevLowV  = ta.valuewhen(plFound, osc[lbR], 1)
    int   prevLowI  = int(ta.valuewhen(plFound, bar_index[lbR], 1))
    float prevHighV = ta.valuewhen(phFound, osc[lbR], 1)
    int   prevHighI = int(ta.valuewhen(phFound, bar_index[lbR], 1))

    // f_inRange depends on ta.barssince, so it must be evaluated unconditionally
    // and once per side. Calling it inside an `and` chain lets short-circuiting
    // skip bars, which corrupts the bar count it relies on.
    bool rngLow  = f_inRange(plFound[1])
    bool rngHigh = f_inRange(phFound[1])

    float prevLowPrice  = ta.valuewhen(plFound, low[lbR], 1)
    float prevHighPrice = ta.valuewhen(phFound, high[lbR], 1)

    bool oscHL   = osc[lbR] > prevLowV and rngLow
    bool priceLL = low[lbR] < prevLowPrice
    bool bullReg = plFound and oscHL and priceLL

    bool oscLH   = osc[lbR] < prevHighV and rngHigh
    bool priceHH = high[lbR] > prevHighPrice
    bool bearReg = phFound and oscLH and priceHH

    bool oscLL   = osc[lbR] < prevLowV and rngLow
    bool priceHL = low[lbR] > prevLowPrice
    bool bullHid = plFound and oscLL and priceHL

    bool oscHH   = osc[lbR] > prevHighV and rngHigh
    bool priceLH = high[lbR] < prevHighPrice
    bool bearHid = phFound and oscHH and priceLH

    [bullReg, bearReg, bullHid, bearHid, prevLowV, prevLowI, prevHighV, prevHighI]

[wtBull, wtBear, wtBullH, wtBearH, wtPLV, wtPLI, wtPHV, wtPHI] = f_divergence(wt2, divLbL, divLbR)
[cvBull, cvBear, cvBullH, cvBearH, cvPLV, cvPLI, cvPHV, cvPHI] = f_divergence(cvdNorm, divLbL, divLbR)

// REGULAR and HIDDEN are kept apart from here on.
//
// They used to be folded into one flag: wtBullDiv = wtBull or (divHidden and
// wtBullH). Both are bullish, so the direction was never wrong - but the two
// describe opposite situations. Regular bullish is a DOWNTREND running out of
// sellers at a new low. Hidden bullish is an UPTREND holding a higher low. One
// is a reversal, the other is a continuation.
//
// Merged, three things broke. They rendered as the same marker, so you could
// not tell which one you were looking at. The statistics counted them as one
// population, so their win rates could never be compared. And switching the
// display on silently changed the signal count, because the same flag fed the
// PROOF gate.
bool wtBullReg = divWt  and wtBull
bool wtBearReg = divWt  and wtBear
bool cvBullReg = divCvd and cvBull
bool cvBearReg = divCvd and cvBear

bool wtBullHid = divWt  and divHidden and wtBullH
bool wtBearHid = divWt  and divHidden and wtBearH
bool cvBullHid = divCvd and divHidden and cvBullH
bool cvBearHid = divCvd and divHidden and cvBearH

// What the GATES see. Regular always; hidden only when explicitly asked for, so
// turning the drawing on does not move the signals underneath you.
bool wtBullDiv = wtBullReg or (divHidProof and wtBullHid)
bool wtBearDiv = wtBearReg or (divHidProof and wtBearHid)
bool cvBullDiv = cvBullReg or (divHidProof and cvBullHid)
bool cvBearDiv = cvBearReg or (divHidProof and cvBearHid)

// --- divergence LINES connecting the two pivots on the oscillator
// BUDGET BUG FOUND: these were created with no bookkeeping at all. Pine caps
// drawings at max_lines_count and silently deletes the OLDEST when it fills -
// which on a long chart means the value area, naked POC and IB lines get thrown
// away to make room for old divergence lines. The important levels were being
// evicted by decoration.
var array<line> divLineArr = array.new<line>()

f_pushDivLine(line ln) =>
    divLineArr.push(ln)
    while divLineArr.size() > divMaxLines
        line.delete(divLineArr.shift())

// Drawn from the DISPLAY flags, not the gate flags, so a hidden divergence is
// still drawn when it is not allowed to produce a signal - that is the whole
// point of being able to look at one before trusting it. Hidden legs are
// dotted; regular ones keep the solid and dashed styles they had.
if divLines and barClosed
    if wtBullReg
        f_pushDivLine(line.new(wtPLI, wtPLV, bar_index - divLbR, wt2[divLbR], color=C_UP, width=2))
    if wtBearReg
        f_pushDivLine(line.new(wtPHI, wtPHV, bar_index - divLbR, wt2[divLbR], color=C_DN, width=2))
    if wtBullHid
        f_pushDivLine(line.new(wtPLI, wtPLV, bar_index - divLbR, wt2[divLbR], color=C_UP, width=1, style=line.style_dotted))
    if wtBearHid
        f_pushDivLine(line.new(wtPHI, wtPHV, bar_index - divLbR, wt2[divLbR], color=C_DN, width=1, style=line.style_dotted))
    if cvBullReg
        f_pushDivLine(line.new(cvPLI, cvPLV, bar_index - divLbR, cvdNorm[divLbR], color=cCvdUp, width=1, style=line.style_dashed))
    if cvBearReg
        f_pushDivLine(line.new(cvPHI, cvPHV, bar_index - divLbR, cvdNorm[divLbR], color=cCvdDn, width=1, style=line.style_dashed))
    if cvBullHid
        f_pushDivLine(line.new(cvPLI, cvPLV, bar_index - divLbR, cvdNorm[divLbR], color=cCvdUp, width=1, style=line.style_dotted))
    if cvBearHid
        f_pushDivLine(line.new(cvPHI, cvPHV, bar_index - divLbR, cvdNorm[divLbR], color=cCvdDn, width=1, style=line.style_dotted))

// ============================================================================
// 19. GRADED SIGNALS
// ----------------------------------------------------------------------------
// The original fires its "gold dot" on a fixed RSI level plus a cross. Here the
// grade reflects how many independent things agree - momentum, real money flow
// and absorption - so a weak setup looks weak instead of looking gold.
// ============================================================================
bool inOS = wt2 <= wtOS1
bool inOB = wt2 >= wtOB1
bool divRecentBull = ta.barssince(wtBullDiv or cvBullDiv) <= 3
bool divRecentBear = ta.barssince(wtBearDiv or cvBearDiv) <= 3

bool buyB  = wtCrossUp and inOS and mfBull
bool buyA  = buyB and divRecentBull
bool sellB = wtCrossDn and inOB and not mfBull
bool sellA = sellB and divRecentBear

// pBuyA..pSellC removed with the pane's own verdicts. buyA/sellA survive
// because the alert dispatcher still reports them.


// ============================================================================
// 19b. MARKET STRUCTURE  -  BOS / CHoCH
// ----------------------------------------------------------------------------
// The one piece of SMC worth keeping. Everything else it sells you is already
// in this script under a measured name: naked POC instead of unmitigated order
// block, low volume node instead of fair value gap, excess instead of liquidity
// sweep, acceptance outside value instead of break of structure.
//
// What structure genuinely adds is a visual skeleton - where the swings are and
// which break mattered. It is drawn with lines and labels, so it costs nothing
// from the plot budget.
//
//   BOS   - break in the same direction as the prevailing trend. Continuation.
//   CHoCH - break against it. The first evidence the trend may be over.
// ============================================================================
var array<line>  strLines  = array.new<line>()
var array<label> strLabels = array.new<label>()

float pvHi = ta.pivothigh(high, strLen, strLen)
float pvLo = ta.pivotlow(low, strLen, strLen)

var float sHi = na
var int   sHiIdx = na
var float sHiPrev = na
var float sLo = na
var int   sLoIdx = na
var float sLoPrev = na
var int   trendDir = 0

// Two helpers rather than one taking na - Pine cannot infer a parameter type
// from a bare na literal.
f_pushStrLine(line ln) =>
    strLines.push(ln)
    while strLines.size() > strMaxDraw
        line.delete(strLines.shift())

f_pushStrLabel(label lb) =>
    strLabels.push(lb)
    while strLabels.size() > strMaxDraw * 2
        label.delete(strLabels.shift())

if strOn and not na(pvHi) and barClosed
    sHiPrev := sHi
    sHi := pvHi
    sHiIdx := bar_index - strLen
    if strSwings
        string tag = na(sHiPrev) ? "H" : (pvHi > sHiPrev ? "HH" : "LH")
        f_pushStrLabel(label.new(sHiIdx, pvHi, tag, xloc=xloc.bar_index,
             style=label.style_label_down, color=color.new(cSwing, 92),
             textcolor=cSwing, size=size.tiny, force_overlay=true))

if strOn and not na(pvLo) and barClosed
    sLoPrev := sLo
    sLo := pvLo
    sLoIdx := bar_index - strLen
    if strSwings
        string tag = na(sLoPrev) ? "L" : (pvLo > sLoPrev ? "HL" : "LL")
        f_pushStrLabel(label.new(sLoIdx, pvLo, tag, xloc=xloc.bar_index,
             style=label.style_label_up, color=color.new(cSwing, 92),
             textcolor=cSwing, size=size.tiny, force_overlay=true))

bool bosUp = false
bool bosDn = false
bool chochUp = false
bool chochDn = false

if strOn and barClosed
    if not na(sHi) and close > sHi
        if trendDir < 0
            chochUp := true
        else
            bosUp := true
        color bc = chochUp ? cChoch : cBos
        string bt = chochUp ? "CHoCH" : "BOS"
        f_pushStrLine(line.new(sHiIdx, sHi, bar_index, sHi, xloc=xloc.bar_index,
             color=bc, style=line.style_dashed, width=1, force_overlay=true))
        f_pushStrLabel(label.new(bar_index, sHi, bt, xloc=xloc.bar_index,
             style=label.style_label_down, color=color.new(bc, 80),
             textcolor=bc, size=size.small, force_overlay=true))
        trendDir := 1
        sHi := na

    if not na(sLo) and close < sLo
        if trendDir > 0
            chochDn := true
        else
            bosDn := true
        color bc2 = chochDn ? cChoch : cBos
        string bt2 = chochDn ? "CHoCH" : "BOS"
        f_pushStrLine(line.new(sLoIdx, sLo, bar_index, sLo, xloc=xloc.bar_index,
             color=bc2, style=line.style_dashed, width=1, force_overlay=true))
        f_pushStrLabel(label.new(bar_index, sLo, bt2, xloc=xloc.bar_index,
             style=label.style_label_up, color=color.new(bc2, 80),
             textcolor=bc2, size=size.small, force_overlay=true))
        trendDir := -1
        sLo := na


// ============================================================================
// 19e. BALANCE AREAS  -  auto-detected, clock-independent
// ----------------------------------------------------------------------------
// A balance area is not a calendar event. It starts when the market stops
// trending and begins rotating, and it ends when someone forces it out. ADX
// falling through its threshold is the cleanest signal of that transition in
// pure price terms.
//
// The box builds for balBuild bars, then gets its own volume profile. Its POC
// is where this specific rotation did most of its business, and its edges are
// what a breakout has to clear. Those are more relevant to the next hour than a
// value area anchored to midnight.
//
// Concept from Low Volatility Profiles [BigBeluga], CC BY-NC-SA 4.0.
// Reimplemented here rather than copied.
// ============================================================================
[_dip, _dim, adxVal] = ta.dmi(balAdxLen, balAdxLen)

var box   balBody   = na
var box   balFillBx = na
var int   balStart  = na
var bool  balActive = false
var float balHi     = na
var float balLo     = na
var float balPoc    = na
var bool  balArmed  = false
var array<box>  balBars  = array.new<box>()
var array<line> balPocLn = array.new<line>()

// REAL BUG FOUND: broken balance boxes were never deleted. Every contraction
// left two boxes on the chart permanently. Pine evicts the OLDEST drawing when
// the 500-object cap fills, so these were quietly pushing out the value area
// and naked POC lines - exactly the leak already fixed for divergence lines.
var array<box>  balOldBx = array.new<box>()

bool balContract = ta.crossunder(adxVal, balAdxTh)

f_clearBalBars() =>
    for b in balBars
        box.delete(b)
    balBars.clear()

// --- open a new balance area
if balOn and balContract and not balActive and barClosed
    balStart := bar_index
    balHi := high
    balLo := low
    balActive := true
    balArmed := false
    balPoc := na
    f_clearBalBars()
    balBody := box.new(bar_index, high, bar_index, low, border_color=cBalBox,
         bgcolor=color(na), force_overlay=true)
    balFillBx := box.new(bar_index, high, bar_index, low, border_color=color(na),
         bgcolor=cBalFill, force_overlay=true)

// --- build it out
if balOn and balActive
    if bar_index - balStart < balBuild
        balHi := math.max(balHi, high)
        balLo := math.min(balLo, low)
    else
        balArmed := true
    if not na(balBody)
        box.set_top(balBody, balHi)
        box.set_bottom(balBody, balLo)
        box.set_right(balBody, bar_index + 3)
        box.set_top(balFillBx, balHi)
        box.set_bottom(balFillBx, balLo)
        box.set_right(balFillBx, bar_index)

// --- profile the balance area (last bar only; the loop is not cheap)
// Moved into a function to keep the main body under Pine's size cap. balPoc is
// the one global it wrote, so it comes back as a return value instead - and it
// is seeded from the current balPoc so the value survives a pass where the
// profile is switched off or the bins come back empty.
f_drawBalance() =>
    float outPoc = balPoc
    f_clearBalBars()
    float step = (balHi - balLo) / balBins
    array<float> bBins = array.new<float>(balBins, 0.0)
    float bDelta = 0.0
    int look = math.min(bar_index - balStart, 300)
    for k = 0 to look
        float c = close[k]
        float o = open[k]
        float v = nz(volume[k])
        bDelta += c > o ? v : -v
        int bi = math.max(0, math.min(balBins - 1, int((c - balLo) / step)))
        bBins.set(bi, bBins.get(bi) + v)

    float bMax = bBins.max()
    if bMax > 0 and balProfile
        int pocIdx = bBins.indexof(bMax)
        for i = 0 to balBins - 1
            float wFrac = bBins.get(i) / bMax
            int wBars = int(math.round(wFrac * balBuild))
            if wBars > 0
                float bl = balLo + step * i
                float bt = bl + step
                balBars.push(box.new(balStart, bt, balStart + wBars, bl,
                     bgcolor=color.from_gradient(wFrac, 0, 1, cBalLo, color.new(cBalPoc, 35)),
                     border_color=color(na), force_overlay=true))
        outPoc := balLo + step * (pocIdx + 0.5)
        box.set_text(balBody, "BALANCE  delta " + (bDelta > 0 ? "+" : "") + str.tostring(bDelta, format.volume))
        box.set_text_color(balBody, chart.fg_color)
        box.set_text_size(balBody, size.tiny)
        box.set_text_halign(balBody, text.align_right)
        box.set_text_valign(balBody, text.align_top)
    outPoc

if balOn and balActive and balArmed and barstate.islast and balHi > balLo
    balPoc := f_drawBalance()

// --- break it
bool balBreakUp = false
bool balBreakDn = false
if balOn and balActive and balArmed
    if close > balHi
        balBreakUp := true
    if close < balLo
        balBreakDn := true

if (balBreakUp or balBreakDn) and barClosed
    if not na(balBody)
        box.set_border_style(balBody, line.style_dashed)
        box.set_border_color(balBody, color.new(cBalBox, 70))
        box.set_right(balBody, bar_index)
        box.set_right(balFillBx, bar_index)
        // retire the broken boxes into a bounded queue and release the handles
        balOldBx.push(balBody)
        balOldBx.push(balFillBx)
        while balOldBx.size() > 12
            box.delete(balOldBx.shift())
        balBody := na
        balFillBx := na
    // the POC of a broken balance area stays a magnet
    if not na(balPoc)
        balPocLn.push(line.new(bar_index, balPoc, bar_index + 1, balPoc, xloc=xloc.bar_index,
             color=color.new(cBalPoc, 40), style=line.style_dotted, width=1,
             extend=extend.right, force_overlay=true))
        while balPocLn.size() > 5
            line.delete(balPocLn.shift())
    balActive := false
    balArmed := false


// ============================================================================
// 19f. CME GAP
// ----------------------------------------------------------------------------
// CME Bitcoin futures shut for the weekend; spot and perps do not. Whatever
// range price covers while CME is closed is untraded ON THE FUTURES BOOK - a
// genuine single print, and the cleanest real-world example of one.
// ============================================================================
// The session timestamp comes along in the same request so a weekend gap can be
// told apart from an ordinary daily open gap - one request, not two.
// RUNTIME: a security request costs whether or not you look at the result, so
// it is skipped entirely when the layer is switched off.
float cmeO = na
float cmeC = na
int   cmeT = na
if cmeOn
    // Named cmeQ* rather than q*: qC and qT are the label-queue arrays in the
    // level-labelling section, and reusing those names shadowed them. Pine
    // compiles it, but a local silently masking a global of a DIFFERENT type
    // is a bug waiting for whoever edits this block next.
    [cmeQO, cmeQC, cmeQT] = request.security(cmeSymEff, "D", [open, close, time],
         ignore_invalid_symbol=true, lookahead=barmerge.lookahead_off)
    cmeO := cmeQO
    cmeC := cmeQC
    cmeT := cmeQT

var array<float> gapTop = array.new<float>()
var array<float> gapBot = array.new<float>()
var array<box>   gapBox = array.new<box>()

bool cmeNewDay = not na(cmeO) and cmeO != cmeO[1]
// Testing "was the previous CME day a Friday" breaks on any holiday that shuts
// the book on a Friday - Good Friday most obviously. The last session before
// that weekend is a Thursday and a genuine multi-day gap goes unrecorded.
//
// Measuring the actual time between consecutive CME sessions has no such
// blind spot. A normal day-to-day step is 24 hours; anything past 40 means the
// futures book was shut for a weekend or a holiday, whichever it was.
float cmeStepH = na(cmeT) ? na : (cmeT - nz(cmeT[1], cmeT)) / 3600000.0
bool cmeWeekendGap = not na(cmeStepH) and cmeStepH >= 40
if cmeOn and cmeNewDay and not na(cmeC[1]) and barClosed and (not cmeWeekOnly or cmeWeekendGap)
    float gT = math.max(cmeO, cmeC[1])
    float gB = math.min(cmeO, cmeC[1])
    if (gT - gB) / close * 100 >= cmeMinEff
        gapTop.push(gT)
        gapBot.push(gB)
        gapBox.push(box.new(bar_index, gT, bar_index + 1, gB, bgcolor=cCmeGap,
             border_color=color.new(cCmeGap, 40), extend=extend.right,
             text="CME gap", text_color=color.new(chart.fg_color, 30),
             text_size=size.tiny, text_halign=text.align_left, force_overlay=true))
        while gapTop.size() > cmeKeep
            box.delete(gapBox.shift())
            gapTop.shift()
            gapBot.shift()

// a gap is closed once price has traded through it
var int gapFilled = 0
if gapTop.size() > 0 and barClosed
    for i = gapTop.size() - 1 to 0
        if low <= gapTop.get(i) and high >= gapBot.get(i)
            box.delete(gapBox.get(i))
            gapBox.remove(i)
            gapTop.remove(i)
            gapBot.remove(i)
            gapFilled += 1

// ============================================================================
// 19g. SESSION RANGES
// ----------------------------------------------------------------------------
// Crypto has no exchange sessions but plenty of session behaviour. London and
// New York routinely open by running one side of the Asia range. This is the
// measured version of what ICT calls a killzone.
// ============================================================================
f_sessActive(string ss) =>
    not na(time(timeframe.period, ss, sessTz))

var array<box> sessBoxes = array.new<box>()

f_sessTrack(bool active, bool activePrev, float hiIn, float loIn, color col, string nm) =>
    var float sHiV = na
    var float sLoV = na
    var box   sBx = na
    if active and not activePrev and barClosed
        sHiV := hiIn
        sLoV := loIn
        sBx := box.new(bar_index, high, bar_index, low, bgcolor=col,
             border_color=color(na), force_overlay=true,
             text=sessLbl ? nm : "", text_color=color.new(chart.fg_color, 45),
             text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
        sessBoxes.push(sBx)
        while sessBoxes.size() > sessKeep * 3
            box.delete(sessBoxes.shift())
    if active and not na(sBx)
        sHiV := math.max(sHiV, hiIn)
        sLoV := math.min(sLoV, loIn)
        box.set_top(sBx, sHiV)
        box.set_bottom(sBx, sLoV)
        box.set_right(sBx, bar_index)
    [sHiV, sLoV]

bool a1 = sessOn and f_sessActive(sess1)
bool a2 = sessOn and f_sessActive(sess2)
bool a3 = sessOn and f_sessActive(sess3)
[asiaHi, asiaLo] = f_sessTrack(a1, a1[1], high, low, cSess1, "ASIA")
[lonHi, lonLo]   = f_sessTrack(a2, a2[1], high, low, cSess2, "LONDON")
[nyHi, nyLo]     = f_sessTrack(a3, a3[1], high, low, cSess3, "NEW YORK")


// ============================================================================
// 19h. RISK LAYER
// ----------------------------------------------------------------------------
// The layer that actually decides whether you keep money, and the one this
// script was missing entirely.
//
// Stops here are STRUCTURAL, not an ATR multiple. A long taken off value fails
// if the low that produced it is taken out - so the stop sits below that low
// plus a buffer. The target is the next real level the auction must visit: the
// opposite value edge, or the nearest untested POC.
//
// R is computed and drawn BEFORE you act. A 0.6R setup is a losing trade taken
// slowly, and the minimum-R filter simply refuses to show it.
// ============================================================================
// ---------------------------------------------------------------------------
// WHY BUYS NEVER FIRED IN AN UPTREND
// The target used to be the NEAREST level in the trade's direction. In a rally
// the levels above are close (price is walking into them) while the levels
// below are far away. So a long got a tiny R and was filtered out, and a short
// got a huge R and passed - the minimum-R filter was quietly forcing the whole
// system to trade counter-trend.
//
// Now every candidate level is collected and the nearest one that ACTUALLY
// ACHIEVES the minimum R is chosen. If price is inches from the first level,
// the trade aims at the next one instead of being discarded.
// ---------------------------------------------------------------------------
f_pushCand(array<float> arr, float v) =>
    if not na(v)
        arr.push(v)

f_pickUp(float e, float risk) =>
    array<float> c = array.new<float>()
    // devVah and htfDevVah are computed on the last bar only. Including them
    // gave the live bar a target list that no historical bar ever had, so R -
    // and therefore whether a signal passed the minimum-R filter - differed
    // between live and reload. Only every-bar levels are used.
    f_pushCand(c, priorVah)
    // The plain-English read tells you to rotate back to the POC, but the POC
    // was not in the target list, so the trade the script recommends was not
    // the trade it measured. Prior POC exists on every bar, so unlike the
    // developing one it is safe to use here.
    f_pushCand(c, priorPoc)
    f_pushCand(c, npocUp)
    f_pushCand(c, priorHi)
    f_pushCand(c, vwapU1)
    f_pushCand(c, vwapU2)
    if balActive
        f_pushCand(c, balHi)
    float pick = na
    if c.size() > 0 and risk > 0
        c.sort(order.ascending)
        for i = 0 to c.size() - 1
            float t = c.get(i)
            if t > e and (t - e) / risk >= riskMinR
                pick := t
                break
        if na(pick)
            // The old fallback returned the farthest level even when it failed
            // minR. rkOkL rejected the signal anyway, so nothing leaked, but
            // returning na here is cleaner than returning a target we know is
            // unusable.
            float far = c.max()
            if far > e and (far - e) / risk >= riskMinR
                pick := far
    pick

f_pickDn(float e, float risk) =>
    array<float> c = array.new<float>()
    f_pushCand(c, priorVal)
    f_pushCand(c, priorPoc)
    f_pushCand(c, npocDn)
    f_pushCand(c, priorLo)
    f_pushCand(c, vwapL1)
    f_pushCand(c, vwapL2)
    if balActive
        f_pushCand(c, balLo)
    float pick = na
    if c.size() > 0 and risk > 0
        c.sort(order.descending)
        for i = 0 to c.size() - 1
            float t = c.get(i)
            if t < e and (e - t) / risk >= riskMinR
                pick := t
                break
        if na(pick)
            float far = c.min()
            if far < e and (e - far) / risk >= riskMinR
                pick := far
    pick

float rkEntry = close
float rkMinDist = atr14 * riskMinStop
float rkStopL = math.min(ta.lowest(low, riskSwing) - atr14 * riskBuf, close - rkMinDist)
float rkStopS = math.max(ta.highest(high, riskSwing) + atr14 * riskBuf, close + rkMinDist)

float rkRiskL = rkEntry - rkStopL
float rkRiskS = rkStopS - rkEntry
float rkTgtL  = f_pickUp(rkEntry, rkRiskL)
float rkTgtS  = f_pickDn(rkEntry, rkRiskS)

// --- optional cap on how far the structural target may sit
// math.max keeps the cap at or beyond Minimum R: capping below it would draw a
// target that fails the script's own filter on the bar it appears.
if riskTgtCap > 0
    float capMult = math.max(riskMinR, riskTgtCap)
    if not na(rkTgtL) and rkRiskL > 0
        float capL = rkEntry + rkRiskL * capMult
        rkTgtL := math.min(rkTgtL, capL)
    if not na(rkTgtS) and rkRiskS > 0
        float capS = rkEntry - rkRiskS * capMult
        rkTgtS := math.max(rkTgtS, capS)

float rkRL = rkRiskL > 0 and not na(rkTgtL) ? (rkTgtL - rkEntry) / rkRiskL : na
float rkRS = rkRiskS > 0 and not na(rkTgtS) ? (rkEntry - rkTgtS) / rkRiskS : na

// ---------------------------------------------------------------------------
// FLOATING-POINT BOUNDARY - introduced by the target cap
// ---------------------------------------------------------------------------
// The cap sets the target to entry + risk x capMult, and R is then recovered
// as (target - entry) / risk. In exact arithmetic that returns capMult. In
// binary floating point it can return 1.4999999999999998, and with the natural
// setting of cap 1.5 against Minimum R 1.5 the filter below would then reject
// its own target - silently, on some price values and not others, so roughly
// half the signals would vanish for no visible reason.
//
// One part per million of slack. Far below any price move that could matter,
// and far above the representation error it exists to absorb.
float rMinEps = riskMinR * 0.999999

bool rkOkL = not na(rkRL) and rkRL >= rMinEps
bool rkOkS = not na(rkRS) and rkRS >= rMinEps

// ============================================================================
// 19h2. THE TRADE LEDGER
// ----------------------------------------------------------------------------
// Declared here rather than beside the statistics that consume it, because the
// signal gate below has to know whether a trade is ALREADY OPEN before it is
// allowed to draw another one. Pine resolves strictly top to bottom.
// ============================================================================
var array<float> opEntry = array.new<float>()
var array<float> opStop  = array.new<float>()
var array<float> opTgt   = array.new<float>()
var array<int>   opDir   = array.new<int>()
var array<int>   opBar   = array.new<int>()
// The table could say how OFTEN the target was hit but never what that was
// worth. A 33% hit rate is excellent at 4R and a slow death at 1.5R, and
// nothing here could tell the two apart. These carry the R of every trade.
var array<float> opRisk  = array.new<float>()
var array<float> opRPlan = array.new<float>()

var int sigOpen = 0
var int sigSkip = 0

// THE RUNNING STATISTICS, as one array rather than eleven separate counters.
//
// Not a style choice. The two blocks that ADD to these had to become functions
// to keep the script's main body under Pine's size cap, and a Pine function may
// mutate an array but may NOT modify a global - `f_ledAdd(LG_REALR, realR)` inside a
// function is a compile error. An array element is not a global being
// reassigned, it is an object being changed, so it is allowed.
//
// The named indices below and the plain copies further down mean every site
// that READS a statistic still reads sumRealR, sigWin and the rest by name.
// Total R alone cannot say WHERE the money went, which is why realised R is
// split by how each trade ended: an edge that was never there looks nothing
// like an edge the exits are handing back.
var array<float> ledger = array.new<float>(11, 0.0)
int LG_WIN   = 0
int LG_LOSS  = 1
int LG_EXP   = 2
int LG_FLAT  = 3
int LG_NCL   = 4
int LG_REALR = 5
int LG_PLANR = 6
int LG_RWIN  = 7
int LG_RLOSS = 8
int LG_REXP  = 9
int LG_RFLAT = 10

f_ledAdd(int k, float v) =>
    ledger.set(k, ledger.get(k) + v)

// A signal is known at its bar's CLOSE, so the earliest price anyone could
// actually trade is the next bar's OPEN. These hold a signal for that one bar.
var bool  pendLong  = false
var bool  pendShort = false
var float pendStop  = na
var float pendTgt   = na

// What is live right now, as of the close of the previous bar. A pending
// signal counts as a commitment - otherwise a second one could fire in the
// gap between the signal and its fill.
bool anyLongOpen  = pendLong
bool anyShortOpen = pendShort
if opDir.size() > 0
    for i = 0 to opDir.size() - 1
        if opDir.get(i) == 1
            anyLongOpen := true
        else
            anyShortOpen := true

// ============================================================================
// 19d. OPEN INTEREST & FUNDING
// ----------------------------------------------------------------------------
// The last thing this system could not see, and for perpetuals it is the most
// important. Price alone cannot distinguish a short squeeze from genuine
// buying - both go up. Open interest can:
//
//   price up   + OI up     new longs opening. Real demand, risk building.
//   price up   + OI down   shorts covering. A squeeze. Tends to stall.
//   price down + OI up     new shorts opening. Real supply.
//   price down + OI down   longs closing or liquidated. A flush.
//
// ignore_invalid_symbol keeps this safe on instruments with no OI feed - it
// returns na instead of killing the script.
// ============================================================================
string oiTicker = syminfo.prefix + ":" + syminfo.ticker + "_OI"
float oiClose = na
if oiOn
    oiClose := request.security(oiTicker, timeframe.period, close, ignore_invalid_symbol=true)

// This used to request syminfo.tickerid whenever the funding field was blank -
// a whole security call fetching the chart's own close, so it could then be
// discarded by the fundOk test below. Blank now means no request at all.
float fundVal = na
if fundSym != ""
    fundVal := request.security(fundSym, timeframe.period, close, ignore_invalid_symbol=true)
bool fundOk = not na(fundVal)

// The correlated market for the divergence quality score. Requested here, next
// to the other external data, and only when it is actually switched on and
// named - an unconditional request was what made this script "heavy" before.
float refClose = na
if divQRef and divRefSym != ""
    refClose := request.security(divRefSym, timeframe.period, close, ignore_invalid_symbol=true)
bool refOk = divQRef and not na(refClose)

bool oiOk = oiOn and not na(oiClose)
float oiChg = oiOk ? oiClose - nz(oiClose[1], oiClose) : 0.0
float oiChgMean = ta.sma(oiChg, 50)
float oiChgSd = ta.stdev(oiChg, 50)
float oiChgZ = oiChgSd > 0 ? (oiChg - oiChgMean) / oiChgSd : 0.0

float priceChg = close - close[1]

string oiState = "-"
color  oiCol = C_NE
if oiOk
    if oiChg > 0 and priceChg > 0
        oiState := "Longs opening"
        oiCol := cOiUp
    else if oiChg > 0 and priceChg < 0
        oiState := "Shorts opening"
        oiCol := cOiDn
    else if oiChg < 0 and priceChg > 0
        oiState := "Shorts covering"
        oiCol := C_WN
    else if oiChg < 0 and priceChg < 0
        oiState := "Longs closing"
        oiCol := C_WN

// A wide bar on collapsing OI is forced closing, not conviction. These
// overshoot, which is why they so often print the excess tail at the extreme.
bool liqCascade = false
if liqOn and oiOk
    if oiChgZ < -liqOiZ and spreadZ > liqSprZ
        liqCascade := true


// OI histogram plot removed. It was off by default but a declared plot costs a
// slot whether or not it draws, and it was the clutter behind the money flow
// waves. The OI reading you need is the dashboard row.

plotshape(liqCascade ? high : na, "Liquidation Cascade", shape.xcross, location.abovebar,
     color=cLiq, size=size.small, force_overlay=true)

// ---------------------------------------------------------------------------
// OPEN INTEREST AS EVIDENCE  -  measured over the APPROACH, not one bar
// ---------------------------------------------------------------------------
// The single-bar reading above is what the dashboard shows. It is the wrong
// thing to gate a signal with: a buy signal fires on a REJECTION bar, which
// usually closes green after wicking into support, so a one-bar read would
// call that "shorts covering" and hand the evidence to the sell side.
//
// What matters is how price and open interest behaved on the way INTO the
// level. That is measured over the same window the trigger and the location
// already use, so all three gates agree on what "recently" means.
//
//   price down + OI down   longs flushed out. Buy proof.
//   price up   + OI down   shorts squeezed out. Sell proof.
//   price up   + OI up     new longs. REAL demand - do not fade it.
//   price down + OI up     new shorts. REAL supply - do not catch it.
float oiChgW    = oiOk ? oiClose - nz(oiClose[csigWindow], oiClose) : 0.0
float priceChgW = close - close[csigWindow]

bool oiFlushDn   = oiOk and oiChgW < 0 and priceChgW < 0
bool oiSqueezeUp = oiOk and oiChgW < 0 and priceChgW > 0
bool oiRealBid   = oiOk and oiChgW > 0 and priceChgW > 0
bool oiRealOffer = oiOk and oiChgW > 0 and priceChgW < 0

// A cascade is a single-bar event, so it is read from that bar's own direction.
bool oiProofBuy  = oiProofOn and (oiFlushDn   or (liqCascade and close <  open))
bool oiProofSell = oiProofOn and (oiSqueezeUp or (liqCascade and close >= open))
bool oiVetoBuy   = oiVetoOn  and oiRealOffer
bool oiVetoSell  = oiVetoOn  and oiRealBid

// ============================================================================
// 20c. ORDER FLOW ENGINE  (the footprint, headless)
// ----------------------------------------------------------------------------
// The Auction Footprint script's reading half, with the grid switched off.
//
// The expensive part of a footprint is the DRAWING - five hundred boxes, one
// per cell - not the arithmetic. The arithmetic is a single pass over the
// lower-timeframe samples this script already fetches for the volume profile.
// So it runs here for almost nothing, and what it produces is the one kind of
// evidence the rest of the script does not have: every oscillator in the pane
// is built out of this symbol's own price, and this is not.
//
// Two things come out of it.
//
// DELTA DIVERGENCE - a bar that closed UP while net flow was SELLING. Every
// aggressive seller was absorbed by somebody taking the other side and price
// went the wrong way for them. Hidden strength, and its mirror.
//
// ABSORPTION LEVELS - a price where one side pushed hard, traded an unusual
// amount, and then failed to get through. Note the inversion: heavy BUYING at a
// high that fails is buyers being absorbed, so the level is RESISTANCE even
// though every print there was green. The aggressive side is the side that
// lost. Whether it failed is only knowable from what came next, so a level is a
// candidate until it has survived, and is deleted the moment price CLOSES
// through it.
// ============================================================================
var array<OfLvl> ofLvls = array.new<OfLvl>()

// --- delta divergence, from the excursion the delta request already returns
float ofTot  = nz(totVol, nz(volume))
bool  ofBig  = ofTot > 0 and math.abs(barDelta) >= ofTot * ofDivMin / 100.0
bool  ofBull = ofOn and ofBig and close > open and barDelta < 0
bool  ofBear = ofOn and ofBig and close < open and barDelta > 0
// how far delta travelled inside the bar, not just where it ended
float ofSwing = not na(dHiIn) and not na(dLoIn) ? dHiIn - dLoIn : na

// --- absorption candidates from this bar's own rows
// Moved into a function to keep the main body under Pine's size cap.
f_ofRows() =>
    float ofStep = (high - low) / ofRows
    if ofStep > 0
        array<float> ofBuy = array.new<float>(ofRows, 0.0)
        array<float> ofSel = array.new<float>(ofRows, 0.0)
        for i = 0 to lH.size() - 1
            float v = lV.get(i)
            if not na(v) and v > 0
                int a = math.max(0, math.min(ofRows - 1, int((lL.get(i) - low) / ofStep)))
                int b = math.max(0, math.min(ofRows - 1, int((lH.get(i) - low) / ofStep)))
                float sh = v / (b - a + 1)
                float up = lC.get(i) > lO.get(i) ? sh : lC.get(i) < lO.get(i) ? 0.0 : sh * 0.5
                for r = a to b
                    ofBuy.set(r, ofBuy.get(r) + up)
                    ofSel.set(r, ofSel.get(r) + (sh - up))

        float ofSum = ofBuy.sum() + ofSel.sum()
        if ofSum > 0
            float avgRow = ofSum / ofRows
            int band = math.max(1, math.min(ofRows, int(math.round(ofRows * ofAbsEdge / 100.0))))

            // resistance: heaviest BUY-dominant row in the top band
            int bR = -1
            float bRv = 0.0
            for i = math.max(0, ofRows - band) to ofRows - 1
                float v = ofBuy.get(i) + ofSel.get(i)
                if v >= avgRow * ofAbsMult and ofBuy.get(i) > ofSel.get(i) and v > bRv
                    bRv := v
                    bR := i
            // support: heaviest SELL-dominant row in the bottom band
            int bS = -1
            float bSv = 0.0
            for i = 0 to math.min(ofRows - 1, band - 1)
                float v = ofBuy.get(i) + ofSel.get(i)
                if v >= avgRow * ofAbsMult and ofSel.get(i) > ofBuy.get(i) and v > bSv
                    bSv := v
                    bS := i

            if bR >= 0
                ofLvls.push(OfLvl.new(px = low + (bR + 0.5) * ofStep, dir = -1, born = bar_index,
                     ok = false, vol = bRv, ln = na))
            if bS >= 0
                ofLvls.push(OfLvl.new(px = low + (bS + 0.5) * ofStep, dir = 1, born = bar_index,
                     ok = false, vol = bSv, ln = na))
            while ofLvls.size() > ofAbsKeep
                OfLvl gone = ofLvls.shift()
                line.delete(gone.ln)

if ofOn and barClosed and high > low and ltfOk
    f_ofRows()

// --- confirm what held, delete what broke
float ofTol = atr14 * 0.15
bool ofNewSup = false
bool ofNewRes = false
if ofOn and barClosed and ofLvls.size() > 0
    for i = ofLvls.size() - 1 to 0
        OfLvl a = ofLvls.get(i)
        if bar_index > a.born
            // A WICK through the level is price testing whoever is there. A
            // CLOSE through it is them being gone.
            bool broke = a.dir > 0 ? close < a.px - ofTol : close > a.px + ofTol
            if broke
                line.delete(a.ln)
                ofLvls.remove(i)
            else if not a.ok and bar_index - a.born >= ofAbsConf
                a.ok := true
                ofNewSup := ofNewSup or a.dir > 0
                ofNewRes := ofNewRes or a.dir < 0

// --- the nearest CONFIRMED level each side, the form the gates can use
float ofSupPx = na
float ofResPx = na
if ofOn and ofLvls.size() > 0
    for i = 0 to ofLvls.size() - 1
        OfLvl a = ofLvls.get(i)
        if a.ok
            if a.dir > 0 and a.px <= close
                ofSupPx := na(ofSupPx) ? a.px : math.max(ofSupPx, a.px)
            if a.dir < 0 and a.px >= close
                ofResPx := na(ofResPx) ? a.px : math.min(ofResPx, a.px)

// --- optional: the levels only, never the grid
var array<line> ofLines = array.new<line>()
if barstate.islast
    for l in ofLines
        line.delete(l)
    ofLines.clear()
    if ofOn and ofDraw and ofLvls.size() > 0
        for i = 0 to ofLvls.size() - 1
            OfLvl a = ofLvls.get(i)
            ofLines.push(line.new(math.max(a.born, bar_index - 480), a.px, bar_index + 2, a.px,
                 xloc=xloc.bar_index, color=a.ok ? cOfAbs : color.new(cOfAbs, 60),
                 width=a.ok ? 2 : 1, style=a.ok ? line.style_solid : line.style_dotted,
                 extend=extend.right, force_overlay=true))

// ============================================================================
// 19c. CHART SIGNALS  -  all four layers must agree
// ----------------------------------------------------------------------------
// The pane's A/B/C grades are momentum only: a WaveTrend cross with money flow
// agreeing. That is a trigger, not a trade. On the price chart a signal has to
// clear all four layers of the hierarchy:
//
//   CONTEXT   the regime permits this direction
//   LOCATION  price is at a value area edge or an untested POC
//   TRIGGER   a WaveTrend cross fired in the extreme zone, recently
//   PROOF     money flow, absorption, or a delta divergence backs it
//
// There will be far fewer of these than pane signals. That is the entire point.
// ============================================================================
float locTol = close * csigTol / 100.0

// ============================================================================
// WHY THE PREVIOUS VERSION FIRED ON EVERY BAR
// ----------------------------------------------------------------------------
// Three of the four gates were not gates at all.
//
//   LOCATION was "price is beyond the level". In a downtrend price sits under
//   VWAP -1sd for days, so that gate was permanently open. A level only means
//   something when price REACHES it and gets REJECTED - reached and rejected,
//   not merely passed.
//
//   PROOF for a sell was "not mfBull". Money flow is negative roughly half the
//   time, so that gate was open on a coin flip. The absence of the opposite is
//   not evidence. Proof now requires something that actually happened: a
//   divergence, absorption, or money flow CROSSING zero - an event, not a state.
//
//   COOLDOWN was six bars, so even a genuine setup re-fired repeatedly through
//   one swing.
//
// A level touched and rejected, a cross, positive evidence and a permitting
// regime is a rare combination. It should be.
// ============================================================================

// --- LOCATION: touched and rejected on this bar
f_rejUp(float lvl) =>
    bool outr = false
    if not na(lvl)
        // closing back above the level IS the rejection. Also demanding an up
        // candle threw away most higher-timeframe rejections, where the bar
        // often closes red after a deep wick.
        if low <= lvl + locTol and close > lvl
            if not csigNeedBody or close > open
                outr := true
    outr

f_rejDn(float lvl) =>
    bool outr = false
    if not na(lvl)
        if high >= lvl - locTol and close < lvl
            if not csigNeedBody or close < open
                outr := true
    outr

// ---------------------------------------------------------------------------
// WHY 1m AND 3m SIGNALLED BUT 15m AND 30m DID NOT
// The rejection had to happen on the SAME BAR as everything else. A 1m chart
// gets thirty times as many bars as a 30m chart, so it got thirty times as many
// chances to line that up. The criteria were bar-count dependent, which is the
// opposite of harmonised.
//
// A rejection now stays valid for csigWindow bars, exactly like the trigger, so
// the same setup registers on every timeframe.
// ---------------------------------------------------------------------------
bool rejLowNow = f_rejUp(priorVal) or f_rejUp(npocDn) or f_rejUp(ibL) or f_rejUp(priorLo)
bool rejHighNow = f_rejDn(priorVah) or f_rejDn(npocUp) or f_rejDn(ibH) or f_rejDn(priorHi)
if csigVwap
    if f_rejUp(vwapL1)
        rejLowNow := true
    if f_rejDn(vwapU1)
        rejHighNow := true
// The developing value area is deliberately NOT used as a signal location. It
// is computed on the last bar only, so including it gives the live bar a way to
// trigger that no historical bar ever had - live signals would appear that a
// reloaded chart could not reproduce.
//
// THE COMMENT HERE USED TO CLAIM HTF VALUE WAS SAFE. IT WAS NOT. htfDevVah and
// htfDevVal are built inside the same barstate.islast guard as devVah/devVal,
// so on every historical bar they are na and contribute nothing, while on the
// live bar they can open the location gate. That is precisely the live-only
// signal this section exists to prevent, and it was sitting under a comment
// asserting the opposite.
//
// htfVah / htfVal - the last COMPLETED higher-timeframe value area - are set at
// each HTF rollover and do exist on every bar. They were computed and then
// never used. They are the correct levels for a gate.
if htfOn
    if f_rejUp(htfVal)
        rejLowNow := true
    if f_rejDn(htfVah)
        rejHighNow := true
if balUseLoc and balActive
    // balPoc is NOT an entry. The point of control is where the auction found
    // its fairest price - maximum acceptance, minimum edge - so it is a TARGET
    // to rotate toward and a level to count in confluence, never a place to
    // initiate. Fading an extreme back to the POC is the trade; buying the POC
    // itself is buying the middle of the range. It was in this gate and that
    // was a straight violation of the model the script claims to run.
    // npocDn/npocUp stay: an UNTESTED POC is the opposite case, a price the
    // market never accepted, which is why it acts as a magnet.
    if f_rejUp(balLo)
        rejLowNow := true
    if f_rejDn(balHi)
        rejHighNow := true
// Absorption levels. Every other level in this gate says where price HAS BEEN -
// a prior value area edge, an untested POC, an initial balance. An absorption
// level says somebody actively defended a price and succeeded, which is a
// different kind of fact and the best argument for wiring the footprint engine
// in at all. Only CONFIRMED levels reach here; a candidate that has not held
// yet is not a level.
if ofLoc
    if f_rejUp(ofSupPx)
        rejLowNow := true
    if f_rejDn(ofResPx)
        rejHighNow := true
// Gamma walls. Unlike every other level in this gate these are not derived
// from this chart at all - they are somebody else's option book. That makes
// them genuinely independent evidence, and also the only levels here that can
// silently go stale, because nothing on the chart knows when you last updated
// them.
if gexLoc
    if f_rejUp(f_gx(gexPut)) or f_rejUp(f_gx(gexPut2)) or f_rejUp(f_gx(gexHvl))
        rejLowNow := true
    if f_rejDn(f_gx(gexCall)) or f_rejDn(f_gx(gexCall2)) or f_rejDn(f_gx(gexHvl))
        rejHighNow := true

// ---------------------------------------------------------------------------
// ALL FOUR GATES SHARE ONE WINDOW
// ---------------------------------------------------------------------------
// Location used to sit on the tight csigWindow while trigger and proof were
// widened to alignWin. The reasoning was "price must be at the level NOW" -
// and it was wrong, because the rejection and the oscillator pivot are the
// SAME swing low. Price wicks the level at bar N; the divergence measuring
// that same low cannot confirm until bar N+divLbR. With location closing after
// 3 bars and the divergence arriving on bar 5, the two could never coexist, so
// a divergence you can plainly see on the oscillator still produced no signal.
//
// If the four gates are meant to describe ONE event, they have to agree on how
// long that event lasts. alignWin is csigWindow + divLbR, so both inputs still
// control it.
int alignWin = csigWindow + divLbR

// ---------------------------------------------------------------------------
// CONFLUENCE - how many levels agree on this price?
// ---------------------------------------------------------------------------
// Every level counted here exists on EVERY bar, the same discipline the
// location test itself follows. The developing value area is excluded for the
// same reason: it is built on the last bar only, so counting it would make the
// live bar score higher than any historical bar ever could.
f_near(float a, float b, float tol) =>
    not na(a) and not na(b) and math.abs(a - b) <= tol

f_confluence(float px) =>
    // SATURATION: this used twice the location tolerance. On BTC at 79,800
    // with the default 0.12% that is a 190-point band, and roughly half the
    // tracked level set falls inside it during any ordinary range - the count
    // sat at 5 or 6 on both sides at once and discriminated nothing.
    //
    // It is now exactly locTol, which halves the band AND preserves a
    // necessary invariant: f_rejUp accepts a level within locTol of the low,
    // so the level that actually triggered the rejection is always counted.
    // Any tighter and confluence could read 0 on a genuine rejection, which
    // would close the gate on the very setup that opened it.
    //
    // If the count is still saturated on your instrument, lower Location
    // Tolerance itself - that tightens the rejection test and this band
    // together, which is the coherent way to do it.
    float tol = locTol
    int n = 0
    n += f_near(px, priorVah, tol) ? 1 : 0
    n += f_near(px, priorVal, tol) ? 1 : 0
    n += f_near(px, priorPoc, tol) ? 1 : 0
    n += f_near(px, priorHi,  tol) ? 1 : 0
    n += f_near(px, priorLo,  tol) ? 1 : 0
    n += f_near(px, npocUp,   tol) ? 1 : 0
    n += f_near(px, npocDn,   tol) ? 1 : 0
    n += f_near(px, ibH,      tol) ? 1 : 0
    n += f_near(px, ibL,      tol) ? 1 : 0
    n += f_near(px, vwapVal,  tol) ? 1 : 0
    n += f_near(px, vwapU1,   tol) ? 1 : 0
    n += f_near(px, vwapL1,   tol) ? 1 : 0
    n += f_near(px, htfVah,   tol) ? 1 : 0
    n += f_near(px, htfVal,   tol) ? 1 : 0
    n += f_near(px, htfPoc,   tol) ? 1 : 0
    if balActive
        n += f_near(px, balHi,  tol) ? 1 : 0
        n += f_near(px, balLo,  tol) ? 1 : 0
        n += f_near(px, balPoc, tol) ? 1 : 0
    // The golden pocket, and only if asked for. These are geometry, not volume,
    // so they are the one entry here that is opt-in - see the input tooltip.
    if gpConf
        n += f_near(px, gpF618, tol) ? 1 : 0
        n += f_near(px, gpF786, tol) ? 1 : 0
    if ofConf
        n += f_near(px, ofSupPx, tol) ? 1 : 0
        n += f_near(px, ofResPx, tol) ? 1 : 0
    if gexConf
        n += f_near(px, f_gx(gexCall),  tol) ? 1 : 0
        n += f_near(px, f_gx(gexPut),   tol) ? 1 : 0
        n += f_near(px, f_gx(gexCall2), tol) ? 1 : 0
        n += f_near(px, f_gx(gexPut2),  tol) ? 1 : 0
        n += f_near(px, f_gx(gexHvl),   tol) ? 1 : 0
        n += f_near(px, f_gx(gexFlip),  tol) ? 1 : 0
    n

int confLow  = f_confluence(low)
int confHigh = f_confluence(high)

// scored at the REJECTION bar, not now - the cluster that mattered is the one
// price actually wicked into, which may be several bars back
int confAtLowRej  = int(ta.valuewhen(rejLowNow,  confLow,  0))
int confAtHighRej = int(ta.valuewhen(rejHighNow, confHigh, 0))

// ta.barssince COUNTS BARS, so it has to be reached on every bar or the count
// it returns is wrong from then on. Behind an `and` it is not: the operator
// short-circuits, so on any bar where the left side is false the call never
// runs. That is the same trap f_inRange documents above, and it is why these
// two are hoisted here and referenced everywhere else rather than called again
// further down. Called once, unconditionally, at the top level.
int barsSinceRejLow  = ta.barssince(rejLowNow)
int barsSinceRejHigh = ta.barssince(rejHighNow)

bool atLowEdge  = barsSinceRejLow  <= alignWin and confAtLowRej  >= csigConfMin
bool atHighEdge = barsSinceRejHigh <= alignWin and confAtHighRej >= csigConfMin

// --- TRIGGER
bool crossUpOk = csigZoneOnly ? (wtCrossUp and wt2 <= wtOS1) : wtCrossUp
bool crossDnOk = csigZoneOnly ? (wtCrossDn and wt2 >= wtOB1) : wtCrossDn
// ---------------------------------------------------------------------------
// THE GATES HAVE TO AGREE ON WHAT "RECENTLY" MEANS
// ---------------------------------------------------------------------------
// A divergence is only KNOWN divLbR bars after the pivot that formed it - that
// delay is unavoidable, it is what makes the divergence non-repainting. With
// the defaults that is 5 bars, against a 3-bar trigger window. So by the time
// the divergence confirmed, the WaveTrend cross that belongs to the same event
// had already fallen outside the window, and the two could essentially never
// coincide. That is why a divergence plainly visible on the oscillator kept
// producing no signal.
//
// Hoisted for the reason spelled out above barsSinceRejLow, and then ignored
// when I wrote the strict gate: ta.barssince COUNTS BARS, so it has to be
// reached on EVERY bar. Inside f_evtBuy it sat behind two `and`s, and
// divProofBuy - the left-most term - is false on the overwhelming majority of
// bars, so the call almost never ran and the count it returned was wrong from
// the first skipped bar onward. That is the same trap this file documents twice
// and I walked into it a third time.
//
// It also explains the 8 trades. A corrupted barssince does not fail loudly; it
// returns a stale number, so the strict gate was testing the cross against a
// count that had stopped advancing.
int barsSinceCrossUp = ta.barssince(crossUpOk)
int barsSinceCrossDn = ta.barssince(crossDnOk)
bool trigBuy  = barsSinceCrossUp <= alignWin
bool trigSell = barsSinceCrossDn <= alignWin

// ---------------------------------------------------------------------------
// DIVERGENCE QUALITY
// ---------------------------------------------------------------------------
// A divergence says momentum disagreed with price. It does not say whether the
// disagreement mattered. These four checks ask that, from data the oscillators
// cannot reach, and they can only take signals away - at divMinQual 0 nothing
// below changes a single decision.
//
// The span is the swing ITSELF: from the previous confirmed pivot to the one
// that just completed the divergence. bar_index of the previous pivot comes
// back from f_divergence, so the offset is exact rather than a fixed window.
f_backFrom(int prevIdx) =>
    int b = bar_index - nz(prevIdx, bar_index)
    // 1 keeps it off the current bar; 480 keeps it inside max_bars_back
    b >= 1 and b <= 480 ? b : -1

// If both sources diverged, score the WaveTrend swing - it is the one the
// trigger gate is built on, so the two are talking about the same event.
int bullBack = f_backFrom(wtBullDiv ? wtPLI : cvPLI)
int bearBack = f_backFrom(wtBearDiv ? wtPHI : cvPHI)
// A ternary does not stop Pine from evaluating the history access on the dead
// branch, and a negative offset is a runtime error, not an na. The offsets are
// therefore always legal and the -1 is carried in the guard alone.
int bullOff = math.max(1, bullBack)
int bearOff = math.max(1, bearBack)

// --- 1. participation: was the new extreme made on less volume than the old one
float volAtPivot = volume[divLbR]
float volPrevBull = bullBack > 0 ? volume[bullOff] : na
float volPrevBear = bearBack > 0 ? volume[bearOff] : na
bool qPartBull = divQPart and not na(volPrevBull) and volPrevBull > 0 and volAtPivot < volPrevBull * divVolFrac
bool qPartBear = divQPart and not na(volPrevBear) and volPrevBear > 0 and volAtPivot < volPrevBear * divVolFrac

// --- 2. open interest across the swing: closing flow, not new positioning
float oiAtPivot  = oiOk ? oiClose[divLbR] : na
float oiPrevBull = (oiOk and bullBack > 0) ? oiClose[bullOff] : na
float oiPrevBear = (oiOk and bearBack > 0) ? oiClose[bearOff] : na
bool qOiBull = divQOi and not na(oiPrevBull) and not na(oiAtPivot) and oiAtPivot < oiPrevBull
bool qOiBear = divQOi and not na(oiPrevBear) and not na(oiAtPivot) and oiAtPivot < oiPrevBear

// --- 3. the divergence is at a level worth reversing against
// barsSinceRejLow / High, not a second ta.barssince call - see the hoist above.
bool qLocBull = divQLoc and confAtLowRej  >= csigConfMin and barsSinceRejLow  <= alignWin
bool qLocBear = divQLoc and confAtHighRej >= csigConfMin and barsSinceRejHigh <= alignWin

// --- 4. the correlated market did not confirm the new extreme
// With Invert ON the reference is expected to move the OTHER way, so "did not
// confirm this low" becomes "did not make the matching HIGH".
float refAtPivot  = refOk ? refClose[divLbR] : na
float refPrevBull = (refOk and bullBack > 0) ? refClose[bullOff] : na
float refPrevBear = (refOk and bearBack > 0) ? refClose[bearOff] : na
bool qRefBull = refOk and not na(refPrevBull) and not na(refAtPivot) and
     (divRefInv ? refAtPivot <= refPrevBull : refAtPivot >= refPrevBull)
bool qRefBear = refOk and not na(refPrevBear) and not na(refAtPivot) and
     (divRefInv ? refAtPivot >= refPrevBear : refAtPivot <= refPrevBear)

int divQualBuy  = (qPartBull ? 1 : 0) + (qOiBull ? 1 : 0) + (qLocBull ? 1 : 0) + (qRefBull ? 1 : 0)
int divQualSell = (qPartBear ? 1 : 0) + (qOiBear ? 1 : 0) + (qLocBear ? 1 : 0) + (qRefBear ? 1 : 0)

// The gate. At divMinQual 0 this is exactly the old expression.
bool divProofBuy  = (cvBullDiv or wtBullDiv) and divQualBuy  >= divMinQual
bool divProofSell = (cvBearDiv or wtBearDiv) and divQualSell >= divMinQual

// --- PROOF: an event, never a state
bool mfTurnUp = ta.crossover(mfRaw, 0)
bool mfTurnDn = ta.crossunder(mfRaw, 0)
// LOGIC ERROR FOUND: dnaAbsorb appeared in BOTH proofs. Absorption as computed
// is directionless, so it satisfied the evidence gate for a buy and a sell at
// the same time - a free pass to whichever side happened to have the other
// three gates open. Absorption on an up bar supports buying, on a down bar
// supports selling; it cannot support both.
bool absorbUp = dnaAbsorb and close >= open
bool absorbDn = dnaAbsorb and close <  open
// PROOF WAS INSTANTANEOUS. Location and trigger each stayed valid for a window
// of bars; proof counted only on the exact bar it fired. Three gates that
// persist and one that does not can only line up by luck, which is the whole
// of the "there is a divergence but no signal" complaint.
// ofBull / ofBear are the footprint's delta divergence: the bar closed one way
// while the aggressive flow went the other, so that flow was absorbed. It is
// the only entry in this list that is not derived from this symbol's own price
// curve, which is exactly why it is worth having - and why it is off until you
// have measured it.
bool ofProofBuy  = ofProof and ofBull
bool ofProofSell = ofProof and ofBear
bool proofBuyNow  = divProofBuy  or absorbUp or mfTurnUp or oiProofBuy  or ofProofBuy
bool proofSellNow = divProofSell or absorbDn or mfTurnDn or oiProofSell or ofProofSell
bool proofBuy  = ta.barssince(proofBuyNow)  <= alignWin
bool proofSell = ta.barssince(proofSellNow) <= alignWin

// --- CONTEXT
bool ctxBuy  = true
bool ctxSell = true
if csigStrict
    // regimeLive, not regime - the displayed one is blank on historical bars
    ctxBuy  := not imbDn
    ctxSell := not imbUp

// ---------------------------------------------------------------------------
// SAME EVENT
// ---------------------------------------------------------------------------
// The window mode asks each gate "did this happen recently" and lets recently
// mean eight bars, independently, in any order. Four things that each happened
// sometime this week is not four confirmations of one event - and measured
// against a twenty-bar cooldown it qualifies often enough that the cooldown,
// not the logic, decides which trades are taken.
//
// This anchors on the divergence instead. A divergence is KNOWN divLbR bars
// after the pivot it measures; that lag is unavoidable and it is exactly what
// makes it non-repainting. So the signal is evaluated on the bar the
// divergence confirms, and the other two gates have to belong to the pivot
// that divergence just measured:
//
//   the rejection happened divLbR bars ago, give or take gateTol
//   the momentum cross happened no earlier than that same pivot
//
// and PROOF is the divergence itself. Not one of five. The whole reason this
// script exists is the divergence; if it cannot carry a signal on its own then
// that is worth knowing plainly rather than hiding behind an OR with
// money-flow-crosses-zero, which fires every ten or twenty bars regardless.
// Every barssince here is a HOISTED value, never a fresh call. A call placed
// behind an `and` in this expression would be short-circuited away on most
// bars and would return a stale count forever after.
f_evtBuy() =>
    divProofBuy and math.abs(barsSinceRejLow - divLbR) <= gateTol and barsSinceCrossUp <= divLbR + gateTol and confAtLowRej >= csigConfMin

f_evtSell() =>
    divProofSell and math.abs(barsSinceRejHigh - divLbR) <= gateTol and barsSinceCrossDn <= divLbR + gateTol and confAtHighRej >= csigConfMin

bool strictMode = gateMode == "Same event (strict)"
bool evtBuy  = strictMode and f_evtBuy()
bool evtSell = strictMode and f_evtSell()

int gatesBuy  = (ctxBuy ? 1 : 0) + (atLowEdge ? 1 : 0) + (trigBuy ? 1 : 0) + (proofBuy ? 1 : 0)
int gatesSell = (ctxSell ? 1 : 0) + (atHighEdge ? 1 : 0) + (trigSell ? 1 : 0) + (proofSell ? 1 : 0)

int needGates = 4
if csigSens == "Standard (3 of 4)"
    needGates := 3
else if csigSens == "Loose (location + trigger)"
    needGates := 2

// location and trigger are never optional, whatever the sensitivity
// Strict replaces the window test outright; context is the one gate it keeps,
// because "the regime permits this direction" is a state, not an event.
bool rawBuySig  = csigOn and (strictMode ? (evtBuy  and ctxBuy)  : (atLowEdge  and trigBuy  and gatesBuy  >= needGates))
bool rawSellSig = csigOn and (strictMode ? (evtSell and ctxSell) : (atHighEdge and trigSell and gatesSell >= needGates))

// LOGIC ERROR FOUND: these were independent, so a wide bar that touched a low
// level AND a high level satisfied both location tests and printed BUY and SELL
// on the same candle. Two contradictory instructions is worse than none.
// When both sides qualify the evidence is genuinely conflicting, so neither is
// shown and the ACTION row says so.
bool sigConflict = rawBuySig and rawSellSig
if sigConflict
    rawBuySig := false
    rawSellSig := false
// NOISE GATE. A target three times the risk away is unreachable while price is
// travelling three units to net one. This blocks both sides equally - chop is
// not directional.
if csigNoiseOn and effRatio < csigErMin
    rawBuySig := false
    rawSellSig := false

// OPEN INTEREST VETO. A squeeze into resistance and genuine buying into
// resistance are the same picture on price and opposite trades. When OI is
// RISING with price the bid is real positioning, not short covering, and
// selling it is standing in front of it. Same logic inverted for buys.
if oiVetoBuy
    rawBuySig := false
if oiVetoSell
    rawSellSig := false

if riskOn and riskMinR > 0
    // a setup whose target is nearer than the stop is not a setup
    if not rkOkL
        rawBuySig := false
    if not rkOkS
        rawSellSig := false

// ---------------------------------------------------------------------------
// ONE TRADE AT A TIME
// ---------------------------------------------------------------------------
// Nothing previously stopped a BUY firing while a SELL was still running. The
// two sets of stop and target boxes then sat on top of each other and the
// chart was telling you to be long and short at the same time. Same-bar
// conflicts were already suppressed; this is the case where they overlap in
// TIME rather than on one candle, which is the one you kept hitting.
//
// wantBuy / wantSell are captured BEFORE the suppression, because a fully
// qualified opposite signal is what invalidates an open trade even when it is
// not itself allowed to open a new one.
bool wantBuy  = rawBuySig
bool wantSell = rawSellSig

// ---------------------------------------------------------------------------
// A REVERSAL CLOSE MUST BE AN EVENT, NOT A STATE
// ---------------------------------------------------------------------------
// wantSell is built from gates that all sit on alignWin, so once the sell side
// qualifies it STAYS qualified for the whole window. When location was widened
// from csigWindow to alignWin so divergences could complete, that window
// doubled - and both sides now overlap constantly. The consequence is visible
// in the statistics: reversal closes went from 8 of 120 trades, averaging
// +1.12R and carrying the whole result, to 150 of 297 averaging +0.03R. The
// exit stopped being selective and became churn.
//
// An ENTRY needs a window, because four pieces of evidence arriving on exactly
// one bar is too much to ask. An EXIT does not: "the opposite side has been
// qualified for the last eight bars" is not news, it is the same fact being
// re-read. Requiring the opposite TRIGGER to fire on this bar turns the close
// back into a genuine event - the cross that says the move has turned, not the
// lingering memory of one.
// I hardcoded the momentum-cross requirement last round and called it a fix.
// It was a hypothesis, and the arithmetic did not support it: 150 flats
// returned +4.8R, or +0.032R each, while 145 resolved trades returned -5.1R,
// or -0.035R each. Cutting early was the BETTER of the two buckets, so making
// flips rarer pushes trades into the worse one. I had anchored on an earlier
// 8-flat sample averaging +1.12R and read a larger sample regressing to the
// mean as degradation.
//
// It is now selectable and defaults to the behaviour those 297 trades were
// actually measured on, so nothing silently swaps a measured result for an
// unmeasured one.
bool flipCross = csigFlipMode == "Opposite momentum cross"
bool flipLong  = csigFlip and anyLongOpen  and wantSell and (not flipCross or crossDnOk)
bool flipShort = csigFlip and anyShortOpen and wantBuy  and (not flipCross or crossUpOk)
bool closeOnReversal = flipLong or flipShort

if csigOneTrade and (anyLongOpen or anyShortOpen)
    rawBuySig := false
    rawSellSig := false

var int lastBuyBar = -9999
var int lastSellBar = -9999
// ============================================================================
// 19h2. GATE AUDIT
// ----------------------------------------------------------------------------
// A rule set is only its rules if the rules are what select the trades. If all
// four gates stand open on a large share of bars then the hierarchy is not
// choosing anything - the cooldown is - and "four independent confirmations"
// describes the comment block rather than the code.
//
// An array rather than sixteen scalars for the usual reason: a Pine function
// may not assign a global but may mutate an array it is handed, and the tally
// has to live in a function to keep the main body under the size cap.
// ============================================================================
var array<float> gaud = array.new<float>(16, 0.0)

f_audit(bool cB, bool lB, bool tB, bool pB, bool sB,
         bool cS, bool lS, bool tS, bool pS, bool sS,
         bool pDiv, bool pMf, bool pAbs) =>
    gaud.set(0,  gaud.get(0)  + 1)
    gaud.set(1,  gaud.get(1)  + (cB ? 1 : 0))
    gaud.set(2,  gaud.get(2)  + (lB ? 1 : 0))
    gaud.set(3,  gaud.get(3)  + (tB ? 1 : 0))
    gaud.set(4,  gaud.get(4)  + (pB ? 1 : 0))
    gaud.set(5,  gaud.get(5)  + (cB and lB and tB and pB ? 1 : 0))
    gaud.set(6,  gaud.get(6)  + (sB ? 1 : 0))
    gaud.set(7,  gaud.get(7)  + (cS ? 1 : 0))
    gaud.set(8,  gaud.get(8)  + (lS ? 1 : 0))
    gaud.set(9,  gaud.get(9)  + (tS ? 1 : 0))
    gaud.set(10, gaud.get(10) + (pS ? 1 : 0))
    gaud.set(11, gaud.get(11) + (cS and lS and tS and pS ? 1 : 0))
    gaud.set(12, gaud.get(12) + (sS ? 1 : 0))
    gaud.set(13, gaud.get(13) + (pDiv ? 1 : 0))
    gaud.set(14, gaud.get(14) + (pMf  ? 1 : 0))
    gaud.set(15, gaud.get(15) + (pAbs ? 1 : 0))

bool chartBuy = false
bool chartSell = false
if rawBuySig and bar_index - lastBuyBar > csigCool
    chartBuy := true
    lastBuyBar := bar_index
if rawSellSig and bar_index - lastSellBar > csigCool
    chartSell := true
    lastSellBar := bar_index

// Tally AFTER cooldown, so the gap between "all four gates open" and "a signal
// fired" is exactly the number of setups the cooldown threw away.
if audOn and barClosed
    f_audit(ctxBuy, atLowEdge, trigBuy, proofBuy, chartBuy, ctxSell, atHighEdge, trigSell, proofSell, chartSell, divProofBuy, mfTurnUp, absorbUp)


// --- draw the trade
// The boxes used to be kept on a rolling queue of twelve, so a trade that had
// already hit its target or stop kept showing its risk/reward zones for another
// eleven signals. They are now tied to the trade and deleted the moment it
// resolves.
var array<TradeDraw> opDraw = array.new<TradeDraw>()

f_drawTrade(bool isLong, float e, float st, float tg, float rr) =>
    box tb = box.new(bar_index, tg, bar_index + riskExtend, e, bgcolor=cRiskTgt,
         border_color=color(na), force_overlay=true)
    box sb = box.new(bar_index, e, bar_index + riskExtend, st, bgcolor=cRiskStop,
         border_color=color(na), force_overlay=true)
    label lb = label.new(bar_index + riskExtend, tg,
         (isLong ? "LONG " : "SHORT ") + str.tostring(rr, "#.##") + "R\ne " + str.tostring(e, format.mintick) +
         "\nsl " + str.tostring(st, format.mintick) + "\ntp " + str.tostring(tg, format.mintick),
         xloc=xloc.bar_index, style=label.style_label_left,
         color=color.new(#131722, 15), textcolor=isLong ? cBuySig : cSellSig,
         size=size.tiny, force_overlay=true)
    opDraw.push(TradeDraw.new(tb, sb, lb))

// ============================================================================
// 19i. STATISTICS
// ----------------------------------------------------------------------------
// Every claim this script makes - poor highs get revisited, excess holds,
// balance breaks follow through, signals work - is a CLAIM until it is counted
// on YOUR instrument. This counts them.
//
// Read the sample size before the percentage. Under about 20 occurrences these
// numbers mean nothing at all, and a confident-looking 71% from 7 events is
// worse than no number.
// ============================================================================

// --- a fully qualified opposite signal invalidates the open thesis. Close it
// at market and book whatever R it actually made, rather than leaving it to
// drift to a stop the setup no longer supports.
// A pending order is a commitment the gate already counts, but it is not in
// the ledger yet, so the loop below could never reach it. Without this, the
// system would decide the opposite side had won and then still buy the next
// open on an order it had already disowned.
if closeOnReversal and barClosed
    if pendLong and wantSell
        pendLong := false
        sigSkip  += 1
    if pendShort and wantBuy
        pendShort := false
        sigSkip   += 1

// Moved into a function to keep the main body under Pine's size cap.
f_closeReversals() =>
    for i = opEntry.size() - 1 to 0
        int d = opDir.get(i)
        bool invalid = (d == 1 and wantSell) or (d == -1 and wantBuy)
        if invalid
            float rk = opRisk.get(i)
            float en = opEntry.get(i)
            float flatR = rk > 0 ? (d == 1 ? close - en : en - close) / rk : 0.0
            f_ledAdd(LG_REALR, flatR)
            f_ledAdd(LG_RFLAT, flatR)
            f_ledAdd(LG_PLANR, nz(opRPlan.get(i)))
            f_ledAdd(LG_NCL, 1)
            f_ledAdd(LG_FLAT, 1)
            if riskOn and opDraw.size() > i
                TradeDraw tdf = opDraw.get(i)
                box.delete(tdf.tgtBox)
                box.delete(tdf.stopBox)
                label.delete(tdf.info)
                opDraw.remove(i)
            opEntry.remove(i)
            opStop.remove(i)
            opTgt.remove(i)
            opDir.remove(i)
            opBar.remove(i)
            opRisk.remove(i)
            opRPlan.remove(i)


bool fillNextOpen = riskFill == "Next bar open (realistic)"

// --- fill whatever was pending, at THIS bar's open. The stop and target are
// structural levels chosen by the auction, so they do not move with the fill -
// but R does, and R computed from a price you could actually get is the only
// honest one.
//
// Long and short are filled by SEPARATE blocks. To be accurate about why: the
// two can never currently both be pending, because a same-bar conflict is
// suppressed upstream and the fill always clears the flag before a new signal
// can set one. So this is not fixing an observed bug - it is removing a shared
// pendStop / pendTgt trap that a single shared block depended on, which would
// have silently dropped one of the two the moment that upstream guard changed.
float fillSlip = riskSlipT * syminfo.mintick

// returns true if the fill was taken
f_fillPending(bool isLong, float st, float tg) =>
    float fillP = isLong ? open + fillSlip : open - fillSlip
    float fRisk = isLong ? fillP - st : st - fillP
    float fR    = fRisk > 0 ? (isLong ? tg - fillP : fillP - tg) / fRisk : na
    bool taken = not na(fR) and fR >= rMinEps
    if taken
        opEntry.push(fillP)
        opStop.push(st)
        opTgt.push(tg)
        opDir.push(isLong ? 1 : -1)
        opBar.push(bar_index)
        opRisk.push(fRisk)
        opRPlan.push(fR)
        if riskOn
            f_drawTrade(isLong, fillP, st, tg, fR)
    taken

// The take-profit marker is derived from THIS loop rather than from a second
// parallel ledger of its own. That duplicate ledger was pushed at signal time,
// so once fills moved to the next open it could mark a target reached for a
// trade that was never actually taken.
bool tpHit = false

// Moved into a function to keep the main body under Pine's size cap. tpHit
// comes back as a return value because a function may not write a global.
f_manageTrades() =>
    bool hit = false
    for i = opEntry.size() - 1 to 0
        int d = opDir.get(i)
        float st = opStop.get(i)
        float tg = opTgt.get(i)
        float en = opEntry.get(i)
        float rk = opRisk.get(i)
        bool done = false
        // realised R: a stop is exactly -1R by construction, a target is the R
        // that was drawn on the chart when the trade was taken, and an expiry
        // is marked to market. Every closed trade contributes, so the average
        // is the real one and not a survivor's.
        float realR = 0.0
        int   outc  = 0
        if d == 1
            if low <= st
                f_ledAdd(LG_LOSS, 1)
                realR := -1.0
                outc  := 2
                done := true
            else if high >= tg
                f_ledAdd(LG_WIN, 1)
                hit := true
                realR := opRPlan.get(i)
                outc  := 1
                done := true
        else
            if high >= st
                f_ledAdd(LG_LOSS, 1)
                realR := -1.0
                outc  := 2
                done := true
            else if low <= tg
                f_ledAdd(LG_WIN, 1)
                hit := true
                realR := opRPlan.get(i)
                outc  := 1
                done := true
        // MEASUREMENT ERROR FOUND: a trade that reached neither target nor stop
        // within the horizon used to be deleted silently. It disappeared from
        // the denominator entirely, so the win rate was computed only over
        // trades that resolved - systematically overstating it. Expired trades
        // are now counted and shown.
        if not done and bar_index - opBar.get(i) > statHorizon
            f_ledAdd(LG_EXP, 1)
            realR := rk > 0 ? (d == 1 ? close - en : en - close) / rk : 0.0
            outc  := 3
            done := true
        if done
            // remove the drawings with the trade - this is the cleanup that was
            // missing, which is why finished trades kept showing their boxes
            if riskOn and opDraw.size() > i
                TradeDraw td = opDraw.get(i)
                box.delete(td.tgtBox)
                box.delete(td.stopBox)
                label.delete(td.info)
                opDraw.remove(i)
            f_ledAdd(LG_REALR, realR)
            if outc == 1
                f_ledAdd(LG_RWIN, realR)
            else if outc == 2
                f_ledAdd(LG_RLOSS, realR)
            else
                f_ledAdd(LG_REXP, realR)
            f_ledAdd(LG_PLANR, nz(opRPlan.get(i)))
            f_ledAdd(LG_NCL, 1)
            opEntry.remove(i)
            opStop.remove(i)
            opTgt.remove(i)
            opDir.remove(i)
            opBar.remove(i)
            opRisk.remove(i)
            opRPlan.remove(i)
    hit

// if the market opened past the stop, or the move to the open ate enough of the
// edge that the setup no longer clears its own minimum, it is not a trade any
// more. Counted as unfilled, not hidden.
if barClosed and pendLong
    if not f_fillPending(true, pendStop, pendTgt)
        sigSkip += 1
    pendLong := false
if barClosed and pendShort
    if not f_fillPending(false, pendStop, pendTgt)
        sigSkip += 1
    pendShort := false

// ----------------------------------------------------------------------------
// ORDER OF EVENTS INSIDE ONE BAR. This sequence is the whole point, and it used
// to be scrambled: the reversal close ran FIRST, at the top of the block, then
// the fill, then new signals, and stops and targets were resolved LAST, three
// hundred lines further down. Two things were wrong with that.
//
// ONE - a trade the bar had already STOPPED OUT could be flat-closed by a
// reversal signal before anything looked at the low. The stop is touched
// intrabar; the reversal close marks to the CLOSE. So a trade that lost its
// full 1R was booked at whatever the close happened to be, which on a reversal
// bar is usually far better. That is an optimistic bias, it lands entirely in
// the flat bucket, and the flat bucket is exactly what the reversal-close
// setting is judged on.
//
// TWO - in "Signal bar close" fill mode a trade was pushed and then resolved
// against the SAME bar's high and low. Those extremes happened BEFORE the entry
// price existed. That is look-ahead: the trade could be recorded as hitting a
// target on a high it was never live for.
//
// Chronological order within the bar is open, then intrabar, then close:
//   1. fill what was pending, at this bar's OPEN            (above)
//   2. resolve stops and targets against this bar's RANGE   (here)
//   3. flat-close what a reversal invalidates, at the CLOSE (here)
//   4. arm the next signal                                  (below)
//
// Step 2 before step 3 means a stop that was touched wins over the flat. Step 2
// before step 4 means a trade entered at the close cannot resolve on the bar it
// was entered on, which is what removes the look-ahead. A trade FILLED at this
// bar's open is still resolved on this bar, correctly - it was live for the
// whole range.
// ----------------------------------------------------------------------------
if opEntry.size() > 0 and barClosed
    tpHit := f_manageTrades()

if closeOnReversal and barClosed and opEntry.size() > 0
    f_closeReversals()

if chartBuy and not na(rkTgtL) and barClosed
    if fillNextOpen
        pendLong := true
        pendStop := rkStopL
        pendTgt  := rkTgtL
    else
        opEntry.push(rkEntry)
        opStop.push(rkStopL)
        opTgt.push(rkTgtL)
        opDir.push(1)
        opBar.push(bar_index)
        opRisk.push(rkRiskL)
        opRPlan.push(rkRL)
        if riskOn
            f_drawTrade(true, rkEntry, rkStopL, rkTgtL, rkRL)
if chartSell and not na(rkTgtS) and barClosed
    if fillNextOpen
        pendShort := true
        pendStop  := rkStopS
        pendTgt   := rkTgtS
    else
        opEntry.push(rkEntry)
        opStop.push(rkStopS)
        opTgt.push(rkTgtS)
        opDir.push(-1)
        opBar.push(bar_index)
        opRisk.push(rkRiskS)
        opRPlan.push(rkRS)
        if riskOn
            f_drawTrade(false, rkEntry, rkStopS, rkTgtS, rkRS)


sigOpen := opEntry.size()

// ---------------------------------------------------------------------------
// UNREALISED R ON THE OPEN TRADE - the one number live trading needs and the
// table did not have.
// ---------------------------------------------------------------------------
// Everything here reports on trades that have ALREADY closed. While a trade is
// running the only readout was a count, so the position that is currently up
// 1.2R and the one that is down 0.7R looked identical.
//
// That matters specifically because of what the R breakdown shows: trades reach
// profit and hand it back before the structural target. Seeing that happen live
// is the difference between taking the move and watching it go.
float openR = na
if opEntry.size() > 0
    int li = opEntry.size() - 1
    float oEn = opEntry.get(li)
    float oRk = opRisk.get(li)
    int   oDr = opDir.get(li)
    if oRk > 0
        openR := (oDr == 1 ? close - oEn : oEn - close) / oRk

// Expectancy is the number that decides whether any of this is worth trading.
// Positive means the edge pays; negative means a higher hit rate would still
// be losing money, which is exactly the case a raw win percentage hides.
// Plain copies of the ledger, taken AFTER both accumulating blocks have run on
// this bar and BEFORE anything reads them. Every existing read site is
// untouched by the array underneath.
int   sigWin     = int(ledger.get(LG_WIN))
int   sigLoss    = int(ledger.get(LG_LOSS))
int   sigExpired = int(ledger.get(LG_EXP))
int   sigFlat    = int(ledger.get(LG_FLAT))
int   nClosed    = int(ledger.get(LG_NCL))
float sumRealR   = ledger.get(LG_REALR)
float sumPlanR   = ledger.get(LG_PLANR)
float sumRWin    = ledger.get(LG_RWIN)
float sumRLoss   = ledger.get(LG_RLOSS)
float sumRExp    = ledger.get(LG_REXP)
float sumRFlat   = ledger.get(LG_RFLAT)

float expectR = nClosed > 0 ? sumRealR / nClosed : na
float avgPlanR = nClosed > 0 ? sumPlanR / nClosed : na

// --- does a POOR extreme really get revisited?
var int poorHiTotal = 0
var int poorHiHit = 0
var int poorLoTotal = 0
var int poorLoHit = 0
var float poorHiLvl = na
var int poorHiBar = na
var float poorLoLvl = na
var int poorLoBar = na

if isNewPeriod and priorHighQual == "POOR" and not na(priorHiLvl)
    poorHiLvl := priorHiLvl
    poorHiBar := bar_index
    poorHiTotal += 1
if not na(poorHiLvl)
    if high >= poorHiLvl
        poorHiHit += 1
        poorHiLvl := na
    else if bar_index - poorHiBar > statHorizon
        poorHiLvl := na

if isNewPeriod and priorLowQual == "POOR" and not na(priorLoLvl)
    poorLoLvl := priorLoLvl
    poorLoBar := bar_index
    poorLoTotal += 1
if not na(poorLoLvl)
    if low <= poorLoLvl
        poorLoHit += 1
        poorLoLvl := na
    else if bar_index - poorLoBar > statHorizon
        poorLoLvl := na

// --- does a balance break actually follow through?
var int balTotal = 0
var int balHold = 0
var float balBrkLvl = na
var int balBrkBar = na
var int balBrkDir = 0
if balBreakUp or balBreakDn
    balTotal += 1
    balBrkLvl := balBreakUp ? balHi : balLo
    balBrkBar := bar_index
    balBrkDir := balBreakUp ? 1 : -1
if not na(balBrkLvl)
    float need = atr14 * 1.5
    if balBrkDir == 1
        if close > balBrkLvl + need
            balHold += 1
            balBrkLvl := na
        else if close < balBrkLvl
            balBrkLvl := na
    else
        if close < balBrkLvl - need
            balHold += 1
            balBrkLvl := na
        else if close > balBrkLvl
            balBrkLvl := na
    if not na(balBrkLvl) and bar_index - balBrkBar > statHorizon
        balBrkLvl := na

f_pct(int hit, int tot) =>
    // INT DIVISION BUG: hit and tot are both int, so hit / tot truncated to 0
    // or 1 BEFORE the multiply. Every percentage in this table could therefore
    // only ever read 0% or 100%. Multiplying first keeps it in floating point.
    tot > 0 ? str.tostring(math.round(hit * 100.0 / tot)) + "%  (" + str.tostring(tot) + ")" : "-"

var table stat = table.new(f_tablePos(statPos), 2, 15, bgcolor=cTblBg,
     border_color=color.new(#000000, 75), border_width=1,
     frame_color=color.new(#000000, 50), frame_width=1, force_overlay=true)

// Pine requires functions at global scope - this cannot live inside the if
// block that uses it.
f_pair2(int r, string k, string v, color c) =>
    table.cell(stat, 0, r, k, text_color=color.new(cTxt, 40), text_size=size.tiny, text_halign=text.align_left)
    table.cell(stat, 1, r, v, text_color=c, text_size=size.tiny, text_halign=text.align_right)

var table aud = table.new(f_tablePos(audPos),
     2, 13, bgcolor=cTblBg, border_color=color.new(#000000, 75), border_width=1,
     frame_color=color.new(#000000, 50), frame_width=1, force_overlay=true)

f_aud(int r, string k, string v, color c) =>
    table.cell(aud, 0, r, k, text_color=color.new(cTxt, 40), text_size=size.tiny, text_halign=text.align_left)
    table.cell(aud, 1, r, v, text_color=c, text_size=size.tiny, text_halign=text.align_right)

f_audPct(float hit, float tot) =>
    tot > 0 ? str.tostring(math.round(hit * 100.0 / tot)) + "%" : "-"

f_drawAudit() =>
    float bars = gaud.get(0)
    // A gate open on most bars is not a gate. Red is the warning.
    f_aud(0, "GATE AUDIT", str.tostring(int(bars)) + " bars", cTxt)
    f_aud(1, "Context open",  f_audPct(gaud.get(1), bars) + " / " + f_audPct(gaud.get(7), bars),
         gaud.get(1) > bars * 0.8 ? C_DN : C_NE)
    f_aud(2, "Location open", f_audPct(gaud.get(2), bars) + " / " + f_audPct(gaud.get(8), bars),
         gaud.get(2) > bars * 0.5 ? C_DN : C_NE)
    f_aud(3, "Trigger open",  f_audPct(gaud.get(3), bars) + " / " + f_audPct(gaud.get(9), bars),
         gaud.get(3) > bars * 0.5 ? C_DN : C_NE)
    f_aud(4, "Proof open",    f_audPct(gaud.get(4), bars) + " / " + f_audPct(gaud.get(10), bars),
         gaud.get(4) > bars * 0.7 ? C_DN : C_NE)
    f_aud(5, "ALL FOUR open", f_audPct(gaud.get(5), bars) + " / " + f_audPct(gaud.get(11), bars),
         gaud.get(5) > bars * 0.1 ? C_DN : C_UP)
    f_aud(6, "Signals fired", str.tostring(int(gaud.get(6))) + " / " + str.tostring(int(gaud.get(12))), cTxt)
    // The number that decides whether the logic or the cooldown is the strategy.
    float qual = gaud.get(5) + gaud.get(11)
    float took = gaud.get(6) + gaud.get(12)
    f_aud(7, "Cooldown discarded", str.tostring(int(qual - took)) + "  (" + f_audPct(qual - took, qual) + ")",
         qual > 0 and (qual - took) / qual > 0.8 ? C_DN : C_NE)
    f_aud(8, "PROOF came from", "", color.new(cTxt, 40))
    float pd = gaud.get(13)
    float pm = gaud.get(14)
    float pa = gaud.get(15)
    float ptot = pd + pm + pa
    f_aud(9,  "  divergence", str.tostring(int(pd)) + "  " + f_audPct(pd, ptot), ptot > 0 and pd / ptot < 0.2 ? C_DN : C_UP)
    f_aud(10, "  money flow", str.tostring(int(pm)) + "  " + f_audPct(pm, ptot), C_NE)
    f_aud(11, "  absorption", str.tostring(int(pa)) + "  " + f_audPct(pa, ptot), C_NE)
    f_aud(12, "red = too permissive", "", color.new(cTxt, 55))

// Moved into a function to keep the main body under Pine's size cap.
f_drawStats() =>
    table.cell(stat, 0, 0, "MEASURED ON THIS CHART", text_color=cTxt, text_size=size.tiny, text_halign=text.align_left)
    table.cell(stat, 1, 0, str.tostring(statHorizon) + "b" + (sigSkip > 0 ? "  " + str.tostring(sigSkip) + " unfilled" : ""),
         text_color=color.new(cTxt, 50), text_size=size.tiny, text_halign=text.align_right)

    int sigTot = sigWin + sigLoss
    int sigAll = sigWin + sigLoss + sigExpired + sigFlat
    f_pair2(1, "Hit target (resolved)", f_pct(sigWin, sigTot), sigTot < 20 ? C_NE : (sigWin * 2 > sigTot ? C_UP : C_DN))
    f_pair2(2, "Hit target (all)", f_pct(sigWin, sigAll), sigAll < 20 ? C_NE : C_WN)
    f_pair2(3, "Win/Loss/Exp/Flat", str.tostring(sigWin) + "/" + str.tostring(sigLoss) + "/" +
         str.tostring(sigExpired) + "/" + str.tostring(sigFlat), C_NE)
    // THE row. Under 20 closed trades it is grey, because it means nothing yet.
    color expCol = nClosed < 20 ? C_NE : (nz(expectR) > 0 ? C_UP : C_DN)
    f_pair2(4, "Expectancy  R/trade", na(expectR) ? "-" : str.tostring(expectR, "#.##") + "R", expCol)
    f_pair2(5, "Total R", na(expectR) ? "-" : (sumRealR >= 0 ? "+" : "") + str.tostring(sumRealR, "#.#") + "R", expCol)
    f_pair2(6, "Avg R targeted", na(avgPlanR) ? "-" : str.tostring(avgPlanR, "#.##") + "R", C_NE)
    // WHERE the R went. If wins minus losses is positive while the total is
    // not, the entries are finding an edge and the EXITS are handing it back.
    f_pair2(7, "R  win / loss",
         (sumRWin >= 0 ? "+" : "") + str.tostring(sumRWin, "#.#") + " / " + str.tostring(sumRLoss, "#.#"),
         sumRWin + sumRLoss > 0 ? C_UP : C_DN)
    f_pair2(8, "R  expired / flat",
         str.tostring(sumRExp, "#.#") + " / " + str.tostring(sumRFlat, "#.#"),
         sumRExp + sumRFlat > 0 ? C_UP : C_DN)
    f_pair2(9, "Poor high revisited", f_pct(poorHiHit, poorHiTotal), poorHiTotal < 20 ? C_NE : C_WN)
    f_pair2(10, "Poor low revisited", f_pct(poorLoHit, poorLoTotal), poorLoTotal < 20 ? C_NE : C_WN)
    f_pair2(11, "Balance break held", f_pct(balHold, balTotal), balTotal < 20 ? C_NE : C_UP)
    // THE CAP, STATED RATHER THAN INFERRED.
    // "Avg R targeted" cannot tell you whether the cap is on, and I spent
    // several rounds wrongly insisting it could. With next-bar-open fills the R
    // is recomputed from the FILL, not the signal: an open that gaps against
    // you shrinks the distance to the stop and stretches the distance to the
    // target, so the realised R goes UP even though the target price was
    // capped. And the minimum-R filter then discards the favourable gaps, which
    // shrink R below the floor, while keeping the adverse ones. The average is
    // biased upward by construction, so it can sit above the cap with the cap
    // switched on. This row reads the input itself and settles it.
    f_pair2(14, "Target cap", riskTgtCap > 0 ? str.tostring(riskTgtCap, "#.#") + "R  ON" : "OFF",
         riskTgtCap > 0 ? C_UP : C_WN)
    f_pair2(12, "CME gaps filled", str.tostring(gapFilled) + " open " + str.tostring(gapTop.size()), C_NE)
    f_pair2(13, "Open now  (live R)",
         str.tostring(sigOpen) + (na(openR) ? "" : "   " + (openR >= 0 ? "+" : "") + str.tostring(openR, "0.00") + "R"),
         na(openR) ? C_NE : (openR > 0 ? C_UP : C_DN))

if statOn and barstate.islast
    f_drawStats()

if audOn and barstate.islast
    f_drawAudit()

// THE ONLY MARKERS THAT MEAN "TRADE". Labelled boxes, not triangles, so they
// can never be mistaken for the DNA or momentum annotations around them.
// TP is now set by the trade ledger itself, so it can only ever fire for a
// trade that was actually filled.
plotshape(tpHit ? close : na, "TAKE PROFIT", shape.xcross, location.absolute,
     color=#00e676, size=size.small, text="TP", textcolor=#00e676, force_overlay=true)

plotshape(chartBuy ? low : na, "CHART BUY", shape.labelup, location.belowbar,
     color=cBuySig, text="BUY", textcolor=#000000, size=size.normal, force_overlay=true)
plotshape(chartSell ? high : na, "CHART SELL", shape.labeldown, location.abovebar,
     color=cSellSig, text="SELL", textcolor=#ffffff, size=size.normal, force_overlay=true)


// ============================================================================
// 19j. THE PLAIN-ENGLISH READ
// ----------------------------------------------------------------------------
// Moved here deliberately. It reports chartBuy / chartSell, which are not
// computed until the signal section above - reading them from section 12g meant
// referencing variables that did not exist yet. Pine resolves strictly top to
// bottom, so anything that summarises the whole picture has to come last.
// ============================================================================
// --- the plain-English read
// One element, for the same reason aucLn is an array: the block that writes it
// is a function now, and a function may mutate an array but not reassign a
// global.
var array<label> guideArr = array.new<label>()
// Moved into a function to keep the main body under Pine's size cap.
f_drawGuide() =>
    for lb in guideArr
        label.delete(lb)
    guideArr.clear()

    string headline = "WAITING - not enough data yet"
    color  headCol = C_NE

    // ---------------------------------------------------------------------
    // THE READ MUST NOT CONTRADICT THE LINE BELOW IT
    // ---------------------------------------------------------------------
    // regime is built from the value areas overlapping; dayType is built from
    // the range against the initial balance. Both can be true at once - a day
    // that travels 1.8x its IB and still finishes overlapping prior value is a
    // trend day inside balance. But the ADVICE that followed only ever read
    // regime, so the script printed "fade the edges back to POC" directly above
    // "day type Trend day", and on gold breaking below weekly value it was
    // recommending longs into a 1.4% decline.
    //
    // Fading is the one thing you must not do on a trend day. When the two
    // disagree the read now says so and withholds the fade instead of asserting
    // half the evidence as though the other half were not on the same label.
    bool fadeUnsafe = dayType == "Trend day" or regimeLive == "IMBALANCE"

    if regime == "BALANCE" and not fadeUnsafe
        headline := "BALANCE - two-way auction. Fade the edges back to POC."
        headCol := C_UP
    else if regime == "BALANCE"
        headline := "BALANCE by value, but " +
             (dayType == "Trend day" ? "a TREND DAY is running" : "the live range says IMBALANCE") +
             " - do NOT fade."
        headCol := C_WN
    else if regime == "IMBALANCE"
        headline := "IMBALANCE - value is moving. Go with it, do not fade."
        headCol := C_WN
    else if regime == "TRANSITION"
        headline := "TRANSITION - the auction has not decided. Stand down."
        headCol := C_NE

    string whereTxt = "inside value"
    if posVsValue == "ABOVE value"
        whereTxt := "above value (expensive)"
    else if posVsValue == "BELOW value"
        whereTxt := "below value (cheap)"

    string doTxt = ""
    if regime == "BALANCE" and fadeUnsafe
        doTxt := "\nThe rotation playbook is OFF while the day is extending. Wait for the range to stop expanding, or trade with the direction instead."
    else if regime == "BALANCE"
        if posVsValue == "ABOVE value"
            doTxt := "\nSELL side favoured back toward POC " + (devOk ? str.tostring(devPoc, format.mintick) : "")
        else if posVsValue == "BELOW value"
            doTxt := "\nBUY side favoured back toward POC " + (devOk ? str.tostring(devPoc, format.mintick) : "")
        else
            doTxt := "\nMid-value. Wait for an edge - VAH or VAL."
    else if regime == "IMBALANCE"
        doTxt := "\nTarget the untested POC: " + (na(npocUp) ? "-" : str.tostring(npocUp, format.mintick)) + " up / " + (na(npocDn) ? "-" : str.tostring(npocDn, format.mintick)) + " down"

    string htfLine = ""
    if htfOn and htfPos != "n/a"
        htfLine := "\nZoomed out: price is " + htfPos + "."

    // The gamma read is the one line here that comes from outside this chart,
    // and when it disagrees with the auction read it is worth more than the
    // agreement is - two independent sources saying "do not fade this" is a
    // much stronger statement than the day type saying it alone.
    string gexLine = ""
    if gexOn
        int gr2 = f_gexReg()
        if gr2 == -1
            gexLine := "\nNEGATIVE GAMMA below " + str.tostring(f_gx(gexFlip), format.mintick) + " - dealers amplify the move. Do NOT fade."
        else if gr2 == 1
            gexLine := "\nPositive gamma above " + str.tostring(f_gx(gexFlip), format.mintick) + " - dealers suppress range. Fading edges is supported."

    string extremes = ""
    if highQual == "POOR"
        extremes += "\nHigh is POOR - unfinished, expect a revisit up."
    else if highQual == "EXCESS"
        extremes += "\nHigh is EXCESS - finished, rejection was real."
    if lowQual == "POOR"
        extremes += "\nLow is POOR - unfinished, expect a revisit down."
    else if lowQual == "EXCESS"
        extremes += "\nLow is EXCESS - finished, rejection was real."

    string dnaTxt = ""
    if dnaAbsorb
        dnaTxt := "\nABSORPTION now - someone is soaking up this level."
    else if dnaExhaust
        dnaTxt := "\nEXHAUSTION now - this move has no volume behind it."

    string actLine = ""
    if chartBuy
        actLine := "\n>>> BUY SIGNAL - all four gates open."
    else if chartSell
        actLine := "\n>>> SELL SIGNAL - all four gates open."

    guideArr.push(label.new(bar_index + lblOffset + labMaxColUsed * labSpacing + guideGap, high + atr14 * 2, headline + actLine +
         "\nPrice is " + whereTxt + " - day type " + dayType + doTxt + htfLine + gexLine + extremes + dnaTxt,
         xloc=xloc.bar_index, style=label.style_label_left,
         color=color.new(#131722, 12), textcolor=headCol, size=f_lblSize(),
         force_overlay=true))

if guideOn and barstate.islast
    f_drawGuide()

// ============================================================================
// 20. PANE PLOTS - drawn back to front in the order you described
// ============================================================================
hline(0, "Zero", color=cZeroLine)
hOB1 = hline(wtOB1, "Overbought", color=cObOs, linestyle=hline.style_dotted)
hOB2 = hline(wtOB2, "Extreme OB", color=cObOs, linestyle=hline.style_dotted)
hOS1 = hline(wtOS1, "Oversold",   color=cObOs, linestyle=hline.style_dotted)
hOS2 = hline(wtOS2, "Extreme OS", color=cObOs, linestyle=hline.style_dotted)

// Shaded extreme zones. You should see "we are stretched" without reading a
// number off the scale.
// Barely-there shading. The original marks these with thin dotted lines only;
// my slabs were heavy enough to read as another data series.
fill(hOB1, hOB2, color=color.new(C_DN, 95), title="Overbought Zone")
fill(hOS1, hOS2, color=color.new(C_UP, 95), title="Oversold Zone")

// --- LAYER 1: momentum waves, behind everything
// The area plots double as the fill anchors - separate line plots would cost
// two more of the 64 available.
// CLASSIC MARKET CIPHER B LAYERING
// Area style is correct - it is what makes the waves read as waves. The mud
// came from my colours, not the style: two similar-brightness blues at 45%
// transparency overlapping into soup.
//
// The classic does it with contrast. The SLOW wave is dark navy and recedes;
// the FAST wave is bright cyan and sits on top; you read the cross by watching
// the bright one climb out of the dark one. Drawn slow-first so fast is above.
//
// No fill between them either - the original carries direction in the green/red
// VWAP wave, and a third shaded band between the waves is exactly what made
// this pane unreadable.
// THE ORIGINAL'S KEY MOVE: the momentum waves are DARK GREY, almost black.
// They recede and act as background, which is what lets the cyan, green and red
// near zero read clearly on top of them. Bright blue waves dominated the pane
// and everything else had to fight them.
//
// No outline. The zoomed original has none - the waves are pure dark fill, and
// the bright edge I added was pulling the eye back to the thing that is meant
// to recede.
plot(wt2, "Slow Wave", style=plot.style_area, color=cSlowWave)
plot(wt1, "Fast Wave", style=plot.style_area, color=cFastWave)

// --- LAYER 2: VWAP wave (cyan) - BEHIND the money flow
// The close-up of the original settles the order: cyan is the wider, softer
// shape underneath, and the green/red money flow sits on top of it almost
// opaque. I had these reversed, which washed the money flow out.
plot(showVwap ? wtDiff : na, "VWAP Wave", style=plot.style_area,
     color=wtDiff > 0 ? cVwapUp : cVwapDn)

// --- LAYER 3: money flow, opaque, in front
plot(mfShow ? mfPlot : na, "Money Flow", style=plot.style_area,
     color=mfBull ? cMfiBull : cMfiBear)

// --- LAYER 4 and 5: hidden by default
plot(showRsi ? rsiPlot : na, "RSI", color=color.new(#ffffff, 45), linewidth=1)
// Stoch RSI plot removed - redundant with RSI, and both were hidden anyway.

// --- LAYER 6: CVD, in front
plot(cvdShow ? cvdNorm : na, "CVD", color=cvdCol, linewidth=2)

// --- LAYER 7: dots, divergence markers, signals
// Up and down variants are merged into single plots with a dynamic colour.
// Six plots became three, which is what keeps the script under the 64 limit.
// plotshape's "size" argument must be a CONST string - a ternary makes it a
// series string and the script will not compile. So the two sizes are two
// separate plots rather than one plot with a computed size.

// The MCB Dots Filter setting was declared but never consumed - changing it did
// nothing. It now actually filters which crosses get a dot.
bool dotsPass = true
if dotsFilter == "Extreme Waves (< -20 / > +20)"
    dotsPass := (wtCrossUp and wt2 < -20.0) or (wtCrossDn and wt2 > 20.0)
else if dotsFilter == "Money Flow Direction"
    dotsPass := (wtCrossUp and mfBull) or (wtCrossDn and not mfBull)
else if dotsFilter == "Extreme Waves + Money Flow"
    dotsPass := (wtCrossUp and wt2 < -20.0 and mfBull) or (wtCrossDn and wt2 > 20.0 and not mfBull)


// The original plots dots as CIRCLES on the slow wave, sized by linewidth.
// linewidth must be a constant, so a big and a small version are separate
// plots - which is also how the size ends up carrying meaning.
bool dotBuy  = wtCrossUp and dotsPass
bool dotSell = wtCrossDn and dotsPass
// ta.barssince COUNTS BARS, so it has to run on every one of them. Sitting on
// the right of an `or` it can be short-circuited away, and the count silently
// drifts. Hoisted to global scope - the same mistake that was in f_inRange.
//
// The leading "wtBullDiv or cvBullDiv" was also redundant: barssince returns 0
// on the bar the divergence fires, which <= 3 already covers.
int barsSinceBullDiv = ta.barssince(wtBullDiv or cvBullDiv)
int barsSinceBearDiv = ta.barssince(wtBearDiv or cvBearDiv)

bool dotBuyBig  = dotBuy  and barsSinceBullDiv <= 3
bool dotSellBig = dotSell and barsSinceBearDiv <= 3

bool ribbonBull = trendDir > 0 ? true : trendDir < 0 ? false : wt1 > wt2

// TREND RIBBON
// The red/green strip along the bottom of the original pane. Two invisible
// anchor plots with a fill between them, which is exactly how the old build did
// it. Green when structure is bullish, red when bearish; it falls back to the
// wave relationship before the first swing is confirmed.
rb1 = plot(ribbonOn ? ribbonTop : na, "Ribbon Top", color=color.new(#000000, 100), display=display.none)
rb2 = plot(ribbonOn ? ribbonBot : na, "Ribbon Bot", color=color.new(#000000, 100), display=display.none)
fill(rb1, rb2, color=ribbonBull ? cRibbonUp : cRibbonDn, title="Trend Ribbon")

plot(dotBuy and not dotBuyBig ? wt2 : na, "Buy Dot", color=cBuyDot, style=plot.style_circles, linewidth=4)
plot(dotSell and not dotSellBig ? wt2 : na, "Sell Dot", color=cSellDot, style=plot.style_circles, linewidth=4)

// BIG dot = a cross with a divergence behind it. This is the one to look for.
plot(dotBuyBig ? wt2 : na, "Buy Dot BIG (divergence)", color=cBuyDot, style=plot.style_circles, linewidth=9)
plot(dotSellBig ? wt2 : na, "Sell Dot BIG (divergence)", color=cSellDot, style=plot.style_circles, linewidth=9)

// A cross inside an extreme zone is the one worth seeing - drawn large, so the
// size itself carries the meaning.

// Yellow for divergence, as in the original - the one marker that should catch
// your eye in the pane.
plotshape(wtBullReg or wtBearReg ? wt2[divLbR] : na, "WT Divergence", shape.circle, location.absolute,
     color=#ffea00, size=size.tiny, offset=-divLbR)
plotshape(cvBullReg or cvBearReg ? cvdNorm[divLbR] : na, "CVD Absorption", shape.diamond, location.absolute,
     color=cvBullReg ? C_GLD : #ff7043, size=size.tiny, offset=-divLbR)

// HIDDEN divergence gets its own marker - an X - so a continuation reading is
// never mistaken for a reversal one at a glance. They were the same dot before.
plotshape(wtBullHid or wtBearHid ? wt2[divLbR] : na, "WT Hidden Divergence", shape.xcross, location.absolute,
     color=wtBullHid ? C_UP : C_DN, size=size.tiny, offset=-divLbR)
plotshape(cvBullHid or cvBearHid ? cvdNorm[divLbR] : na, "CVD Hidden Divergence", shape.xcross, location.absolute,
     color=cvBullHid ? cCvdUp : cCvdDn, size=size.tiny, offset=-divLbR)

// Grade A keeps its own labelled marker. B and C share one plot, separated by
// colour depth rather than by shape.
// The pane's own A/B/C verdicts have been REMOVED. They judged momentum alone,
// so they routinely said "buy" while the chart correctly said nothing - and you
// were left choosing between two of my own opinions.
//
// The pane now describes. The chart decides. One BUY label, one SELL label,
// and nothing else on either surface claims to be a trade.

// --- VOLUME DNA markers, pushed onto the PRICE chart
plotshape(dnaAbsorb or dnaExhaust ? 1 : na, "Absorption / Exhaustion", shape.square,
     location.abovebar, color=dnaAbsorb ? cAbs : cExh, size=size.tiny, force_overlay=true)
// Circles, not triangles. These describe VOLUME BEHAVIOUR, they are not calls
// to act, and they were being confused with the buy/sell markers.
// Merged into one plot with a dynamic price and colour - saves two slots.
plotshape(dnaEffortB or dnaEffortS ? (dnaEffortB ? low : high) : na, "Effort",
     shape.circle, location.absolute, color=dnaEffortB ? cEffB : cEffS,
     size=size.tiny, force_overlay=true)
// Exhaustion shares the marker above, coloured differently - see the dashboard
// DNA row and the barcode tape to tell them apart at a glance.
// Stagnation is the "nothing happening" quadrant - it still appears in the tape
// and the dashboard, but it does not earn a chart marker or a plot slot.

// ============================================================================
// 21. COMBINED DASHBOARD  (4 columns to stay compact in the pane)
// ============================================================================
// force_overlay lifts the dashboard onto the PRICE chart instead of leaving it
// stacked beside the oscillator in the lower pane.
var table dash = table.new(f_tablePos(tblPos), 4, 19, bgcolor=cTblBg,
     border_color=color.new(#000000, 75), border_width=1,
     frame_color=color.new(#000000, 50), frame_width=1, force_overlay=true)

f_pair(int r, int c, string k, string v, color vc) =>
    table.cell(dash, c, r, k, text_color=color.new(cTxt, 45), text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, c + 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

// Moved into a function to keep the main body under Pine's size cap.
f_drawDash() =>
    string modeTag = "Daily"
    if periodModeEff == "RTH Session (futures)"
        modeTag := "RTH"
    else if periodModeEff == "24h UTC (crypto)"
        modeTag := "UTC"
    else if periodModeEff == "Weekly"
        modeTag := "Week"

    // BROKEN CHAIN: the "if not useLtf" started a SECOND if/else, so on a 1m
    // chart the tag read "chart delta (no LTF)" even when the source was MFI or
    // Chaikin - neither of which uses lower-timeframe data at all. And the MFI
    // and Chaikin branches were unreachable whenever useLtf was false. One
    // chain, keyed on the source first, then qualified by data availability.
    string srcTag = "OG (no vol)"
    if mfSource == "Money Flow Index"
        srcTag := "MFI"
    else if mfSource == "Chaikin Money Flow"
        srcTag := "CMF"
    else if mfSource == "Volume Delta (intrabar)"
        if not useLtf
            srcTag := "chart delta (no LTF)"
        else if deltaOfficial
            srcTag := deltaTf + " delta*"
        else if ltfPresent
            srcTag := ltfEff + " delta"
        else
            srcTag := "chart delta"

    color regCol = C_NE
    if regime == "IMBALANCE"
        regCol := C_WN
    else if regime == "BALANCE"
        regCol := C_UP

    color posCol = C_NE
    if posVsValue == "ABOVE value"
        posCol := C_UP
    else if posVsValue == "BELOW value"
        posCol := C_DN

    color relCol = C_NE
    if vaRelation == "Higher value"
        relCol := C_UP
    else if vaRelation == "Lower value"
        relCol := C_DN

    color hiCol = C_NE
    if highQual == "POOR"
        hiCol := C_WN
    else if highQual == "EXCESS"
        hiCol := C_UP
    color loCol = C_NE
    if lowQual == "POOR"
        loCol := C_WN
    else if lowQual == "EXCESS"
        loCol := C_UP

    string zone = "Mid"
    if wt2 >= wtOB2
        zone := "Extreme OB"
    else if wt2 >= wtOB1
        zone := "Overbought"
    else if wt2 <= wtOS2
        zone := "Extreme OS"
    else if wt2 <= wtOS1
        zone := "Oversold"
    color zoneCol = C_NE
    if wt2 >= wtOB1
        zoneCol := C_DN
    if wt2 <= wtOS1
        zoneCol := C_UP

    string divTxt = "-"
    color divCol = C_NE
    if divRecentBull
        divTxt := "Bullish"
        divCol := C_UP
    else if divRecentBear
        divTxt := "Bearish"
        divCol := C_DN

    table.cell(dash, 0, 0, "AUCTION CIPHER", text_color=cTxt, text_size=size.small, text_halign=text.align_left)
    // A stale feed belongs at the top, not buried in a row. Everything below it
    // is describing a market that has already moved on.
    table.cell(dash, 1, 0,
         feedStale ? "! DELAYED " + str.tostring(feedAgeMin) + "m" : acProfTag + " - " + modeTag,
         text_color=feedStale ? #ff1744 : color.new(cTxt, 45), text_size=size.tiny, text_halign=text.align_right)

    // The gate uses regimeLive (available on every bar); the row used to show
    // only `regime` (last bar only). When they disagree the dashboard was
    // saying BALANCE while the context gate was blocking exactly the fade that
    // implies. Both are shown so a blocked signal is explainable.
    string regTxt = regime + (regime != regimeLive ? "  (live " + regimeLive + ")" : "")
    f_pair(1, 0, "Regime",   regTxt, regCol)
    f_pair(1, 2, "Wave",     wt1 > wt2 ? "Bullish" : "Bearish", wt1 > wt2 ? C_UP : C_DN)
    f_pair(2, 0, "Day type", dayType, dayType == "Trend day" ? C_WN : C_NE)
    f_pair(2, 2, "Zone",     zone, zoneCol)
    f_pair(3, 0, "Open",     openType, C_NE)
    f_pair(3, 2, "WT2",      str.tostring(wt2, "#.#"), C_NE)
    f_pair(4, 0, "Position", posVsValue, posCol)
    f_pair(4, 2, "Flow",     str.tostring(mfRaw, "#.##") + "  " + srcTag, mfBull ? C_UP : C_DN)
    f_pair(5, 0, "Vs prior", vaRelation, relCol)
    f_pair(5, 2, "Delta",    str.tostring(deltaRatio * 100, "#.#") + "%", deltaRatio > 0 ? C_UP : C_DN)
    f_pair(6, 0, "POC",      devOk ? str.tostring(devPoc, format.mintick) : "-", cPoc)
    f_pair(6, 2, "CVD",      str.tostring(cvdNorm, "#.#"), cvdNorm > 0 ? C_UP : C_DN)
    f_pair(7, 0, "VAH",      devOk ? str.tostring(devVah, format.mintick) : "-", cVa)
    f_pair(7, 2, "Diverge",  divTxt, divCol)
    f_pair(8, 0, "VAL",      devOk ? str.tostring(devVal, format.mintick) : "-", cVa)
    f_pair(8, 2, "IB ext",   ibExt, C_NE)
    f_pair(9, 0, "High",     highQual + (na(topPct) ? "" : "  " + str.tostring(topPct, "#") + "%"), hiCol)
    f_pair(9, 2, "Low",      lowQual  + (na(botPct) ? "" : "  " + str.tostring(botPct, "#") + "%"), loCol)
    f_pair(10, 0, "nPOC up", na(npocUp) ? "-" : str.tostring(npocUp, format.mintick), cNpoc)
    f_pair(10, 2, "nPOC dn", na(npocDn) ? "-" : str.tostring(npocDn, format.mintick), cNpoc)
    f_pair(11, 0, "DNA",     dnaState, dnaCol)
    f_pair(11, 2, "Vol z",   str.tostring(volZ, "#.#") + " / spr " + str.tostring(spreadZ, "#.#"), volZ > dnaVolTh ? C_WN : C_NE)
    string vwTxt = "-"
    color  vwCol = C_NE
    if not na(vwapVal)
        vwTxt := str.tostring(vwapVal, format.mintick)
        vwCol := close > vwapVal ? C_UP : C_DN
    f_pair(12, 0, "VWAP", vwTxt, vwCol)
    int barsPer = devSamples
    bool tooCoarse = barsPer < 10
    // A frozen profile has to announce itself. Outside the session inPeriod is
    // false and nothing is being added, so every level on the chart is a
    // snapshot of the last close - true when it was drawn, stale now.
    string profTxt = not inPeriod ? "DORMANT - outside session" :
         tooCoarse ? "TOO FEW (" + str.tostring(barsPer) + ")" :
         str.tostring(barsPer) + " x " + (ltfOk ? ltfEff + "m" : "chart bar")
    f_pair(12, 2, "Profile", profTxt, not inPeriod ? C_WN : tooCoarse ? C_DN : C_UP)
    f_pair(13, 0, "Open int", oiOk ? oiState : "no OI feed", oiCol)
    f_pair(13, 2, "OI z", oiOk ? str.tostring(oiChgZ, "#.#") : "-", math.abs(oiChgZ) > 1.5 ? C_WN : C_NE)
    // What the footprint engine is seeing, whether or not it is allowed to act
    // on it. STRENGTH means the bar closed up while the aggressive flow was
    // selling - those sellers were absorbed. sup / res are confirmed absorption
    // levels, the prices somebody defended and held.
    string ofTxt = ofBull ? "STRENGTH" : ofBear ? "WEAKNESS" : "-"
    if not ofOn
        ofTxt := "off"
    else if ofTxt == "-"
        ofTxt := (na(ofSupPx) ? "" : "sup " + str.tostring(ofSupPx, format.mintick)) +
             (na(ofSupPx) or na(ofResPx) ? "" : "  ") +
             (na(ofResPx) ? "" : "res " + str.tostring(ofResPx, format.mintick))
        if ofTxt == ""
            ofTxt := "-"
    f_pair(18, 0, "Order flow", ofTxt, ofBull ? C_UP : ofBear ? C_DN : C_NE)
    f_pair(18, 2, "Delta swing", na(ofSwing) ? "-" : f_volShort(ofSwing), C_NE)
    f_pair(14, 0, "Structure", trendDir > 0 ? "Bullish" : trendDir < 0 ? "Bearish" : "-",
         trendDir > 0 ? C_UP : trendDir < 0 ? C_DN : C_NE)
    f_pair(14, 2, "Funding", fundOk ? str.tostring(fundVal, "#.####") : "-", C_NE)
    color htfCol = C_NE
    if str.contains(htfPos, "above")
        htfCol := C_UP
    else if str.contains(htfPos, "below")
        htfCol := C_DN
    // labelled "dev" because it IS the developing week, unlike the drawn lines
    f_pair(15, 0, "HTF value (dev)", htfPos, htfCol)
    f_pair(15, 2, "prior " + (htfOn ? htfMode : "HTF") + " POC", na(htfPoc) ? "-" : str.tostring(htfPoc, format.mintick), cHtfPoc)
    if gexOn
        int gr = f_gexReg()
        f_pair(16, 0, "Gamma", gr == 1 ? "POSITIVE - fade edges" : gr == -1 ? "NEGATIVE - do NOT fade" : "no flip set",
             gr == 1 ? C_UP : gr == -1 ? C_DN : C_NE)
        f_pair(16, 2, "Flip / walls",
             (na(f_gx(gexFlip)) ? "-" : str.tostring(f_gx(gexFlip), format.mintick)) + "  " +
             (na(f_gx(gexPut)) ? "-" : str.tostring(f_gx(gexPut), format.mintick)) + " / " +
             (na(f_gx(gexCall)) ? "-" : str.tostring(f_gx(gexCall), format.mintick)), cGexFlip)

    // Which gates are currently open, so a silent chart is explainable
    // C context - L location - T trigger - P proof, then the OI verdict:
    // OK = open interest backs this side, NO = open interest vetoes it.
    // qN is the divergence quality score, shown only once it can reject
    // something, so the row does not grow for people who leave it at 0.
    string qB = divMinQual > 0 ? " q" + str.tostring(divQualBuy)  : ""
    string qS = divMinQual > 0 ? " q" + str.tostring(divQualSell) : ""
    string gBuy = (ctxBuy ? "C" : "-") + (atLowEdge ? "L" : "-") + (trigBuy ? "T" : "-") + (proofBuy ? "P" : "-") +
         "x" + str.tostring(confAtLowRej) + (oiVetoBuy ? " NO" : oiProofBuy ? " OK" : "") + qB
    string gSell = (ctxSell ? "C" : "-") + (atHighEdge ? "L" : "-") + (trigSell ? "T" : "-") + (proofSell ? "P" : "-") +
         "x" + str.tostring(confAtHighRej) + (oiVetoSell ? " NO" : oiProofSell ? " OK" : "") + qS
    f_pair(16, 0, "Buy gates", gBuy + "  " + str.tostring(gatesBuy) + "/" + str.tostring(needGates),
         gatesBuy >= needGates ? C_UP : C_NE)
    // ACTION - the single authoritative line. Everything else on both surfaces
    // is description; this is the only thing that says trade.
    string actTxt = "WAIT"
    color  actCol = C_NE
    if sigConflict
        actTxt := "CONFLICT - both sides qualified"
        actCol := C_WN
    else if chartBuy
        actTxt := "BUY  " + (na(rkRL) ? "" : str.tostring(rkRL, "#.#") + "R")
        actCol := cBuySig
    else if chartSell
        actTxt := "SELL  " + (na(rkRS) ? "" : str.tostring(rkRS, "#.#") + "R")
        actCol := cSellSig
    else if gatesBuy >= needGates - 1 and atLowEdge
        actTxt := "buy setting up"
        actCol := C_UP
    else if gatesSell >= needGates - 1 and atHighEdge
        actTxt := "sell setting up"
        actCol := C_DN
    f_pair(0, 2, "ACTION", actTxt, actCol)

    string balTxt = balActive ? (balArmed ? "ARMED " + str.tostring(balLo, format.mintick) + "-" + str.tostring(balHi, format.mintick) : "forming") : "none"
    f_pair(17, 0, "Balance area", balTxt, balActive and balArmed ? C_WN : C_NE)
    f_pair(17, 2, "ADX / Eff", str.tostring(adxVal, "#.#") + " - " + str.tostring(effRatio, "0.00"),
         csigNoiseOn and effRatio < csigErMin ? C_DN : effRatio >= csigErMin ? C_UP : C_NE)
    f_pair(16, 2, "Sell gates", gSell + "  " + str.tostring(gatesSell) + "/" + str.tostring(needGates),
         gatesSell >= needGates ? C_DN : C_NE)

if showTable and barstate.islast
    f_drawDash()

// ============================================================================
// 22. ALERTS
// ============================================================================
bool inValNow = false
bool inValPrev = false
if not na(priorVah) and not na(priorVal)
    inValNow := close <= priorVah and close >= priorVal
    inValPrev := close[1] <= priorVah and close[1] >= priorVal
bool backInValue = inValNow and not inValPrev

bool acceptAbove = false
bool acceptBelow = false
if not na(priorVah)
    acceptAbove := close > priorVah and close[1] > priorVah and close[2] > priorVah and close[3] <= priorVah
if not na(priorVal)
    acceptBelow := close < priorVal and close[1] < priorVal and close[2] < priorVal and close[3] >= priorVal

// ----------------------------------------------------------------------------
// These use alert() rather than alertcondition(). alertcondition costs one of
// the 64 plot slots EACH - thirteen of them were quietly consuming a fifth of
// the budget. alert() costs nothing.
//
// Setup differs slightly: create ONE alert on this indicator and choose
// "Any alert() function call". Every event below then arrives through it, and
// the message tells you which one fired. One alert instead of thirteen.
// ----------------------------------------------------------------------------
string alertMsg = ""

if buyA
    alertMsg += "GRADE A BUY - cross up in oversold, money flow positive, divergence present. "
if sellA
    alertMsg += "GRADE A SELL - cross down in overbought, money flow negative, divergence present. "
if buyB and not buyA
    alertMsg += "Grade B buy - cross up in oversold with money flow agreement. "
if sellB and not sellA
    alertMsg += "Grade B sell - cross down in overbought with money flow agreement. "
if acceptAbove
    alertMsg += "ACCEPTANCE ABOVE VALUE - three closes above prior VAH, balance to imbalance. "
if acceptBelow
    alertMsg += "ACCEPTANCE BELOW VALUE - three closes below prior VAL, balance to imbalance. "
if backInValue
    alertMsg += "Rotation back into prior value area. "
if cvBullDiv
    alertMsg += "CVD ABSORPTION BULL - price lower low, CVD higher low, sellers not being paid. "
if cvBearDiv
    alertMsg += "CVD ABSORPTION BEAR - price higher high, CVD lower high, buyers not being paid. "
if dnaAbsorb
    alertMsg += "VOLUME DNA ABSORPTION - high volume, narrow spread" + (dnaAtEdge ? " at a value area edge" : "") + ". "
if dnaExhaust
    alertMsg += "VOLUME DNA EXHAUSTION - low volume, wide spread, the move is running on empty. "
if balBreakUp
    alertMsg += "BALANCE BREAK UP - the rotation resolved higher. "
if balBreakDn
    alertMsg += "BALANCE BREAK DOWN - the rotation resolved lower. "
if liqCascade
    alertMsg += "LIQUIDATION CASCADE - open interest collapsing on a wide bar, forced closing not conviction. "
// The fill model says the entry is the NEXT bar's open, so the alert has to say
// so. An instruction that does not name its entry price is not an instruction.
// THE ALERT AND THE LEDGER MUST GIVE THE SAME INSTRUCTION.
// The alert fires at this bar's close; the fill happens at the next bar's open,
// and the script re-checks R there against the price actually available. If the
// open has eaten the edge, the ledger records the signal as UNFILLED and never
// tracks it. Without saying so, the alert would have sent you into a trade the
// statistics quietly disown. The stand-down condition is now part of the
// instruction.
string standDown = " Stand down if the open leaves less than " + str.tostring(riskMinR, "#.#") + "R. "
if chartBuy
    alertMsg += "CHART BUY - context, location, trigger and proof all agree. Entry at the NEXT bar open" +
         (na(rkStopL) ? "" : ", stop " + str.tostring(rkStopL, format.mintick)) +
         (na(rkTgtL) ? "" : ", target " + str.tostring(rkTgtL, format.mintick)) + "." + standDown
if chartSell
    alertMsg += "CHART SELL - context, location, trigger and proof all agree. Entry at the NEXT bar open" +
         (na(rkStopS) ? "" : ", stop " + str.tostring(rkStopS, format.mintick)) +
         (na(rkTgtS) ? "" : ", target " + str.tostring(rkTgtS, format.mintick)) + "." + standDown
if chochUp
    alertMsg += "CHoCH up - structure shifted bullish. "
if chochDn
    alertMsg += "CHoCH down - structure shifted bearish. "
if qBig
    alertMsg += "BIG volume cluster. "
else if qMed
    alertMsg += "Medium volume cluster. "

// Order flow, through the same single alert() the rest of the script uses.
if ofOn
    if ofBull
        alertMsg += "Hidden strength - closed up on selling delta, sellers absorbed. "
    if ofBear
        alertMsg += "Hidden weakness - closed down on buying delta, buyers absorbed. "
    if ofNewSup
        alertMsg += "Absorption SUPPORT confirmed" + (na(ofSupPx) ? "" : " at " + str.tostring(ofSupPx, format.mintick)) + ". "
    if ofNewRes
        alertMsg += "Absorption RESISTANCE confirmed" + (na(ofResPx) ? "" : " at " + str.tostring(ofResPx, format.mintick)) + ". "

if alertMsg != ""
    alert(str.tostring(syminfo.ticker) + " " + timeframe.period + " | " + alertMsg, alert.freq_once_per_bar_close)
