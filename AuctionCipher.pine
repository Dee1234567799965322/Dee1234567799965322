//@version=6
// ============================================================================
// AUCTION CIPHER  v3.0
// ----------------------------------------------------------------------------
// ONE indicator. Two layers.
//
//   PRICE CHART  — auction context: volume profile, value area, naked POCs,
//                  initial balance, low volume nodes, excess/poor extremes.
//                  Drawn onto the main chart using Pine v6 force_overlay.
//
//   LOWER PANE   — Market Cipher B style oscillator, with REAL money flow.
//
// This exists as one script because a free TradingView account allows two
// indicators per chart, and you should not have to spend both on this.
//
// ----------------------------------------------------------------------------
// PANE LAYER ORDER (back to front, as requested)
//   1. Momentum waves        WaveTrend 1 and 2, area fill
//   2. Money flow            in front of the waves
//   3. VWAP wave             wt1 minus wt2
//   4. RSI                   hidden by default
//   5. Stoch RSI             hidden by default
//   6. CVD                   in front of everything
//   7. Cross dots, divergence dots and divergence LINES on top
//
// ----------------------------------------------------------------------------
// THE MONEY FLOW POINT
//   Market Cipher B's money flow uses no volume. The original is:
//       sma( ((close - open) / (high - low)) * 150, 60 ) - 2.5
//   A smoothed candle body ratio. Volume never enters it.
//
//   Four sources are offered here, including the original so you can switch
//   between them on the same chart and see where they disagree.
//
// ----------------------------------------------------------------------------
// HONEST LIMITS
//   Pine has no order book access. "Delta" is inferred from lower-timeframe bar
//   direction, not true bid/ask. At 1-minute granularity it is a good proxy and
//   nothing sold as a TradingView footprint is better.
//
//   The oscillator says WHEN. The auction layer says IF and WHERE. A cross in
//   the middle of balance is noise. The same cross at a value area edge with
//   delta divergence is a trade. That hierarchy is the whole point.
// ============================================================================

indicator("Auction Cipher", shorttitle="AUCTION CIPHER", overlay=false,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// Official TradingView library — provides requestVolumeDelta(), which is a more
// faithful buy/sell split than classifying whole lower-timeframe bars by hand.
// This is what both QuantAlgo's Volume Bubbles and the original Volume DNA use.
//
// The import has to come before every other statement in the script. It used to
// sit BELOW the type declaration, which is a compile error.
import TradingView/ta/12 as taLib

// One trade's three drawings held together. Three parallel arrays indexed by
// hand can drift apart; a single object cannot. Not reachable in the current
// flow, but this removes the whole class of bug rather than guarding it.
type TradeDraw
    box   tgtBox
    box   stopBox
    label info

// ============================================================================
// 1. INPUTS
// ============================================================================
string G_PER = "1 · PERIOD"
string periodMode = input.string("24h UTC (crypto)", "Period Mode",
     options=["24h UTC (crypto)", "RTH Session (futures)", "Chart Daily", "Weekly"], group=G_PER,
     tooltip="24h UTC — new period at 00:00 UTC. Use for BTC perps.\nRTH Session — CME futures. Gold RTH is 0820-1330 New York.\nChart Daily — the symbol's own daily boundary.\nWeekly — composite weekly profile.")
string rthSess   = input.session("0820-1330", "RTH Session", group=G_PER)
string rthTz     = input.string("America/New_York", "Session Timezone", group=G_PER,
     options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "UTC"])
int    ibMinutes = input.int(60, "Initial Balance (minutes)", minval=5, maxval=480, group=G_PER)

