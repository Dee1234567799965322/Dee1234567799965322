//@version=6
// ============================================================================
// AUCTION CIPHER  v3.0
// ----------------------------------------------------------------------------
// ONE indicator. Two layers.
//
//   PRICE CHART  - auction context: volume profile, value area, naked POCs,
//                  initial balance, low volume nodes, excess/poor extremes.
//                  Drawn onto the main chart using Pine v6 force_overlay.
//
//   LOWER PANE   - Market Cipher B style oscillator, with REAL money flow.
//
// This exists as one script because a free TradingView account allows two
// indicators per chart, and you should not have to spend both on this.
//
// ----------------------------------------------------------------------------
// PANE LAYER ORDER (back to front, as requested)
//   1. Momentum waves        WaveTrend 1 and 2, area fill
//   2. Money flow            in front of the waves
//   3. VWAP wave             wt1 minus wt2
//   4. RSI                   hidden by default
//   5. Stoch RSI             hidden by default
//   6. CVD                   in front of everything
//   7. Cross dots, divergence dots and divergence LINES on top
//
// ----------------------------------------------------------------------------
// THE MONEY FLOW POINT
//   Market Cipher B's money flow uses no volume. The original is:
//       sma( ((close - open) / (high - low)) * 150, 60 ) - 2.5
//   A smoothed candle body ratio. Volume never enters it.
//
//   Four sources are offered here, including the original so you can switch
//   between them on the same chart and see where they disagree.
//
// ----------------------------------------------------------------------------
// HONEST LIMITS
//   Pine has no order book access. "Delta" is inferred from lower-timeframe bar
//   direction, not true bid/ask. At 1-minute granularity it is a good proxy and
//   nothing sold as a TradingView footprint is better.
//
//   The oscillator says WHEN. The auction layer says IF and WHERE. A cross in
//   the middle of balance is noise. The same cross at a value area edge with
//   delta divergence is a trade. That hierarchy is the whole point.
// ============================================================================

indicator("Auction Cipher", shorttitle="AUCTION CIPHER", overlay=false,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// Official TradingView library - provides requestVolumeDelta(), which is a more
// faithful buy/sell split than classifying whole lower-timeframe bars by hand.
// This is what both QuantAlgo's Volume Bubbles and the original Volume DNA use.
//
// The import has to come before every other statement in the script. It used to
// sit BELOW the type declaration, which is a compile error.
import TradingView/ta/12 as taLib

// One trade's three drawings held together. Three parallel arrays indexed by
// hand can drift apart; a single object cannot. Not reachable in the current
// flow, but this removes the whole class of bug rather than guarding it.
type TradeDraw
    box   tgtBox
    box   stopBox
    label info

// A naked POC: the price, and the line drawn at it. These were two parallel
// arrays that every site had to push, shift and remove from in step - three
// sites, six calls, and one missed call silently mismatches every level with
// somebody else's line. The arrays happened to be in step, but that was upkeep,
// not a guarantee. One object per level makes it a guarantee.
type Npoc
    float price
    line  ln

// A price somebody defended and held. dir +1 is support (sellers absorbed),
// -1 is resistance (buyers absorbed). ok means it has survived long enough to
// be believed rather than merely spotted.
type OfLvl
    float px
    int   dir
    int   born
    bool  ok
    float vol
    line  ln

// ============================================================================
// 1. INPUTS
// ============================================================================
string G_PER = "1 - PERIOD"
string periodMode = input.string("24h UTC (crypto)", "Period Mode",
     options=["24h UTC (crypto)", "RTH Session (futures)", "Chart Daily", "Weekly"], group=G_PER,
     tooltip="24h UTC - new period at 00:00 UTC. Use for BTC perps.\nRTH Session - CME futures. Gold RTH is 0820-1330 New York.\nChart Daily - the symbol's own daily boundary.\nWeekly - composite weekly profile.")
string rthSess   = input.session("0820-1330", "RTH Session", group=G_PER)
// Named RTH explicitly. A second input in group 22 was also called "Session
// Timezone", and the two control completely different things: this one decides
// where the RTH session sits, which sets the whole period boundary and every
// profile built on it, while the other only places the Asia/London/New York
// boxes. Setting the wrong one silently moves the gold session and every level
// derived from it, with nothing on the chart to say why.
string rthTz     = input.string("America/New_York", "RTH Session Timezone", group=G_PER,
     options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "UTC"])
int    ibMinutes = input.int(240, "Initial Balance (minutes)", minval=5, maxval=480, group=G_PER,
     tooltip="Classic Initial Balance is the first 60 minutes of a REGULAR TRADING HOURS session - roughly a sixth of it.\n\nA 24-hour crypto period is nearly four times longer, so 60 minutes is only a twenty-fourth of it and price extends past that range almost every day. That is what makes IB extension read BOTH and day type read Neutral on nearly every period, which tells you nothing.\n\n240 minutes is the same SIXTH of a 24-hour day, so the classification means something again.\n\nNote the resolution limit: this cannot be finer than one bar. On a 4h chart anything from 5 to 240 gives you exactly the first bar.")

string G_AUC = "2 - AUCTION LAYER (price chart)"
bool  aucOn_in      = input.bool(true,  "Enable Auction Layer", group=G_AUC)
int   profRows   = input.int(250, "Profile Rows", minval=8, maxval=300, group=G_AUC,
     tooltip="How many price buckets the period's volume is sorted into. This is the COMPUTE resolution - it sets how precisely the POC, value area and low volume nodes are located.\n\n250 matches the TradingView volume profile default. It is finer than the old default of 100 and costs more per bar, so if the script reports 'heavy', this is the first number to bring down.\n\nNote that the DRAWN histogram may use fewer rows than this - see the Histogram Width tooltip. The levels are always computed at full resolution regardless.")
float vaPct      = input.float(70.0, "Value Area %", minval=50.0, maxval=95.0, group=G_AUC) / 100.0
string profRange = input.string("Auction Period", "Profile Range",
     options=["Auction Period", "Rolling Lookback"], group=G_AUC,
     tooltip="WHAT THE PROFILE MEASURES, and the answer to 'the profile does not move with price'.\n\nAUCTION PERIOD (default) - everything traded since the period started: the UTC day, the RTH session, whichever Period Mode selects. Its top and bottom only change when the PERIOD makes a new high or low, so once the day has set its range the shape stays put while price wanders around inside it. That is not a fault, it is what a period profile is, and it is why the POC and value area are levels worth trading against - they do not move under you.\n\nROLLING LOOKBACK - the last N bars, recomputed every bar. The window slides with price, so the profile follows it and the POC is always the busiest price of the recent past rather than of the session. Closer to the TradingView visible-range profile.\n\nThis switches the DEVELOPING profile only - the histogram, its value area, and the excess/poor read. Prior period value, naked POCs, initial balance and the higher-timeframe value area stay on the period clock either way, because those are levels from a finished auction and a sliding window has no finished auction to take them from.")
int    profLook  = input.int(300, "Rolling Lookback (bars)", minval=20, maxval=480, group=G_AUC,
     tooltip="How many bars the rolling profile covers. Capped at 480 because Pine will not reach further back than the script's max_bars_back, and asking for more would fail at runtime rather than simply showing less.")
bool  showHist_in   = input.bool(true,  "Profile Histogram", group=G_AUC)
float histWidthPct = input.float(34.0, "Histogram Width (%)", minval=2.0, maxval=100.0, group=G_AUC,
     tooltip="Width of the widest histogram row, as a percentage of the number of bars in the current period.\n\nThis used to be a fixed bar count, which meant the profile was the wrong size on every timeframe except the one it was tuned for - 50 bars is most of a 4h chart's day and a sliver of a 1m chart's day. A percentage scales itself.\n\nThe drawn width is clamped to 2..300 bars.")
bool  histSplitUD = input.bool(true, "Split Up / Down Volume", group=G_AUC,
     tooltip="Draws a second, shorter bar OVER each row showing the dominant side's volume, in green when buyers traded more of that price and red when sellers did.\n\nSo the grey bar is the total traded at that price, the colored bar is how much of it was one-sided, and the gap between the two tips is how balanced that price was. A long red bar reaching almost to the grey tip is one-way selling; a short colored bar under a long grey one is two-way trade.\n\nUp volume is intrabar volume that closed above its open, down volume is volume that closed below. With no usable lower timeframe this falls back to whole chart bars, which is much coarser - the dashboard Profile row says which is in use.")
bool  histVaColor = input.bool(true, "Color Value Area Rows Differently", group=G_AUC)
float histRowFill = input.float(80.0, "Row Fill (%)", minval=20.0, maxval=100.0, step=5.0, group=G_AUC,
     tooltip="How much of each row's price slot the bar actually fills. Below 100 leaves a gap between rows, which is what makes a 250-row profile read as 250 separate prices instead of one solid blob. 100 makes them touch.")
int   histOvW     = input.int(2, "Dominant-side Thickness (px)", minval=1, maxval=4, group=G_AUC,
     tooltip="Pixel thickness of the colored bar drawn over each row. 1 or 2 at 200+ rows, 3 or 4 if you run a coarse profile.")
bool  histVaExt   = input.bool(true, "Value Area Extremities", group=G_AUC,
     tooltip="Marks the top and bottom of the value area across the histogram itself, so you can see where the 70% band sits inside the shape rather than only as a line out on the price chart.")
bool  histBgOn    = input.bool(false, "Range Background", group=G_AUC,
     tooltip="Fills the whole profile high-to-low behind the rows. Useful for seeing the profile's total extent when the tails are thin enough to be invisible.")
bool  histExtR    = input.bool(true, "Extend To The Right", group=G_AUC,
     tooltip="ON  - the profile is drawn to the RIGHT of the last bar, growing rightwards into empty space. Nothing is hidden behind it.\n\nOFF - the profile is drawn back OVER the bars it measures, growing leftwards from the last bar, the way the built-in volume profile does. You can read each row against the candles that built it, at the cost of covering them.")
int   histOffset = input.int(8, "Histogram Offset (bars right)", minval=0, maxval=100, group=G_AUC,
     tooltip="How far right of the last bar the profile is drawn.\n\nThis was hardcoded at 30. Together with a width of 50 that put the histogram between 30 and 80 bars into the future, which is further right than most charts leave empty - so on a normally scrolled chart the whole profile sat outside the visible area and looked like it was not being drawn at all.\n\n8 keeps it clear of the last candles while staying on screen. Raise it if it crowds price.")
bool  showPrior_in  = input.bool(true,  "Prior POC / VAH / VAL", group=G_AUC)
bool  showPrHL_in   = input.bool(false, "Prior High / Low", group=G_AUC)
bool  showIB_in     = input.bool(true,  "Initial Balance Lines", group=G_AUC)
bool  showNpoc_in   = input.bool(true,  "Naked (untested) POCs", group=G_AUC,
     tooltip="A POC from a prior period price has not traded back through. The measurable version of an 'unmitigated' level - deleted the moment price touches it.")
int   maxNpoc    = input.int(12, "Max Naked POCs", minval=1, maxval=40, group=G_AUC)
float npocMaxDist= input.float(15.0, "Ignore nPOC Beyond (%)", minval=1.0, maxval=100.0, group=G_AUC)
bool  showLvn_in    = input.bool(true,  "Low Volume Nodes", group=G_AUC,
     tooltip="Thin shelves inside the profile. The rigorous version of an 'imbalance' or 'fair value gap' - derived from where trade did NOT happen.")
float lvnThresh  = input.float(20.0, "LVN Threshold (% of POC)", minval=2.0, maxval=60.0, group=G_AUC)
int   maxLvn     = input.int(6, "Max LVNs", minval=1, maxval=25, group=G_AUC)
float excThresh  = input.float(15.0, "Excess Threshold (% of POC)", minval=2.0, maxval=50.0, group=G_AUC)
float excBand    = input.float(5.0, "Extreme Band (% of range)", minval=1.0, maxval=25.0, group=G_AUC,
     tooltip="How much of the range counts as 'the extreme'.\n\nThis previously tested ONE bin. At 24 rows that bin was 4% of the range; at the current default of 100 rows it is 1% - thin enough that it almost always looked empty, so nearly every high and low was reported as EXCESS. Measuring a fixed 5% band instead makes the reading independent of row count.")
float poorMult   = input.float(2.5,  "Poor Multiplier", minval=1.2, maxval=6.0, group=G_AUC)

string G_AC = "2b - AUCTION COLORS"
color cHistTot   = input.color(color.new(#b2b5be, 62), "Total Volume", group=G_AC)
color cHistVaTot = input.color(color.new(#d1d4dc, 38), "VA Total Volume", group=G_AC)
color cHistUp   = input.color(color.new(#26a69a, 25), "Up Volume", group=G_AC)
color cHistDn   = input.color(color.new(#ef5350, 25), "Down Volume", group=G_AC)
color cHistVaUp = input.color(color.new(#26a69a, 0), "VA Up Volume", group=G_AC)
color cHistVaDn = input.color(color.new(#ef5350, 0), "VA Down Volume", group=G_AC)
color cHistPoc  = input.color(color.new(#ffb300, 25), "Profile POC Row", group=G_AC)
color cVaExt    = input.color(color.new(#26c6da, 40), "VA Extremities", group=G_AC)
color cHistBg   = input.color(color.new(#787b86, 93), "Range Background", group=G_AC)
color cPoc   = input.color(#ffb300, "POC", group=G_AC)
color cVa    = input.color(#26c6da, "VAH / VAL", group=G_AC)
color cPrior = input.color(#9e9e9e, "Prior Value", group=G_AC)
color cPrHL  = input.color(color.new(#9e9e9e, 50), "Prior High/Low", group=G_AC)
color cNpoc  = input.color(#ec407a, "Naked POC", group=G_AC)
color cLvn   = input.color(color.new(#ab47bc, 30), "LVN", group=G_AC)
color cIB    = input.color(#66bb6a, "Initial Balance Line", group=G_AC)

string G_WT = "3 - MOMENTUM WAVES (WaveTrend)"
int   wtChannel = input.int(9,  "Channel Length", minval=2, group=G_WT)
int   wtAverage = input.int(12, "Average Length", minval=2, group=G_WT)
int   wtMALen   = input.int(3,  "Signal Length",  minval=1, group=G_WT)
float wtOB1 = input.float(53.0,  "Overbought 1", group=G_WT)
float wtOB2 = input.float(60.0,  "Overbought 2", group=G_WT)
float wtOS1 = input.float(-53.0, "Oversold 1",   group=G_WT)
float wtOS2 = input.float(-60.0, "Oversold 2",   group=G_WT)

string G_MF = "4 - MONEY FLOW"
string mfSource = input.string("Volume Delta (intrabar)", "Source",
     options=["Volume Delta (intrabar)", "Money Flow Index", "Chaikin Money Flow", "OG Market Cipher (no volume)"],
     group=G_MF,
     tooltip="Volume Delta - signed volume from lower-timeframe bars. Most informative.\nMoney Flow Index - Wilder's real MFI.\nChaikin - close position in range, volume weighted.\nOG Market Cipher - the original formula, which contains no volume. Included for comparison.")
bool  mfShow    = input.bool(true, "Show Money Flow", group=G_MF)
int   mfLength  = input.int(60, "Length", minval=2, group=G_MF)
int   mfSmooth  = input.int(3,  "Smoothing", minval=1, group=G_MF)
bool  mfAutoNorm= input.bool(true, "Auto-normalise Height", group=G_MF,
     tooltip="Scales whichever source you pick to a comparable height, so switching sources does not require re-tuning.")
float mfScale   = input.float(1.0, "Height", minval=0.1, maxval=10.0, group=G_MF)
float ogMult    = input.float(150.0, "OG Multiplier", group=G_MF)
float ogPosY    = input.float(2.5,   "OG Y Offset",   group=G_MF)

string G_DNA = "11 - VOLUME DNA (effort vs result)"
bool  dnaOn_in      = input.bool(true, "Enable Volume DNA", group=G_DNA,
     tooltip="Wyckoff effort vs result, read from two z-scores: volume against its own average, and bar spread against its own average.\n\nABSORPTION   high volume, narrow spread - someone is soaking up everything thrown at them. The most valuable of the four.\nEFFORT       high volume, wide spread - participation and follow-through agree.\nEXHAUSTION   low volume, wide spread - the move is running on empty. This is what excess looks like as it forms.\nSTAGNATION   low volume, narrow spread - nobody home.")
int   dnaVolLen  = input.int(20, "Volume Lookback", minval=5, group=G_DNA)
int   dnaSprLen  = input.int(20, "Spread Lookback", minval=5, group=G_DNA)
float dnaVolTh   = input.float(1.5, "Volume Std Dev Threshold", minval=0.5, maxval=5.0, group=G_DNA)
float dnaSprTh   = input.float(1.0, "Spread Std Dev Threshold", minval=0.2, maxval=5.0, group=G_DNA)
bool  dnaAbsOn   = input.bool(true,  "Mark Absorption", group=G_DNA)
bool  dnaEffOn   = input.bool(true,  "Mark Effort", group=G_DNA)
bool  dnaExhOn   = input.bool(true,  "Mark Exhaustion", group=G_DNA)
bool  dnaStgOn   = input.bool(false, "Mark Stagnation", group=G_DNA)
bool  dnaAtEdge  = input.bool(false, "Only Mark at Value Area Edges", group=G_DNA,
     tooltip="Absorption in the middle of value is ordinary two-way trade. Absorption at VAH or VAL is someone defending a level. This filter keeps only the second kind.")
color cAbs   = input.color(#ff7b00, "Absorption Color", group=G_DNA)
color cEffB  = input.color(#00e5ff, "Effort Bullish Color", group=G_DNA)
color cEffS  = input.color(#e91e63, "Effort Bearish Color", group=G_DNA)
color cExh   = input.color(#ffd54f, "Exhaustion Color", group=G_DNA)
color cStg   = input.color(color.new(#787b86, 40), "Stagnation Color", group=G_DNA)


string G_DNAV = "11b - VOLUME DNA - VISUALS"
bool  dnaGlow_in    = input.bool(true,  "Ghost Glow Candles", group=G_DNAV,
     tooltip="Draws a soft halo around the candle body in the DNA colour. Additive, so your normal candles stay untouched.")
bool  dnaCloud_in   = input.bool(true,  "Absorption Clouds", group=G_DNAV)
int   dnaCloudEx = input.int(10, "Cloud Extension (bars)", minval=1, maxval=60, group=G_DNAV)
bool  dnaDots_in    = input.bool(false, "DNA Circles with Volume", group=G_DNAV,
     tooltip="A circle at the bar midpoint, sized and shaded by the volume z-score, with the volume printed inside.")
bool  dnaTape_in    = input.bool(false, "Barcode Heatmap Tape", group=G_DNAV,
     tooltip="A vertical strip on the right showing the DNA state of the last N bars. A real-time tape of institutional activity.")
int   dnaTapeRow = input.int(20, "Tape Rows", minval=5, maxval=40, group=G_DNAV)
string tapePos   = input.string("Middle Right", "Tape Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=G_DNAV,
     tooltip="Keep this away from the dashboard position or the two will overlap on the price chart.")

string G_BUB = "12 - VOLUME BUBBLES"
bool   bubOn_in      = input.bool(false, "Enable Volume Bubbles", group=G_BUB,
     tooltip="Percentile-based volume clusters. Concept from Volume Bubbles [QuantAlgo], CC BY-NC-SA 4.0 - reimplemented, not copied.\n\nOff by default because it stacks a lot of objects on the chart alongside everything else.")
string bubDetect  = input.string("Volume OR Delta", "Detection Method",
     options=["Volume Only", "Delta Only", "Volume + Delta", "Volume OR Delta"], group=G_BUB)
string bubClass   = input.string("Both", "Buy/Sell Classification",
