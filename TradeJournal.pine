//@version=6
indicator("Trade Journal - measure your own entries", "MY-TRADES", overlay = true, max_labels_count = 100)

// ═══════════════════════════════════════════════════════════════════════════
// WHAT THIS TESTS  -  you
// ═══════════════════════════════════════════════════════════════════════════
// The seven signal families measured in this project all landed on a coin flip.
// The one thing never measured is your own discretionary entries: the trades you
// take by reading the chart, not by a rule. This is the only place an edge could
// still be, because it is the only input we have not tested.
//
// Log each of your real entries as a slot below: pick Long or Short, then click
// the entry bar to set its time (or type the timestamp). On the bar at or after
// that time, a paper trade opens at the close in your chosen direction, and it is
// scored on EXACTLY the same terms as every other test - 2R target, 1 ATR stop,
// 100-bar horizon, against the exact 1/(1+R) null, drift removed by averaging the
// two direction strata, MDL = 2.8 x se.
//
// Two things this tool cannot do, and you must:
//   1. It measures a synthetic 2R trade from your entry, not your real exit. That
//      is deliberate - it asks one question only: was your ENTRY better than a
//      coin flip? Your exits are a separate skill, measured separately.
//   2. It is only honest if you log EVERY trade, including the ones you would
//      rather forget. A journal with the losers quietly left out will show an
//      edge that is not there. The tool enforces nothing; your honesty does.
//
// Sample size is the hard part. A real edge needs roughly 30+ resolved trades per
// direction before the panel will even give a verdict, and a few hundred before
// the floor is tight enough to trust. You will fill this in over months, not one
// sitting. That slow, honest accumulation IS the discipline that separates
// traders with an edge from traders with a story.

string G_J = "Your trades"
string jDir1 = input.string("—", "Trade  1", options = ["—", "Long", "Short"], inline = "t1", group = G_J)
int    jT1   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t1", group = G_J)
string jDir2 = input.string("—", "Trade  2", options = ["—", "Long", "Short"], inline = "t2", group = G_J)
int    jT2   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t2", group = G_J)
string jDir3 = input.string("—", "Trade  3", options = ["—", "Long", "Short"], inline = "t3", group = G_J)
int    jT3   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t3", group = G_J)
string jDir4 = input.string("—", "Trade  4", options = ["—", "Long", "Short"], inline = "t4", group = G_J)
int    jT4   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t4", group = G_J)
string jDir5 = input.string("—", "Trade  5", options = ["—", "Long", "Short"], inline = "t5", group = G_J)
int    jT5   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t5", group = G_J)
string jDir6 = input.string("—", "Trade  6", options = ["—", "Long", "Short"], inline = "t6", group = G_J)
int    jT6   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t6", group = G_J)
string jDir7 = input.string("—", "Trade  7", options = ["—", "Long", "Short"], inline = "t7", group = G_J)
int    jT7   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t7", group = G_J)
string jDir8 = input.string("—", "Trade  8", options = ["—", "Long", "Short"], inline = "t8", group = G_J)
int    jT8   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t8", group = G_J)
string jDir9 = input.string("—", "Trade  9", options = ["—", "Long", "Short"], inline = "t9", group = G_J)
int    jT9   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t9", group = G_J)
string jDir10 = input.string("—", "Trade 10", options = ["—", "Long", "Short"], inline = "t10", group = G_J)
int    jT10   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t10", group = G_J)
string jDir11 = input.string("—", "Trade 11", options = ["—", "Long", "Short"], inline = "t11", group = G_J)
int    jT11   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t11", group = G_J)
string jDir12 = input.string("—", "Trade 12", options = ["—", "Long", "Short"], inline = "t12", group = G_J)
int    jT12   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t12", group = G_J)
string jDir13 = input.string("—", "Trade 13", options = ["—", "Long", "Short"], inline = "t13", group = G_J)
int    jT13   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t13", group = G_J)
string jDir14 = input.string("—", "Trade 14", options = ["—", "Long", "Short"], inline = "t14", group = G_J)
int    jT14   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t14", group = G_J)
string jDir15 = input.string("—", "Trade 15", options = ["—", "Long", "Short"], inline = "t15", group = G_J)
int    jT15   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t15", group = G_J)
string jDir16 = input.string("—", "Trade 16", options = ["—", "Long", "Short"], inline = "t16", group = G_J)
int    jT16   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t16", group = G_J)
string jDir17 = input.string("—", "Trade 17", options = ["—", "Long", "Short"], inline = "t17", group = G_J)
int    jT17   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t17", group = G_J)
string jDir18 = input.string("—", "Trade 18", options = ["—", "Long", "Short"], inline = "t18", group = G_J)
int    jT18   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t18", group = G_J)
string jDir19 = input.string("—", "Trade 19", options = ["—", "Long", "Short"], inline = "t19", group = G_J)
int    jT19   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t19", group = G_J)
string jDir20 = input.string("—", "Trade 20", options = ["—", "Long", "Short"], inline = "t20", group = G_J)
int    jT20   = input.time(timestamp("2024-01-01 00:00"), "", inline = "t20", group = G_J)
var array<int> jTime = array.new<int>()
var array<int> jDir  = array.new<int>()
var array<bool> jDone = array.new<bool>()
if barstate.isfirst
    if jDir1 != "—"
        jTime.push(jT1)
        jDir.push(jDir1 == "Long" ? 1 : -1)
    if jDir2 != "—"
        jTime.push(jT2)
        jDir.push(jDir2 == "Long" ? 1 : -1)
    if jDir3 != "—"
        jTime.push(jT3)
        jDir.push(jDir3 == "Long" ? 1 : -1)
    if jDir4 != "—"
        jTime.push(jT4)
        jDir.push(jDir4 == "Long" ? 1 : -1)
    if jDir5 != "—"
        jTime.push(jT5)
        jDir.push(jDir5 == "Long" ? 1 : -1)
    if jDir6 != "—"
        jTime.push(jT6)
        jDir.push(jDir6 == "Long" ? 1 : -1)
    if jDir7 != "—"
        jTime.push(jT7)
        jDir.push(jDir7 == "Long" ? 1 : -1)
    if jDir8 != "—"
        jTime.push(jT8)
        jDir.push(jDir8 == "Long" ? 1 : -1)
    if jDir9 != "—"
        jTime.push(jT9)
        jDir.push(jDir9 == "Long" ? 1 : -1)
    if jDir10 != "—"
        jTime.push(jT10)
        jDir.push(jDir10 == "Long" ? 1 : -1)
    if jDir11 != "—"
        jTime.push(jT11)
        jDir.push(jDir11 == "Long" ? 1 : -1)
    if jDir12 != "—"
        jTime.push(jT12)
        jDir.push(jDir12 == "Long" ? 1 : -1)
    if jDir13 != "—"
        jTime.push(jT13)
        jDir.push(jDir13 == "Long" ? 1 : -1)
    if jDir14 != "—"
        jTime.push(jT14)
        jDir.push(jDir14 == "Long" ? 1 : -1)
    if jDir15 != "—"
        jTime.push(jT15)
        jDir.push(jDir15 == "Long" ? 1 : -1)
    if jDir16 != "—"
        jTime.push(jT16)
        jDir.push(jDir16 == "Long" ? 1 : -1)
    if jDir17 != "—"
        jTime.push(jT17)
        jDir.push(jDir17 == "Long" ? 1 : -1)
    if jDir18 != "—"
        jTime.push(jT18)
        jDir.push(jDir18 == "Long" ? 1 : -1)
    if jDir19 != "—"
        jTime.push(jT19)
        jDir.push(jDir19 == "Long" ? 1 : -1)
    if jDir20 != "—"
        jTime.push(jT20)
        jDir.push(jDir20 == "Long" ? 1 : -1)    for _i = 0 to jTime.size() - 1
        jDone.push(false)

bool myLong  = false
bool myShort = false
if jTime.size() > 0 and not na(time[1])
    for k = 0 to jTime.size() - 1
        if not jDone.get(k) and time >= jTime.get(k) and time[1] < jTime.get(k)
            jDone.set(k, true)
            if jDir.get(k) > 0
                myLong := true
            else
                myShort := true

plotshape(myLong,  "My long",  style = shape.triangleup,   location = location.belowbar, color = color.new(#26A69A, 0), text = "ME", textcolor = color.white, size = size.small)
plotshape(myShort, "My short", style = shape.triangledown, location = location.abovebar, color = color.new(#EF5350, 0), text = "ME", textcolor = color.white, size = size.small)

// ═══════════════════════════════════════════════════════════════════════════
// MEASUREMENT PANEL  (build m2)   -- identical apparatus to every other test
// ═══════════════════════════════════════════════════════════════════════════
bool ictBull = myLong
bool ictBear = myShort

string STAT_GROUP  = "Measurement"
bool   statOnInput      = input.bool(true, "Show measurement panel", group = STAT_GROUP)
float  statTargetRInput = input.float(2.0, "Target (R)", minval = 0.5, maxval = 10.0, step = 0.5, group = STAT_GROUP)
float  statStopAtrInput = input.float(1.0, "Stop = ATR x", minval = 0.1, maxval = 10.0, step = 0.1, group = STAT_GROUP)
int    statAtrLenInput  = input.int(14, "ATR length", minval = 2, maxval = 200, group = STAT_GROUP)
int    statHorizonInput = input.int(100, "Horizon (bars)", minval = 5, maxval = 2000, group = STAT_GROUP)
float  statCostRInput   = input.float(0.05, "Round-trip cost (R)", minval = 0.0, maxval = 1.0, step = 0.005, group = STAT_GROUP)
int    statMinNInput    = input.int(30, "Minimum resolved per direction", minval = 5, maxval = 500, group = STAT_GROUP)
bool   statOneAtATimeInput = input.bool(false, "One trade at a time", group = STAT_GROUP)
string statPosInput     = input.string("Top Right", "Panel position", options = ["Top Right", "Top Left", "Middle Right", "Bottom Right", "Bottom Left"], group = STAT_GROUP)

f_statPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Middle Right"  => position.middle_right
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        => position.top_right

f_statPct(float v) =>
    na(v) ? "—" : str.tostring(v, "#.#") + "%"

f_statPp(float v) =>
    na(v) ? "—" : (v > 0 ? "+" : "") + str.tostring(v, "#.#") + "pp"

var array<float> statEntry  = array.new<float>()
var array<float> statStop   = array.new<float>()
var array<float> statTarget = array.new<float>()
var array<int>   statDir    = array.new<int>()
var array<int>   statOpened = array.new<int>()

var int statSigLong  = 0
var int statSigShort = 0
var int statWinLong  = 0
var int statLosLong  = 0
var int statTimLong  = 0
var int statWinShort = 0
var int statLosShort = 0
var int statTimShort = 0

float statAtr = ta.atr(statAtrLenInput)
bool  statLive = statOnInput and barstate.isconfirmed

if statLive and array.size(statEntry) > 0
    for tradeIndex = array.size(statEntry) - 1 to 0
        int   tradeDir = array.get(statDir, tradeIndex)
        float tradeTarget = array.get(statTarget, tradeIndex)
        float tradeStop = array.get(statStop, tradeIndex)
        bool  stopHit = tradeDir > 0 ? low <= tradeStop : high >= tradeStop
        bool  targetHit = tradeDir > 0 ? high >= tradeTarget : low <= tradeTarget
        bool  expired = bar_index - array.get(statOpened, tradeIndex) >= statHorizonInput
        bool  resolved = stopHit or targetHit or expired
        if stopHit
            if tradeDir > 0
                statLosLong += 1
            else
                statLosShort += 1
        else if targetHit
            if tradeDir > 0
                statWinLong += 1
            else
                statWinShort += 1
        else if expired
            if tradeDir > 0
                statTimLong += 1
            else
                statTimShort += 1
        if resolved
            array.remove(statEntry, tradeIndex)
            array.remove(statStop, tradeIndex)
            array.remove(statTarget, tradeIndex)
            array.remove(statDir, tradeIndex)
            array.remove(statOpened, tradeIndex)

float statStopDistance = na(statAtr) ? na : statStopAtrInput * statAtr
bool  statCanOpen = statLive and not na(statStopDistance) and statStopDistance > 0
if statCanOpen and ictBull and (not statOneAtATimeInput or array.size(statEntry) == 0)
    array.push(statEntry, close)
    array.push(statStop, close - statStopDistance)
    array.push(statTarget, close + statTargetRInput * statStopDistance)
    array.push(statDir, 1)
    array.push(statOpened, bar_index)
    statSigLong += 1
if statCanOpen and ictBear and (not statOneAtATimeInput or array.size(statEntry) == 0)
    array.push(statEntry, close)
    array.push(statStop, close + statStopDistance)
    array.push(statTarget, close - statTargetRInput * statStopDistance)
    array.push(statDir, -1)
    array.push(statOpened, bar_index)
    statSigShort += 1

int   statNLong  = statWinLong + statLosLong
int   statNShort = statWinShort + statLosShort
float statPLong  = statNLong > 0 ? statWinLong / float(statNLong) : na
float statPShort = statNShort > 0 ? statWinShort / float(statNShort) : na
bool  statBothSides = not na(statPLong) and not na(statPShort)
float statDriftFree = statBothSides ? (statPLong + statPShort) / 2 * 100 : na
float statDrift     = statBothSides ? (statPLong - statPShort) / 2 * 100 : na
float statVLong     = statNLong  > 0 ? (statWinLong  + 0.5) / (statNLong  + 1) : na
float statVShort    = statNShort > 0 ? (statWinShort + 0.5) / (statNShort + 1) : na
float statSe        = statBothSides ? math.sqrt(statVLong * (1 - statVLong) / statNLong + statVShort * (1 - statVShort) / statNShort) / 2 * 100 : na
float statNull      = 100.0 / (1.0 + statTargetRInput)
float statEdge      = na(statDriftFree) ? na : statDriftFree - statNull
float statMdl       = na(statSe) or statSe <= 0 ? na : 2.8 * statSe
float statExpR      = na(statDriftFree) ? na : statDriftFree / 100 * statTargetRInput - (1 - statDriftFree / 100) - statCostRInput
float statNeeded    = (1.0 + statCostRInput) / (1.0 + statTargetRInput) * 100

string statVerdict = "NEED MORE DATA"
color  statVerdictColor = color.gray
if statBothSides and statNLong >= statMinNInput and statNShort >= statMinNInput
    if na(statMdl) or math.abs(statEdge) < statMdl
        statVerdict := "NO EDGE DETECTABLE"
        statVerdictColor := color.gray
    else if statEdge < 0
        statVerdict := "NEGATIVE"
        statVerdictColor := color.red
    else if statExpR > 0
        statVerdict := "EDGE, net " + str.tostring(statExpR, "#.##") + "R"
        statVerdictColor := color.green
    else
        statVerdict := "EDGE BELOW COST"
        statVerdictColor := color.orange

var table statTable = table.new(f_statPos(statPosInput), 2, 13, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

f_statRow(int rowIndex, string label, string value, color valueColor) =>
    table.cell(statTable, 0, rowIndex, label, text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(statTable, 1, rowIndex, value, text_color = valueColor, text_size = size.small, text_halign = text.align_right)
    rowIndex

if statOnInput and barstate.islast
    table.cell(statTable, 0, 0, "MY TRADES", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(statTable, 1, 0, "m2  " + str.tostring(statTargetRInput, "#.#") + "R / " + str.tostring(statHorizonInput) + "b", text_color = color.new(color.white, 45), text_size = size.small, text_halign = text.align_right)
    f_statRow(1,  "Entries  long / short",  str.tostring(statSigLong) + " / " + str.tostring(statSigShort), color.new(color.white, 10))
    f_statRow(2,  "Resolved  long / short", str.tostring(statNLong) + " / " + str.tostring(statNShort), color.new(color.white, 10))
    f_statRow(3,  "Timed out  long / short", str.tostring(statTimLong) + " / " + str.tostring(statTimShort), color.new(color.white, 45))
    f_statRow(4,  "Still open", str.tostring(array.size(statEntry)), color.new(color.white, 45))
    f_statRow(5,  "Hit rate  long", f_statPct(statPLong * 100), color.new(color.white, 10))
    f_statRow(6,  "Hit rate  short", f_statPct(statPShort * 100), color.new(color.white, 10))
    f_statRow(7,  "Drift-free hit rate", f_statPct(statDriftFree), color.new(color.white, 0))
    f_statRow(8,  "Drift removed", f_statPp(statDrift), color.new(color.white, 45))
    f_statRow(9,  "Chance baseline  1/(1+R)", f_statPct(statNull) + "  (need " + str.tostring(statNeeded, "#.#") + "% after cost)", color.new(color.white, 45))
    f_statRow(10, "Edge vs chance", f_statPp(statEdge), na(statEdge) ? color.gray : statEdge > 0 ? color.green : color.red)
    f_statRow(11, "Detection floor  MDL", na(statMdl) ? "—" : "±" + str.tostring(statMdl, "#.#") + "pp", color.new(color.white, 45))
    f_statRow(12, "VERDICT", statVerdict, statVerdictColor)
