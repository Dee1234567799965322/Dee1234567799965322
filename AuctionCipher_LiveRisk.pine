//@version=6
// Auction Cipher - Live Risk Manager (companion indicator)
// ───────────────────────────────────────────────────────────────────────────
// WHY THIS IS A SEPARATE SCRIPT, NOT BOLTED ONTO AUCTION CIPHER:
// Auction Cipher is a single ~5,900-line script and is already sitting at
// TradingView's Pine compile-token ceiling (100,256 tokens). Adding this
// panel directly into that file pushed it over the limit and it stopped
// compiling. Rather than carve tokens out of a carefully audited 5,900-line
// engine to make room - which risks breaking the 19 corrections that file has
// already been through - this ships as its own small script. Add it as a
// SECOND indicator on the same chart, next to Auction Cipher. Read the signal
// (BUY/SELL, stop, target) off Auction Cipher as you already do; read the
// SIZE and the WIDENED stop off this panel.
//
// THE ONE IDEA THIS EXISTS TO DELIVER:
//   A tighter stop does not stop you getting wicked out - it GUARANTEES it,
//   because it sits inside normal noise. The fix is the opposite: put the
//   stop WIDE, past the noise, where the trade is genuinely wrong - then
//   shrink the POSITION SIZE so that wide stop still only costs a small,
//   FIXED dollar amount. Widen the stop and the size falls; the dollar risk
//   never changes. That is how you avoid stop-outs without taking a bigger
//   loss.
//
// The structural stop here is the SAME formula Auction Cipher's own Risk
// Layer uses (swing high/low +/- an ATR buffer, with a minimum ATR
// distance), so the stop this panel shows lines up with what Auction Cipher
// itself would draw - just widened further for live safety, and paired with
// the size that makes that width affordable.
indicator("Auction Cipher - Live Risk Manager", "AC-RISK", overlay = true)

// ── Structural stop (mirrors Auction Cipher's own Risk Layer) ─────────────────
gS = "Structural stop (matches Auction Cipher's Risk Layer)"
int   atrLen    = input.int(14, "ATR length", minval = 2, group = gS)
int   riskSwing = input.int(5, "Stop Swing Lookback", minval = 1, group = gS)
float riskBuf   = input.float(0.3, "Stop Buffer (x ATR)", step = 0.1, group = gS)
float riskMinStop = input.float(0.6, "Minimum Stop Distance (x ATR)", step = 0.1, group = gS)

// ── Live sizing - the lever that actually prevents stop-outs ──────────────────
gR = "Live risk (the fix for getting wicked out)"
float rmAcct     = input.float(10000, "Account size ($)", minval = 1, group = gR)
float rmRiskPct  = input.float(0.5, "Risk per trade (% of account)", minval = 0.01, maxval = 10, step = 0.1, group = gR, tooltip = "The one number that keeps you alive. 0.5% means ONE loss costs 0.5% of the account, whatever the stop distance. Size is derived from this, so a wider stop just means a smaller size - never a bigger loss.")
float rmExtraBuf = input.float(0.5, "Widen stop past structure (x ATR)", minval = 0, maxval = 5, step = 0.1, group = gR, tooltip = "Pushes the stop further beyond the structural stop above, so normal noise cannot reach it. Combined with the sizing, a wider stop costs the same dollars - just a smaller position.")
bool  showLines  = input.bool(true, "Plot the stop lines on the chart", group = gR)
string rmPos     = input.string("Bottom Left", "Panel position", options = ["Bottom Left", "Bottom Right", "Top Left", "Top Right"], group = gR)

f_pos(string p) =>
    switch p
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        => position.top_right

// ── The math ────────────────────────────────────────────────────────────────
float atr14   = ta.atr(atrLen)
float entry   = close
float minDist = atr14 * riskMinStop
float stopL   = math.min(ta.lowest(low, riskSwing) - atr14 * riskBuf, entry - minDist)
float stopS   = math.max(ta.highest(high, riskSwing) + atr14 * riskBuf, entry + minDist)
float wideL   = stopL - atr14 * rmExtraBuf
float wideS   = stopS + atr14 * rmExtraBuf

float riskUsd = rmAcct * rmRiskPct / 100.0
float distL   = entry - wideL
float distS   = wideS - entry
float sizeL   = distL > 0 ? riskUsd / distL : na
float sizeS   = distS > 0 ? riskUsd / distS : na
float levL    = na(sizeL) ? na : sizeL * entry / rmAcct
float levS    = na(sizeS) ? na : sizeS * entry / rmAcct

plot(showLines ? wideL : na, "Wide stop (long)", color = color.new(#26a69a, 0), style = plot.style_circles)
plot(showLines ? wideS : na, "Wide stop (short)", color = color.new(#ef5350, 0), style = plot.style_circles)
plot(showLines ? stopL : na, "Structural stop (long)", color = color.new(#26a69a, 60))
plot(showLines ? stopS : na, "Structural stop (short)", color = color.new(#ef5350, 60))

// ── Panel ──────────────────────────────────────────────────────────────────
var table t = table.new(f_pos(rmPos), 2, 5, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(c, 20), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if barstate.islast
    row(0, "LIVE RISK / SIZE", "$" + str.tostring(rmAcct, "#") + " | " + str.tostring(rmRiskPct, "#.##") + "%", color.white)
    row(1, "Risk / trade", "$" + str.tostring(riskUsd, "#"), color.white)
    row(2, "LONG stop/size", (na(wideL) ? "-" : str.tostring(wideL, format.mintick)) + "  " +
         (na(sizeL) ? "" : str.tostring(sizeL, "#.####") + "u " + str.tostring(levL, "#.#") + "x"), #26a69a)
    row(3, "SHORT stop/size", (na(wideS) ? "-" : str.tostring(wideS, format.mintick)) + "  " +
         (na(sizeS) ? "" : str.tostring(sizeS, "#.####") + "u " + str.tostring(levS, "#.#") + "x"), #ef5350)
    row(4, "Stop widened", "+" + str.tostring(rmExtraBuf, "#.#") + " ATR past structure", color.white)
