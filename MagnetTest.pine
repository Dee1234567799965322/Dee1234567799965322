//@version=6
// ============================================================================
// MAGNET TEST  v1.0
// ----------------------------------------------------------------------------
// A DIFFERENT QUESTION, ASKED WITH A CONTROL.
//
// Three hypotheses have now been measured on this repo and all three read
// zero across 920 trades. Every one of them asked the same thing: WHICH WAY
// will price go from here. That is the hardest question in markets and the
// most competed, and the answer came back no each time.
//
// This asks something else: WHERE does price go. Not a signal, a DESTINATION.
// The claim under test is the one auction theory actually makes -
//
//   An auction that ended badly is unfinished business. A POOR extreme - one
//   where price stalled flat instead of being rejected - gets revisited. An
//   EXCESS extreme - a sharp tail, a real rejection - does not. An untested
//   POC is a magnet. A gap gets filled.
//
// Those are falsifiable statements about destination, and nothing built here
// has ever tested them.
//
// WHY THE CONTROL IS THE WHOLE POINT.
//
// Over 200 bars almost ANY level near price gets revisited. Price wanders.
// A naive reading of "poor highs revisited 80%" is therefore worthless: the
// honest question is 80% against WHAT. Auction Cipher's own panel has been
// printing that unbaselined number all along and it means nothing.
//
// So every magnet here is registered with a MIRROR: the same distance from
// the same price at the same moment, in the opposite direction. Then:
//
//   hit rate on the magnet   vs   hit rate on its own mirror
//
// The pair is matched on everything that actually drives revisit probability
// - distance, start price, time window, the volatility that followed - and
// differs only in the structural claim. Each magnet is its own control, which
// is the strongest form this test can take.
//
// If structure is real, magnets beat mirrors. If they read the same, the
// levels are not magnets; they are just places that happen to be nearby, and
// the whole excess/poor vocabulary is describing the past rather than saying
// anything about the future.
//
// THE NEGATIVE CONTROL.
//
// EXCESS extremes are tracked too, and theory says they should be revisited
// LESS than poor ones. A result where poor beats mirror AND excess does not
// is far harder to explain away than either alone - it is the theory's own
// prediction coming true in both directions. If poor and excess read the
// same, whatever is happening is not the mechanism auction theory describes.
//
// WHAT MAKES A MAGNET TRADEABLE, WHICH IS NOT THE HIT RATE.
//
// An 80% hit rate is worthless if price first runs three times the target
// distance against you. So every magnet records its MAE - the furthest price
// went the WRONG way before the level was reached - as a fraction of the
// distance to the level. That ratio is the trade:
//
//   MAE/D of 0.5  ->  a stop half the distance to target, a 2R trade
//   MAE/D of 3.0  ->  you were stopped out six times over, hit rate be damned
//
// Read the ratio before the hit rate. It is the column that decides whether
// any of this is money.
//
// NO INTRABAR DATA ANYWHERE IN THIS FILE.
//
// The profile is built from chart bars. It is coarser than the real thing and
// that is a deliberate trade: request.security_lower_tf has a hard depth limit
// that silently starves long histories, and this test wants as much history as
// TradingView will load. A magnet study needs sample size more than it needs
// a precise POC.
// ============================================================================
indicator("Magnet Test", shorttitle="MAGNET", overlay=true,
     max_boxes_count=100, max_lines_count=300, max_labels_count=200, max_bars_back=500)

// ============================================================================
// 1. INPUTS
// ============================================================================
string G_P = "1 - PERIOD & PROFILE"
string perMode = input.string("Daily", "Auction Period", options=["Daily", "Weekly"], group=G_P,
     tooltip="The auction whose extremes become magnets. Daily gives many more samples and is the default for that reason alone.")
int   rows    = input.int(24, "Profile Rows", minval=8, maxval=60, group=G_P,
     tooltip="How finely the period's range is sliced when locating the POC and the value area. Coarse is fine here - the test is about whether the level is special at all, not about pinpointing it to the tick.")
float vaPct   = input.float(70, "Value Area %", minval=50, maxval=90, step=5, group=G_P)

string G_C = "2 - WHAT COUNTS AS POOR"
float excTh   = input.float(0.25, "Excess Threshold", minval=0.02, maxval=0.9, step=0.01, group=G_C,
     tooltip="Volume in the extreme row, as a fraction of the POC row. BELOW this the extreme is a thin tail - a real rejection - and is classified EXCESS.")
float poorTh  = input.float(0.55, "Poor Threshold", minval=0.1, maxval=1.0, step=0.01, group=G_C,
     tooltip="ABOVE this fraction the extreme is thick - price stalled flat there instead of being rejected - and is classified POOR. The gap between the two thresholds is deliberately left as 'Flat', neither one thing nor the other, rather than forcing every extreme into a bucket it does not fit.")

string G_T = "3 - THE TEST"
int   horiz   = input.int(200, "Tracking Horizon (bars)", minval=20, maxval=1000, group=G_T,
     tooltip="How long a magnet is given to be reached before it is written off as unreached. The same number is applied to its mirror, so the comparison stays matched.")
float minDist = input.float(0.2, "Minimum Distance (ATR)", minval=0.0, maxval=5.0, step=0.1, group=G_T,
     tooltip="Levels closer than this to the current price are skipped. A magnet one tick away is reached by noise and tells you nothing, and it would inflate magnets and mirrors alike.")
bool  useGaps = input.bool(true, "Include Session Gaps", group=G_T)

string G_D = "4 - DISPLAY"
bool  showLv  = input.bool(true, "Draw Open Magnets", group=G_D)
bool  showTbl = input.bool(true, "Results Table", group=G_D)
color cPoor   = input.color(#26a69a, "Poor",   group=G_D, inline="c")
color cExc    = input.color(#ef5350, "Excess", group=G_D, inline="c")
color cPoc    = input.color(#ffa726, "POC/VA", group=G_D, inline="c")

// ============================================================================
// 2. PRIMITIVES
// ----------------------------------------------------------------------------
// Everything with rolling state is evaluated here, at top level, on every bar.
// Pine's ta.* functions carry history internally: put one behind an `and` or a
// ternary and it silently stops updating and returns stale values. That bug
// has already cost this project a whole measurement round.
// ============================================================================
bool  barClosed = barstate.isconfirmed
float atr       = ta.atr(14)
bool  isNew     = perMode == "Daily" ? ta.change(time("D")) != 0 : ta.change(time("W")) != 0

// ============================================================================
// 3. PERIOD PROFILE, BUILT FROM CHART BARS
// ----------------------------------------------------------------------------
// Bars are stored as they arrive and the profile is computed in ONE pass when
// the period closes. Building it incrementally would mean rebinning on every
// new extreme, because the range is not known until the auction is over.
// ============================================================================
var array<float> pH = array.new<float>()
var array<float> pL = array.new<float>()
var array<float> pV = array.new<float>()

var float perHi = na
var float perLo = na

// Finished-period levels, published for the magnet registrar below.
var float fHi   = na
var float fLo   = na
var float fPoc  = na
var float fVah  = na
var float fVal  = na
var float fTopP = na
var float fBotP = na
var bool  fOk   = false

f_profile() =>
    float oHi = perHi
    float oLo = perLo
    float oPoc = na
    float oVah = na
    float oVal = na
    float oTop = na
    float oBot = na
    bool  ok = false
    if pH.size() > 2 and not na(oHi) and not na(oLo) and oHi > oLo
        float step = (oHi - oLo) / rows
        if step > 0
            array<float> prof = array.new<float>(rows, 0.0)
            for i = 0 to pH.size() - 1
                float bh = pH.get(i)
                float bl = pL.get(i)
                float bv = pV.get(i)
                int r1 = math.max(0, math.min(rows - 1, int((bl - oLo) / step)))
                int r2 = math.max(0, math.min(rows - 1, int((bh - oLo) / step)))
                int span = r2 - r1 + 1
                float share = bv / span
                for r = r1 to r2
                    prof.set(r, prof.get(r) + share)
            int pocIdx = 0
            float pocVol = 0.0
            float total = 0.0
            for r = 0 to rows - 1
                float v = prof.get(r)
                total += v
                if v > pocVol
                    pocVol := v
                    pocIdx := r
            // value area: grow out from the POC, always taking the richer side
            float want = total * vaPct / 100.0
            float got = pocVol
            int lo = pocIdx
            int hi = pocIdx
            while got < want and (lo > 0 or hi < rows - 1)
                float below = lo > 0 ? prof.get(lo - 1) : -1.0
                float above = hi < rows - 1 ? prof.get(hi + 1) : -1.0
                if above >= below
                    hi += 1
                    got += above
                else
                    lo -= 1
                    got += below
            oPoc := oLo + (pocIdx + 0.5) * step
            oVah := oLo + (hi + 1) * step
            oVal := oLo + lo * step
            // EXCESS vs POOR, measured the way the auction defines it: how much
            // trade happened AT the extreme relative to the busiest price. A
            // thin top is a rejection. A thick top is an auction that stopped
            // because the clock ran out, not because it was finished.
            oTop := pocVol > 0 ? prof.get(rows - 1) / pocVol : na
            oBot := pocVol > 0 ? prof.get(0) / pocVol : na
            ok := true
    [oHi, oLo, oPoc, oVah, oVal, oTop, oBot, ok]

if barClosed
    if isNew
        [a, b, c, d, e, f, g, h] = f_profile()
        fHi := a
        fLo := b
        fPoc := c
        fVah := d
        fVal := e
        fTopP := f
        fBotP := g
        fOk := h
        pH.clear()
        pL.clear()
        pV.clear()
        perHi := high
        perLo := low
    else
        fOk := false
        perHi := na(perHi) ? high : math.max(perHi, high)
        perLo := na(perLo) ? low : math.min(perLo, low)
    pH.push(high)
    pL.push(low)
    pV.push(nz(volume, 1.0))
    while pH.size() > 600
        pH.shift()
        pL.shift()
        pV.shift()

// ============================================================================
// 4. THE MAGNET REGISTER
// ----------------------------------------------------------------------------
// kind: 0 POOR HI  1 POOR LO  2 EXCESS HI  3 EXCESS LO
//       4 POC      5 VAH      6 VAL        7 GAP
//
// Every magnet carries its MIRROR implicitly: born at price P targeting level
// L, the mirror is at P - (L - P). Same distance, same instant, opposite side.
// Nothing else about the two differs, which is what makes the comparison mean
// something.
// ============================================================================
var array<float> mLvl  = array.new<float>()
var array<float> mMir  = array.new<float>()
var array<float> mBirth= array.new<float>()
var array<int>   mKind = array.new<int>()
var array<int>   mBar  = array.new<int>()
var array<float> mMae  = array.new<float>()
var array<int>   mHitM = array.new<int>()
var array<int>   mHitX = array.new<int>()

int KINDS = 8
var array<float> cN    = array.new<float>(KINDS, 0.0)
var array<float> cHitM = array.new<float>(KINDS, 0.0)
var array<float> cHitX = array.new<float>(KINDS, 0.0)
var array<float> cBars = array.new<float>(KINDS, 0.0)
var array<float> cMae  = array.new<float>(KINDS, 0.0)
var array<float> cMaeN = array.new<float>(KINDS, 0.0)

f_reg(float lvl, int kind) =>
    bool ok = false
    if not na(lvl) and not na(atr) and atr > 0
        float d = lvl - close
        if math.abs(d) >= minDist * atr
            mLvl.push(lvl)
            mMir.push(close - d)
            mBirth.push(close)
            mKind.push(kind)
            mBar.push(bar_index)
            mMae.push(0.0)
            mHitM.push(0)
            mHitX.push(0)
            ok := true
    ok

if barClosed and fOk
    // the extremes, classified
    if not na(fTopP)
        if fTopP >= poorTh
            f_reg(fHi, 0)
        else if fTopP <= excTh
            f_reg(fHi, 2)
    if not na(fBotP)
        if fBotP >= poorTh
            f_reg(fLo, 1)
        else if fBotP <= excTh
            f_reg(fLo, 3)
    f_reg(fPoc, 4)
    f_reg(fVah, 5)
    f_reg(fVal, 6)

// session gaps: the open jumped away from the last close and left a void
if barClosed and useGaps and isNew and not na(close[1])
    if math.abs(open - close[1]) >= minDist * atr
        f_reg(close[1], 7)

// ============================================================================
// 5. TRACKING
// ----------------------------------------------------------------------------
// Both sides are tracked to the end of the horizon even after one is reached,
// because the question is not which was reached FIRST - it is how often each
// is reached at all. Booking the magnet the moment it prints and abandoning
// the mirror would hand the magnet a win it did not earn.
// ============================================================================
f_track() =>
    if mLvl.size() > 0
        for i = mLvl.size() - 1 to 0
            float lvl = mLvl.get(i)
            float mir = mMir.get(i)
            float bp  = mBirth.get(i)
            int   k   = mKind.get(i)
            int   age = bar_index - mBar.get(i)
            bool  up  = lvl > bp
            float dist = math.abs(lvl - bp)

            // NOTHING IS EVALUATED ON THE BIRTH BAR. A magnet is registered at
            // that bar's CLOSE, but its high and low were already made before
            // the close existed. Testing them here would book hits from price
            // action that happened before the level was even identified - a
            // lookahead that would flatter magnets and mirrors alike and, worse,
            // flatter whichever side the bar happened to travel.
            if age >= 1
                // adverse excursion is only meaningful until the magnet is reached
                if mHitM.get(i) == 0
                    float adv = up ? bp - low : high - bp
                    if adv > mMae.get(i)
                        mMae.set(i, adv)
                    if up ? high >= lvl : low <= lvl
                        mHitM.set(i, 1)
                if mHitX.get(i) == 0
                    if up ? low <= mir : high >= mir
                        mHitX.set(i, 1)

            if age >= horiz
                cN.set(k, cN.get(k) + 1)
                cHitM.set(k, cHitM.get(k) + mHitM.get(i))
                cHitX.set(k, cHitX.get(k) + mHitX.get(i))
                if mHitM.get(i) == 1
                    cBars.set(k, cBars.get(k) + age)
                    if dist > 0
                        cMae.set(k, cMae.get(k) + mMae.get(i) / dist)
                        cMaeN.set(k, cMaeN.get(k) + 1)
                mLvl.remove(i)
                mMir.remove(i)
                mBirth.remove(i)
                mKind.remove(i)
                mBar.remove(i)
                mMae.remove(i)
                mHitM.remove(i)
                mHitX.remove(i)
    mLvl.size()

if barClosed
    f_track()

// ============================================================================
// 6. DRAWING
// ============================================================================
var array<line> mLine = array.new<line>()

f_kindCol(int k) =>
    k == 0 or k == 1 ? cPoor : k == 2 or k == 3 ? cExc : cPoc

f_draw() =>
    while mLine.size() > 0
        line.delete(mLine.shift())
    if mLvl.size() > 0 and mLvl.size() < 60
        for i = 0 to mLvl.size() - 1
            if mHitM.get(i) == 0
                mLine.push(line.new(mBar.get(i), mLvl.get(i), bar_index + 6, mLvl.get(i),
                     color=color.new(f_kindCol(mKind.get(i)), 35), width=1))
    mLine.size()

if showLv and barstate.islast
    f_draw()

// ============================================================================
// 7. RESULTS
// ----------------------------------------------------------------------------
// LIFT is the column. It is the magnet's hit rate minus its own mirror's, and
// it is the only number here that survives the objection that price simply
// wanders back to wherever it came from.
//
// MAE/D is the column that decides whether a positive lift is money. It is the
// average worst adverse move before the level was reached, as a multiple of
// the distance to it. Under 1.0 means a stop tighter than the target existed.
// ============================================================================
var table t = table.new(position.bottom_left, 6, 11, bgcolor=color.new(#131722, 10),
     border_color=color.new(#000000, 55), border_width=1)

f_cell(int c, int r, string v, color col, bool hdr) =>
    table.cell(t, c, r, v, text_color=col, text_size=size.tiny,
         text_halign=c == 0 ? text.align_left : text.align_right,
         bgcolor=hdr ? color.new(#2a2e39, 20) : color(na))

f_row(int r, int k, string nm) =>
    float n = cN.get(k)
    if n > 0
        float hm = cHitM.get(k) / n * 100
        float hx = cHitX.get(k) / n * 100
        float lift = hm - hx
        float mn = cMaeN.get(k)
        color lc = n < 30 ? #b2b5be : lift > 8 ? #26a69a : lift < -8 ? #ef5350 : #b2b5be
        f_cell(0, r, nm, #b2b5be, false)
        f_cell(1, r, str.tostring(int(n)), n < 30 ? #ff9800 : #b2b5be, false)
        f_cell(2, r, str.tostring(hm, "#.#") + "%", #b2b5be, false)
        f_cell(3, r, str.tostring(hx, "#.#") + "%", #6c7080, false)
        f_cell(4, r, str.tostring(lift, "+#.#"), lc, false)
        f_cell(5, r, mn > 0 ? str.tostring(cMae.get(k) / mn, "#.##") : "-",
             mn > 0 and cMae.get(k) / mn < 1.0 ? #26a69a : #b2b5be, false)
    else
        f_cell(0, r, nm, #3a3e48, false)
        for c = 1 to 5
            f_cell(c, r, "-", #3a3e48, false)
    n

f_results() =>
    f_cell(0, 0, "MAGNET", #d1d4dc, true)
    f_cell(1, 0, "N", #d1d4dc, true)
    f_cell(2, 0, "HIT", #d1d4dc, true)
    f_cell(3, 0, "MIRROR", #d1d4dc, true)
    f_cell(4, 0, "LIFT", #d1d4dc, true)
    f_cell(5, 0, "MAE/D", #d1d4dc, true)
    f_row(1, 0, "Poor high")
    f_row(2, 1, "Poor low")
    f_row(3, 2, "Excess high")
    f_row(4, 3, "Excess low")
    f_row(5, 4, "Prior POC")
    f_row(6, 5, "Prior VAH")
    f_row(7, 6, "Prior VAL")
    f_row(8, 7, "Session gap")
    // POOR against EXCESS is the theory's own prediction, so it gets its own
    // line rather than leaving the reader to subtract two rows by eye.
    float pn = cN.get(0) + cN.get(1)
    float xn = cN.get(2) + cN.get(3)
    float pl = pn > 0 ? (cHitM.get(0) + cHitM.get(1) - cHitX.get(0) - cHitX.get(1)) / pn * 100 : na
    float xl = xn > 0 ? (cHitM.get(2) + cHitM.get(3) - cHitX.get(2) - cHitX.get(3)) / xn * 100 : na
    f_cell(0, 9, "POOR lift", #d1d4dc, true)
    f_cell(1, 9, str.tostring(int(pn)), #b2b5be, true)
    f_cell(2, 9, na(pl) ? "-" : str.tostring(pl, "+#.#"), na(pl) ? #b2b5be : pl > 8 ? #26a69a : #b2b5be, true)
    f_cell(3, 9, "EXCESS lift", #d1d4dc, true)
    f_cell(4, 9, str.tostring(int(xn)), #b2b5be, true)
    f_cell(5, 9, na(xl) ? "-" : str.tostring(xl, "+#.#"), na(xl) ? #b2b5be : xl < 0 ? #26a69a : #b2b5be, true)
    f_cell(0, 10, "open " + str.tostring(mLvl.size()) + "   horizon " + str.tostring(horiz) + "b", #6c7080, false)
    f_cell(1, 10, "", #6c7080, false)
    f_cell(2, 10, "", #6c7080, false)
    f_cell(3, 10, "theory:", #6c7080, false)
    f_cell(4, 10, "POOR>0", #6c7080, false)
    f_cell(5, 10, "EXCESS<0", #6c7080, false)
    mLvl.size()

if showTbl and barstate.islast
    f_results()
