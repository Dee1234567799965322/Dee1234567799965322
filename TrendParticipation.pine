//@version=6
indicator("Trend Participation Engine", "TPE", overlay = false)

// ═══════════════════════════════════════════════════════════════════════════
// THE ONE THING A MONTH OF MEASUREMENT SAYS YOU CAN TRUST
// ═══════════════════════════════════════════════════════════════════════════
// Twenty-one entry signals were measured in this project over ~35,000 trades.
// Not one beat a coin flip. So this file contains NO entry signal - trying to
// predict the next candle is the thing that does not work.
//
// What DID survive measurement was structural, not predictive:
//   1. DRIFT. Some assets (crypto majors, equity indices) go up over time. That
//      is beta, not skill - but it is real and it is free.
//   2. TREND-FOLLOWING EXITS capture the rare large move and cut the small loss.
//   3. The TAIL kills you unless you trade continuously-quoted instruments and
//      size by volatility, never by a fixed stop you can gap through.
//
// So this is a PARTICIPATION machine, not a predictor:
//   - Be long only while the slow trend is up (participate in drift; don't guess).
//   - Size every position by volatility so each bar risks about the same (this is
//     the tail control the gap trades taught us).
//   - Trail out with a wide chandelier stop to keep the fat right tail.
//   - No fixed notional stop - only a trailing one - so there is no "1R" to gap.
//   - Long only: across every test the SHORT side was the weak one, and drift is up.
//
// THE HONEST BAR: on a drifting asset the benchmark is NOT a coin flip - it is
// BUY-AND-HOLD. This engine plots its own equity against buy-and-hold and judges
// itself on RETURN PER UNIT OF DRAWDOWN (a MAR-style ratio). It earns its keep
// only if it keeps most of the return with materially less pain. If it does not,
// the honest answer is: just hold, or don't trade. The panel will say so.
//
// This is beta capture + tail control. It does not claim alpha. That is exactly
// why it is trustworthy: it only claims what the data actually supports.
// Everything is on CONFIRMED bars; position set at a bar's close earns the NEXT
// bar's return, so nothing repaints or peeks.

// ── Inputs ────────────────────────────────────────────────────────────────────
string G = "Engine"
int   trendLen   = input.int(200, "Trend regime EMA", minval = 20, maxval = 500, tooltip = "Long only while price is above this EMA. The single filter that keeps you participating with the trend instead of guessing turns.", group = G)
int   atrLen     = input.int(22,  "ATR length", minval = 2, maxval = 200, group = G)
float chMult     = input.float(4.0, "Chandelier trail (ATR x)", minval = 1.0, maxval = 12.0, step = 0.5, tooltip = "The trailing exit distance. Wider = fewer shake-outs, larger give-back. There is NO fixed stop; this trail is the only exit besides losing the trend.", group = G)
float volTarget  = input.float(2.0, "Volatility target (% move/bar)", minval = 0.2, maxval = 10.0, step = 0.1, tooltip = "Each bar the position is levered so that a typical bar moves equity by about this much. Calm markets get more size, wild markets less - constant risk. THIS is the tail control.", group = G)
float maxLev     = input.float(3.0, "Max leverage", minval = 1.0, maxval = 10.0, step = 0.5, tooltip = "Hard cap on position size, so a quiet grind cannot lever you into a cliff.", group = G)
float costPct    = input.float(0.04, "Cost per side (%)", minval = 0.0, maxval = 1.0, step = 0.01, tooltip = "Spread + fee + slippage charged on every entry and exit. Buy-and-hold pays it once.", group = G)

float atr     = ta.atr(atrLen)
float trendEma = ta.ema(close, trendLen)

// ── Position + two equity curves (strategy vs buy-and-hold) ───────────────────
var int   pos      = 0        // position decided at the previous close (0 flat, 1 long)
var float trail    = na
var float lev      = 0.0      // leverage carried into this bar
var int   posPrev  = 0
var float levPrev  = 0.0

var float eqS   = 100.0       // strategy equity
var float eqBH  = 100.0       // buy-and-hold equity
var float peakS = 100.0
var float peakBH= 100.0
var float maxDDs = 0.0
var float maxDDbh= 0.0
var float worstBar = 0.0      // worst single-bar strategy return (%) - the tail
var int   nTrades = 0
var int   inBars = 0
var int   totBars = 0

if barstate.isconfirmed and not na(close[1]) and close[1] > 0 and not na(trendEma)
    float ret = close / close[1] - 1.0

    // 1) apply this bar's market move using the exposure carried in from last bar
    if posPrev == 1
        float g = levPrev * ret
        eqS *= (1.0 + g)
        worstBar := math.min(worstBar, g * 100.0)
    eqBH *= (1.0 + ret)

    // drawdowns
    peakS  := math.max(peakS, eqS)
    peakBH := math.max(peakBH, eqBH)
    maxDDs  := math.max(maxDDs,  peakS  > 0 ? (peakS  - eqS)  / peakS  * 100.0 : 0.0)
    maxDDbh := math.max(maxDDbh, peakBH > 0 ? (peakBH - eqBH) / peakBH * 100.0 : 0.0)

    // 2) decide the position to carry into the NEXT bar, at this close
    bool trendUp = close > trendEma
    if pos == 1
        trail := math.max(trail, close - atr * chMult)
        if close < trail or not trendUp
            pos := 0
            eqS *= (1.0 - costPct / 100.0)   // exit cost
    if pos == 0 and trendUp and not na(atr) and atr > 0
        pos := 1
        trail := close - atr * chMult
        eqS *= (1.0 - costPct / 100.0)       // entry cost
        nTrades += 1

    // exposure for next bar: vol-targeted leverage, capped
    float barVolPct = atr > 0 and close > 0 ? atr / close * 100.0 : na
    lev := pos == 1 and not na(barVolPct) ? math.min(maxLev, volTarget / math.max(barVolPct, 0.01)) : 0.0

    posPrev := pos
    levPrev := lev
    inBars  += pos
    totBars += 1

// ── Equity curves (the whole point: can it beat just holding?) ────────────────
plot(eqS,  "Strategy equity",     color = color.new(color.teal, 0),  linewidth = 2)
plot(eqBH, "Buy & hold equity",   color = color.new(color.gray, 20), linewidth = 1)
plot(pos == 1 ? eqS : na, "In market", color = color.new(color.teal, 60), style = plot.style_circles, linewidth = 1)
hline(100, "Start", color = color.new(color.gray, 70), linestyle = hline.style_dotted)

// ── Scoreboard ────────────────────────────────────────────────────────────────
string GS = "Scoreboard"
bool   sOn  = input.bool(true, "Show scoreboard", group = GS)
string sPos = input.string("Top Right", "Position", options = ["Top Right","Top Left","Middle Right","Bottom Right","Bottom Left"], group = GS)
f_pos(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Middle Right" => position.middle_right
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

float retS  = eqS  - 100.0
float retBH = eqBH - 100.0
float marS  = maxDDs  > 0 ? retS  / maxDDs  : na    // return per unit of drawdown
float marBH = maxDDbh > 0 ? retBH / maxDDbh : na
float pctIn = totBars > 0 ? inBars / float(totBars) * 100.0 : na

string verdict = "NEED MORE HISTORY"
color  vCol = color.gray
if totBars >= 200
    if retS > 0 and not na(marS) and not na(marBH) and marS > marBH and maxDDs < maxDDbh
        verdict := "BEATS HOLD  (less pain)"
        vCol := color.green
    else if retS > 0 and not na(marS) and not na(marBH) and marS > marBH
        verdict := "better risk-adj, more DD"
        vCol := color.new(color.green, 40)
    else if retS > 0
        verdict := "UNDERPERFORMS HOLD"
        vCol := color.orange
    else
        verdict := "NEGATIVE"
        vCol := color.red

var table t = table.new(f_pos(sPos), 3, 10, bgcolor = color.new(color.black, 12), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
f_h(int r, string a, string b, string c) =>
    table.cell(t, 0, r, a, text_color = color.new(color.white, 20), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, b, text_color = color.new(color.teal, 0),  text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, c, text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_right)
    r
f_pctv(float v) => na(v) ? "—" : str.tostring(v, "#.#") + "%"

if sOn and barstate.islast
    table.cell(t, 0, 0, "TREND PARTICIPATION", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, "strat", text_color = color.new(color.teal, 0), text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, 0, "hold",  text_color = color.new(color.white, 35), text_size = size.small, text_halign = text.align_right)
    f_h(1, "Total return",       f_pctv(retS),  f_pctv(retBH))
    f_h(2, "Max drawdown",       "-" + str.tostring(maxDDs, "#.#") + "%", "-" + str.tostring(maxDDbh, "#.#") + "%")
    f_h(3, "Return / drawdown",  na(marS) ? "—" : str.tostring(marS, "#.##"), na(marBH) ? "—" : str.tostring(marBH, "#.##"))
    f_h(4, "Worst single bar",   str.tostring(worstBar, "#.#") + "%", "")
    f_h(5, "Time in market",     f_pctv(pctIn), "")
    f_h(6, "Trades",             str.tostring(nTrades), "")
    table.cell(t, 0, 7, "VERDICT", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 7, verdict, text_color = vCol, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, 7, "", text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 8, "vs BUY & HOLD, not a coin flip", text_color = color.new(color.white, 55), text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 8, "", text_color = color.gray)
    table.cell(t, 2, 8, "", text_color = color.gray)

alertcondition(pos == 1 and pos[1] == 0, "TPE enter long",  "Trend Participation: trend up, entering")
alertcondition(pos == 0 and pos[1] == 1, "TPE exit",        "Trend Participation: trend lost, flat")
